<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FFXIV_Craft_Architect.Core</RootNamespace>
    <AssemblyName>FFXIV_Craft_Architect.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Gooseworks.FFXIVCraftArchitect.Core</PackageId>
    <Version>0.1.0-local</Version>
    <Authors>Gooseworks</Authors>
    <Description>Core planning services for FFXIV Craft Architect, including the craft appraisal engine, plan snapshots and item lookup that a host can run in-process.</Description>
    <PackageTags>ffxiv;crafting;workshop-host;marketmafioso</PackageTags>
    <PackageProjectUrl>https://github.com/FranFkntastic/XIV-Craft-Architect</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FranFkntastic/XIV-Craft-Architect</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Franthropy.FFXIV" Version="[$(FranthropyPackageVersion)]" Condition="'$(FranthropySource)' == 'Package'" />
    <ProjectReference Include="$(FranthropyRoot)/src/Franthropy.FFXIV/Franthropy.FFXIV.csproj" Condition="'$(FranthropySource)' == 'Local'" SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\world-directory.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FFXIV Craft Architect.ContractTests" />
    <InternalsVisibleTo Include="FFXIV_Craft_Architect.Web" />
  </ItemGroup>

</Project>
