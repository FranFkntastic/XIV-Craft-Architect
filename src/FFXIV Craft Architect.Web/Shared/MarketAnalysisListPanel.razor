            SortDescending);
    }

    private IReadOnlyList<WorkerMarketItemProjection> GetProjectedItems()
    {
        var items = ProjectedItems.AsEnumerable();
        IOrderedEnumerable<WorkerMarketItemProjection> ordered = SortColumn switch
        {
            MarketAnalysisGridSortColumn.Quantity => OrderProjectedItems(
                items,
                item => item.QuantityNeeded,
                SortDescending),
            MarketAnalysisGridSortColumn.Coverage => OrderProjectedItems(
                items,
                item => item.AvailableQuantity,
                SortDescending),
            MarketAnalysisGridSortColumn.Worlds => OrderProjectedItems(
                items,
                item => item.WorldCount,
                SortDescending),
            MarketAnalysisGridSortColumn.Total => OrderProjectedItems(
                items,
                item => item.EstimatedTotalCost,
                SortDescending),
            _ => OrderProjectedItems(
                items,
                item => item.Name,
                SortDescending,
                StringComparer.OrdinalIgnoreCase)
        };

        return ordered.ThenBy(item => item.ItemId).ToArray();
    }

    private static IOrderedEnumerable<WorkerMarketItemProjection> OrderProjectedItems<TKey>(
        IEnumerable<WorkerMarketItemProjection> items,
        Func<WorkerMarketItemProjection, TKey> selector,
        bool descending,
        IComparer<TKey>? comparer = null) =>
        descending
            ? items.OrderByDescending(selector, comparer)
            : items.OrderBy(selector, comparer);

    private IReadOnlyList<WorkerMarketWorldProjection> GetProjectedWorlds(
        WorkerMarketItemProjection item)
    {
        var worlds = item.Worlds.AsEnumerable();
        IOrderedEnumerable<WorkerMarketWorldProjection> ordered = WorldSortColumn switch
        {
            MarketAnalysisWorldGridSortColumn.StockDepth => OrderProjectedWorlds(
                worlds,
                world => world.Quantity,
                WorldSortDescending),
            MarketAnalysisWorldGridSortColumn.Coverage => OrderProjectedWorlds(
                worlds,
                world => world.HasSufficientStock,
                WorldSortDescending),
            MarketAnalysisWorldGridSortColumn.PriceValue => OrderProjectedWorlds(
                worlds,
                world => world.AverageUnitPrice,
                WorldSortDescending),
            MarketAnalysisWorldGridSortColumn.Value => OrderProjectedWorlds(
                worlds,
                world => world.TotalCost,
                WorldSortDescending),
            MarketAnalysisWorldGridSortColumn.Data => OrderProjectedWorlds(
                worlds,
                world => world.DataAge ?? TimeSpan.MaxValue,
                WorldSortDescending),
            _ => OrderProjectedWorlds(
                worlds,
                world => world.WorldName,
                WorldSortDescending,
                StringComparer.OrdinalIgnoreCase)
        };

        return ordered
            .ThenBy(world => world.DataCenter, StringComparer.OrdinalIgnoreCase)
            .ThenBy(world => world.WorldName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static IOrderedEnumerable<WorkerMarketWorldProjection> OrderProjectedWorlds<TKey>(
        IEnumerable<WorkerMarketWorldProjection> worlds,
        Func<WorkerMarketWorldProjection, TKey> selector,
        bool descending,
        IComparer<TKey>? comparer = null) =>
        descending
            ? worlds.OrderByDescending(selector, comparer)
            : worlds.OrderBy(selector, comparer);

    private string GetProjectedCardClass(WorkerMarketItemProjection item)
    {
        var classes = new List<string> { "ma-market-card" };
        if (_selectedProjectedItem?.ItemId == item.ItemId)
        {
            classes.Add("is-selected");
        }
        if (!item.HasSufficientStock || !string.IsNullOrWhiteSpace(item.Warning))
        {
            classes.Add("has-warning");
        }
        return string.Join(" ", classes);
    }

    private static string GetProjectedCardDestination(WorkerMarketItemProjection item)
    {
        if (!string.IsNullOrWhiteSpace(item.RecommendedWorld) &&
            !string.Equals(item.RecommendedWorld, "Unavailable", StringComparison.OrdinalIgnoreCase))
        {
            return item.RecommendedWorld;
        }

        return GetProjectedFallbackDestination(item);
    }

    private static string GetProjectedFallbackDestination(WorkerMarketItemProjection item) =>
        item.WorldCount switch
        {
            <= 0 => "No eligible worlds",
            1 when item.Worlds.FirstOrDefault() is { } world => $"{world.WorldName} · {world.DataCenter}",
            1 => "1 world compared",
            _ => $"{item.WorldCount:N0} worlds compared"
        };

    private static string GetProjectedStockClass(WorkerMarketItemProjection item) =>
        item.HasSufficientStock ? "ma-stock-ok" : "ma-stock-warning";

    private static string FormatProjectedCoverage(WorkerMarketItemProjection item) =>
        item.IsAvailable
            ? $"{item.AvailableQuantity:N0} / {item.QuantityNeeded:N0}"
            : "Unavailable";

    private static string GetProjectedTotalClass(WorkerMarketItemProjection item) =>
        item.IsAvailable
            ? "ma-total-value"
            : "ma-total-value is-unavailable";

    private static string GetProjectedTotalTooltip(WorkerMarketItemProjection item) =>
        item.IsAvailable
            ? $"Calculated cost across {item.WorldCount:N0} world{(item.WorldCount == 1 ? string.Empty : "s")}."
            : item.Warning ?? "No eligible market listings are available.";

    private static string FormatProjectedTotal(WorkerMarketItemProjection item) =>
        item.IsAvailable ? FormatGil(item.EstimatedTotalCost) : "Unavailable";

    private static string GetUniversalisUrl(int itemId) =>
        $"https://universalis.app/market/{itemId}";

    private static string FormatWorldAge(TimeSpan? age)
    {
        if (!age.HasValue)
        {
            return "-";
        }

        var value = age.Value < TimeSpan.Zero ? TimeSpan.Zero : age.Value;
        if (value < TimeSpan.FromMinutes(1))
        {
            return "<1m";
        }
        if (value < TimeSpan.FromHours(1))
        {
            return $"{Math.Floor(value.TotalMinutes):N0}m";
        }
        return value < TimeSpan.FromDays(1)
            ? $"{Math.Floor(value.TotalHours):N0}h"
            : $"{Math.Floor(value.TotalDays):N0}d";
    }

    private static bool HasWarning(DetailedShoppingPlan plan)
    {
        return !string.IsNullOrWhiteSpace(plan.Error) ||
            !string.IsNullOrWhiteSpace(plan.MarketDataWarning) ||
            !plan.HasSufficientStock;
    }

    private static string GetQuantityLabel(DetailedShoppingPlan plan)
    {
        if (!plan.HasSufficientStock)
            return $"{plan.TotalAvailableQuantity:N0}/{plan.QuantityNeeded:N0}";
        return FormatQuantity(plan.QuantityNeeded);
    }

    private static string FormatQuantity(int quantity)
    {
        return $"x{quantity:N0}";
    }

    private static string FormatGil(decimal value)
    {
        return $"{value:N0}g";
    }

    private static string FormatGil(long value)
    {
        return $"{value:N0}g";
    }

    private static string FormatBandRange(MarketScopePriceBand band)
    {
        return band.MinUnitPrice == band.MaxUnitPrice
            ? FormatGil(band.MinUnitPrice)
            : $"{FormatGil(band.MinUnitPrice)} - {FormatGil(band.MaxUnitPrice)}";
    }

    private static string FormatBandCompetitiveness(PriceBandCompetitiveness competitiveness)
    {
        return competitiveness switch
        {
            PriceBandCompetitiveness.LowOutlier => "Deal",
            PriceBandCompetitiveness.Competitive => "Acceptable",
            PriceBandCompetitiveness.Uncompetitive => "Pricey",
            PriceBandCompetitiveness.Insane => "Extreme outlier",
            _ => "Unclassified"
        };
    }

    private static string GetPriceBandSignalClass(MarketScopePriceBand band)
    {
        return band.Competitiveness switch
        {
            PriceBandCompetitiveness.LowOutlier => "ma-price-band-signal is-low-outlier",
            PriceBandCompetitiveness.Competitive when band.Depth == PriceBandDepth.Thin => "ma-price-band-signal is-thin",
            PriceBandCompetitiveness.Competitive => "ma-price-band-signal is-competitive",
            PriceBandCompetitiveness.Uncompetitive => "ma-price-band-signal is-uncompetitive",
            PriceBandCompetitiveness.Insane => "ma-price-band-signal is-insane",
            _ => "ma-price-band-signal"
        };
    }

    private static string GetPriceBandKey(MarketScopePriceBand band)
    {
        return $"{band.MinUnitPrice}:{band.MaxUnitPrice}:{band.Competitiveness}:{band.Depth}";
    }

    private static int GetBandSignalSortValue(MarketScopePriceBand band)
    {
        var competitivenessRank = band.Competitiveness switch
        {
            PriceBandCompetitiveness.LowOutlier => 0,
            PriceBandCompetitiveness.Competitive => 1,
            PriceBandCompetitiveness.Uncompetitive => 2,
            PriceBandCompetitiveness.Insane => 3,
            _ => 4
        };
        var depthRank = band.Depth switch
        {
            PriceBandDepth.Deep => 0,
            PriceBandDepth.Usable => 1,
            PriceBandDepth.Thin => 2,
            _ => 3
        };

        return competitivenessRank * 10 + depthRank;
    }

    private static string GetPriceBandListingKey(PriceBandListingRow row)
    {
        return $"{row.WorldName}:{row.Listing.SortIndex}:{row.Listing.PricePerUnit}:{row.Listing.RetainerName}";
    }

    private static string FormatReviewAge(AnalyzedMarketListing listing)
    {
        if (!listing.LastReviewTimeUtc.HasValue)
        {
            return "-";
        }

        var age = DateTime.UtcNow - listing.LastReviewTimeUtc.Value;
        if (age < TimeSpan.Zero)
        {
            age = TimeSpan.Zero;
        }

        if (age < TimeSpan.FromMinutes(1))
        {
            return "<1m";
        }

        if (age < TimeSpan.FromHours(1))
        {
            return $"{Math.Floor(age.TotalMinutes):N0}m";
        }

        return age < TimeSpan.FromDays(1)
            ? $"{Math.Floor(age.TotalHours):N0}h"
            : $"{Math.Floor(age.TotalDays):N0}d";
    }

    private static string FormatReviewTooltip(AnalyzedMarketListing listing)
    {
        return listing.LastReviewTimeUtc.HasValue
            ? $"Reviewed: {listing.LastReviewTimeUtc.Value.ToLocalTime():g}"
            : "Review time unavailable";
    }

    private static string FormatListingFlags(AnalyzedMarketListing listing)
    {
        if (listing.PriceSanity == MarketListingPriceSanity.Insane)
        {
            return "extreme outlier";
        }

        if (listing.PriceSanity == MarketListingPriceSanity.Outlier)
        {
            return "outlier";
        }

        if (listing.PriceSanity == MarketListingPriceSanity.LowOutlier)
        {
            return "low outlier";
        }

        if (listing.Competitiveness is MarketListingCompetitiveness.Fair or MarketListingCompetitiveness.Uncompetitive)
        {
            return "pricy";
        }

        return string.Empty;
    }

    private string GetPlanCardClass(DetailedShoppingPlan plan)
    {
        var classes = new List<string> { "ma-market-card" };
        if (_selectedPlan?.ItemId == plan.ItemId)
        {
            classes.Add("is-selected");
        }

        if (HasWarning(plan))
        {
            classes.Add("has-warning");
        }

        return string.Join(" ", classes);
    }

    private static string GetCardDestination(DetailedShoppingPlan plan)
    {
        if (!string.IsNullOrWhiteSpace(plan.Error))
        {
            return "Needs attention";
        }

        if (plan.RequiresSplitPurchase && plan.RecommendedSplit?.Any() == true)
        {
            var worldCount = plan.RecommendedSplit
                .Select(split => split.WorldName)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();
            return $"{worldCount:N0}-world split";
        }

        return plan.RecommendedWorld is { } world
            ? string.Equals(world.WorldName, MarketShoppingConstants.VendorWorldName, StringComparison.OrdinalIgnoreCase)
                ? "Vendor"
                : string.IsNullOrWhiteSpace(world.DataCenter)
                    ? world.WorldName
                    : $"{world.WorldName} · {world.DataCenter}"
            : "No eligible purchase";
    }

    private static string GetRecommendationClass(DetailedShoppingPlan plan) =>
        !string.IsNullOrWhiteSpace(plan.Error) ||
        plan.RecommendedWorld is null && plan.RecommendedSplit?.Any() != true
            ? "ma-recommendation-strip is-warning"
            : "ma-recommendation-strip";

    private static string GetRecommendationTitle(DetailedShoppingPlan plan)
    {
        if (!string.IsNullOrWhiteSpace(plan.Error))
        {
            return "Purchase needs attention";
        }

        if (plan.RequiresSplitPurchase && plan.RecommendedSplit?.Any() == true)
        {
            var worldCount = plan.RecommendedSplit
                .Select(split => split.WorldName)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();
            return $"Buy across {worldCount:N0} worlds";
        }

        return plan.RecommendedWorld is { } world
            ? string.Equals(world.WorldName, MarketShoppingConstants.VendorWorldName, StringComparison.OrdinalIgnoreCase)
                ? "Buy from vendor"
                : $"Buy on {world.WorldName}"
            : "No eligible purchase";
    }

    private static string GetRecommendationDetail(DetailedShoppingPlan plan)
    {
        if (!string.IsNullOrWhiteSpace(plan.Error))
        {
            return plan.Error;
        }

        if (plan.RequiresSplitPurchase && plan.RecommendedSplit?.Any() == true)
        {
            var quantity = plan.RecommendedSplit.Sum(split => split.QuantityToBuy);
            return $"{quantity:N0}/{plan.QuantityNeeded:N0} covered for {MarketAnalysisGridViewService.FormatTotalCost(plan)}.";
        }

        if (plan.RecommendedWorld is { } world)
        {
            if (string.Equals(world.WorldName, MarketShoppingConstants.VendorWorldName, StringComparison.OrdinalIgnoreCase))
            {
                return $"{plan.QuantityNeeded:N0} items for {MarketAnalysisGridViewService.FormatTotalCost(plan)}.";
            }

            var dataCenter = string.IsNullOrWhiteSpace(world.DataCenter)
                ? string.Empty
                : $"{world.DataCenter} · ";
            return $"{dataCenter}{world.TotalQuantityPurchased:N0}/{plan.QuantityNeeded:N0} covered at ~{world.AveragePricePerUnit:N0}g each.";
        }

        return "The current evidence does not contain a complete eligible purchase.";
    }

    private static string? GetPlanWarning(DetailedShoppingPlan plan)
    {
        if (!string.IsNullOrWhiteSpace(plan.MarketDataWarning))
        {
            return plan.MarketDataWarning;
        }

        if (!plan.HasSufficientStock)
        {
            return $"Only {plan.TotalAvailableQuantity:N0} of {plan.QuantityNeeded:N0} required items are covered.";
        }

        return null;
    }

    private int GetDisplayedItemCount() => _orderedPlans.Count + _orderedProjectedItems.Count;

    private string FormatScopeSummary()
    {
        var analyzedWorldCount = _analysisByItemId.Values
            .Select(analysis => analysis.Worlds.Count)
            .DefaultIfEmpty(0)
            .Max();
        var projectedWorldCount = _orderedProjectedItems
            .Select(item => item.WorldCount)
            .DefaultIfEmpty(0)
            .Max();
        var worldCount = Math.Max(analyzedWorldCount, projectedWorldCount);
        if (worldCount > 0)
        {
            return $"{worldCount:N0} world{(worldCount == 1 ? string.Empty : "s")} searched";
        }

        return ShowWorldsColumn ? "Regional search" : "Data-center search";
    }

    private string FormatDisplayedTotal()
    {
        var total = _orderedPlans.Sum(plan => (decimal)MarketAnalysisGridViewService.GetTotalCost(plan)) +
            _orderedProjectedItems.Where(item => item.IsAvailable).Sum(item => item.EstimatedTotalCost);
        return total > 0 ? $"{total:N0}g total" : "No purchase total";
    }

    private string FormatCoverageSummary()
    {
        var itemCount = GetDisplayedItemCount();
        if (itemCount == 0)
        {
            return "No purchases";
        }

        var coveredCount = _orderedPlans.Count(plan => plan.HasSufficientStock) +
            _orderedProjectedItems.Count(item => item.HasSufficientStock);
        return coveredCount == itemCount
            ? "All requirements covered"
            : $"{coveredCount:N0}/{itemCount:N0} requirements covered";
    }

    private static string FormatItemCount(int count) =>
        $"{count:N0} market purchase{(count == 1 ? string.Empty : "s")}";

    private static string GetStockClass(DetailedShoppingPlan plan)
    {
        return !plan.HasSufficientStock
            ? "ma-stock-warning"
            : "ma-stock-ok";
    }

    private async Task CopySelectedItemNameAsync(string itemName)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", itemName);
            Snackbar.Add("Item name copied", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to copy item name", Severity.Error);
        }
    }

