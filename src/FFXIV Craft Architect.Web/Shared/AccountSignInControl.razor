@using FFXIV_Craft_Architect.Web.Services.ProfileHosting
@inject DiscordIdentityClient DiscordIdentityClient
@inject ProfileHostClient ProfileHostClient
@inject ProfileSyncLocalStateService LocalState
@inject ProfileSyncService ProfileSync
@inject IDialogService DialogService
@implements IDisposable

@if (_signInEnabled && !_connected)
{
    <MudButton Variant="Variant.Text"
               OnClick="OpenAccountAsync"
               Disabled="_settingsOpen"
               Style="color: #d4a73a; text-transform: none; font-size: 14px;">
        <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Small" Style="color: #7289da; margin-right: 8px;" />
        Sign in with Discord
    </MudButton>
}
else if (_connected)
{
    <MudButton Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.AccountCircle"
               OnClick="OpenAccountAsync"
               Disabled="_settingsOpen"
               Style="color: #cccccc; text-transform: none; font-size: 14px;">
        @(string.IsNullOrWhiteSpace(_displayName) ? "Account" : _displayName)
    </MudButton>
}
else
{
    <MudButton Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.AccountCircle"
               OnClick="OpenAccountAsync"
               Disabled="_settingsOpen"
               Style="color: #cccccc; text-transform: none; font-size: 14px;">
        Connect account
    </MudButton>
}

@code {
    private bool _signInEnabled;
    private bool _connected;
    private bool _settingsOpen;
    private string? _displayName;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        ProfileSync.ConnectionChanged += OnConnectionChanged;
        ProfileSync.ProfileMetadataMayHaveChanged += OnProfileMetadataMayHaveChanged;
    }

    private async void OnConnectionChanged()
    {
        await InvokeAsync(RefreshAsync);
    }

    private async void OnProfileMetadataMayHaveChanged()
    {
        await InvokeAsync(RefreshAsync);
    }

    private async Task RefreshAsync()
    {
        try
        {
            var settings = await LocalState.LoadConnectionSettingsAsync();
            if (settings.IsConfigured)
            {
                try
                {
                    var profile = await ProfileHostClient.GetProfileAsync(
                        settings.HostUrl!,
                        settings.AccessKey!,
                        CancellationToken.None);
                    if (!string.Equals(settings.ConnectedProfileName, profile.DisplayName, StringComparison.Ordinal) ||
                        settings.ConnectedProfileMetadataRevision != profile.MetadataRevision)
                    {
                        var saved = await LocalState.TrySaveConnectedProfileNameAsync(
                            settings,
                            profile.DisplayName,
                            profile.MetadataRevision);
                        if (saved == ConnectedProfileNameSaveResult.Saved)
                        {
                            settings.ConnectedProfileName = profile.DisplayName;
                            settings.ConnectedProfileMetadataRevision = profile.MetadataRevision;
                        }
                        else
                        {
                            settings = await LocalState.LoadConnectionSettingsAsync();
                        }
                    }
                }
                catch (Exception)
                {
                    // Keep the last truthful account name while the host is unavailable.
                }
            }
            _connected = settings.IsConfigured;
            _displayName = settings.ConnectedProfileName;
            _signInEnabled = !_connected &&
                (await DiscordIdentityClient.GetSignInStatusAsync(
                    ProfileHostClient.DefaultHostUrl,
                    CancellationToken.None)).Enabled;
        }
        catch (Exception)
        {
            _signInEnabled = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenAccountAsync()
    {
        if (_settingsOpen)
        {
            return;
        }

        _settingsOpen = true;
        try
        {
            var parameters = new DialogParameters
            {
                [nameof(SettingsDialog.InitialSection)] = SettingsSection.Profile
            };
            var options = new DialogOptions { CloseOnEscapeKey = false, MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
            var dialog = await DialogService.ShowAsync<SettingsDialog>("Settings", parameters, options);
            await dialog.Result;
            await RefreshAsync();
        }
        finally
        {
            _settingsOpen = false;
        }
    }

    public void Dispose()
    {
        ProfileSync.ConnectionChanged -= OnConnectionChanged;
        ProfileSync.ProfileMetadataMayHaveChanged -= OnProfileMetadataMayHaveChanged;
    }
}
