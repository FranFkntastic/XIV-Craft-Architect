@using FFXIV_Craft_Architect.Core.Engine
@using FFXIV_Craft_Architect.Core.Models
@using FFXIV_Craft_Architect.Web.Services
@inject IConfiguration Configuration
@inject WorkerSessionCoordinator WorkerSession
@inject WorkerProjectionStore WorkerProjections
@inject CraftArchitectEngineHost EngineHost

@if (_enabled)
{
    <div data-benchmark-id="engine-transaction-acceptance"
         data-status="@_status"
         data-progress-count="@_progressCount"
         data-progress="@_progress"
         data-terminal-status="@_terminalStatus"
         data-final-transaction-hash="@_finalTransactionHash"
         data-failure-code="@_failureCode"
         data-failed-phase="@_failedPhase"
         data-terminal-evidence="@_terminalEvidence"
         data-evidence-issues="@_evidenceIssues"
         data-settlement-phase-timings=""
         data-autosave-timings=""
         data-ledger-complete-timings=""
         data-worker-result-timings=""
         data-computation-validation-ms=""
         data-replay-matched="@_replayMatched.ToString().ToLowerInvariant()"
         data-replay-status="@_replayStatus"
         data-replay-hash="@_replayHash"
         data-replay-error="@_replayError"
         data-route-validity="@(WorkerProjections.Procurement?.HasRoute == true ? "Current" : "Missing")"
         data-route-has-decision="@(WorkerProjections.Procurement?.HasRoute == true ? "true" : "false")"
         data-route-truncated="@(WorkerProjections.Procurement?.RouteSearchWasTruncated.ToString().ToLowerInvariant())"
         data-error="@_error">
        <button type="button"
                data-benchmark-id="engine-transaction-run"
                disabled="@_running"
                @onclick="RunAsync">
            Run browser Worker session acceptance
        </button>
        <span data-benchmark-id="engine-transaction-progress">@_progress</span>
    </div>
}

@code {
    private bool _enabled;
    private bool _running;
    private string _status = "ready";
    private string _terminalStatus = string.Empty;
    private string _finalTransactionHash = string.Empty;
    private string _failureCode = string.Empty;
    private string _failedPhase = string.Empty;
    private string _terminalEvidence = string.Empty;
    private string _evidenceIssues = string.Empty;
    private string _progress = string.Empty;
    private string _error = string.Empty;
    private int _progressCount;
    private bool _replayMatched;
    private string _replayStatus = string.Empty;
    private string _replayHash = string.Empty;
    private string _replayError = string.Empty;

    protected override void OnInitialized()
    {
        _enabled = Configuration.GetValue<bool>("EngineAcceptance:Enabled");
    }

    private async Task RunAsync()
    {
        if (_running)
        {
            return;
        }

        _running = true;
        _status = "running";
        _error = string.Empty;
        _progressCount = 0;
        try
        {
            Report("Reading canonical Worker session");
            var trade = await WorkerSession.GetTradeProjectionAsync()
                ?? throw new InvalidOperationException(
                    "Import a craft plan before running Worker acceptance.");
            if (!trade.HasPlan)
            {
                throw new InvalidOperationException(
                    "Import a craft plan before running Worker acceptance.");
            }

            var market = await WorkerSession.GetMarketProjectionAsync();
            if (market?.HasAnalysis != true && market?.CandidateCount > 0)
            {
                Report("Publishing market evidence");
                var analysis = await WorkerSession.RunMarketAnalysisAsync(
                    new WorkerMarketAnalysisRequest(
                        ForceRefreshData: false,
                        trade.MarketFetchScope,
                        trade.SelectedDataCenter,
                        trade.SelectedRegion,
                        trade.MarketLens));
                market = analysis.Market;
            }

            if (market?.CandidateCount > 0)
            {
                Report("Publishing procurement route");
                await WorkerSession.RunProcurementAsync(
                    new WorkerProcurementRequest(
                        trade.MarketFetchScope,
                        trade.SelectedDataCenter,
                        trade.SelectedRegion,
                        trade.MarketLens,
                        TravelTolerance: 0,
                        IncludeSplitPurchases: true,
                        StartFromHomeDataCenter: false,
                        MarketTravelPriority.DataCenterTransfersFirst));
            }

            Report("Committing acceptance snapshot");
            var before = await WorkerSession.ExportStoredPlanAsync(
                "acceptance",
                "Worker acceptance");
            _finalTransactionHash = EngineCanonicalHash.Compute(
                CreateDurableFingerprint(before),
                EngineJsonSerializerOptions.CreateWire());

            Report("Replacing Worker and restoring durable revision");
            await EngineHost.RestartAsync();
            await WorkerSession.BootstrapAsync();
            var after = await WorkerSession.ExportStoredPlanAsync(
                "acceptance",
                "Worker acceptance");
            _replayHash = EngineCanonicalHash.Compute(
                CreateDurableFingerprint(after),
                EngineJsonSerializerOptions.CreateWire());
            _replayMatched = string.Equals(
                _finalTransactionHash,
                _replayHash,
                StringComparison.Ordinal);
            _replayStatus = _replayMatched ? "Succeeded" : "Mismatch";
            if (!_replayMatched)
            {
                throw new InvalidOperationException(
                    "The restarted Worker did not restore the accepted durable session.");
            }

            _terminalStatus = "Succeeded";
            _terminalEvidence =
                $"revision={WorkerProjections.Shell.Revision};" +
                $"planSession={WorkerProjections.Shell.PlanSessionVersion};" +
                $"route={WorkerProjections.Shell.HasProcurementRoute}";
            _status = "complete";
        }
        catch (Exception ex)
        {
            _status = "failed";
            _terminalStatus = "Failed";
            _failureCode = "worker-session-acceptance";
            _failedPhase = _progress;
            _error = ex.Message;
            _replayError = ex.Message;
        }
        finally
        {
            _running = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Report(string message)
    {
        _progressCount++;
        _progress = message;
        _ = InvokeAsync(StateHasChanged);
    }

    private static DurableSessionFingerprint CreateDurableFingerprint(StoredPlan? plan) =>
        new(
            plan?.ProjectItems ?? [],
            plan?.PlanJson,
            plan?.MarketIntelligenceJson,
            plan?.MarketAnalysisRecipeBasisJson,
            plan?.ProcurementRouteJson,
            plan?.ProcurementTravelTolerance,
            plan?.SavedRecommendationMode,
            plan?.SavedMarketAnalysisLens,
            plan?.SourcePlanId,
            plan?.SourcePlanName,
            plan?.DataCenter);

    private sealed record DurableSessionFingerprint(
        IReadOnlyList<StoredProjectItem> ProjectItems,
        string? PlanJson,
        string? MarketIntelligenceJson,
        string? MarketAnalysisRecipeBasisJson,
        string? ProcurementRouteJson,
        int? ProcurementTravelTolerance,
        RecommendationMode? RecommendationMode,
        MarketAcquisitionLens? MarketLens,
        string? SourcePlanId,
        string? SourcePlanName,
        string? DataCenter);
}
