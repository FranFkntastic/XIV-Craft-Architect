@using FFXIV_Craft_Architect.Core.Models
@using FFXIV_Craft_Architect.Web.Services
@using FFXIV_Craft_Architect.Web.Services.ProfileHosting
@using FFXIV_Craft_Architect.Web.Services.TradeCompany
@inject TradeOperationsPersistenceService TradeOperationsPersistence
@inject ProfileSyncService ProfileSync
@inject ProfileSyncLocalStateService LocalState
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject FFXIV_Craft_Architect.Web.Services.TradeCompany.CompanyHubClient CompanyHubClient
@implements IDisposable

@if (_activeCompany != null)
{
    <MudMenu Dense="true"
             AnchorOrigin="Origin.TopCenter"
             TransformOrigin="Origin.BottomCenter"
             Class="trade-company-switcher">
        <ActivatorContent>
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Business"
                       EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                       Class="trade-company-switcher-button"
                       aria-label="Switch active Trade company">
                <span class="trade-company-switcher-name">@_activeCompany.Name</span>
                <span class="trade-company-switcher-id">@(_activeRole == null ? FormatCompanyId(_activeCompany.Id) : $"{_activeRole} · {FormatCompanyId(_activeCompany.Id)}")</span>
            </MudButton>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Href="@CompanyHubUrl(_activeCompany)" Icon="@Icons.Material.Filled.Home">
                Company hub
            </MudMenuItem>
            <div class="trade-company-switcher-heading">Active Trade company</div>
            @foreach (var company in _companies)
            {
                <MudMenuItem OnClick="@(() => SelectCompanyAsync(company))"
                             Icon="@(company.Id == _activeCompany.Id
                                 ? Icons.Material.Filled.Check
                                 : Icons.Material.Filled.BusinessCenter)">
                    <span class="trade-company-switcher-option">
                        <span class="trade-company-switcher-option-name">@company.Name</span>
                        <span class="trade-company-switcher-option-meta">
                            ID @FormatCompanyId(company.Id)
                        </span>
                    </span>
                </MudMenuItem>
            }
            <MudDivider />
            <MudMenuItem OnClick="OpenWorkspaceSettingsAsync" Icon="@Icons.Material.Filled.Notifications">
                Workspace settings and notifications
            </MudMenuItem>
        </ChildContent>
    </MudMenu>
}
else
{
    <MudButton Variant="Variant.Text"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Business"
               Class="trade-company-switcher-button"
               OnClick="OpenWorkspaceSettingsAsync">
        No company workspace
    </MudButton>
}

@code {
    private TradeCompanyProfile? _activeCompany;
    private IReadOnlyList<TradeCompanyProfile> _companies = [];
    private bool _refreshQueued;
    private bool _disposed;
    private string? _activeRole;

    protected override async Task OnInitializedAsync()
    {
        ProfileSync.StatusChanged += OnProfileSyncStatusChanged;
        await LoadCompaniesAsync();
    }

    private void OnProfileSyncStatusChanged()
    {
        if (_disposed || _refreshQueued)
        {
            return;
        }

        _refreshQueued = true;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadCompaniesAsync();
                StateHasChanged();
            }
            finally
            {
                _refreshQueued = false;
            }
        });
    }

    private async Task LoadCompaniesAsync()
    {
        try
        {
            var localCompanies = (await TradeOperationsPersistence.LoadCompanyProfilesAsync())
                .OrderBy(company => company.Name, StringComparer.OrdinalIgnoreCase)
                .ThenBy(company => company.Id)
                .ToArray();
            _companies = await FilterAuthorizedCompaniesAsync(localCompanies);
            _activeCompany = await TradeOperationsPersistence.LoadActiveCompanyProfileAsync();
            if (_activeCompany == null || _companies.All(company => company.Id != _activeCompany.Id))
            {
                _activeCompany = _companies.FirstOrDefault();
                if (_activeCompany != null)
                {
                    await TradeOperationsPersistence.SelectCompanyProfileAsync(_activeCompany.Id);
                }
            }
            _activeRole = null;
            if (_activeCompany != null)
            {
                try
                {
                    var hub = await CompanyHubClient.LoadAsync(_activeCompany.Id.ToString("D"));
                    _activeRole = hub?.Kind == "hub" ? SentenceCase(hub.Standing.Role) : null;
                }
                catch
                {
                    // The local company context remains truthful while hosted role data is unavailable.
                }
            }
        }
        catch (Exception exception)
        {
            _activeCompany = null;
            _companies = [];
            _activeRole = null;
            Snackbar.Add($"Trade companies could not be loaded: {exception.Message}", Severity.Error);
        }
    }

    private async Task<IReadOnlyList<TradeCompanyProfile>> FilterAuthorizedCompaniesAsync(
        IReadOnlyList<TradeCompanyProfile> localCompanies)
    {
        var connection = await LocalState.LoadConnectionSettingsAsync();
        if (!connection.IsConfigured)
        {
            return localCompanies;
        }

        var authorized = new List<TradeCompanyProfile>(localCompanies.Count);
        foreach (var company in localCompanies)
        {
            CompanyHubProjection? hub;
            try
            {
                hub = await CompanyHubClient.LoadAsync(company.Id.ToString("D"));
            }
            catch
            {
                // A temporary host failure cannot prove that local company access was revoked.
                return localCompanies;
            }

            if (hub?.Kind == "hub" &&
                string.Equals(hub.Standing.State, "active", StringComparison.OrdinalIgnoreCase))
            {
                authorized.Add(company);
            }
        }

        return authorized;
    }

    private async Task SelectCompanyAsync(TradeCompanyProfile company)
    {
        if (_activeCompany?.Id == company.Id)
        {
            return;
        }

        try
        {
            await TradeOperationsPersistence.SelectCompanyProfileAsync(company.Id);
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Trade company could not be switched: {exception.Message}", Severity.Error);
        }
    }

    private async Task OpenWorkspaceSettingsAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(SettingsDialog.InitialSection)] = SettingsSection.Workspace
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = false,
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        };
        var dialog = DialogService.Show<SettingsDialog>("Settings", parameters, options);
        await dialog.Result;
        await LoadCompaniesAsync();
    }

    private static string FormatCompanyId(Guid companyId) =>
        companyId.ToString("N")[..6].ToUpperInvariant();

    private static string CompanyHubUrl(TradeCompanyProfile company) =>
        $"/companies/{Slugify(company.Name)}";

    private static string Slugify(string value)
    {
        var slug = new System.Text.StringBuilder(value.Length);
        var hyphenPending = false;
        foreach (var character in value)
        {
            if (char.IsAsciiLetterOrDigit(character))
            {
                if (hyphenPending && slug.Length > 0)
                {
                    slug.Append('-');
                }
                slug.Append(char.ToLowerInvariant(character));
                hyphenPending = false;
            }
            else
            {
                hyphenPending = slug.Length > 0;
            }
        }
        return slug.Length == 0 ? "company" : slug.ToString();
    }

    private static string? SentenceCase(string? value) => string.IsNullOrWhiteSpace(value)
        ? null
        : char.ToUpperInvariant(value[0]) + value[1..];

    public void Dispose()
    {
        _disposed = true;
        ProfileSync.StatusChanged -= OnProfileSyncStatusChanged;
    }

}
