@using FFXIV_Craft_Architect.Web.Services.ProfileHosting
@inject ProfileHostClient ProfileHostClient
@inject DiscordIdentityClient DiscordIdentityClient
@inject ProfileSyncLocalStateService LocalState
@inject ProfileSyncService ProfileSync
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<div class="account-dialog">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="my-4" />
        }
        else
        {
            @if (Section == AccountSettingsSection.Profile)
            {
            <div class="account-heading">
                @if (_settings.IsConfigured && _editingDisplayName)
                {
                    <div class="account-name-editor">
                        <MudTextField @bind-Value="_displayNameDraft"
                                      Label="Account name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      MaxLength="120"
                                      Disabled="_accountBusy"
                                      Class="account-name-field" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="SaveDisplayNameAsync"
                                   Disabled="_accountBusy">
                            Save
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   OnClick="CancelDisplayNameEdit"
                                   Disabled="_accountBusy">
                            Cancel
                        </MudButton>
                    </div>
                }
                else
                {
                    <div class="account-heading-row">
                        <MudText Typo="Typo.h6">@(_settings.IsConfigured ? AccountDisplayName : "Connect account")</MudText>
                        @if (_settings.IsConfigured)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           OnClick="BeginDisplayNameEdit"
                                           Disabled="_accountBusy"
                                           aria-label="Edit account name" />
                        }
                    </div>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @if (_settings.IsConfigured)
                    {
                        <span>Account @ShortProfileId · Signed in with @SignInMethod</span>
                    }
                    else
                    {
                        <span>Sign in with Discord, or connect this browser with an access key or one-time pairing code.</span>
                    }
                </MudText>
            </div>

            @if (_settings.IsConfigured)
            {
                <div class="account-section-label">Discord identity</div>
                <div class="account-row">
                    <div class="account-row-main">
                        <MudText Typo="Typo.subtitle2">
                            @(_discordStatus?.Linked == true
                                ? _discordStatus.DisplayName
                                : _discordStatusLoaded
                                    ? "No Discord sign-in identity"
                                    : "Discord identity unavailable")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(_discordStatus?.Linked == true
                                ? $"Linked {FormatDate(_discordStatus.LinkedAt)} · used for Discord sign-in and commission notifications"
                                : "Discord identities are created through Discord sign-in.")
                        </MudText>
                    </div>
                    @if (_discordStatus?.Enabled == true && _discordStatus.Linked)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">linked</MudChip>
                    }
                </div>
            }
            else if (_discordSignInEnabled)
            {
                <div class="account-section-label">Discord identity</div>
                <div class="account-row">
                    <div class="account-row-main">
                        <MudText Typo="Typo.subtitle2">Use Discord to create or reconnect your account</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">The same identity receives private commission notifications after you join a company.</MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Forum"
                               OnClick="SignInWithDiscordAsync"
                               Disabled="_accountBusy">
                        Sign in with Discord
                    </MudButton>
                </div>
            }

                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    Your Craft Architect account name is presentation only. Discord identifies where private notifications go, while FFXIV character identity is confirmed separately for each commission.
                </MudAlert>
            }

            @if (Section == AccountSettingsSection.AccessAndDevices && _settings.IsConfigured)
            {
                <div class="account-section-label">This browser</div>
                <div class="account-row">
                    <div class="account-row-main">
                        <MudText Typo="Typo.subtitle2">This device</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@CurrentSessionSummary</MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="SignOutAsync" Disabled="_accountBusy">
                        Sign out
                    </MudButton>
                </div>

                <div class="account-section-label">Other ways in</div>
                <div class="account-row account-row-stack">
                    <div class="account-row-summary">
                        <div class="account-row-main">
                            <MudText Typo="Typo.subtitle2">@OtherKeySummary</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Paired access keys remain active until revoked.</MudText>
                        </div>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ToggleKeyManagement" Disabled="_accountBusy">
                            @(_managingKeys ? "Done" : "Manage…")
                        </MudButton>
                    </div>
                    @if (_managingKeys)
                    {
                        <div class="account-key-list">
                            @foreach (var key in OtherKeys)
                            {
                                <div class="account-key-row">
                                    <div>
                                        <MudText Typo="Typo.body2">Browser key @ShortKeyId(key.Id)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Created @FormatDate(key.CreatedAtUtc) · last used @FormatDate(key.LastUsedAtUtc)
                                        </MudText>
                                    </div>
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="() => RevokeKeyAsync(key.Id)" Disabled="_accountBusy">
                                        Revoke
                                    </MudButton>
                                </div>
                            }
                            @if (OtherKeys.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(_keysLoaded ? "No other active browser keys." : "Active browser keys could not be loaded.")
                                </MudText>
                            }
                        </div>
                    }
                </div>
            }

            @if (Section == AccountSettingsSection.AccessAndDevices)
            {
            <MudExpansionPanels Class="account-advanced" Elevation="0">
                <MudExpansionPanel Text="Advanced: access key, pairing, custom host" Expanded="@(!_settings.IsConfigured)">
                    <MudTextField @bind-Value="_accessKey"
                                  Label="Access key"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Password"
                                  Immediate="true"
                                  Disabled="_accountBusy" />
                    <MudTextField @bind-Value="_pairingCode"
                                  Label="One-time pairing code"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Disabled="_accountBusy"
                                  Class="mt-2" />
                    @if (_useCustomHost)
                    {
                        <MudTextField @bind-Value="_hostUrl"
                                      Label="Profile host API URL"
                                      Placeholder="https://craft.example.com/api/"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Disabled="_accountBusy"
                                      Class="mt-2" />
                    }
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConnectWithKeyAsync" Disabled="_accountBusy">
                            Connect with key
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="RedeemPairingCodeAsync" Disabled="_accountBusy">
                            Pair this browser
                        </MudButton>
                        @if (_settings.IsConfigured)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CreatePairingCodeAsync" Disabled="_accountBusy">
                                Connect another browser
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ToggleCustomHost" Disabled="_accountBusy">
                            @(_useCustomHost ? "Use release host" : "Use custom host")
                        </MudButton>
                    </div>

                    @if (_bootstrapPreview != null && _pendingSettings != null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                            Both this browser and hosted profile contain data. Choose which side initializes this connection.
                        </MudAlert>
                        <MudRadioGroup T="FirstConnectMode" @bind-Value="_firstConnectMode" Class="my-2">
                            <MudRadio T="FirstConnectMode" Value="@FirstConnectMode.UploadLocal" Color="Color.Primary">
                                Keep this browser (@_bootstrapPreview.LocalObjectCount.ToString("N0") objects)
                            </MudRadio>
                            <MudRadio T="FirstConnectMode" Value="@FirstConnectMode.DownloadRemote" Color="Color.Primary">
                                Use hosted profile (@_bootstrapPreview.RemoteObjectCount.ToString("N0") objects)
                            </MudRadio>
                        </MudRadioGroup>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CompleteConnectionAsync" Disabled="_accountBusy">Continue</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="CancelPendingConnection" Disabled="_accountBusy">Cancel</MudButton>
                    }

                    @if (!string.IsNullOrWhiteSpace(_generatedPairingCode))
                    {
                        <MudPaper Variant="Variant.Outlined" Class="pa-3 mt-3">
                            <MudText Typo="Typo.subtitle2">One-time pairing code</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Use on another browser before @_pairingExpiresAtUtc?.ToLocalTime().ToString("t").
                            </MudText>
                            <div class="d-flex align-center gap-2 mt-2">
                                <MudTextField Value="@_generatedPairingCode" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyPairingCodeAsync">Copy</MudButton>
                            </div>
                        </MudPaper>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>

            @if (_accountBusy)
            {
                <MudProgressLinear Indeterminate="true" Class="mt-3" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">@_busyMessage</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <MudText Typo="Typo.caption" Color="@_statusColor" Class="mt-2 d-block">@_statusMessage</MudText>
            }
            }
        }
</div>

@code {
    [Parameter] public AccountSettingsSection Section { get; set; } = AccountSettingsSection.Profile;

    private HostedProfileConnectionSettings _settings = new();
    private DiscordIdentityWebStatus? _discordStatus;
    private bool _discordStatusLoaded;
    private bool _discordSignInEnabled;
    private IReadOnlyList<ProfileHostAccessKeyMetadata> _keys = [];
    private bool _keysLoaded;
    private bool _loading = true;
    private bool _accountBusy;
    private bool _managingKeys;
    private bool _editingDisplayName;
    private string _displayNameDraft = string.Empty;
    private long _profileMetadataRevision;
    private string _busyMessage = "Working...";
    private string? _statusMessage;
    private Color _statusColor = Color.Secondary;
    private string _hostUrl = string.Empty;
    private string _accessKey = string.Empty;
    private string _pairingCode = string.Empty;
    private bool _useCustomHost;
    private string? _generatedPairingCode;
    private DateTime? _pairingExpiresAtUtc;
    private ProfileSyncBootstrapPreview? _bootstrapPreview;
    private HostedProfileConnectionSettings? _pendingSettings;
    private FirstConnectMode _firstConnectMode = FirstConnectMode.DownloadRemote;

    private string AccountDisplayName => string.IsNullOrWhiteSpace(_settings.ConnectedProfileName)
        ? "Account"
        : _settings.ConnectedProfileName;
    private string ShortProfileId => ShortId(_settings.ProfileScopeId);
    private string SignInMethod => !_discordStatusLoaded
        ? "an account session"
        : _discordStatus?.Linked == true ? "Discord" : "an access key";
    private IReadOnlyList<ProfileHostAccessKeyMetadata> OtherKeys => _keys.Where(key => !key.IsCurrent).ToArray();
    private string OtherKeySummary => !_keysLoaded
        ? "Browser access unavailable"
        : OtherKeys.Count switch
        {
            0 => "No other browsers have access",
            1 => "1 other browser has access",
            _ => $"{OtherKeys.Count:N0} other browsers have access"
        };
    private string CurrentSessionSummary
    {
        get
        {
            var current = _keys
                .Where(key => key.IsCurrent)
                .OrderBy(key => key.CreatedAtUtc)
                .FirstOrDefault();
            return current == null
                ? "Current session key"
                : $"Session key issued {FormatDate(current.CreatedAtUtc)} · revoke to sign out here";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _settings = await LocalState.LoadConnectionSettingsAsync();
        _profileMetadataRevision = _settings.ConnectedProfileMetadataRevision;
        _hostUrl = string.IsNullOrWhiteSpace(_settings.HostUrl)
            ? ProfileHostClient.DefaultHostUrl
            : _settings.HostUrl;
        _accessKey = _settings.AccessKey ?? string.Empty;
        _useCustomHost = !AddressesMatch(_hostUrl, ProfileHostClient.DefaultHostUrl);
        try
        {
            _discordSignInEnabled = (await DiscordIdentityClient.GetSignInStatusAsync(
                ProfileHostClient.DefaultHostUrl,
                CancellationToken.None)).Enabled;
        }
        catch
        {
            _discordSignInEnabled = false;
        }
        if (_settings.IsConfigured)
        {
            await Task.WhenAll(RefreshProfileAsync(), RefreshDiscordAsync(), RefreshKeysAsync());
        }
        _loading = false;
    }

    private async Task SignInWithDiscordAsync()
    {
        _accountBusy = true;
        _busyMessage = "Opening Discord sign in...";
        try
        {
            var authorizationUri = await DiscordIdentityClient.StartSignInAsync(
                ProfileHostClient.DefaultHostUrl,
                CancellationToken.None);
            NavigationManager.NavigateTo(authorizationUri.AbsoluteUri, forceLoad: true);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Color.Error);
            _accountBusy = false;
        }
    }

    private async Task RefreshProfileAsync()
    {
        try
        {
            var profile = await ProfileHostClient.GetProfileAsync(
                _settings.HostUrl!,
                _settings.AccessKey!,
                CancellationToken.None);
            await ApplyCanonicalProfileAsync(profile);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Color.Warning);
        }
    }

    private void BeginDisplayNameEdit()
    {
        _displayNameDraft = AccountDisplayName;
        _editingDisplayName = true;
        _statusMessage = null;
    }

    private void CancelDisplayNameEdit()
    {
        _displayNameDraft = AccountDisplayName;
        _editingDisplayName = false;
    }

    private async Task SaveDisplayNameAsync()
    {
        if (!ProfileHostDisplayNamePolicy.TryNormalize(_displayNameDraft, out var displayName))
        {
            SetStatus("Account names must contain 1 to 120 visible characters.", Color.Error);
            return;
        }
        if (string.Equals(displayName, _settings.ConnectedProfileName, StringComparison.Ordinal))
        {
            _editingDisplayName = false;
            return;
        }

        _accountBusy = true;
        _busyMessage = "Updating account name...";
        try
        {
            var currentConnection = await LocalState.LoadConnectionSettingsAsync();
            if (!string.Equals(
                    currentConnection.ConnectionScopeId,
                    _settings.ConnectionScopeId,
                    StringComparison.Ordinal))
            {
                _settings = currentConnection;
                _editingDisplayName = false;
                SetStatus("The account connection changed while the name was being updated.", Color.Warning);
                return;
            }

            var profile = await ProfileHostClient.UpdateProfileDisplayNameAsync(
                _settings.HostUrl!,
                _settings.AccessKey!,
                _profileMetadataRevision,
                displayName,
                CancellationToken.None);
            if (!await ApplyCanonicalProfileAsync(profile))
            {
                _editingDisplayName = false;
                SetStatus("The account connection changed while the name was being updated.", Color.Warning);
                return;
            }
            _displayNameDraft = AccountDisplayName;
            _editingDisplayName = false;
            SetStatus("Account name updated.", Color.Success);
        }
        catch (ProfileHostConnectionException ex)
            when (ex.Failure == ProfileHostConnectionFailure.ProfileNameConflict)
        {
            try
            {
                var profile = await ProfileHostClient.GetProfileAsync(
                    _settings.HostUrl!,
                    _settings.AccessKey!,
                    CancellationToken.None);
                if (!await ApplyCanonicalProfileAsync(profile))
                {
                    _editingDisplayName = false;
                    SetStatus("The account connection changed while the name was being updated.", Color.Warning);
                    return;
                }
                _displayNameDraft = AccountDisplayName;
                SetStatus("The name changed in another browser. The current account name has been restored here.", Color.Warning);
            }
            catch (Exception refreshError)
            {
                SetStatus(refreshError.Message, Color.Error);
            }
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Color.Error);
        }
        finally
        {
            _accountBusy = false;
        }
    }

    private async Task<bool> ApplyCanonicalProfileAsync(ProfileHostProfileResponse profile)
    {
        if (!string.Equals(_settings.ConnectedProfileId, profile.ProfileId, StringComparison.Ordinal))
        {
            _settings = await LocalState.LoadConnectionSettingsAsync();
            return false;
        }

        if (string.Equals(_settings.ConnectedProfileName, profile.DisplayName, StringComparison.Ordinal) &&
            _settings.ConnectedProfileMetadataRevision == profile.MetadataRevision)
        {
            _profileMetadataRevision = profile.MetadataRevision;
            return true;
        }

        var saved = await LocalState.TrySaveConnectedProfileNameAsync(
            _settings,
            profile.DisplayName,
            profile.MetadataRevision);
        if (saved == ConnectedProfileNameSaveResult.ConnectionChanged)
        {
            _settings = await LocalState.LoadConnectionSettingsAsync();
            return false;
        }
        if (saved == ConnectedProfileNameSaveResult.Stale)
        {
            _settings = await LocalState.LoadConnectionSettingsAsync();
            _profileMetadataRevision = _settings.ConnectedProfileMetadataRevision;
            return true;
        }

        _settings.ConnectedProfileName = profile.DisplayName;
        _settings.ConnectedProfileMetadataRevision = profile.MetadataRevision;
        _profileMetadataRevision = profile.MetadataRevision;
        return true;
    }

    private async Task RefreshKeysAsync()
    {
        if (!_settings.IsConfigured)
        {
            _keys = [];
            _keysLoaded = false;
            return;
        }

        try
        {
            _keys = await ProfileHostClient.GetAccessKeysAsync(
                _settings.HostUrl!,
                _settings.AccessKey!,
                CancellationToken.None);
            _keysLoaded = true;
        }
        catch (Exception ex)
        {
            _keysLoaded = false;
            SetStatus(ex.Message, Color.Warning);
        }
    }

    private async Task RefreshDiscordAsync()
    {
        if (!_settings.IsConfigured)
        {
            return;
        }

        try
        {
            _discordStatus = await DiscordIdentityClient.GetStatusAsync(
                _settings.HostUrl!,
                _settings.AccessKey!,
                CancellationToken.None);
            _discordStatusLoaded = true;
        }
        catch
        {
            _discordStatus = new DiscordIdentityWebStatus(false, false, null, null);
            _discordStatusLoaded = false;
        }
    }

    private async Task SignOutAsync()
    {
        _accountBusy = true;
        _busyMessage = "Signing out this browser...";
        try
        {
            var revocationConfirmed = await TryRevokeCurrentAccessKeyAsync();
            await ProfileSync.DisconnectAsync();
            await LoadAsync();
            SetStatus(
                revocationConfirmed
                    ? "This browser is signed out."
                    : "This browser is signed out, but server revocation could not be confirmed.",
                revocationConfirmed ? Color.Success : Color.Warning);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Color.Error);
        }
        finally
        {
            _accountBusy = false;
        }
    }

    private async Task<bool> TryRevokeCurrentAccessKeyAsync()
    {
        try
        {
            await ProfileHostClient.RevokeCurrentAccessKeyAsync(
                _settings.HostUrl!,
                _settings.AccessKey!,
                CancellationToken.None);
            return true;
        }
        catch (ProfileHostConnectionException exception)
            when (exception.Failure == ProfileHostConnectionFailure.AccessKeyRejected)
        {
            // The server has already removed this key. Local removal must still complete.
            return true;
        }
        catch
        {
            // Signing out this browser is local. Preserve that escape hatch while reporting that
            // an unexpected server failure left remote revocation unconfirmed.
            return false;
        }
    }

    private async Task RevokeKeyAsync(string keyId)
    {
        _accountBusy = true;
        _busyMessage = "Revoking browser access...";
        try
        {
            await ProfileHostClient.RevokeAccessKeyAsync(
                _settings.HostUrl!,
                _settings.AccessKey!,
                keyId,
                CancellationToken.None);
            await RefreshKeysAsync();
            SetStatus("Browser access revoked.", Color.Success);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Color.Error);
        }
        finally
        {
            _accountBusy = false;
        }
    }

    private async Task ConnectWithKeyAsync()
    {
        if (string.IsNullOrWhiteSpace(_accessKey))
        {
            SetStatus("Enter an access key.", Color.Error);
            return;
        }

        _accountBusy = true;
        _busyMessage = "Authorizing this browser...";
        ClearPendingConnection();
        try
        {
            var settings = new HostedProfileConnectionSettings
            {
                HostUrl = SelectedHostUrl(),
                AccessKey = _accessKey.Trim(),
                RememberAccessKey = true
            };
            var health = await ProfileHostClient.GetHealthAsync(settings.HostUrl, CancellationToken.None);
            if (!health.ProfileHostEnabled)
            {
                throw new ProfileHostConnectionException(
                    ProfileHostConnectionFailure.ProfileHostingDisabled,
                    "Profile hosting is not enabled on that server.");
            }
            if (health.ProtocolVersion != 1)
            {
                throw new ProfileHostConnectionException(
                    ProfileHostConnectionFailure.IncompatibleHost,
                    "This server is not a compatible Craft Architect profile host.");
            }
            var profile = await ProfileHostClient.GetProfileAsync(settings.HostUrl, settings.AccessKey, CancellationToken.None);
            await PrepareConnectionAsync(settings, profile);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Color.Error);
        }
        finally
        {
            _accountBusy = false;
        }
    }

    private async Task RedeemPairingCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_pairingCode))
        {
            SetStatus("Enter a one-time pairing code.", Color.Error);
            return;
        }

        _accountBusy = true;
        _busyMessage = "Pairing this browser...";
        ClearPendingConnection();
        try
        {
            var hostUrl = SelectedHostUrl();
            var health = await ProfileHostClient.GetHealthAsync(hostUrl, CancellationToken.None);
            if (!health.ProfileHostEnabled || health.ProtocolVersion != 1)
            {
                throw new ProfileHostConnectionException(
                    ProfileHostConnectionFailure.IncompatibleHost,
                    "This server is not a compatible Craft Architect profile host.");
            }
            var redeemed = await ProfileHostClient.RedeemPairingCodeAsync(
                hostUrl,
                _pairingCode.Trim(),
                CancellationToken.None);
            _pairingCode = string.Empty;
            _accessKey = redeemed.AccessKey;
            await PrepareConnectionAsync(
                new HostedProfileConnectionSettings
                {
                    HostUrl = hostUrl,
                    AccessKey = redeemed.AccessKey,
                    RememberAccessKey = true,
                    ConnectedProfileId = redeemed.Profile.ProfileId,
                    ConnectedProfileName = redeemed.Profile.DisplayName,
                    ConnectedProfileMetadataRevision = redeemed.Profile.MetadataRevision
                },
                redeemed.Profile);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Color.Error);
        }
        finally
        {
            _accountBusy = false;
        }
    }

    private async Task PrepareConnectionAsync(
        HostedProfileConnectionSettings settings,
        ProfileHostProfileResponse profile)
    {
        settings.ConnectedProfileId = profile.ProfileId;
        settings.ConnectedProfileName = profile.DisplayName;
        settings.ConnectedProfileMetadataRevision = profile.MetadataRevision;
        _busyMessage = "Comparing browser and hosted data...";
        var preview = await ProfileSync.PreviewFirstConnectAsync(settings);
        if (preview.LocalObjectCount > 0 && preview.RemoteObjectCount > 0 && !preview.ContentsMatch)
        {
            _bootstrapPreview = preview;
            _pendingSettings = settings.Snapshot();
            _firstConnectMode = FirstConnectMode.DownloadRemote;
            return;
        }

        await ConnectVerifiedAsync(
            settings,
            preview.RemoteObjectCount == 0 && preview.LocalObjectCount > 0
                ? FirstConnectMode.UploadLocal
                : FirstConnectMode.DownloadRemote);
    }

    private async Task CompleteConnectionAsync()
    {
        if (_pendingSettings == null)
        {
            return;
        }
        _accountBusy = true;
        _busyMessage = "Connecting and reconciling data...";
        try
        {
            await ConnectVerifiedAsync(_pendingSettings, _firstConnectMode);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Color.Error);
        }
        finally
        {
            _accountBusy = false;
        }
    }

    private async Task ConnectVerifiedAsync(HostedProfileConnectionSettings settings, FirstConnectMode mode)
    {
        await ProfileSync.ConnectAsync(settings, mode);
        ClearPendingConnection();
        SetStatus($"Connected to {settings.ConnectedProfileName ?? "hosted profile"}.", Color.Success);
        await LoadAsync();
    }

    private async Task CreatePairingCodeAsync()
    {
        _accountBusy = true;
        _busyMessage = "Creating a one-time pairing code...";
        try
        {
            var pairing = await ProfileHostClient.CreatePairingCodeAsync(
                _settings.HostUrl!,
                _settings.AccessKey!,
                CancellationToken.None);
            _generatedPairingCode = pairing.PairingCode;
            _pairingExpiresAtUtc = pairing.ExpiresAtUtc;
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Color.Error);
        }
        finally
        {
            _accountBusy = false;
        }
    }

    private async Task CopyPairingCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_generatedPairingCode))
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _generatedPairingCode);
            Snackbar.Add("Pairing code copied.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("The pairing code could not be copied.", Severity.Error);
        }
    }

    private void ToggleKeyManagement() => _managingKeys = !_managingKeys;
    private void ToggleCustomHost()
    {
        _useCustomHost = !_useCustomHost;
        if (!_useCustomHost)
        {
            _hostUrl = ProfileHostClient.DefaultHostUrl;
        }
    }
    private void CancelPendingConnection()
    {
        ClearPendingConnection();
        SetStatus("Connection canceled. Browser data was not changed.", Color.Info);
    }
    private void ClearPendingConnection()
    {
        _bootstrapPreview = null;
        _pendingSettings = null;
    }
    private string SelectedHostUrl() => ProfileHostClient.NormalizeHostUrl(
        _useCustomHost ? _hostUrl : ProfileHostClient.DefaultHostUrl);
    private static bool AddressesMatch(string first, string second)
    {
        try
        {
            return string.Equals(
                ProfileHostClient.NormalizeHostUrl(first),
                ProfileHostClient.NormalizeHostUrl(second),
                StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }
    private static string ShortId(string? value) => string.IsNullOrWhiteSpace(value)
        ? "unknown"
        : value.Replace("-", string.Empty, StringComparison.Ordinal) is { Length: > 8 } compact
            ? $"{compact[..4]}…{compact[^4..]}"
            : value;
    private static string ShortKeyId(string value) => value.Length > 8 ? $"{value[..4]}…{value[^4..]}" : value;
    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd") ?? "never";
    private static string FormatDate(DateTime? value) => value?.ToLocalTime().ToString("yyyy-MM-dd") ?? "never";
    private void SetStatus(string message, Color color)
    {
        _statusMessage = message;
        _statusColor = color;
    }
}
