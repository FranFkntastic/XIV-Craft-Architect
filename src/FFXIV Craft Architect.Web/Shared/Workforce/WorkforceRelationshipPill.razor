@using FFXIV_Craft_Architect.Web.Services.TradeCompany

<span class="workforce-pill @ToneClass">@Label</span>

@code {
    [Parameter, EditorRequired] public CompanyWorkforceRow Row { get; set; } = default!;

    private string Label => Row.Relationship switch
    {
        CompanyWorkforceRelationship.Owner => "Owner",
        CompanyWorkforceRelationship.Operator => "Operator",
        CompanyWorkforceRelationship.Crafter => "Member · Crafter",
        CompanyWorkforceRelationship.Requested => "Requested",
        CompanyWorkforceRelationship.Invited => "Invited",
        _ => "Freelancer"
    };

    private string ToneClass => Row.Relationship switch
    {
        CompanyWorkforceRelationship.Owner or CompanyWorkforceRelationship.Operator or CompanyWorkforceRelationship.Crafter => "is-member",
        CompanyWorkforceRelationship.Requested or CompanyWorkforceRelationship.Invited => "is-pending",
        _ => "is-contractor"
    };
}
