@using FFXIV_Craft_Architect.Web.Services.TradeCompany
@inject CompanyHubClient HubClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<MudPaper Class="pa-3 mb-3">
    <div class="d-flex align-center justify-space-between gap-2">
        <div><MudText Typo="Typo.h6">Invite a crafter</MudText><MudText Typo="Typo.body2">Choose when the company invitation expires. No commission is required.</MudText></div>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_issuingInvitation || !_invitationExpiresOn.HasValue)" OnClick="IssueInvitationAsync">Create invitation</MudButton>
    </div>
    @if (AvailableLegacyCrafters.Any())
    {
        <MudSelect T="Guid?" Label="Connect existing crafter history (optional)" Dense="true" Class="mt-2" @bind-Value="_invitationLegacyCrafterId" Clearable="true">
            @foreach (var crafter in AvailableLegacyCrafters)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)crafter.LegacyCrafterId)">@CrafterLabel(crafter)</MudSelectItem>
            }
        </MudSelect>
    }
    <MudDatePicker Label="Invitation expires"
                   Date="@_invitationExpiresOn"
                   DateChanged="SetInvitationExpiry"
                   MinDate="@DateTime.Today"
                   MaxDate="@DateTime.Today.AddDays(365)"
                   HelperText="Expires at the end of the selected day. Seven days is the default."
                   Class="mt-2" />
    @if (_issuedInvitation != null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-2">
            <div class="d-flex align-center justify-space-between gap-2">
                <span>Invitation copied. It expires @_issuedInvitation.ExpiresAtUtc.ToLocalTime().ToString("g")@(_issuedInvitation.LegacyCrafterName == null ? "." : $" and will connect {_issuedInvitation.LegacyCrafterName}.")</span>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="CopyIssuedInvitationAsync">Copy again</MudButton>
            </div>
        </MudAlert>
    }
    @if (_invitations.Any(invitation => invitation.State == "active"))
    {
        <MudTable Items="@_invitations.Where(invitation => invitation.State == "active")" Dense="true" Hover="true" Class="mt-2">
            <HeaderContent><MudTh>Invitation</MudTh><MudTh>Expires</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@(context.LegacyCrafterName ?? "New company member")</MudTd>
                <MudTd>@context.ExpiresAtUtc.ToLocalTime().ToString("g")</MudTd>
                <MudTd><MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => RevokeInvitationAsync(context.InvitationId))">Revoke</MudButton></MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<MudPaper Class="pa-3 mb-3">
    <MudText Typo="Typo.h6">Membership requests</MudText>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudTable Items="Pending" Dense="true" Hover="true">
            <HeaderContent><MudTh>Requester</MudTh><MudTh>Note</MudTh><MudTh>Requested</MudTh><MudTh>Existing history</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd><strong>@context.Member.DisplayName</strong></MudTd><MudTd>@(context.Request.RequestNote ?? "No note")</MudTd><MudTd>@context.Request.RequestedAtUtc.ToLocalTime().ToString("g")</MudTd>
                <MudTd>
                    @if (BindingsFor(context.Member.AccountProfileId).Any())
                    {
                        <MudText Typo="Typo.body2">Connected: @BindingNames(context.Member.AccountProfileId)</MudText>
                    }
                    else if (AvailableLegacyCrafters.Any())
                    {
                        <MudSelect T="Guid?" Label="Legacy crafter" Dense="true" Value="@SelectedLegacyCrafter(context.Member.AccountProfileId)" ValueChanged="@(value => SelectLegacyCrafter(context.Member.AccountProfileId, value))">
                            @foreach (var crafter in AvailableLegacyCrafters)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)crafter.LegacyCrafterId)">@CrafterLabel(crafter)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">No legacy history</MudText>
                    }
                </MudTd>
                <MudTd>
                    @if (SelectedLegacyCrafter(context.Member.AccountProfileId).HasValue)
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => ApproveAndConnectAsync(context.Member.AccountProfileId))">Approve + connect history</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => TransitionAsync(context.Member.AccountProfileId, "approve"))">Approve</MudButton>
                    }
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => TransitionAsync(context.Member.AccountProfileId, "deny"))">Deny</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Typo="Typo.body2">No pending requests.</MudText></NoRecordsContent>
        </MudTable>
    }
</MudPaper>

<MudPaper Class="pa-3 mb-3">
    <MudText Typo="Typo.h6">Company members</MudText>
    <MudTable Items="ActiveMembers" Dense="true" Hover="true">
        <HeaderContent><MudTh>Member</MudTh><MudTh>Role</MudTh><MudTh>Standing</MudTh><MudTh>Routing</MudTh><MudTh>Existing history</MudTh><MudTh></MudTh></HeaderContent>
        <RowTemplate>
            <MudTd><strong>@context.DisplayName</strong></MudTd><MudTd>@context.Role</MudTd><MudTd>@context.State</MudTd><MudTd>@(context.DiscordLinked ? "Linked Discord" : "Discord not linked")</MudTd>
            <MudTd>
                <div class="d-flex align-center gap-1">
                    <MudText Typo="Typo.body2">@(BindingsFor(context.AccountProfileId).Any() ? BindingNames(context.AccountProfileId) : "No connected history")</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ToggleHistoryManager(context.AccountProfileId))">@(_manageHistoryMemberId == context.AccountProfileId ? "Done" : "Manage")</MudButton>
                </div>
                @if (_manageHistoryMemberId == context.AccountProfileId)
                {
                    @foreach (var binding in BindingsFor(context.AccountProfileId))
                    {
                        <div class="d-flex align-center gap-1"><MudText Typo="Typo.body2">@BindingName(binding)</MudText><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => DisconnectAsync(binding.LegacyCrafterId))">Disconnect</MudButton></div>
                    }
                    @if (AvailableLegacyCrafters.Any())
                    {
                        <div class="d-flex align-center gap-1">
                            <MudSelect T="Guid?" Label="Connect legacy crafter" Dense="true" Value="@SelectedLegacyCrafter(context.AccountProfileId)" ValueChanged="@(value => SelectLegacyCrafter(context.AccountProfileId, value))">
                                @foreach (var crafter in AvailableLegacyCrafters)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)crafter.LegacyCrafterId)">@CrafterLabel(crafter)</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Size="Size.Small" Disabled="@(!SelectedLegacyCrafter(context.AccountProfileId).HasValue)" OnClick="@(() => ConnectAsync(context.AccountProfileId))">Connect</MudButton>
                        </div>
                    }
                }
            </MudTd>
            <MudTd>@if (CanRevoke(context)) { <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => _revokeMember = context">Revoke</MudButton> }</MudTd>
        </RowTemplate>
    </MudTable>
    @if (_revokeMember != null)
    {
        <div class="d-flex align-center gap-2 mt-2"><MudTextField @bind-Value="_revokeReason" Label="Reason" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" /><MudButton OnClick="CancelRevoke">Cancel</MudButton><MudButton Color="Color.Error" Disabled="@string.IsNullOrWhiteSpace(_revokeReason)" OnClick="RevokeAsync">Revoke @_revokeMember.DisplayName</MudButton></div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string CompanyId { get; set; } = string.Empty;
    private bool _loading = true;
    private string _viewerRole = string.Empty;
    private IReadOnlyList<CompanyMembership> _requests = [];
    private IReadOnlyList<CompanyMember> _members = [];
    private IReadOnlyList<CompanyMembershipInvitation> _invitations = [];
    private LegacyCrafterMigration _migration = new([], []);
    private readonly Dictionary<Guid, Guid?> _selectedLegacyCrafters = [];
    private Guid? _manageHistoryMemberId;
    private CompanyMember? _revokeMember;
    private string? _revokeReason;
    private Guid? _invitationLegacyCrafterId;
    private DateTime? _invitationExpiresOn = DateTime.Today.AddDays(7);
    private CompanyMembershipInvitation? _issuedInvitation;
    private bool _issuingInvitation;
    private IEnumerable<PendingMember> Pending => _requests.Join(_members, request => request.AccountProfileId, member => member.AccountProfileId, (request, member) => new PendingMember(request, member));
    private IEnumerable<CompanyMember> ActiveMembers => _members.Where(member => member.State == "active");
    private IEnumerable<LegacyCrafterCandidate> AvailableLegacyCrafters => _migration.LegacyCrafters.Where(crafter => _migration.Bindings.All(binding => binding.LegacyCrafterId != crafter.LegacyCrafterId));

    protected override async Task OnParametersSetAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true;
        var hubTask = HubClient.LoadAsync(CompanyId);
        var requestsTask = HubClient.LoadPendingMembershipsAsync(CompanyId);
        var membersTask = HubClient.LoadCompanyMembersAsync(CompanyId);
        var migrationTask = HubClient.LoadLegacyCrafterMigrationAsync(CompanyId);
        var invitationsTask = HubClient.LoadMembershipInvitationsAsync(CompanyId);
        await Task.WhenAll(hubTask, requestsTask, membersTask, migrationTask, invitationsTask);
        var hub = await hubTask;
        _viewerRole = hub?.Standing.Role ?? string.Empty;
        _requests = await requestsTask;
        _members = await membersTask;
        _migration = await migrationTask;
        _invitations = await invitationsTask;
        _loading = false;
    }
    private async Task IssueInvitationAsync()
    {
        _issuingInvitation = true;
        try
        {
            _issuedInvitation = await HubClient.IssueMembershipInvitationAsync(
                CompanyId,
                _invitationLegacyCrafterId,
                InvitationExpiresAtUtc());
            _invitationLegacyCrafterId = null;
            await CopyIssuedInvitationAsync();
            _invitations = await HubClient.LoadMembershipInvitationsAsync(CompanyId);
        }
        catch (CompanyHubRequestException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _issuingInvitation = false;
        }
    }
    private void SetInvitationExpiry(DateTime? value) =>
        _invitationExpiresOn = value?.Date;
    private DateTimeOffset InvitationExpiresAtUtc()
    {
        var selected = _invitationExpiresOn!.Value;
        var endOfLocalDay = DateTime.SpecifyKind(selected.Date.AddDays(1).AddTicks(-1), DateTimeKind.Local);
        return new DateTimeOffset(endOfLocalDay).ToUniversalTime();
    }
    private async Task CopyIssuedInvitationAsync()
    {
        if (string.IsNullOrWhiteSpace(_issuedInvitation?.Token)) return;
        var url = Navigation.ToAbsoluteUri($"companies/{Uri.EscapeDataString(CompanyId)}?invite={Uri.EscapeDataString(_issuedInvitation.Token)}").AbsoluteUri;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
        Snackbar.Add("Company invitation copied.", Severity.Success);
    }
    private async Task RevokeInvitationAsync(Guid invitationId)
    {
        await HubClient.RevokeMembershipInvitationAsync(CompanyId, invitationId);
        _invitations = await HubClient.LoadMembershipInvitationsAsync(CompanyId);
        Snackbar.Add("Invitation revoked.", Severity.Success);
    }
    private bool CanRevoke(CompanyMember member) => member.Role != "owner" || _viewerRole == "owner";
    private async Task TransitionAsync(Guid accountId, string action) { await HubClient.TransitionMembershipAsync(CompanyId, accountId, action); await LoadAsync(); Snackbar.Add($"Membership {action}d.", Severity.Success); }
    private IEnumerable<LegacyCrafterBinding> BindingsFor(Guid accountId) => _migration.Bindings.Where(binding => binding.AccountProfileId == accountId);
    private string BindingNames(Guid accountId) => string.Join(", ", BindingsFor(accountId).Select(BindingName));
    private string BindingName(LegacyCrafterBinding binding) => _migration.LegacyCrafters.FirstOrDefault(crafter => crafter.LegacyCrafterId == binding.LegacyCrafterId)?.DisplayName ?? binding.LegacyCrafterId.ToString("D");
    private static string CrafterLabel(LegacyCrafterCandidate crafter) => string.IsNullOrWhiteSpace(crafter.WorldName) ? crafter.DisplayName : $"{crafter.DisplayName} · {crafter.WorldName}";
    private Guid? SelectedLegacyCrafter(Guid accountId) => _selectedLegacyCrafters.GetValueOrDefault(accountId);
    private void SelectLegacyCrafter(Guid accountId, Guid? legacyCrafterId) => _selectedLegacyCrafters[accountId] = legacyCrafterId;
    private void ToggleHistoryManager(Guid accountId) => _manageHistoryMemberId = _manageHistoryMemberId == accountId ? null : accountId;
    private async Task ApproveAndConnectAsync(Guid accountId) { await ConnectAsync(accountId, reload: false); await HubClient.TransitionMembershipAsync(CompanyId, accountId, "approve"); await LoadAsync(); Snackbar.Add("Membership approved and existing history connected.", Severity.Success); }
    private async Task ConnectAsync(Guid accountId, bool reload = true) { var legacyCrafterId = SelectedLegacyCrafter(accountId); if (!legacyCrafterId.HasValue) return; await HubClient.ConnectLegacyCrafterAsync(CompanyId, legacyCrafterId.Value, accountId); _selectedLegacyCrafters.Remove(accountId); if (reload) { await LoadAsync(); Snackbar.Add("Existing crafter history connected.", Severity.Success); } }
    private async Task DisconnectAsync(Guid legacyCrafterId) { await HubClient.DisconnectLegacyCrafterAsync(CompanyId, legacyCrafterId); await LoadAsync(); Snackbar.Add("Existing crafter history disconnected.", Severity.Success); }
    private void CancelRevoke() { _revokeMember = null; _revokeReason = null; }
    private async Task RevokeAsync() { await HubClient.TransitionMembershipAsync(CompanyId, _revokeMember!.AccountProfileId, "revoke", _revokeReason!.Trim()); CancelRevoke(); await LoadAsync(); Snackbar.Add("Membership revoked.", Severity.Success); }
    private sealed record PendingMember(CompanyMembership Request, CompanyMember Member);
}
