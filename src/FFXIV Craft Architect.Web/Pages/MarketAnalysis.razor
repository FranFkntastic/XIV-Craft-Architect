@page "/market"
@using FFXIV_Craft_Architect.Core.Models
@using FFXIV_Craft_Architect.Web.Services
@using FFXIV_Craft_Architect.Web.Dialogs
@inject WorkerSessionCoordinator WorkerSession
@inject WorkerProjectionStore WorkerProjections
@inject ISettingsService Settings
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject AppState AppState
@inject IDialogService DialogService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-0 ma-page-container">
    <div class="ma-grid-layout">
        <MarketAnalysisControlsPanel
            Lens="@(_market?.Lens ?? MarketAcquisitionLens.MinimumUpfrontCost)"
            EvidenceOverlay="_evidenceOverlay"
            Scope="@(_market?.Scope ?? AppState.DefaultMarketFetchScope)"
            SelectedDataCenter="@(_market?.SelectedDataCenter ?? WorkerProjections.Shell.SelectedDataCenter)"
            SelectedRegion="@(_market?.SelectedRegion ?? WorkerProjections.Shell.SelectedRegion)"
            AnalysisRegions="@GetSelectedAnalysisRegions()"
            HasShoppingPlans="@(_market?.HasAnalysis == true)"
            SecretDebugToolsEnabled="_secretDebugToolsEnabled"
            IsAnalyzing="_isAnalyzing"
            IsRefreshingPrices="_isRefreshingPrices"
            DerivedOperationActive="HasActiveWorkerOperation"
            CanAnalyze="CanAnalyze"
            CanRefreshPrices="CanRefreshPrices"
            OnLensChangedRequested="OnLensChanged"
            OnEvidenceOverlayChangedRequested="SetEvidenceOverlay"
            OnOpenMarketOptionsRequested="OpenMarketOptionsAsync"
            OnRunAnalysisRequested="RunMarketAnalysisAsync"
            OnRefreshPricesRequested="RefreshPricesAsync"
            OnGoToProcurementRequested="GoToProcurement" />

        <MarketAnalysisResultsPanel
            BuyItems="@(_market?.CandidateItems.ToList() ?? new List<MaterialAggregate>())"
            ProjectedItems="@(_market?.Items ?? Array.Empty<WorkerMarketItemProjection>())"
            ShoppingPlans="@(_market?.ShoppingPlans ?? Array.Empty<DetailedShoppingPlan>())"
            MarketItemAnalyses="@(_market?.ItemAnalyses ?? Array.Empty<MarketItemAnalysis>())"
            CurrentLens="@(_market?.Lens ?? MarketAcquisitionLens.MinimumUpfrontCost)"
            CurrentSort="_marketSort"
            EvidenceOverlay="_evidenceOverlay"
            SortColumn="_sortColumn"
            SortDescending="_sortDescending"
            WorldSortColumn="_worldSortColumn"
            WorldSortDescending="_worldSortDescending"
            SelectedItemId="_selectedItemId"
            ExpandedWorldKeys="_expandedWorldKeys"
            ShowWorldsColumn="SearchesEntireRegion"
            IsRefreshingItem="@(_isRefreshingSelectedItem || _isAnalyzing || _isRefreshingPrices || HasActiveWorkerOperation)"
            IsLoadingDetails="_isLoadingMarketDetails"
            IsAnalyzing="_isAnalyzing"
            OnSelectedItemChanged="SelectMarketAnalysisItem"
            OnRefreshItemRequested="RefreshSelectedMarketItemAsync"
            OnWorldExpansionToggled="ToggleMarketAnalysisWorld"
            OnSortChanged="SetMarketAnalysisSort"
            OnWorldSortChanged="SetMarketAnalysisWorldSort"
            OnGoToPlannerRequested="GoToPlanner" />
    </div>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "itemId")]
    public int? RequestedItemId { get; set; }

    private WorkerMarketProjection? _market;
    private bool _isAnalyzing;
    private bool _isRefreshingPrices;
    private bool _isRefreshingSelectedItem;
    private bool _isLoadingMarketDetails;
    private bool _secretDebugToolsEnabled;
    private bool _suppressProjectionRefresh;
    private MarketSortOption _marketSort = MarketSortOption.ByRecommended;
    private MarketAnalysisEvidenceOverlay _evidenceOverlay =
        MarketAnalysisEvidenceOverlay.CompetitivenessOverlay;
    private MarketAnalysisGridSortColumn? _sortColumn;
    private bool _sortDescending;
    private MarketAnalysisWorldGridSortColumn? _worldSortColumn;
    private bool _worldSortDescending;
    private int? _selectedItemId;
    private long _projectionRefreshRevision = -1;
    private readonly HashSet<MarketAnalysisExpandedWorldKey> _expandedWorldKeys = [];

    private bool HasActiveWorkerOperation =>
        WorkerProjections.Operation?.IsActive == true;

    private bool CanAnalyze =>
        !_isAnalyzing &&
        !HasActiveWorkerOperation &&
        WorkerProjections.Shell.HasSession &&
        (_market?.CandidateCount ?? 0) > 0;

    private bool CanRefreshPrices =>
        !_isAnalyzing &&
        !_isRefreshingPrices &&
        !HasActiveWorkerOperation &&
        WorkerProjections.Shell.HasSession &&
        _market?.HasAnalysis == true;

    private bool SearchesEntireRegion =>
        (_market?.Scope ?? AppState.DefaultMarketFetchScope) == MarketFetchScope.EntireRegion;

    protected override async Task OnInitializedAsync()
    {
        WorkerProjections.Changed += ProjectionChanged;
        AppState.OnStateChanged += AppStateChanged;
        if (WorkerProjections.Market is { } retained &&
            retained.Revision == WorkerProjections.Shell.Revision)
        {
            _market = retained;
            ApplyRequestedItem();
            _selectedItemId ??= _market.Items.FirstOrDefault()?.ItemId;
        }

        _secretDebugToolsEnabled = await Settings.GetAsync("debug.secret_tools_enabled", false);
        var overlay = await Settings.GetAsync(
            "market.analysis_evidence_overlay",
            nameof(MarketAnalysisEvidenceOverlay.CompetitivenessOverlay));
        if (Enum.TryParse(overlay, ignoreCase: true, out MarketAnalysisEvidenceOverlay parsedOverlay))
        {
            _evidenceOverlay = parsedOverlay;
        }

        _market ??= await WorkerSession.GetMarketProjectionAsync();
        ApplyRequestedItem();
        _selectedItemId ??= _market?.Items.FirstOrDefault()?.ItemId;
        _market = await LoadSelectedMarketDetailsAsync(_market, _selectedItemId);
    }

    private void AppStateChanged(AppStateChange change)
    {
        if (change.HasScope(AppStateChangeScope.Settings))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    protected override void OnParametersSet()
    {
        ApplyRequestedItem();
    }

    private void ProjectionChanged()
    {
        if (_suppressProjectionRefresh)
        {
            return;
        }

        var revision = WorkerProjections.Shell.Revision;
        var projected = WorkerProjections.Market;
        if (projected is null)
        {
            return;
        }

        var selectedItemId = ResolveSelectedItemId(projected, _selectedItemId);
        if (projected.HasAnalysis &&
            selectedItemId.HasValue &&
            !HasSelectedMarketDetails(projected, selectedItemId.Value))
        {
            if (_market?.Revision == revision &&
                HasSelectedMarketDetails(_market, selectedItemId.Value))
            {
                return;
            }

            if (_projectionRefreshRevision != revision)
            {
                _projectionRefreshRevision = revision;
                _ = InvokeAsync(() => RefreshProjectionAsync(revision, projected, selectedItemId));
            }
            return;
        }

        _market = projected;
        _selectedItemId = selectedItemId;
        ApplyRequestedItem();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshProjectionAsync(
        long revision,
        WorkerMarketProjection projected,
        int? selectedItemId)
    {
        try
        {
            var detailed = await LoadSelectedMarketDetailsAsync(projected, selectedItemId);
            if (revision != WorkerProjections.Shell.Revision)
            {
                return;
            }

            _market = detailed;
            _selectedItemId = selectedItemId;
            ApplyRequestedItem();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Market detail could not be updated: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (_projectionRefreshRevision == revision)
            {
                _projectionRefreshRevision = -1;
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyRequestedItem()
    {
        if (RequestedItemId.HasValue &&
            (_market?.ShoppingPlans.Any(plan => plan.ItemId == RequestedItemId.Value) == true ||
             _market?.Items.Any(item => item.ItemId == RequestedItemId.Value) == true))
        {
            _selectedItemId = RequestedItemId;
        }
    }

    private async Task SelectMarketAnalysisItem(int? itemId)
    {
        if (!itemId.HasValue)
        {
            _selectedItemId = null;
            return;
        }

        _suppressProjectionRefresh = true;
        try
        {
            var projected = WorkerProjections.Market ?? _market;
            _market = await LoadSelectedMarketDetailsAsync(projected, itemId);
            _selectedItemId = itemId.Value;
        }
        finally
        {
            _suppressProjectionRefresh = false;
        }
    }

    private async Task<WorkerMarketProjection?> LoadSelectedMarketDetailsAsync(
        WorkerMarketProjection? market,
        int? selectedItemId)
    {
        if (market is null ||
            !selectedItemId.HasValue ||
            !market.HasAnalysis ||
            HasSelectedMarketDetails(market, selectedItemId.Value))
        {
            return market;
        }

        _isLoadingMarketDetails = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            return await WorkerSession.GetMarketProjectionAsync(
                includeDetails: true,
                worldDetailItemId: selectedItemId.Value);
        }
        finally
        {
            _isLoadingMarketDetails = false;
        }
    }

    private static bool HasSelectedMarketDetails(
        WorkerMarketProjection market,
        int itemId) =>
        market.ShoppingPlans.Any(plan => plan.ItemId == itemId) &&
        market.ItemAnalyses.Any(analysis =>
            analysis.ItemId == itemId &&
            WorkerSessionCoordinator.HasCompleteMarketDetail(analysis));

    private static int? ResolveSelectedItemId(
        WorkerMarketProjection market,
        int? selectedItemId) =>
        selectedItemId.HasValue &&
        market.Items.Any(item => item.ItemId == selectedItemId.Value)
            ? selectedItemId
            : market.Items.FirstOrDefault()?.ItemId;

    private Task ToggleMarketAnalysisWorld(MarketAnalysisExpandedWorldKey key)
    {
        if (!_expandedWorldKeys.Add(key))
        {
            _expandedWorldKeys.Remove(key);
        }
        return Task.CompletedTask;
    }

    private Task SetMarketAnalysisSort(MarketAnalysisGridSortState sort)
    {
        _sortColumn = sort.Column;
        _sortDescending = sort.Descending;
        return Task.CompletedTask;
    }

    private Task SetMarketAnalysisWorldSort(MarketAnalysisWorldGridSortState sort)
    {
        _worldSortColumn = sort.Column;
        _worldSortDescending = sort.Descending;
        return Task.CompletedTask;
    }

    private async Task SetEvidenceOverlay(MarketAnalysisEvidenceOverlay overlay)
    {
        _evidenceOverlay = overlay;
        await Settings.SetAsync("market.analysis_evidence_overlay", overlay.ToString());
    }

    private async Task OpenMarketOptionsAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(SettingsDialog.InitialSection)] = SettingsSection.MarketAndRoutes
        };
        var dialog = DialogService.Show<SettingsDialog>(
            "Settings",
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = false,
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true
            });
        await dialog.Result;
    }

    private async Task OnLensChanged(MarketAcquisitionLens lens)
    {
        if (HasActiveWorkerOperation || _market?.HasAnalysis != true)
        {
            return;
        }

        try
        {
            _suppressProjectionRefresh = true;
            var projected = await WorkerSession.ApplyMarketLensAsync(lens);
            var selectedItemId = ResolveSelectedItemId(projected, _selectedItemId);
            _market = await LoadSelectedMarketDetailsAsync(projected, selectedItemId);
            _selectedItemId = selectedItemId;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Buying strategy could not be applied: {ex.Message}", Severity.Error);
        }
        finally
        {
            _suppressProjectionRefresh = false;
        }
    }

    private async Task RunMarketAnalysisAsync() =>
        await RunMarketAnalysisAsync(
            forceRefreshData: false,
            showCompletionSnackbar: true);

    private async Task RefreshPricesAsync()
    {
        _isRefreshingPrices = true;
        try
        {
            await RunMarketAnalysisAsync(
                forceRefreshData: true,
                showCompletionSnackbar: true);
        }
        finally
        {
            _isRefreshingPrices = false;
        }
    }

    private async Task RefreshSelectedMarketItemAsync(DetailedShoppingPlan plan)
    {
        await RefreshSelectedMarketItemAsync(plan.ItemId, plan.Name);
    }

    private async Task RefreshSelectedMarketItemAsync(int itemId, string itemName)
    {
        _selectedItemId = itemId;
        _isRefreshingSelectedItem = true;
        _suppressProjectionRefresh = true;
        try
        {
            var outcome = await WorkerSession.RefreshMarketItemAsync(
                new WorkerMarketItemRefreshRequest(
                    itemId,
                    itemName,
                    _market?.Scope ?? AppState.DefaultMarketFetchScope,
                    _market?.SelectedDataCenter ?? WorkerProjections.Shell.SelectedDataCenter,
                    _market?.SelectedRegion ?? WorkerProjections.Shell.SelectedRegion,
                    _market?.Lens ?? MarketAcquisitionLens.MinimumUpfrontCost,
                    RequestedDataCenters: _market?.RequestedDataCenters));
            _market = await LoadSelectedMarketDetailsAsync(outcome.Market, itemId);
            Snackbar.Add($"Refreshed {itemName}", Severity.Success);
        }
        finally
        {
            _isRefreshingSelectedItem = false;
            _suppressProjectionRefresh = false;
        }
    }

    private async Task<bool> RunMarketAnalysisAsync(
        bool forceRefreshData,
        bool showCompletionSnackbar,
        MarketFetchScope? requestedScope = null)
    {
        if (!CanAnalyze || _market is null)
        {
            return false;
        }

        _isAnalyzing = true;
        _suppressProjectionRefresh = true;
        var operation = AppState.BeginOperation(
            "Market analysis",
            forceRefreshData
                ? "Fetching current market listings..."
                : "Checking saved market prices...");
        try
        {
            var scope = requestedScope ?? _market.Scope;
            var outcome = await WorkerSession.RunMarketAnalysisAsync(
                new WorkerMarketAnalysisRequest(
                    forceRefreshData,
                    scope,
                    _market.SelectedDataCenter,
                    _market.SelectedRegion,
                    _market.Lens,
                    SelectedRegions: GetRequestedAnalysisRegions(scope)),
                reportStatus: (message, progress) =>
                    AppState.SetStatusForOperation(
                        operation,
                        message,
                        progress: progress));
            var selectedItemId = ResolveSelectedItemId(outcome.Market, _selectedItemId);
            _market = await LoadSelectedMarketDetailsAsync(outcome.Market, selectedItemId);
            _selectedItemId = selectedItemId;
            if (showCompletionSnackbar)
            {
                Snackbar.Add(
                    $"Analyzed {outcome.AnalyzedCount:N0} items with {outcome.FetchedCount:N0} market fetches.",
                    Severity.Success);
            }
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Market analysis failed: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _isAnalyzing = false;
            _suppressProjectionRefresh = false;
            AppState.EndOperation(operation);
        }
    }

    private IReadOnlyList<string> GetSelectedAnalysisRegions() =>
        _market?.RequestedDataCenters is { Count: > 0 } dataCenters
            ? MarketFetchScopeResolver.ResolveRegionsForDataCenters(
                dataCenters,
                _market.SelectedRegion)
            : AppState.AnalysisRegions;

    private IReadOnlyList<string> GetRequestedAnalysisRegions(MarketFetchScope scope) =>
        scope == MarketFetchScope.EntireRegion
            ? string.Equals(
                _market?.SelectedRegion,
                AppState.SelectedRegion,
                StringComparison.OrdinalIgnoreCase)
                ? AppState.AnalysisRegions
                : [_market?.SelectedRegion ?? AppState.SelectedRegion]
            : [_market?.SelectedRegion ?? AppState.SelectedRegion];

    private void GoToPlanner() => NavigationManager.NavigateTo("");
    private void GoToProcurement() => NavigationManager.NavigateTo("acquisition");

    public void Dispose()
    {
        WorkerProjections.Changed -= ProjectionChanged;
        AppState.OnStateChanged -= AppStateChanged;
    }
}
