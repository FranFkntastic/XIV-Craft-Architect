@page "/account/workspaces"
@using FFXIV_Craft_Architect.Web.Services.TradeCompany
@inject CompanyHubClient HubClient

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudText Typo="Typo.h5">My companies</MudText>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudGrid Spacing="2" Class="mt-1">
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-3">
                    @foreach (var company in _companies)
                    {
                        <div class="d-flex align-center py-2 gap-2">
                            <div class="flex-grow-1"><MudLink Href="@($"/companies/{company.Hub.Slug}")"><strong>@company.Hub.DisplayName</strong></MudLink><div>@company.Membership.Role · @company.Membership.State</div></div>
                            <MudSwitch T="bool" Value="@(!company.OptedOut)" ValueChanged="value => SetNotificationsAsync(company, !value)" Label="Status DMs" Color="Color.Primary" />
                        </div>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-3"><MudText Typo="Typo.h6">Active assignments</MudText>
                    @foreach (var company in _companies)
                    {
                        @foreach (var assignment in company.Hub.Assignments ?? [])
                        {
                            <div class="py-2"><strong>@assignment.Title</strong><div>@company.Hub.DisplayName · @assignment.State · @string.Join(", ", assignment.Outputs.Select(output => $"{output.Name} ×{output.Quantity}"))</div></div>
                        }
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<MemberCompany> _companies = [];

    protected override async Task OnInitializedAsync()
    {
        foreach (var membership in await HubClient.LoadMembershipsAsync())
        {
            var hub = await HubClient.LoadAsync(membership.CompanyId);
            if (hub != null)
            {
                _companies.Add(new MemberCompany(membership, hub, await HubClient.LoadNotificationOptOutAsync(membership.CompanyId)));
            }
        }
        _loading = false;
    }

    private async Task SetNotificationsAsync(MemberCompany company, bool optedOut)
    {
        await HubClient.SetNotificationOptOutAsync(company.Membership.CompanyId, optedOut);
        company.OptedOut = optedOut;
    }

    private sealed class MemberCompany(CompanyMembership membership, CompanyHubProjection hub, bool optedOut)
    {
        public CompanyMembership Membership { get; } = membership;
        public CompanyHubProjection Hub { get; } = hub;
        public bool OptedOut { get; set; } = optedOut;
    }
}
