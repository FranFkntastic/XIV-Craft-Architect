@page "/trade/orders"
@implements IAsyncDisposable
@using System.Text
@using FFXIV_Craft_Architect.Core.Helpers
@using FFXIV_Craft_Architect.Web.Services.TradeCompany
@inject AppState AppState
@inject WorkerSessionCoordinator WorkerSession
@inject WorkerProjectionStore WorkerProjections
@inject PlanLifecycleWorkflowService PlanLifecycle
@inject GarlandService GarlandService
@inject TradeOrderDraftFactory TradeOrderDraftFactory
@inject TradeOrderPricingWorkflowService TradeOrderPricingWorkflow
@inject TradeOperationsPersistenceService TradeOperationsPersistence
@inject TradePayrollPersistenceService TradePayrollPersistence
@inject FFXIV_Craft_Architect.Web.Services.ProfileHosting.ProfileSyncService ProfileSync
@inject FFXIV_Craft_Architect.Web.Services.ProfileHosting.HostedOrderProjectionStore HostedOrders
@inject FFXIV_Craft_Architect.Web.Services.ProfileHosting.HostedOrderSyncCoordinator HostedOrderSync
@inject FFXIV_Craft_Architect.Web.Services.ProfileHosting.TradeOrderArchiveSummaryStore ArchiveSummaries
@inject FFXIV_Craft_Architect.Web.Services.ProfileHosting.ProfileSyncLocalStateService ProfileSyncLocalState
@inject FFXIV_Craft_Architect.Web.Services.ProfileHosting.ProfileHostClient ProfileHostClient
@inject FFXIV_Craft_Architect.Web.Services.ProfileHosting.DiscordIdentityClient DiscordIdentityClient
@inject FFXIV_Craft_Architect.Web.Services.ProfileHosting.TradeOrderProfileSyncAdapter TradeOrderSyncAdapter
@inject WebSettingsService WebSettings
@inject FFXIV_Craft_Architect.Web.Services.TradeCompany.TradeCompanyCollaborationService TradeCollaboration
@inject FFXIV_Craft_Architect.Web.Services.TradeCompany.TradeCommissionOperationsService CommissionOperations
@inject FFXIV_Craft_Architect.Web.Services.TradeCompany.TradeOrderLifecycleService OrderLifecycle
@inject CommissionBriefClient CommissionBriefs
@inject CommissionBriefLocalStateService CommissionBriefLocalState
@inject WebPlanPersistenceService PlanPersistence
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="trade-orders-page">
    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error" Class="ma-4">
            <MudText Typo="Typo.subtitle2">Trade operations storage is unavailable.</MudText>
            <MudText Typo="Typo.body2">@_loadError</MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Class="mt-2"
                       OnClick="LoadAsync">
                Retry
            </MudButton>
        </MudAlert>
    }
    else
    {
        <TradeOrderRestoreBanner State="OrderRestoreState"
                                 HasHostedOrderIdentities="@_orders.Any(order => order.CompanyCommission != null)" />
        <div class="@TradeOrdersBoardClass"
             @ref="_boardElement"
             style="@TradeOrdersBoardStyle">
                <aside class="trade-orders-rail">
                    <div class="trade-orders-rail-header">
                        <MudText Typo="Typo.subtitle1">Orders</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="StartNewOrderWorkspace"
                                       aria-label="New order" />
                    </div>
                    <MudTextField @bind-Value="_orderSearchText"
                                  id="order-search"
                                  Placeholder="Search orders"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                    <div class="trade-orders-rail-scroll">
                        @if (ActiveOrderGroups.Count == 0 && ArchivedOrders.Count == 0 && DeviceOnlyOrders.Count == 0 &&
                             OrderRestoreState.CanShowAuthoritativeEmpty)
                        {
                            <div class="trade-orders-rail-empty">No orders yet.</div>
                        }
                        else if (FilteredActiveOrderGroups.Count == 0 && FilteredArchivedOrders.Count == 0 && FilteredDeviceOnlyOrders.Count == 0)
                        {
                            <div class="trade-orders-rail-empty">No matching orders.</div>
                        }
                        @foreach (var group in FilteredActiveOrderGroups)
                        {
                            <section class="trade-orders-rail-group">
                                <button type="button"
                                        class="trade-orders-rail-group-title"
                                        @onclick="@(() => ToggleAttentionGroup(group.Key))"
                                        aria-expanded="@(!IsAttentionGroupCollapsed(group.Key))">
                                    <span>
                                        <MudIcon Icon="@(IsAttentionGroupCollapsed(group.Key) ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                                        @group.Label
                                    </span>
                                    <span class="trade-orders-count-chip">@group.Orders.Count.ToString("N0")</span>
                                </button>
                                @if (!IsAttentionGroupCollapsed(group.Key))
                                {
                                    <div class="trade-orders-rail-list">
                                        @foreach (var order in group.Orders)
                                        {
                                             <button type="button"
                                                     class="@GetRailOrderClass(order)"
                                                     aria-current="@(_selectedOrder?.Id == order.Id ? "true" : null)"
                                                     @onclick="() => SelectOrder(order)">
                                                <span class="trade-orders-rail-title">@order.Title</span>
                                                <span class="trade-orders-rail-meta">@FormatOrderRailMeta(order)</span>
                                                <span class="trade-orders-status-chip">@FormatRailStatusChip(order)</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </section>
                        }
                        @if (FilteredArchivedOrders.Count > 0)
                        {
                            <section class="trade-orders-rail-group">
                                <button type="button"
                                        class="trade-orders-rail-group-title"
                                        @onclick="ToggleArchiveGroup"
                                        aria-expanded="@(!_isArchiveCollapsed)">
                                    <span>
                                        <MudIcon Icon="@(_isArchiveCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                                        Archive
                                    </span>
                                    <span class="trade-orders-count-chip">@FilteredArchivedOrders.Count.ToString("N0")</span>
                                </button>
                                @if (!_isArchiveCollapsed)
                                {
                                    <div class="trade-orders-rail-list">
                                        @foreach (var order in FilteredArchivedOrders)
                                        {
                                              <button type="button"
                                                      class="@GetRailOrderClass(order)"
                                                      aria-current="@(_selectedOrder?.Id == order.OrderId ? "true" : null)"
                                                      disabled="@IsFetchingArchiveOrder(order.OrderId)"
                                                      @onclick="() => OpenArchiveOrderAsync(order)">
                                                 <span class="trade-orders-rail-title">@order.Title</span>
                                                 <span class="trade-orders-rail-meta">@FormatArchiveOrderDate(order)</span>
                                                 <span class="trade-orders-rail-meta">@FormatArchiveOrderOutputs(order)</span>
                                                 <span class="trade-orders-status-chip">@(IsFetchingArchiveOrder(order.OrderId) ? "Loading..." : FormatRailStatusChip(order.Status))</span>
                                             </button>
                                        }
                                    </div>
                                }
                            </section>
                        }
                        @if (FilteredDeviceOnlyOrders.Count > 0)
                        {
                            <section class="trade-orders-rail-group is-device-only">
                                <button type="button"
                                        class="trade-orders-rail-group-title"
                                        @onclick="ToggleDeviceOnlyGroup"
                                        aria-expanded="@(!_isDeviceOnlyCollapsed)">
                                    <span>
                                        <MudIcon Icon="@(_isDeviceOnlyCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                                        On this device
                                    </span>
                                    <span class="trade-orders-count-chip">@FilteredDeviceOnlyOrders.Count.ToString("N0")</span>
                                </button>
                                @if (!_isDeviceOnlyCollapsed)
                                {
                                    <div class="trade-orders-device-only-note">Not part of the hosted order workspace.</div>
                                    <div class="trade-orders-rail-list">
                                        @foreach (var order in FilteredDeviceOnlyOrders)
                                        {
                                            @if (order.CompanyCommission == null)
                                            {
                                                <button type="button"
                                                        class="@GetRailOrderClass(order) is-device-only"
                                                        aria-current="@(_selectedOrder?.Id == order.Id ? "true" : null)"
                                                        title="Saved on this device; select to retry sync or discard the draft"
                                                        @onclick="() => SelectOrder(order)">
                                                    <span class="trade-orders-rail-title">@order.Title</span>
                                                    <span class="trade-orders-rail-meta">@FormatOrderRailMeta(order)</span>
                                                    <span class="trade-orders-status-chip">Saved here</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="trade-orders-rail-order is-device-only"
                                                     title="Stale commissioned identity; hosted terms remain hidden">
                                                    <span class="trade-orders-rail-title">@order.Title</span>
                                                    <span class="trade-orders-rail-meta">@FormatOrderRailMeta(order)</span>
                                                    <span class="trade-orders-status-chip">Cleanup only</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </section>
                        }
                    </div>
                </aside>

                <main class="trade-orders-workspace">
                    @if (_pendingImport != null)
                    {
                        <section class="trade-orders-workspace-card is-import">
                            <div class="trade-orders-workspace-header">
                                <div>
                                    <MudText Typo="Typo.overline">Active Craft Plan</MudText>
                                    <MudText Typo="Typo.h6">Create Order</MudText>
                                </div>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="CreatePendingOrderAsync"
                                           Disabled="@string.IsNullOrWhiteSpace(_newOrderTitle)">
                                    Save Order
                                </MudButton>
                            </div>
                            <div class="trade-orders-editor-grid">
                                <MudTextField @bind-Value="_newOrderTitle"
                                              id="imported-order-title"
                                              Label="Order title"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                                <CompactSelectField Id="imported-order-crafter"
                                                    Label="Assigned crafter"
                                                    @bind-Value="NewOrderCrafterValue"
                                                    Options="GetCrafterOptions()" />
                            </div>
                            <section class="trade-orders-work-section">
                                <MudText Typo="Typo.subtitle2">Requested Outputs</MudText>
                                <div class="trade-orders-breakdown-table">
                                    <div class="trade-orders-breakdown-header">
                                        <span>Item</span>
                                        <span>Qty</span>
                                        <span>HQ</span>
                                    </div>
                                    @foreach (var item in GetOrderRootItems(_pendingImport))
                                    {
                                        <div class="trade-orders-breakdown-row">
                                            <span>@item.Name</span>
                                            <span>@TradeDisplayFormatter.FormatQuantity(item.Quantity)</span>
                                            <span>@FormatHq(item.MustBeHq)</span>
                                        </div>
                                    }
                                </div>
                            </section>
                        </section>
                    }
                    else if (_showNewOrderPanel)
                    {
                        <section class="trade-orders-workspace-card is-new">
                            <div class="trade-orders-workspace-header">
                                <div>
                                    <MudText Typo="Typo.overline">New Order</MudText>
                                    <MudText Typo="Typo.h6">Requested Outputs</MudText>
                                </div>
                                <div class="trade-orders-workspace-actions">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.Close"
                                               OnClick="CloseNewOrderWorkspace">
                                        Cancel
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.Clear"
                                               OnClick="ResetNewOrderDraft">
                                        Clear
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.Assignment"
                                               OnClick="PrepareOrderImport">
                                        Create From Active Plan
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               OnClick="CreateRequestedOrderAsync"
                                               Disabled="@(!CanCreateRequestedOrder || _isCreatingRequestedOrder)">
                                        @(_isCreatingRequestedOrder ? "Creating..." : "Save Order")
                                    </MudButton>
                                </div>
                            </div>
                            <div class="trade-orders-editor-grid">
                                <MudTextField T="string"
                                              id="new-order-title"
                                              Value="@_newRequestedOrderTitle"
                                              ValueChanged="value => OnRequestedOrderTitleChanged(value)"
                                              Label="Order title"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                                <CompactSelectField Id="new-order-crafter"
                                                    Label="Assigned crafter"
                                                    @bind-Value="NewRequestedOrderCrafterValue"
                                                    Options="GetCrafterOptions()" />
                                <MudTextField @bind-Value="_newRequestedOrderNotes"
                                              id="new-order-notes"
                                              Label="Notes"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Lines="1" />
                            </div>
                            <section class="trade-orders-work-section">
                                <div class="trade-orders-search-row">
                                    <MudTextField @bind-Value="_requestedOrderSearchQuery"
                                                  id="new-order-output-search"
                                                  Label="Add output item"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true"
                                                  OnKeyUp="OnRequestedOrderSearchKeyUp" />
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               OnClick="SearchRequestedOrderItemsAsync"
                                               Disabled="@(_isSearchingRequestedOrderItems || string.IsNullOrWhiteSpace(_requestedOrderSearchQuery))">
                                        @(_isSearchingRequestedOrderItems ? "Searching..." : "Search")
                                    </MudButton>
                                </div>
                                @if (_requestedOrderSearchResults.Count > 0)
                                {
                                    <div class="trade-orders-search-results">
                                        @foreach (var result in _requestedOrderSearchResults)
                                        {
                                            <button type="button"
                                                    class="trade-orders-search-result"
                                                    @onclick="() => AddRequestedOrderOutput(result)">
                                                <span>@result.Object.Name</span>
                                                <span>ID @result.Id</span>
                                            </button>
                                        }
                                    </div>
                                }
                                <div class="trade-orders-output-table">
                                    <div class="trade-orders-output-header">
                                        <span>Item</span>
                                        <span>Qty</span>
                                        <span>HQ</span>
                                        <span></span>
                                    </div>
                                    @if (_requestedOrderOutputs.Count == 0)
                                    {
                                        <div class="trade-orders-output-empty">Add at least one requested output.</div>
                                    }
                                    else
                                    {
                                        @foreach (var output in _requestedOrderOutputs)
                                        {
                                            <div class="trade-orders-output-row">
                                                <span>@output.Name</span>
                                                <MudNumericField T="int"
                                                                 id="@($"new-order-output-quantity-{output.ItemId}")"
                                                                 Value="@output.Quantity"
                                                                 ValueChanged="quantity => UpdateRequestedOrderOutputQuantity(output, quantity)"
                                                                 Immediate="true"
                                                                 Min="1"
                                                                 Max="9999"
                                                                 HideSpinButtons="true"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense" />
                                                <MudCheckBox T="bool"
                                                             Value="@output.MustBeHq"
                                                             ValueChanged="mustBeHq => UpdateRequestedOrderOutputHq(output, mustBeHq)"
                                                             Color="Color.Primary" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="() => RemoveRequestedOrderOutput(output)" />
                                            </div>
                                        }
                                    }
                                </div>
                            </section>
                        </section>
                    }
                    else if (_selectedOrder != null)
                    {
                        @if (IsIdentityOnlyOrder(_selectedOrder))
                        {
                            <section class="trade-orders-workspace-card">
                                <div class="trade-orders-workspace-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.Policy"
                                             Size="Size.Large"
                                             Class="trade-orders-workspace-empty-icon" />
                                    <MudText Typo="Typo.overline">@_selectedOrder.Title</MudText>
                                    <MudText Typo="Typo.h6">Verifying current order details</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        This saved identity is retained, but its terms and progress stay hidden until the hosted profile verifies them.
                                    </MudText>
                                </div>
                            </section>
                        }
                        else if (BuildSelectedOrderCenterOverview() is { } centerOverview)
                        {
                            <section class="trade-orders-workspace-card">
                                <TradeOrderCenterOverview Model="centerOverview"
                                                          OnOpenPlan="OpenPlanWorkbenchAsync"
                                                          OnEditTerms="OpenSelectedOrderTermsAsync">
                                    <HeaderActions>
                                        @if (HasSelectedLifecycleAction)
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Error"
                                                       OnClick="InvokeSelectedOrderLifecycleActionAsync"
                                                       Disabled="@(_isCommissionCommandRunning || _isDeletingSelectedOrder || _isDiscardingSelectedDraft || HasSelectedLocalHostedCollision)">
                                                @SelectedLifecycleActionLabel
                                            </MudButton>
                                        }
                                    </HeaderActions>
                                    <RequirementsContent>
                                        @{
                                            var paymentSummary = GetSelectedOrderPaymentSummary();
                                            var displayedPaymentTotal = SelectedCanonicalCommission?.CurrentTerms.Payment.Total ??
                                                paymentSummary.TotalPayment;
                                            var displayedProcurementTotal = SelectedCanonicalCommission?.CurrentTerms.Materials
                                                .Sum(material => material.TotalCost) ??
                                                paymentSummary.EstimatedProcurementTotal;
                                        }
                               @if (SelectedCommissionOwner is { } operationsOwner &&
                                    operationsOwner.Order.CompanyCommission is { } operationsCommission)
                               {
                                  var operationsProvisional = operationsCommission.ProvisionalCrafter;
                                  var operationsPaymentRequest = SelectedPaymentPolicyRequest;
                                     @if (operationsCommission.PublicMetadata.IsTestFixture)
                                     {
                                         <MudAlert Severity="Severity.Warning" Dense="true" Class="trade-orders-test-commission-banner">
                                             <MudText Typo="Typo.subtitle2">Test commission - claiming disabled</MudText>
                                             <MudText Typo="Typo.body2">Use this record to verify publication, projection updates, and timeline density. It cannot assign work.</MudText>
                                         </MudAlert>
                                     }
                                     <section class="trade-orders-start-gates" aria-labelledby="before-crafting-title">
                                         <div class="trade-orders-start-gates-heading">
                                             <div>
                                                 <MudText Typo="Typo.subtitle1" HtmlTag="h2" id="before-crafting-title">Before crafting</MudText>
                                                 <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                     Payment and material handoff may clear in either order. Crafting can begin once every requirement is complete.
                                                 </MudText>
                                             </div>
                                             <span class="@GetCommissionGateChipClass(operationsCommission.Gates.Identity.State)">
                                                 Identity @FormatCommissionGate(operationsCommission.Gates.Identity.State)
                                             </span>
                                         </div>
                                         <div class="trade-orders-parallel-gates">
                                             <section class="trade-orders-start-gate" aria-labelledby="payment-gate-title">
                                                 <div class="trade-orders-start-gate-heading">
                                                     <div>
                                                         <span>Payment</span>
                                                         <MudText Typo="Typo.subtitle2" HtmlTag="h3" id="payment-gate-title">
                                                             @FormatCommissionPaymentSchedule(operationsCommission.CurrentTerms.Payment) payment
                                                         </MudText>
                                                     </div>
                                                     <strong>@FormatGil(operationsCommission.CurrentTerms.Payment.Total)</strong>
                                                 </div>
                                                 <div class="trade-orders-start-gate-status">
                                                     <span>Status</span>
                                                     <strong>@FormatPaymentConfirmationProgress(operationsCommission.Gates.Payment)</strong>
                                                 </div>
                                                 @if (operationsCommission.Gates.Payment.State != CompanyCommissionClearanceState.NotRequired)
                                                 {
                                                     @if (operationsCommission.Gates.Payment.CommissionerSent == null &&
                                                          !TradeOrderStatusWorkflow.IsArchived(operationsOwner.Order.Status))
                                                     {
                                                         <div class="trade-orders-start-gate-action">
                                                             <MudTextField @bind-Value="_commissionPaymentObservation"
                                                                           id="commission-start-payment-observation"
                                                                           Label="Payment note"
                                                                           Variant="Variant.Outlined"
                                                                           Margin="Margin.Dense"
                                                                           Immediate="true"
                                                                           MaxLength="500" />
                                                             <MudButton Variant="Variant.Filled"
                                                                        Color="Color.Primary"
                                                                        Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(_commissionPaymentObservation))"
                                                                        OnClick="RecordCommissionPaymentAsync">
                                                                 Mark sent
                                                             </MudButton>
                                                         </div>
                                                     }
                                                       else if (operationsCommission.Gates.Payment.CommissionerSent is { } commissionerSent)
                                                       {
                                                           <div class="trade-orders-start-gate-evidence">
                                                               <strong>Company marked payment sent</strong>
                                                               <span>@commissionerSent.Note</span>
                                                               <small>
                                                                   @commissionerSent.RecordedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                                   - terms v@(commissionerSent.TermsVersion)
                                                              </small>
                                                          </div>
                                                          @if (operationsOwner.Order.Status == TradeOrderStatus.Assigned)
                                                          {
                                                              <details class="trade-orders-exception-disclosure">
                                                                  <summary>Retract commissioner confirmation</summary>
                                                                  <MudTextField @bind-Value="_commissionPaymentRetractionReason"
                                                                                id="commission-payment-retraction-reason"
                                                                                Label="Retraction reason"
                                                                                Variant="Variant.Outlined"
                                                                                Margin="Margin.Dense"
                                                                                Immediate="true"
                                                                                MaxLength="500" />
                                                                  <MudButton Variant="Variant.Outlined"
                                                                             Color="Color.Warning"
                                                                             Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(_commissionPaymentRetractionReason))"
                                                                             OnClick="RetractCommissionPaymentAsync">
                                                                      Retract confirmation
                                                                  </MudButton>
                                                              </details>
                                                           }
                                                       }
                                                      @if (operationsCommission.Gates.Payment.CrafterReceived is { } crafterReceipt)
                                                      {
                                                          <div class="trade-orders-start-gate-evidence">
                                                              <strong>Crafter confirmed payment receipt</strong>
                                                              <span>@crafterReceipt.Note</span>
                                                              <small>
                                                                  @crafterReceipt.RecordedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                                  - terms v@(crafterReceipt.TermsVersion)
                                                              </small>
                                                          </div>
                                                      }
                                                      else
                                                      {
                                                          <div class="trade-orders-start-gate-evidence">
                                                              <strong>Crafter confirmation pending</strong>
                                                              <span>No crafter receipt confirmation is recorded for terms v@(operationsCommission.CurrentTermsVersion).</span>
                                                          </div>
                                                      }
                                                      <small>Crafter confirmation remains independent and may arrive before or after material handoff.</small>
                                                  }
                                             </section>

                                             <section class="trade-orders-start-gate" aria-labelledby="materials-gate-title">
                                                 <div class="trade-orders-start-gate-heading">
                                                     <div>
                                                         <span>Company materials</span>
                                                         <MudText Typo="Typo.subtitle2" HtmlTag="h3" id="materials-gate-title">Company material handoff</MudText>
                                                     </div>
                                                 </div>
                                                 <div class="trade-orders-start-gate-materials">
                                                     @foreach (var material in operationsCommission.CurrentTerms.Materials
                                                        .Where(material => material.Responsibility == CommissionMaterialResponsibility.Provided))
                                                     {
                                                         <span>@material.Name <strong>×@(material.Quantity.ToString("N0"))</strong></span>
                                                     }
                                                 </div>
                                                 <div class="trade-orders-start-gate-status">
                                                     <span>Status</span>
                                                     <strong>@FormatCommissionMaterialHandoff(operationsCommission.Gates.CompanyMaterials)</strong>
                                                 </div>
                                                  @if (operationsCommission.Gates.CompanyMaterials.State == CompanyCommissionClearanceState.Pending &&
                                                       operationsCommission.Gates.CompanyMaterials.ReadyAtUtc == null &&
                                                       !TradeOrderStatusWorkflow.IsArchived(operationsOwner.Order.Status))
                                                 {
                                                     <div class="trade-orders-start-gate-action is-end">
                                                         <MudButton Variant="Variant.Filled"
                                                                    Color="Color.Primary"
                                                                    Disabled="@_isCommissionCommandRunning"
                                                                    OnClick="MarkCommissionMaterialsReadyAsync">
                                                             Mark full bundle ready
                                                         </MudButton>
                                                     </div>
                                                 }
                                                 <small>Materials can be confirmed before payment; neither requirement waits for the other.</small>
                                             </section>
                                         </div>
                                     </section>

                                     @if (operationsPaymentRequest != null)
                                     {
                                         <section class="trade-orders-operation-card is-attention">
                                             <div class="trade-orders-operation-card-heading">
                                                 <div>
                                                     <MudText Typo="Typo.subtitle2">Payment timing request</MudText>
                                                     <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                         The crafter requested @FormatPaymentRequestSchedule(operationsPaymentRequest).
                                                     </MudText>
                                                 </div>
                                                 <span class="trade-orders-publication-chip is-attention">Review</span>
                                             </div>
                                             <span>@(operationsPaymentRequest.Reason ?? "No reason supplied.")</span>
                                             @if (!string.IsNullOrWhiteSpace(operationsPaymentRequest.Error))
                                             {
                                                 <span class="is-error">@operationsPaymentRequest.Error</span>
                                             }
                                             <MudTextField @bind-Value="_commissionPaymentDecisionReason"
                                                           id="commission-payment-decision-reason"
                                                           Label="Decision reason"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           Immediate="true"
                                                           MaxLength="500" />
                                             <div class="trade-orders-inline-actions">
                                                 <MudButton Variant="Variant.Filled"
                                                            Color="Color.Primary"
                                                            Size="Size.Small"
                                                            Disabled="@(_isCommissionCommandRunning || operationsPaymentRequest.RequestedSchedule == null || string.IsNullOrWhiteSpace(_commissionPaymentDecisionReason))"
                                                            OnClick="@(() => DecideCommissionPaymentPolicyAsync(true))">
                                                     Accept timing
                                                 </MudButton>
                                                 <MudButton Variant="Variant.Outlined"
                                                            Color="Color.Secondary"
                                                            Size="Size.Small"
                                                            Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(_commissionPaymentDecisionReason))"
                                                            OnClick="@(() => DecideCommissionPaymentPolicyAsync(false))">
                                                     Refuse
                                                 </MudButton>
                                             </div>
                                         </section>
                                     }

                                     @if (operationsProvisional != null &&
                                          operationsCommission.Gates.Identity.State ==
                                          CompanyCommissionClearanceState.Pending)
                                     {
                                         <section class="trade-orders-operation-card is-attention">
                                             <div class="trade-orders-operation-card-heading">
                                                 <div>
                                                     <MudText Typo="Typo.subtitle2">Claimant Identity</MudText>
                                                     <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                         Claim reserved; assignment waits for a company roster identity.
                                                     </MudText>
                                                 </div>
                                                 <span class="trade-orders-publication-chip is-attention">Review</span>
                                             </div>
                                             <div class="trade-orders-identity-evidence">
                                                 <div>
                                                     <span>Character</span>
                                                     <strong>@($"{operationsProvisional.CharacterName} @ {operationsProvisional.HomeWorld}")</strong>
                                                     <small>
                                                         @(string.IsNullOrWhiteSpace(operationsProvisional.LodestoneCharacterId)
                                                             ? "Lodestone verification missing"
                                                             : $"Lodestone {operationsProvisional.LodestoneCharacterId}")
                                                     </small>
                                                 </div>
                                                 <div>
                                                     <span>Contact</span>
                                                     <strong>@operationsProvisional.ContactMethod</strong>
                                                     <small>@operationsProvisional.ContactValue</small>
                                                 </div>
                                             </div>
                                             <div class="trade-orders-identity-review">
                                                 <CompactSelectField Id="commission-identity-crafter"
                                                                     Label="Company crafter"
                                                                     Tooltip="Link an existing matching crafter or create one from this confirmed identity."
                                                                     @bind-Value="CommissionIdentityCrafterValue"
                                                                     Options="GetCommissionCrafterOptions()"
                                                                     Disabled="@_isCommissionCommandRunning" />
                                                 <MudButton Variant="Variant.Filled"
                                                            Color="Color.Primary"
                                                            Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(operationsProvisional.LodestoneCharacterId))"
                                                            OnClick="ConfirmCommissionIdentityAsync">
                                                     Confirm + Assign
                                                 </MudButton>
                                             </div>
                                             <details class="trade-orders-exception-disclosure">
                                                 <summary>Reject or release this claim</summary>
                                                 <MudTextField @bind-Value="_commissionIdentityRejectionReason"
                                                               id="commission-identity-rejection-reason"
                                                               Label="Rejection reason"
                                                               Variant="Variant.Outlined"
                                                               Margin="Margin.Dense"
                                                               Immediate="true"
                                                               MaxLength="500" />
                                                 <MudCheckBox T="bool"
                                                              @bind-Value="_blockRejectedCommissionContact"
                                                              Dense="true"
                                                              Color="Color.Warning"
                                                              Label="Block this contact from reclaiming" />
                                                 <MudButton Variant="Variant.Outlined"
                                                            Color="Color.Error"
                                                            Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(_commissionIdentityRejectionReason))"
                                                            OnClick="RejectCommissionClaimAsync">
                                                     Reject + Release
                                                 </MudButton>
                                             </details>
                                         </section>
                                     }

                                     @if (_showCommissionTermsRevision)
                                     {
                                         <section class="trade-orders-operation-card is-revision">
                                             <div class="trade-orders-operation-card-heading">
                                                 <div>
                                                     <MudText Typo="Typo.subtitle2">
                                                         Create Terms v@(operationsCommission.CurrentTermsVersion + 1)
                                                     </MudText>
                                                     <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                         Adjust material responsibility and crafter-facing details, then publish one immutable revision to the existing brief and Discord message.
                                                     </MudText>
                                                 </div>
                                                 <span class="trade-orders-publication-chip">Draft revision</span>
                                             </div>
                                             @if (HasCommissionTermsRevisionConflict)
                                             {
                                                 <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                                     Canonical terms changed while you were editing. Your local revision is preserved, but it cannot be published until you deliberately rebase it or discard it.
                                                     <div class="trade-orders-inline-actions mt-2">
                                                         <MudButton Variant="Variant.Filled"
                                                                    Color="Color.Warning"
                                                                    Disabled="@_isCommissionCommandRunning"
                                                                    OnClick="RebaseCommissionTermsRevisionAsync">
                                                             Rebase onto latest terms
                                                         </MudButton>
                                                         <MudButton Variant="Variant.Text"
                                                                    Color="Color.Secondary"
                                                                    Disabled="@_isCommissionCommandRunning"
                                                                    OnClick="DiscardConflictedCommissionTermsRevisionAsync">
                                                             Discard local changes
                                                         </MudButton>
                                                     </div>
                                                 </MudAlert>
                                             }
                                             <MudTextField @bind-Value="_commissionTermsRevisionReason"
                                                           id="commission-terms-revision-reason"
                                                           Label="What changed?"
                                                           HelperText="The crafter must acknowledge this immutable revision before work continues."
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           Immediate="true"
                                                           Lines="2"
                                                           MaxLength="500" />
                                             <div class="trade-orders-inline-actions">
                                                 <MudButton Variant="Variant.Text"
                                                            Color="Color.Secondary"
                                                            OnClick="CancelCommissionTermsRevisionAsync">
                                                     Discard Revision
                                                 </MudButton>
                                                 <MudButton Variant="Variant.Filled"
                                                            Color="Color.Primary"
                                                            Disabled="@(_isCommissionCommandRunning || HasCommissionTermsRevisionConflict || string.IsNullOrWhiteSpace(_commissionTermsRevisionReason))"
                                                            OnClick="AmendCommissionTermsAsync">
                                                     Publish Revision
                                                 </MudButton>
                                             </div>
                                         </section>
                                     }

                                     @if (operationsOwner.Order.Status == TradeOrderStatus.AwaitingDelivery &&
                                          operationsCommission.DeliveryReadiness.IsReady)
                                     {
                                         <section class="trade-orders-operation-card is-attention">
                                             <div class="trade-orders-operation-card-heading">
                                                 <div>
                                                     <MudText Typo="Typo.subtitle2">Delivery Ready</MudText>
                                                     <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                         The crafter declared every requested output ready.
                                                     </MudText>
                                                 </div>
                                                 <span class="trade-orders-publication-chip is-attention">Review</span>
                                             </div>
                                             <MudTextField @bind-Value="_commissionReturnReason"
                                                           id="commission-return-to-work-reason"
                                                           Label="Return-to-work reason"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           Immediate="true"
                                                           MaxLength="500" />
                                             <div class="trade-orders-inline-actions">
                                                 <MudButton Variant="Variant.Outlined"
                                                            Color="Color.Warning"
                                                            Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(_commissionReturnReason))"
                                                            OnClick="ReturnCommissionToWorkAsync">
                                                     Return to Work
                                                 </MudButton>
                                                 <MudButton Variant="Variant.Filled"
                                                            Color="Color.Success"
                                                            Disabled="@_isCommissionCommandRunning"
                                                            OnClick="AcceptCommissionDeliveryAsync">
                                                     Accept Complete Delivery
                                                 </MudButton>
                                             </div>
                                         </section>
                                     }

                                     @if (operationsOwner.Order.Status == TradeOrderStatus.Completed &&
                                          operationsCommission.CurrentTerms.Payment.Total > 0 &&
                                          operationsCommission.CurrentTerms.Payment.Schedule != CompanyCommissionPaymentSchedule.Advance)
                                     {
                                         var settlement = operationsCommission.SettlementPayment;
                                         var legacySettlement =
                                             operationsCommission.SettlementState == CompanyCommissionSettlementState.Satisfied &&
                                             settlement.ConfirmationCount == 0;
                                         <section class="trade-orders-operation-card @(operationsCommission.SettlementState == CompanyCommissionSettlementState.Satisfied ? string.Empty : "is-attention")">
                                             <div class="trade-orders-operation-card-heading">
                                                 <div>
                                                     <MudText Typo="Typo.subtitle2">Final payment</MudText>
                                                     <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                         @FormatGil(operationsCommission.CurrentTerms.Payment.Total) against terms v@(operationsCommission.CurrentTermsVersion).
                                                     </MudText>
                                                 </div>
                                                 <span class="@GetSettlementChipClass(operationsCommission.SettlementState)">
                                                     @(legacySettlement
                                                         ? "Legacy settlement"
                                                         : $"{settlement.ConfirmationCount} of 2 confirmed")
                                                 </span>
                                             </div>
                                             @if (legacySettlement)
                                             {
                                                 <div class="trade-orders-payment-clearance is-complete">
                                                     <strong>Settlement preserved</strong>
                                                     <span>This commission predates two-party settlement confirmations.</span>
                                                 </div>
                                             }
                                             else
                                             {
                                                 <div class="trade-orders-payment-handshake">
                                                     <div class="@($"trade-orders-payment-attestation{(settlement.CommissionerSent != null ? " is-complete" : string.Empty)}")">
                                                         <span>Commissioner</span>
                                                         @if (settlement.CommissionerSent is { } sent)
                                                         {
                                                             <strong>Final payment marked sent</strong>
                                                             <p>@sent.Note</p>
                                                             <small>@sent.RecordedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") - terms v@(sent.TermsVersion)</small>
                                                         }
                                                         else
                                                         {
                                                             <strong>Record final payment</strong>
                                                             <MudTextField @bind-Value="_commissionSettlementObservation"
                                                                           id="commission-settlement-observation"
                                                                           Label="Payment note"
                                                                           Variant="Variant.Outlined"
                                                                           Margin="Margin.Dense"
                                                                           Immediate="true"
                                                                           MaxLength="500" />
                                                             <MudButton Variant="Variant.Filled"
                                                                        Color="Color.Primary"
                                                                        FullWidth="true"
                                                                        Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(_commissionSettlementObservation))"
                                                                        OnClick="RecordCommissionSettlementAsync">
                                                                 Mark sent
                                                             </MudButton>
                                                         }
                                                     </div>
                                                     <div class="trade-orders-payment-handshake-mark">
                                                         <MudIcon Icon="@Icons.Material.Filled.SyncAlt" />
                                                     </div>
                                                     <div class="@($"trade-orders-payment-attestation{(settlement.CrafterReceived != null ? " is-complete" : " is-waiting")}")">
                                                         <span>Crafter</span>
                                                         @if (settlement.CrafterReceived is { } received)
                                                         {
                                                             <strong>Final payment receipt confirmed</strong>
                                                             <p>@received.Note</p>
                                                             <small>@received.RecordedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") - terms v@(received.TermsVersion)</small>
                                                         }
                                                         else
                                                         {
                                                             <strong>Crafter confirmation pending</strong>
                                                             <p>The participant brief carries the accepted amount and terms version.</p>
                                                         }
                                                     </div>
                                                 </div>
                                                 @if (settlement.CommissionerSent != null)
                                                 {
                                                     <details class="trade-orders-exception-disclosure">
                                                         <summary>Retract commissioner confirmation</summary>
                                                         <MudTextField @bind-Value="_commissionSettlementRetractionReason"
                                                                       id="commission-settlement-retraction-reason"
                                                                       Label="Retraction reason"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       Immediate="true"
                                                                       MaxLength="500" />
                                                         <MudButton Variant="Variant.Outlined"
                                                                    Color="Color.Warning"
                                                                    Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(_commissionSettlementRetractionReason))"
                                                                    OnClick="RetractCommissionSettlementAsync">
                                                             Retract confirmation
                                                         </MudButton>
                                                     </details>
                                                 }
                                                 <div class="@($"trade-orders-payment-clearance{(operationsCommission.SettlementState == CompanyCommissionSettlementState.Satisfied ? " is-complete" : string.Empty)}")">
                                                     <strong>
                                                         @(operationsCommission.SettlementState == CompanyCommissionSettlementState.Satisfied
                                                             ? "Settlement complete"
                                                             : "Final payment incomplete")
                                                     </strong>
                                                     <span>
                                                         @(operationsCommission.SettlementState == CompanyCommissionSettlementState.Satisfied
                                                             ? "Both parties confirmed the final payment against the accepted terms."
                                                             : $"{settlement.ConfirmationCount} of 2 confirmations recorded.")
                                                     </span>
                                                 </div>
                                             }
                                         </section>
                                     }

                               }
                                @if (_selectedOrder.CompanyCommission?.ManualResolution is { } manualResolution)
                                {
                                    <section class="trade-orders-operation-card is-attention">
                                        <MudText Typo="Typo.subtitle2">Company resolution required</MudText>
                                        <MudText Typo="Typo.body2">
                                            The participant withdrew after work or an exchange began. The Discord brief has been removed while the company reconciles payment, materials, and retained output progress.
                                        </MudText>
                                        <MudText Typo="Typo.caption">
                                            Reported @manualResolution.RequestedAtUtc.ToLocalTime().ToString("g"): @manualResolution.Reason
                                        </MudText>
                                        <MudTextField @bind-Value="_commissionResolutionNote"
                                                      id="commission-resolution-note"
                                                      Label="Resolution note"
                                                      HelperText="Record what was reconciled before reopening. Cancel Commission remains available in the header."
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Lines="2"
                                                      Immediate="true"
                                                      MaxLength="1000" />
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(_commissionResolutionNote))"
                                                   OnClick="ReopenCanonicalCommissionAsync">
                                            Reopen for claiming
                                        </MudButton>
                                    </section>
                                }
                                @if (HasCanonicalCommission &&
                                     TradeOrderStatusWorkflow.IsArchived(_selectedOrder.Status))
                                {
                                   <section class="trade-orders-operation-card trade-orders-order-actions">
                                       <MudText Typo="Typo.subtitle2">Order actions</MudText>
                                        @if (TradeOrderStatusWorkflow.IsArchived(_selectedOrder.Status))
                                        {
                                            @if (_selectedOrder.Status == TradeOrderStatus.Canceled &&
                                                 _selectedOrder.CompanyCommission?.PublicMetadata.ViewState == CompanyCommissionPublicViewState.Published)
                                            {
                                                <MudTextField @bind-Value="_commissionResolutionNote"
                                                              id="commission-reopen-note"
                                                              Label="Reopen resolution"
                                                              HelperText="Explain why this canceled commission is ready to return to public claiming."
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Lines="2"
                                                              Immediate="true"
                                                              MaxLength="1000" />
                                                <MudButton Variant="Variant.Filled"
                                                           Color="Color.Primary"
                                                           Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(_commissionResolutionNote))"
                                                           OnClick="ReopenCanonicalCommissionAsync">
                                                    Reopen and repost
                                                </MudButton>
                                            }
                                            <MudButton Variant="Variant.Outlined"
                                                      Color="Color.Error"
                                                      Disabled="@_isDeletingSelectedOrder"
                                                      OnClick="DeleteSelectedOrderAsync">
                                               @(_isDeletingSelectedOrder ? "Deleting..." : "Delete order permanently")
                                           </MudButton>
                                       }
                                   </section>
                               }
                               <details class="trade-orders-work-details" open="@(!HasCanonicalCommission)">
                                   <summary>Terms and calculation details</summary>
                                   <div class="trade-orders-work-details-content">
                                <div class="trade-orders-payment-metrics">
                                    <div class="trade-orders-payment-metric">
                                        <span>Payment amount</span>
                                        <strong>@FormatGil(displayedPaymentTotal)</strong>
                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@(displayedPaymentTotal <= 0)"
                                                       OnClick='@(() => CopyGilAmountAsync(displayedPaymentTotal, "Payment amount copied"))'
                                                       aria-label="Copy payment amount" />
                                    </div>
                                    <div class="trade-orders-payment-metric">
                                        <span>Total estimated procurement</span>
                                        <strong>@FormatGil(displayedProcurementTotal)</strong>
                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@(displayedProcurementTotal <= 0)"
                                                       OnClick='@(() => CopyGilAmountAsync(displayedProcurementTotal, "Procurement estimate copied"))'
                                                       aria-label="Copy procurement amount" />
                                    </div>
                                </div>
                                @if (paymentSummary.Materials.Count > 0 && paymentSummary.EstimatedProcurementTotal <= 0)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">Material lines are captured, but pricing evidence is missing. Run market analysis from the linked craft plan before using payment totals.</MudAlert>
                                }
                                @if (paymentSummary.Materials.Count > 0)
                                {
                                    <div class="trade-orders-payment-table">
                                        <div class="trade-orders-payment-table-title">
                                            <span>Payment Breakdown</span>
                                            <span>Current route</span>
                                        </div>
                                        <div class="trade-orders-payment-breakdown-header">
                                            <span>Line</span>
                                            <span>Basis</span>
                                            <span>Amount</span>
                                        </div>
                                        <div class="trade-orders-payment-breakdown-row">
                                            <span>Crafter-procured materials</span>
                                            <span>Payable materials</span>
                                            <strong>@FormatGil(paymentSummary.MaterialReimbursementTotal)</strong>
                                        </div>
                                        @if (paymentSummary.OnHandMaterialValueTotal > 0)
                                        {
                                            <div class="trade-orders-payment-breakdown-row">
                                                <span>On-hand material value</span>
                                                <span>Bonus basis only; not reimbursed</span>
                                                <strong>@FormatGil(paymentSummary.OnHandMaterialValueTotal)</strong>
                                            </div>
                                        }
                                        <div class="trade-orders-payment-breakdown-row">
                                            <span>Company-provided materials</span>
                                            <span>Estimate only</span>
                                            <strong>@FormatGilAllowZero(paymentSummary.ProvidedMaterialTotal)</strong>
                                        </div>
                                        @if (paymentSummary.Active.Contract == TradePaymentContractMode.LegacyCommission)
                                        {
                                            <div class="trade-orders-payment-breakdown-row">
                                                <span>Legacy material commission</span>
                                                <span>@paymentSummary.CommissionPercent.ToString("N0")% of procurement</span>
                                                <strong>@FormatGil(paymentSummary.CommissionAmount)</strong>
                                            </div>
                                        }
                                        @if (paymentSummary.Active.Contract == TradePaymentContractMode.LaborStandard)
                                        {
                                            <div class="trade-orders-payment-breakdown-row">
                                                <span>Craft labor</span>
                                                <span>@FormatCraftLaborBasis(paymentSummary.LaborStandard)</span>
                                                <strong>@FormatGilAllowZero(paymentSummary.LaborStandard.CraftLaborTotal)</strong>
                                            </div>
                                        }
                                        <div class="trade-orders-payment-breakdown-row is-total">
                                            <span>Total payment</span>
                                            <span>@FormatPaymentContract(paymentSummary.Active.Contract)</span>
                                            <strong>@FormatGil(paymentSummary.TotalPayment)</strong>
                                        </div>
                                    </div>
                                    <div class="trade-orders-payment-table">
                                        <div class="trade-orders-payment-table-title">
                                            <span>Policy Comparison</span>
                                            <span>Same current route</span>
                                        </div>
                                        <div class="trade-orders-policy-comparison-header">
                                            <span>Contract</span>
                                            <span>Includes</span>
                                            <span>Payment</span>
                                            <span>Delta</span>
                                        </div>
                                        <div class="trade-orders-policy-comparison-row">
                                            <span>Legacy commission</span>
                                            <span>Materials + @paymentSummary.Legacy.CommissionPercent.ToString("N0")% legacy commission</span>
                                            <strong>@FormatPaymentBreakdown(paymentSummary.Legacy)</strong>
                                            <span>Baseline</span>
                                        </div>
                                        <div class="trade-orders-policy-comparison-row">
                                            <span>Labor standard</span>
                                            <span>Materials + synth labor</span>
                                            <strong>@FormatPaymentBreakdown(paymentSummary.LaborStandard)</strong>
                                            <span>@FormatPaymentDifference(paymentSummary.LaborStandard, paymentSummary.Legacy)</span>
                                        </div>
                                    </div>
                                    <div class="trade-orders-payment-heading">
                                        <div>
                                            <MudText Typo="Typo.subtitle2">Supply Summary</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Derived from the commission supply plan.
                                            </MudText>
                                        </div>
                                        <div class="trade-orders-payment-copy-actions">
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                                                       OnClick="CopyOrderPaymentReceiptAsync">
                                                Copy Receipt
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                                       OnClick="CopyOrderPaymentSummaryAsync">
                                                Copy Summary
                                            </MudButton>
                                        </div>
                                    </div>
                                    <div class="@($"trade-orders-material-table is-compact{(SelectedCommissionOwner != null ? " has-commission-handoff" : string.Empty)}")">
                                        <div class="trade-orders-material-header">
                                            <span>Item</span>
                                            <span>Qty</span>
                                            @if (SelectedCommissionOwner != null)
                                            {
                                                <span>Ready</span>
                                                <span>Received</span>
                                            }
                                            <span>Unit cost</span>
                                            <span>Total cost</span>
                                            <span>Resp.</span>
                                            <span>Payment impact</span>
                                        </div>
                                        @foreach (var material in paymentSummary.Materials)
                                        {
                                            <div class="trade-orders-material-row" @key="GetPaymentMaterialKey(material)">
                                                <span class="trade-orders-material-cell">
                                                    <strong>@material.Name</strong>
                                                    @if (material.RequiresHq)
                                                    {
                                                        <span class="trade-orders-hq">HQ</span>
                                                    }
                                                </span>
                                                <span>@TradeDisplayFormatter.FormatQuantity(material.Quantity)</span>
                                                @if (SelectedCommissionOwner != null)
                                                {
                                                    <span>@FormatCompanyMaterialReadyQuantity(material.ItemId, material.RequiresHq)</span>
                                                    <span>@FormatCompanyMaterialReceivedQuantity(material.ItemId, material.RequiresHq)</span>
                                                }
                                                <span>@FormatMaterialUnitCost(material)</span>
                                                <span>@FormatMaterialCost(material)</span>
                                                <span class="trade-orders-payment-responsibility">
                                                    @FormatResponsibility(material.Responsibility)
                                                </span>
                                                <span>@FormatMaterialPaymentImpact(material)</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">Create a linked craft plan, then run market analysis to populate payment evidence.</MudAlert>
                                }
                                   </div>
                               </details>
                                    </RequirementsContent>
                                </TradeOrderCenterOverview>
                            </section>
                        }
                        else if (_selectedOrder.CompanyCommission == null)
                        {
                        <section class="trade-orders-workspace-card">
                            <div class="trade-orders-workspace-header">
                                 <div>
                                      <MudText Typo="Typo.overline">Selected Order</MudText>
                                     <MudText Typo="Typo.h6">@_selectedOrder.Title</MudText>
                                 </div>
                                  <div class="trade-orders-inline-actions">
                                      <MudButton Variant="Variant.Outlined"
                                                 Color="Color.Secondary"
                                                 StartIcon="@Icons.Material.Filled.EditNote"
                                                 OnClick="OpenSelectedOrderTermsAsync"
                                                 Disabled="@(IsSelectedOrderArchived || HasSelectedLocalHostedCollision)">
                                          Edit draft terms
                                      </MudButton>
                                      <MudButton Variant="Variant.Filled"
                                                 Color="Color.Primary"
                                                 OnClick="SaveSelectedOrderAsync"
                                                 Disabled="@(IsSelectedOrderArchived || HasSelectedLocalHostedCollision || string.IsNullOrWhiteSpace(_detailTitle))">
                                          Save Order
                                      </MudButton>
                                      @if (HasSelectedLifecycleAction)
                                      {
                                          <MudButton Variant="Variant.Outlined"
                                                     Color="Color.Error"
                                                     OnClick="InvokeSelectedOrderLifecycleActionAsync"
                                                     Disabled="@(_isDeletingSelectedOrder || _isDiscardingSelectedDraft || HasSelectedLocalHostedCollision)">
                                              @SelectedLifecycleActionLabel
                                          </MudButton>
                                      }
                                  </div>
                             </div>
                             @if (HasSelectedLocalHostedCollision)
                             {
                                 <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                     <div class="trade-orders-device-only-draft-state">
                                         <div>
                                             <strong>Hosted copy arrived while you were editing</strong>
                                             <span>
                                                 @(_selectedLocalHostedCollision?.Order?.CompanyCommission == null
                                                     ? "Your unsaved fields are preserved. Rebase them onto the hosted copy before saving, or discard them."
                                                     : "This order became a canonical commission, so the local buffer cannot be merged safely. Use the hosted copy to discard it.")
                                             </span>
                                         </div>
                                         <div class="trade-orders-inline-actions">
                                             @if (_selectedLocalHostedCollision?.Order?.CompanyCommission == null)
                                             {
                                                 <MudButton Variant="Variant.Filled"
                                                            Color="Color.Primary"
                                                            Size="Size.Small"
                                                            OnClick="RebaseSelectedLocalEditsOntoHostedCopy">
                                                     Rebase edits
                                                 </MudButton>
                                             }
                                             <MudButton Variant="Variant.Outlined"
                                                        Color="Color.Warning"
                                                        Size="Size.Small"
                                                        OnClick="AdoptHostedCopyForSelectedLocalOrder">
                                                 Use hosted copy
                                             </MudButton>
                                         </div>
                                     </div>
                                 </MudAlert>
                             }
                             @if (IsSelectedDeviceOnlyOrder)
                             {
                                 <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                     <div class="trade-orders-device-only-draft-state">
                                         <div>
                                             <strong>Saved on this device</strong>
                                             <span>This order has not joined the hosted order workspace yet.</span>
                                         </div>
                                         <div class="trade-orders-inline-actions">
                                             <MudButton Variant="Variant.Filled"
                                                        Color="Color.Primary"
                                                        Size="Size.Small"
                                                        Disabled="@(_isRetryingSelectedDeviceOnlyOrderSync || HasSelectedLocalDraftEditorChanges)"
                                                        OnClick="RetrySelectedDeviceOnlyOrderSyncAsync">
                                                 @(_isRetryingSelectedDeviceOnlyOrderSync
                                                     ? "Retrying..."
                                                     : HasSelectedLocalDraftEditorChanges
                                                         ? "Save edits first"
                                                         : "Retry sync")
                                             </MudButton>
                                         </div>
                                     </div>
                                 </MudAlert>
                             }
                             @if (SelectedCanonicalCommission is { } centerCommission)
                             {
                                 <div class="trade-orders-commission-identity-strip">
                                     <div>
                                         <span>Claimant</span>
                                         <strong>@FormatCanonicalCommissionClaimant(centerCommission)</strong>
                                     </div>
                                     <div>
                                         <span>Company crafter</span>
                                         <strong>@FormatCanonicalCommissionCrafter(_selectedOrder, centerCommission)</strong>
                                     </div>
                                     <div>
                                         <span>Commission state</span>
                                         <strong>@FormatCanonicalCommissionState(_selectedOrder, centerCommission)</strong>
                                     </div>
                                 </div>
                                 <div class="trade-orders-authority-note">
                                     <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" />
                                     <span>
                                         Assignment and lifecycle are derived from the canonical commission.
                                         Plan and price here; operate the external agreement in the right pane.
                                     </span>
                                 </div>
                             }
                             else
                             {
                                 <div class="trade-orders-editor-grid">
                                     <MudTextField @bind-Value="_detailTitle"
                                                   id="selected-order-title"
                                                   Label="Order title"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Immediate="true"
                                                   Disabled="@IsSelectedOrderArchived" />
                                     <CompactSelectField Id="selected-order-crafter"
                                                         Label="Assigned crafter"
                                                         @bind-Value="DetailCrafterValue"
                                                         Options="GetCrafterOptions()"
                                                         Disabled="@IsSelectedOrderArchived" />
                                    <MudTextField @bind-Value="_detailNotes"
                                                  id="selected-order-notes"
                                                  Label="Notes"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true"
                                                  Lines="1"
                                                  Disabled="@IsSelectedOrderArchived" />
                                 </div>
                             }
                            <section class="trade-orders-work-section">
                                <div class="trade-orders-section-heading">
                                    <MudText Typo="Typo.subtitle2">Requested Outputs</MudText>
                                    @if (CanEditSelectedOrderOutputs)
                                    {
                                        <div class="trade-orders-section-actions">
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Undo"
                                                       OnClick="ResetSelectedOrderOutputEdits"
                                                       Disabled="@(!HasSelectedOrderOutputChanges || _isSavingSelectedOrderOutputs)">
                                                Reset
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Save"
                                                       OnClick="SaveSelectedOrderOutputsAsync"
                                                       Disabled="@(!CanSaveSelectedOrderOutputs)">
                                                @(_isSavingSelectedOrderOutputs ? "Saving..." : "Save Outputs")
                                            </MudButton>
                                        </div>
                                    }
                                </div>
                                @if (CanEditSelectedOrderOutputs)
                                {
                                    <div class="trade-orders-search-row">
                                        <MudTextField @bind-Value="_selectedOrderOutputSearchQuery"
                                                      id="selected-order-output-search"
                                                      Label="Add output item"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      OnKeyUp="OnSelectedOrderOutputSearchKeyUp" />
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Secondary"
                                                   OnClick="SearchSelectedOrderOutputItemsAsync"
                                                   Disabled="@(_isSearchingSelectedOrderOutputs || string.IsNullOrWhiteSpace(_selectedOrderOutputSearchQuery))">
                                            @(_isSearchingSelectedOrderOutputs ? "Searching..." : "Search")
                                        </MudButton>
                                    </div>
                                    @if (_selectedOrderOutputSearchResults.Count > 0)
                                    {
                                        <div class="trade-orders-search-results">
                                            @foreach (var result in _selectedOrderOutputSearchResults)
                                            {
                                                <button type="button"
                                                        class="trade-orders-search-result"
                                                        @onclick="() => AddSelectedOrderOutput(result)">
                                                    <span>@result.Object.Name</span>
                                                    <span>ID @result.Id</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                    <div class="trade-orders-output-table">
                                        <div class="trade-orders-output-header">
                                            <span>Item</span>
                                            <span>Qty</span>
                                            <span>HQ</span>
                                            <span></span>
                                        </div>
                                        @foreach (var output in _selectedOrderOutputEditors)
                                        {
                                            <div class="trade-orders-output-row">
                                                <span>@output.Name</span>
                                                <MudNumericField T="int"
                                                                 id="@($"selected-order-output-quantity-{output.ItemId}-{output.MustBeHq}")"
                                                                 Value="@output.Quantity"
                                                                 ValueChanged="quantity => UpdateSelectedOrderOutputQuantity(output, quantity)"
                                                                 Immediate="true"
                                                                 Min="1"
                                                                 Max="9999"
                                                                 HideSpinButtons="true"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense" />
                                                <MudCheckBox T="bool"
                                                             Value="@output.MustBeHq"
                                                             ValueChanged="mustBeHq => UpdateSelectedOrderOutputHq(output, mustBeHq)"
                                                             Color="Color.Primary" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="() => RemoveSelectedOrderOutput(output)" />
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="@($"trade-orders-breakdown-table{(SelectedCommissionOwner != null ? " has-commission-progress" : string.Empty)}")">
                                        <div class="trade-orders-breakdown-header">
                                            <span>Item</span>
                                            <span>Qty</span>
                                            <span>HQ</span>
                                            @if (SelectedCommissionOwner != null)
                                            {
                                                <span>Completed</span>
                                                <span>Ready</span>
                                            }
                                        </div>
                                        @if (SelectedCanonicalCommission is { } outputCommission)
                                        {
                                            @foreach (var output in outputCommission.CurrentTerms.Outputs)
                                            {
                                                var progress = GetSelectedOutputProgress(output.LineId);
                                                <div class="trade-orders-breakdown-row" @key="output.LineId">
                                                    <span>@output.Name</span>
                                                    <span>@TradeDisplayFormatter.FormatQuantity(output.RequiredQuantity)</span>
                                                    <span>@FormatHq(output.MustBeHq)</span>
                                                    <span>@((progress?.CompletedQuantity ?? 0).ToString("N0"))</span>
                                                    <span>@((progress?.ReadyQuantity ?? 0).ToString("N0"))</span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            @foreach (var item in GetOrderRootItems(_selectedOrder))
                                            {
                                                <div class="trade-orders-breakdown-row">
                                                    <span>@item.Name</span>
                                                    <span>@TradeDisplayFormatter.FormatQuantity(item.Quantity)</span>
                                                    <span>@FormatHq(item.MustBeHq)</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </section>
                            <section class="trade-orders-work-section">
                                <div class="trade-orders-section-heading">
                                    <MudText Typo="Typo.subtitle2">Craft Architect Pipeline</MudText>
                                </div>
                                <div class="trade-orders-pipeline">
                                    <div class="@GetPipelineStageClass(GetOrderRootItems(_selectedOrder).Count > 0)">
                                        <span>1 - Order request</span>
                                        <strong>@(GetOrderRootItems(_selectedOrder).Count > 0 ? "Outputs captured" : "Add requested outputs")</strong>
                                    </div>
                                    <div class="@GetPipelineStageClass(HasLinkedCraftPlan(_selectedOrder), !HasLinkedCraftPlan(_selectedOrder))">
                                        <span>2 - Craft plan</span>
                                        <strong>@(HasLinkedCraftPlan(_selectedOrder) ? "Plan available" : "Craft plan missing")</strong>
                                    </div>
                                    <div class="@GetPipelineStageClass(HasProcurementEvidence(_selectedOrder), HasMaterialBreakdown(_selectedOrder) && !HasProcurementEvidence(_selectedOrder))">
                                        <span>3 - Procurement evidence</span>
                                        <strong>@(HasProcurementEvidence(_selectedOrder) ? "Supply evidence available" : "Supply evidence missing")</strong>
                                    </div>
                                    <div class="@GetPipelineStageClass(IsPaymentReady(_selectedOrder))">
                                        <span>4 - Settlement</span>
                                        <strong>@GetSettlementStageLabel(_selectedOrder)</strong>
                                    </div>
                                </div>
                            </section>
                            <section class="trade-orders-work-section">
                                <div class="trade-orders-section-heading">
                                    <MudText Typo="Typo.subtitle2">Linked Craft Plan</MudText>
                                    <div class="trade-orders-section-actions">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Build"
                                                   OnClick="CreateOrReplaceSelectedOrderCraftPlanAsync"
                                                   Disabled="@(_isSavingSelectedOrderCraftPlan || _isRepricingSelectedOrder || !CanEditSelectedOrderPlan || GetOrderRootItems(_selectedOrder).Count == 0)">
                                            @GetCraftPlanBuildButtonText(_selectedOrder)
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.OpenInNew"
                                                   OnClick="OpenSelectedOrderCraftPlanAsync"
                                                   Disabled="@(_isOpeningSelectedOrderCraftPlan || !HasLinkedCraftPlan(_selectedOrder))">
                                            @(_isOpeningSelectedOrderCraftPlan ? "Opening..." : "Open Craft Plan")
                                        </MudButton>
                                    </div>
                                </div>
                                <div class="trade-orders-linked-plan-grid">
                                    <div>
                                        <span>Plan</span>
                                        <strong>@GetLinkedCraftPlanName(_selectedOrder)</strong>
                                    </div>
                                    <div>
                                        <span>Procurement evidence</span>
                                        <strong>@GetProcurementEvidenceLabel(_selectedOrder)</strong>
                                    </div>
                                    <div>
                                        <span>Last saved</span>
                                        <strong>@FormatLinkedCraftPlanDate(_selectedOrder)</strong>
                                    </div>
                                </div>
                            </section>
                        </section>
                        }
                        else
                        {
                            <section class="trade-orders-workspace-card">
                                <div class="trade-orders-workspace-empty" role="status">
                                    <MudIcon Icon="@Icons.Material.Filled.SyncProblem"
                                             Size="Size.Large"
                                             Class="trade-orders-workspace-empty-icon" />
                                    <MudText Typo="Typo.h6">Current order state unavailable</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        This workspace will appear when the shared hosted-order projection is authoritative.
                                    </MudText>
                                </div>
                            </section>
                        }
                    }
                    else
                    {
                        <section class="trade-orders-workspace-card">
                            <div class="trade-orders-workspace-empty">
                                <MudIcon Icon="@Icons.Material.Filled.Assignment"
                                         Size="Size.Large"
                                         Class="trade-orders-workspace-empty-icon" />
                                <MudText Typo="Typo.h6">No Order Selected</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Select an order from the list, or start a new one.
                                </MudText>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="StartNewOrderWorkspace">
                                    New Order
                                </MudButton>
                            </div>
                        </section>
                    }
                </main>

                <div class="trade-orders-ops-splitter"
                     @ref="_opsSplitterElement"
                     role="separator"
                     aria-label="Resize order work pane"
                     aria-orientation="vertical"
                     aria-valuemin="@MinimumOpsPaneWidth"
                     aria-valuemax="@MaximumOpsPaneWidth"
                     aria-valuenow="@_opsPaneWidth"
                     tabindex="0"></div>

                <aside class="trade-orders-ops" aria-label="Order plan and history">
                    @if (_selectedOrder == null)
                    {
                        <section class="trade-orders-panel">
                            <MudText Typo="Typo.subtitle1">Order details</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Select an order to view its plan, history, and sharing.</MudText>
                        </section>
                    }
                    else if (IsIdentityOnlyOrder(_selectedOrder))
                    {
                        <section class="trade-orders-panel">
                            <MudText Typo="Typo.subtitle1">Order details unavailable</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Plan, History, and Share will return when this order's hosted authority is verified.
                            </MudText>
                        </section>
                    }
                    else
                    {
                        var paymentSummary = GetSelectedOrderPaymentSummary();
                         <MudTabs Elevation="0"
                                  Rounded="true"
                                  ApplyEffectsToContainer="true"
                                  PanelClass="trade-orders-tab-panel"
                                  ActivePanelIndex="_activeOpsTab"
                                  ActivePanelIndexChanged="SetActiveOpsTabAsync">
                            <MudTabPanel Text="Plan">
                                <div class="trade-orders-workbench-heading">
                                    <div>
                                        <MudText Typo="Typo.subtitle1">Craft plan</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            The only editor for this order's linked plan.
                                        </MudText>
                                    </div>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               StartIcon="@(_isPlanPaneExpanded ? Icons.Material.Filled.CloseFullscreen : Icons.Material.Filled.OpenInFull)"
                                               OnClick="TogglePlanPaneExpandedAsync"
                                               aria-pressed="@_isPlanPaneExpanded">
                                        @(_isPlanPaneExpanded ? "Restore pane" : "Expand pane")
                                    </MudButton>
                                </div>
                                @{
                                    var planPaymentIsEditable = CanEditSelectedOrderPlan;
                                    var displayedPlanPayment = HasCanonicalCommission
                                        ? IsEditingCommissionTermsRevision
                                            ? _commissionTermsRevisionBrief?.Payment.Total ??
                                              SelectedCanonicalCommission?.CurrentTerms.Payment.Total ??
                                              paymentSummary.TotalPayment
                                            : SelectedCanonicalCommission?.CurrentTerms.Payment.Total ??
                                              paymentSummary.TotalPayment
                                        : paymentSummary.TotalPayment;
                                }
                                <section class="trade-orders-plan-terms" aria-label="Plan payment terms">
                                    <div class="trade-orders-plan-payment-total">
                                        <span>@(planPaymentIsEditable ? "Predicted payment" : "Accepted payment")</span>
                                        <strong>@FormatGil(displayedPlanPayment)</strong>
                                        <small>@GetSelectedOrderPaymentPolicyLabel()</small>
                                    </div>
                                    <CompactSelectField Id="selected-order-payment-contract"
                                                        Label="Payment basis"
                                                        Value="@SelectedOrderPaymentContract.ToString()"
                                                        ValueChanged="SetSelectedOrderPaymentContractValueAsync"
                                                        Options="PaymentContractOptions"
                                                        Disabled="@(!planPaymentIsEditable || IsPlanMutationTransactionRunning)" />
                                    <CompactSelectField Id="selected-order-payment-schedule"
                                                        Label="Payment timing"
                                                        Value="@SelectedOrderPaymentSchedule.ToString()"
                                                        ValueChanged="SetSelectedOrderPaymentScheduleValueAsync"
                                                        Options="PaymentScheduleOptions"
                                                        Disabled="@(!planPaymentIsEditable || IsPlanMutationTransactionRunning)" />
                                    @if (SelectedOrderPaymentSchedule == CompanyCommissionPaymentSchedule.Custom)
                                    {
                                        <div class="trade-orders-plan-custom-payment">
                                            <MudTextField T="string"
                                                          id="selected-order-custom-payment-terms"
                                                          Label="Custom payment timing"
                                                          Value="@SelectedOrderCustomPaymentTerms"
                                                          ValueChanged="SetSelectedOrderCustomPaymentTerms"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Immediate="true"
                                                          Disabled="@(!planPaymentIsEditable || IsPlanMutationTransactionRunning)" />
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@(!planPaymentIsEditable || IsPlanMutationTransactionRunning || string.IsNullOrWhiteSpace(SelectedOrderCustomPaymentTerms))"
                                                       OnClick="SaveSelectedOrderCustomPaymentTermsAsync">
                                                Save timing
                                            </MudButton>
                                        </div>
                                    }
                                    @if (!HasLinkedCraftPlan(_selectedOrder))
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Build"
                                                   Disabled="@(!CanBeginSelectedOrderPlanReconstruction || IsPlanMutationTransactionRunning)"
                                                   OnClick="BeginSelectedOrderPlanReconstructionAsync">
                                            @(_isSavingSelectedOrderCraftPlan ? "Building..." : "Build craft plan")
                                        </MudButton>
                                    }
                                </section>
                                @if (HasLinkedCraftPlan(_selectedOrder) && GetVisibleLiveProcurementSnapshot() is null)
                                {
                                    @if (_isLoadingSelectedOrderSupplyPlan ||
                                         _isRefreshingLiveProcurement ||
                                         string.IsNullOrWhiteSpace(_selectedOrderPlanRestoreError))
                                    {
                                        <div class="trade-orders-plan-restore" role="status" aria-live="polite">
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                            <div>
                                                <strong>Restoring plan...</strong>
                                                <span>Loading the linked recipe and every precraft decision.</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Error" Dense="true">
                                            @_selectedOrderPlanRestoreError
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => SetActiveOpsTabAsync(ProcurementTabIndex))">
                                                Try again
                                            </MudButton>
                                            @if (CanBeginSelectedOrderPlanReconstruction)
                                            {
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Warning"
                                                           Size="Size.Small"
                                                           Disabled="@IsPlanMutationTransactionRunning"
                                                           OnClick="BeginSelectedOrderPlanReconstructionAsync">
                                                    Reconstruct as new plan
                                                </MudButton>
                                            }
                                        </MudAlert>
                                    }
                                }
                                else
                                {
                                    var allProcurementRows = GetSelectedOrderProcurementRows();
                                    var procurementRows = GetSupplyPlanRows(allProcurementRows);
                                    var visibleProcurementRows = GetFilteredProcurementRows(procurementRows);
                                    @if (procurementRows.Count == 0)
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true">No supply-plan evidence has been captured for this order yet.</MudAlert>
                                    }
                                    else
                                    {
                                    <section class="trade-orders-procurement-summary">
                                        <div class="trade-orders-procurement-total">
                                            <span>Crafter reimbursable</span>
                                            <strong>@FormatGilAllowZero(GetProcurementReimbursementTotal(procurementRows))</strong>
                                        </div>
                                        <div class="trade-orders-procurement-health">
                                            <span>Company handoff</span>
                                            <strong>@FormatCompanyHandoffSummary(procurementRows)</strong>
                                            <small>@FormatCompanyHandoffDetail(procurementRows)</small>
                                        </div>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Refresh"
                                                   OnClick="RepriceSelectedOrderAsync"
                                                   Disabled="@(_isRepricingSelectedOrder || _isSavingSelectedOrderCraftPlan || !CanEditSelectedOrderPlan || !HasLinkedCraftPlan(_selectedOrder))">
                                            @(_isRepricingSelectedOrder ? "Refreshing..." : "Refresh Prices")
                                        </MudButton>
                                    </section>

                                    <div class="trade-orders-procurement-filters" role="group" aria-label="Filter procurement materials">
                                        <button type="button"
                                                class="@GetProcurementFilterClass(TradeOrderProcurementFilter.All)"
                                                aria-pressed="@(_procurementFilter == TradeOrderProcurementFilter.All)"
                                                @onclick="@(() => SetProcurementFilter(TradeOrderProcurementFilter.All))">
                                            All <span>@procurementRows.Count.ToString("N0")</span>
                                        </button>
                                        <button type="button"
                                                class="@GetProcurementFilterClass(TradeOrderProcurementFilter.Attention)"
                                                aria-pressed="@(_procurementFilter == TradeOrderProcurementFilter.Attention)"
                                                @onclick="@(() => SetProcurementFilter(TradeOrderProcurementFilter.Attention))">
                                            Needs attention <span>@CountProcurementRows(procurementRows, TradeOrderProcurementFilter.Attention).ToString("N0")</span>
                                        </button>
                                        <button type="button"
                                                class="@GetProcurementFilterClass(TradeOrderProcurementFilter.Crafter)"
                                                aria-pressed="@(_procurementFilter == TradeOrderProcurementFilter.Crafter)"
                                                @onclick="@(() => SetProcurementFilter(TradeOrderProcurementFilter.Crafter))">
                                            Crafter supplies <span>@CountProcurementRows(procurementRows, TradeOrderProcurementFilter.Crafter).ToString("N0")</span>
                                        </button>
                                        <button type="button"
                                                class="@GetProcurementFilterClass(TradeOrderProcurementFilter.Company)"
                                                aria-pressed="@(_procurementFilter == TradeOrderProcurementFilter.Company)"
                                                @onclick="@(() => SetProcurementFilter(TradeOrderProcurementFilter.Company))">
                                            Company supplies <span>@CountProcurementRows(procurementRows, TradeOrderProcurementFilter.Company).ToString("N0")</span>
                                        </button>
                                        <span class="trade-orders-procurement-legend">
                                            @GetProcurementHealthLabel(procurementRows) | @FormatProcurementEvidenceContext(_selectedOrder)
                                        </span>
                                    </div>

                                    <div class="trade-orders-supply-plan">
                                        <div class="trade-orders-supply-header">
                                            <span>Item</span>
                                            <span>Required</span>
                                            <span>Acquisition</span>
                                            <span>Responsibility</span>
                                            <span>Payment impact</span>
                                        </div>
                                        @if (_procurementFilter == TradeOrderProcurementFilter.All)
                                        {
                                            @foreach (var output in GetOrderRootItems(_selectedOrder))
                                            {
                                                <div class="trade-orders-supply-row is-output" @key="@($"output:{output.ItemId}:{output.MustBeHq}")">
                                                    <div class="trade-orders-output-cell">
                                                        <strong>@output.Name</strong>
                                                        <span>Commission output</span>
                                                    </div>
                                                    <strong class="trade-orders-supply-quantity">@TradeDisplayFormatter.FormatQuantity(output.Quantity)</strong>
                                                    <span class="trade-orders-output-route">Craft output</span>
                                                    <span class="trade-orders-output-route">Crafter delivers</span>
                                                    <span class="trade-orders-supply-impact">-</span>
                                                </div>
                                            }
                                        }
                                        @if (visibleProcurementRows.Count == 0)
                                        {
                                            <div class="trade-orders-procurement-empty">@GetProcurementFilterEmptyMessage()</div>
                                        }
                                        else
                                        {
                                            @foreach (var row in GetOrderedProcurementRows(visibleProcurementRows))
                                            {
                                                <div class="@GetSupplyPlanRowClass(row, procurementRows)" @key="row.RowKey">
                                                    <div class="trade-orders-procurement-item-cell">@RenderProcurementItemCell(row)</div>
                                                    <strong class="trade-orders-supply-quantity">@FormatProcurementQuantity(row)</strong>
                                                    @RenderProcurementSourceCell(row)
                                                    @RenderProcurementResponsibilityCell(row)
                                                    @RenderProcurementCostCell(row)
                                                </div>
                                                @if (row.Responsibility == CommissionMaterialResponsibility.Provided && row.HasChildren)
                                                {
                                                    <div class="trade-orders-supply-handoff">
                                                        <strong>Material handoff required:</strong>
                                                        Company provides @TradeDisplayFormatter.FormatQuantity(row.Quantity) @row.ItemName before work begins; its recipe subtree is excluded from crafter reimbursement.
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                    <div class="trade-orders-procurement-footer">
                                        <span>@FormatProcurementFooter(procurementRows)</span>
                                        <div>
                                            <small>@FormatGilAllowZero(GetProcurementMaterialValueTotal(procurementRows)) material value</small>
                                            <strong>@FormatGilAllowZero(GetProcurementReimbursementTotal(procurementRows)) reimbursable</strong>
                                        </div>
                                    </div>
                                    @if (paymentSummary.Warnings.Count > 0)
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                            <ul class="trade-orders-warning-list">
                                                @foreach (var warning in paymentSummary.Warnings)
                                                {
                                                    <li>@warning</li>
                                                }
                                            </ul>
                                        </MudAlert>
                                    }
                                    }
                                }
                            </MudTabPanel>
                             <MudTabPanel Text="History">
                                 @{ var timelineSummary = GetSelectedTimelineSummary(); }
                                 <div class="trade-orders-timeline-toolbar">
                                     <div class="trade-orders-timeline-filters" role="group" aria-label="Filter commission timeline">
                                         @foreach (var filter in Enum.GetValues<CommissionTimelineFilter>())
                                         {
                                             <button type="button"
                                                     class="@GetTimelineFilterClass(filter)"
                                                     aria-pressed="@(_timelineFilter == filter)"
                                                     @onclick="@(() => SetTimelineFilter(filter))">
                                                 @(filter == CommissionTimelineFilter.CompanyOnly
                                                     ? "Company only"
                                                     : filter.ToString())
                                             </button>
                                         }
                                     </div>
                                     <div class="trade-orders-timeline-summary" aria-label="Timeline event summary">
                                         @if (timelineSummary.Attention > 0)
                                         {
                                             <span class="is-attention">@timelineSummary.Attention need attention</span>
                                         }
                                         @if (timelineSummary.Human > 0)
                                         {
                                             <span class="is-human">@timelineSummary.Human conversations</span>
                                         }
                                         <span>@timelineSummary.Milestone milestones</span>
                                         <span>@timelineSummary.Routine routine</span>
                                     </div>
                                 </div>
                                 <div class="trade-orders-timeline">
                                     @foreach (var group in GetSelectedTimelineGroups())
                                     {
                                         @if (group.IsRoutineCluster)
                                         {
                                             <details class="trade-orders-timeline-routine-group" @key="group.Items[0].Id">
                                                 <summary>
                                                     <span>@group.Items.Count routine updates</span>
                                                     <small>@group.Items[^1].CreatedAtUtc.ToLocalTime().ToString("MMM d") - @group.Items[0].CreatedAtUtc.ToLocalTime().ToString("MMM d")</small>
                                                 </summary>
                                                 @foreach (var routineItem in group.Items)
                                                 {
                                                     <article class="@GetTimelineItemClass(routineItem)" @key="routineItem.Id">
                                                         <time>@routineItem.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</time>
                                                         <span class="trade-orders-timeline-dot"></span>
                                                         <div>
                                                             <div class="trade-orders-timeline-item-heading">
                                                                 <strong>@routineItem.Title</strong>
                                                                 <span>@FormatTimelineVisibility(routineItem.Visibility)</span>
                                                             </div>
                                                             <p>@routineItem.Detail</p>
                                                             <small>@routineItem.Actor</small>
                                                         </div>
                                                     </article>
                                                 }
                                             </details>
                                         }
                                         else
                                         {
                                             var item = group.Items[0];
                                             <article class="@GetTimelineItemClass(item)" @key="item.Id">
                                                 <time>@item.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</time>
                                                 <span class="trade-orders-timeline-dot"></span>
                                                 <div>
                                                     <div class="trade-orders-timeline-item-heading">
                                                         <strong>@item.Title</strong>
                                                         <span>@FormatTimelineImportance(item.Importance) - @FormatTimelineVisibility(item.Visibility)</span>
                                                     </div>
                                                     <p>@item.Detail</p>
                                                     <small>@item.Actor</small>
                                                 </div>
                                             </article>
                                         }
                                     }
                                 </div>
                                 <div class="trade-orders-timeline-composer">
                                     @if (HasCanonicalCommission)
                                     {
                                         <div class="trade-orders-timeline-visibility" role="group" aria-label="Choose timeline entry visibility">
                                             <button type="button"
                                                     class="@(_timelineComposerVisibility == CommissionTimelineVisibility.CompanyOnly ? "is-active" : string.Empty)"
                                                     aria-pressed="@(_timelineComposerVisibility == CommissionTimelineVisibility.CompanyOnly)"
                                                     @onclick="@(() => _timelineComposerVisibility = CommissionTimelineVisibility.CompanyOnly)">
                                                 Company only
                                             </button>
                                             <button type="button"
                                                     class="@(_timelineComposerVisibility == CommissionTimelineVisibility.Shared ? "is-active" : string.Empty)"
                                                     aria-pressed="@(_timelineComposerVisibility == CommissionTimelineVisibility.Shared)"
                                                     @onclick="@(() => _timelineComposerVisibility = CommissionTimelineVisibility.Shared)">
                                                 Share with crafter
                                             </button>
                                         </div>
                                     }
                                     <MudTextField @bind-Value="_timelineComment"
                                                   id="selected-order-timeline-comment"
                                                   Label="@(_timelineComposerVisibility == CommissionTimelineVisibility.Shared ? "Crafter update" : "Company note")"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Immediate="true"
                                                   Lines="2"
                                                   MaxLength="2000" />
                                     <div class="trade-orders-timeline-composer-actions">
                                         <MudButton Variant="Variant.Filled"
                                                    Color="Color.Primary"
                                                    OnClick="AddTimelineEntryAsync"
                                                    Disabled="@(_isCommissionCommandRunning || string.IsNullOrWhiteSpace(_timelineComment))">
                                             Add to Timeline
                                         </MudButton>
                                     </div>
                                 </div>
                             </MudTabPanel>
                             <MudTabPanel Text="Share">
                                @if (SelectedOrderConflict is not null)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                                        <div class="trade-orders-conflict-row">
                                            <span>
                                                This order changed in another client while local edits were pending.
                                                Review before any publication or claim action.
                                            </span>
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Warning"
                                                       Size="Size.Small"
                                                       Disabled="@(SelectedOrderConflict.CanKeepLocal == false)"
                                                       OnClick="KeepLocalOrderVersionAsync">
                                                Keep My Changes
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Warning"
                                                       Size="Size.Small"
                                                       OnClick="UseHostedOrderVersionAsync">
                                                Use Hosted Version
                                            </MudButton>
                                        </div>
                                    </MudAlert>
                                }
                                else if (IsSelectedOrderPending)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                        Saved on this device; hosted sync is still pending.
                                    </MudAlert>
                                }
                                @if (HasCanonicalCommission && SelectedCommissionOwner == null)
                                {
                                    @if (IsSelectedCommissionOwnerRefreshPending)
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                            Loading commission operations...
                                        </MudAlert>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">
                                            <MudText Typo="Typo.subtitle2">Company commission operations are unavailable.</MudText>
                                            <MudText Typo="Typo.body2">
                                                @(SelectedCommissionOperationsError ??
                                                  "The authenticated owner projection could not be loaded.")
                                            </MudText>
                                        </MudAlert>
                                    }
                                }
                                 @if (SelectedCommissionOwner is { } sharingOwner &&
                                      sharingOwner.Order.CompanyCommission is { } sharingCommission)
                                 {
                                     @if (sharingCommission.PublicMetadata.IsTestFixture)
                                     {
                                         <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3 trade-orders-test-commission-banner">
                                             <MudText Typo="Typo.subtitle2">Test commission - claiming disabled</MudText>
                                             <MudText Typo="Typo.body2">This projection exercises publication and update delivery without assigning work to a crafter.</MudText>
                                         </MudAlert>
                                     }
                                     <section class="trade-orders-sharing-card">
                                         <div class="trade-orders-operation-card-heading">
                                             <div>
                                                 <MudText Typo="Typo.subtitle2">Canonical Brief</MudText>
                                                 <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                     Terms v@(sharingCommission.CurrentTermsVersion) - owner revision @sharingOwner.ObjectRevision
                                                 </MudText>
                                             </div>
                                             <span class="@GetCompanyCommissionSharingChipClass(sharingOwner.Order, sharingCommission)">
                                                 @FormatCanonicalCommissionState(sharingOwner.Order, sharingCommission)
                                             </span>
                                         </div>
                                         <div class="trade-orders-sharing-grid">
                                             <div>
                                                 <span>Public brief</span>
                                                 <strong>@(sharingCommission.PublicMetadata.ViewState == CompanyCommissionPublicViewState.Published
                                                     ? sharingCommission.PublicMetadata.PublicUrl ?? sharingCommission.PublicMetadata.PublicBriefId
                                                     : "Not published")</strong>
                                                 <small>@(sharingCommission.PublicMetadata.ViewState == CompanyCommissionPublicViewState.Published
                                                     ? "Portable brief is live"
                                                     : "Draft terms only")</small>
                                             </div>
                                             <div>
                                                 <span>Claim slot</span>
                                                 <strong>@(sharingCommission.PublicMetadata.IsTestFixture
                                                     ? "Disabled for testing"
                                                     : sharingCommission.ActiveClaim == null ? "Open" : "Reserved")</strong>
                                                 <small>
                                                     @(sharingCommission.PublicMetadata.IsTestFixture
                                                         ? "No claim capability can be issued"
                                                         : sharingCommission.ActiveClaim == null
                                                         ? "One crafter may claim"
                                                         : FormatCanonicalCommissionClaimant(sharingCommission))
                                                 </small>
                                             </div>
                                             <div>
                                                 <span>Trade channel</span>
                                                 <strong>@(SelectedCompanyPublication?.State.ToString() ?? "Not delivered")</strong>
                                                 <small>@(SelectedCompanyPublication?.DestinationLabel ?? "Company routing")</small>
                                             </div>
                                         </div>
                                         @if (sharingCommission.PublicMetadata.ViewState == CompanyCommissionPublicViewState.Draft ||
                                              IsEditingCommissionTermsRevision)
                                         {
                                             <div class="trade-orders-collaboration-fields">
                                                 <MudTextField @bind-Value="_commissionContact"
                                                               id="canonical-commission-contact"
                                                               Label="Crafter contact"
                                                               Variant="Variant.Outlined"
                                                               Margin="Margin.Dense"
                                                               Immediate="true"
                                                               MaxLength="240"
                                                               Disabled="@_isCommissionCommandRunning" />
                                                 <MudTextField @bind-Value="_commissionDeliveryInstructions"
                                                               id="canonical-commission-delivery-instructions"
                                                               Label="Delivery instructions"
                                                               Variant="Variant.Outlined"
                                                               Margin="Margin.Dense"
                                                               Immediate="true"
                                                               Lines="2"
                                                               MaxLength="1000"
                                                               Disabled="@_isCommissionCommandRunning" />
                                             </div>
                                         }
                                         <div class="trade-orders-collaboration-actions">
                                             @if (sharingCommission.PublicMetadata.ViewState == CompanyCommissionPublicViewState.Draft ||
                                                  IsEditingCommissionTermsRevision)
                                             {
                                                 <MudButton Variant="Variant.Outlined"
                                                            Color="Color.Secondary"
                                                            StartIcon="@Icons.Material.Filled.Save"
                                                            Disabled="@(!HasCanonicalDraftDetailChanges || _isCommissionCommandRunning)"
                                                            OnClick="SaveCanonicalCommissionDraftDetailsAsync">
                                                     @(IsEditingCommissionTermsRevision ? "Stage Details" : "Save Details")
                                                 </MudButton>
                                                 @if (sharingCommission.PublicMetadata.ViewState == CompanyCommissionPublicViewState.Draft)
                                                 {
                                                     <MudButton Variant="Variant.Filled"
                                                                Color="Color.Primary"
                                                                StartIcon="@Icons.Material.Filled.Send"
                                                                Disabled="@(!CanPublishCanonicalCommissionToDiscord)"
                                                                OnClick="PublishCanonicalCommissionToDiscordAsync">
                                                         @(_isPublishingCommission ? "Publishing..." : "Publish to Company Channel")
                                                     </MudButton>
                                                     @if (!string.IsNullOrWhiteSpace(CanonicalDiscordPublishUnavailableReason))
                                                     {
                                                         <span class="trade-orders-collaboration-action-note">
                                                             @CanonicalDiscordPublishUnavailableReason
                                                         </span>
                                                     }
                                                 }
                                             }
                                             else if (sharingCommission.PublicMetadata.ViewState == CompanyCommissionPublicViewState.Published &&
                                                      HasLiveCommissionPublication)
                                             {
                                                 <MudButton Variant="Variant.Filled"
                                                            Color="Color.Primary"
                                                            StartIcon="@Icons.Material.Filled.OpenInNew"
                                                            OnClick="OpenCommissionBriefAsync">
                                                     View Brief
                                                 </MudButton>
                                                 <MudButton Variant="Variant.Outlined"
                                                            Color="Color.Secondary"
                                                            StartIcon="@Icons.Material.Filled.ContentCopy"
                                                            OnClick="CopyCommissionLinkAsync">
                                                     Copy Public Link
                                                 </MudButton>
                                                 @if (SelectedCompanyPublication?.PublicId is { Length: > 0 })
                                                 {
                                                     <MudButton Variant="Variant.Outlined"
                                                                Color="Color.Secondary"
                                                                StartIcon="@Icons.Material.Filled.Refresh"
                                                                Disabled="@_isReconcilingDiscordPublication"
                                                                OnClick="ReconcileSelectedCommissionToDiscordAsync">
                                                         @(_isReconcilingDiscordPublication ? "Refreshing..." : "Refresh Discord Brief")
                                                     </MudButton>
                                                 }
                                             }
                                             @if (!sharingCommission.PublicMetadata.IsTestFixture &&
                                                  sharingCommission.ActiveClaim == null &&
                                                  sharingCommission.PublicMetadata.ViewState ==
                                                  CompanyCommissionPublicViewState.Published &&
                                                  sharingOwner.Order.Status is not
                                                      (TradeOrderStatus.Completed or TradeOrderStatus.Canceled))
                                             {
                                                 <MudButton Variant="Variant.Outlined"
                                                            Color="Color.Secondary"
                                                            Disabled="@_isCommissionCommandRunning"
                                                            OnClick="CopyCommissionClaimLinkAsync">
                                                     Copy Claim Link
                                                 </MudButton>
                                             }
                                             else if (sharingCommission.ActiveClaim != null)
                                             {
                                                 <MudButton Variant="Variant.Outlined"
                                                            Color="Color.Secondary"
                                                            Disabled="@_isCommissionCommandRunning"
                                                            OnClick="RecoverCommissionParticipantAsync">
                                                     Issue Recovery Link
                                                 </MudButton>
                                             }
                                             @if (sharingCommission.PublicMetadata.ViewState ==
                                                  CompanyCommissionPublicViewState.Published)
                                             {
                                                 <MudButton Variant="Variant.Text"
                                                            Color="Color.Error"
                                                            Disabled="@_isCommissionCommandRunning"
                                                            OnClick="RevokeCanonicalCommissionPublicationAsync">
                                                     Revoke Public Access
                                                 </MudButton>
                                             }
                                         </div>
                                     </section>

                                     @if (!string.IsNullOrWhiteSpace(SelectedCommissionNotificationError))
                                     {
                                         <MudAlert Severity="Severity.Warning" Dense="true">
                                             @SelectedCommissionNotificationError
                                         </MudAlert>
                                     }

                                     @if (SelectedCommissionNotificationDiagnostics.Count > 0)
                                     {
                                         <section class="trade-orders-sharing-card">
                                             <MudText Typo="Typo.subtitle2">Delivery Diagnostics</MudText>
                                             <div class="trade-orders-notification-diagnostics">
                                                 @foreach (var diagnostic in SelectedCommissionNotificationDiagnostics)
                                                 {
                                                     <div class="trade-orders-notification-diagnostic"
                                                          @key="diagnostic.DiagnosticId">
                                                         <div>
                                                             <strong>@diagnostic.Summary</strong>
                                                             <span>@diagnostic.RecommendedAction</span>
                                                         </div>
                                                         @if (diagnostic.CanRetry)
                                                         {
                                                             <MudButton Variant="Variant.Text"
                                                                        Color="Color.Warning"
                                                                        Size="Size.Small"
                                                                        Disabled="@(_retryingCommissionDiagnosticId.HasValue)"
                                                                        OnClick="@(() => RetryCommissionNotificationAsync(diagnostic))">
                                                                 @(_retryingCommissionDiagnosticId == diagnostic.DiagnosticId
                                                                     ? "Requeuing"
                                                                     : "Retry")
                                                             </MudButton>
                                                         }
                                                     </div>
                                                 }
                                             </div>
                                         </section>
                                     }
                                 }
                                @if (SelectedCommissionOwner == null &&
                                     SelectedCompanyPublication is { } companyPublication)
                                {
                                    <section class="@GetCompanyPublicationClass(companyPublication)">
                                        <div class="trade-orders-section-heading">
                                            <div>
                                                <MudText Typo="Typo.subtitle2">
                                                    @FormatCompanyPublicationDestination(companyPublication)
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @(companyPublication.Message ??
                                                      $"Updated {companyPublication.UpdatedAtUtc.ToLocalTime():yyyy-MM-dd HH:mm}.")
                                                </MudText>
                                            </div>
                                            <span class="@GetCompanyPublicationChipClass(companyPublication)">
                                                @companyPublication.State
                                            </span>
                                        </div>
                                    </section>
                                }
                                @if (SelectedCommissionOwner == null &&
                                     HasLiveCommissionPublication &&
                                     !HasFailedCompanyPublication)
                                {
                                    var publication = _selectedOrder.CommissionPublication!;
                                    @if (publication.IsTestFixture)
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3 trade-orders-test-commission-banner">
                                            <MudText Typo="Typo.subtitle2">Test commission - claiming disabled</MudText>
                                            <MudText Typo="Typo.body2">This brief verifies publication rendering only. It cannot be claimed or assigned.</MudText>
                                        </MudAlert>
                                    }
                                    <section class="trade-orders-collaboration-state is-live">
                                        <div class="trade-orders-section-heading">
                                            <div>
                                                <MudText Typo="Typo.subtitle2">Published commission</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    Crafter brief version @publication.Version is live.
                                                </MudText>
                                            </div>
                                            <span class="trade-orders-publication-chip is-live">Live</span>
                                        </div>
                                    </section>
                                    <div class="trade-orders-published-link">
                                        <code>@(publication.PublicUrl ?? $"Commission {publication.PublicId}")</code>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   OnClick="CopyCommissionLinkAsync">
                                            Copy
                                        </MudButton>
                                    </div>
                                    <div class="trade-orders-visibility">
                                        <div><strong>Published</strong><span>@publication.PublishedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span><b>v@(publication.Version)</b></div>
                                        <div><strong>Payment snapshot</strong><span>@FormatGil(paymentSummary.TotalPayment)</span><b>Locked</b></div>
                                        <div><strong>Pricing evidence</strong><span>@FormatCommissionLocation(_selectedOrder.SourceSnapshot)</span><b>Locked</b></div>
                                        <div><strong>Crafter access</strong><span>@(publication.IsTestFixture ? "Read-only test brief" : "No account or CA workflow required")</span><b>@(publication.IsTestFixture ? "No claims" : "Open link")</b></div>
                                    </div>
                                    <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">
                                        Repricing this order will not silently alter the published terms. Publish a replacement only when both sides agree to new terms.
                                    </MudAlert>
                                    <div class="trade-orders-collaboration-actions">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.OpenInNew"
                                                   OnClick="OpenCommissionBriefAsync">
                                            View Crafter Brief
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Secondary"
                                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                                   OnClick="CopyCommissionLinkAsync">
                                            Copy Link
                                        </MudButton>
                                        @if (SelectedCompanyPublication?.PublicId is { Length: > 0 })
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       StartIcon="@Icons.Material.Filled.Refresh"
                                                       Disabled="@_isReconcilingDiscordPublication"
                                                       OnClick="ReconcileSelectedCommissionToDiscordAsync">
                                                @(_isReconcilingDiscordPublication ? "Refreshing..." : "Refresh Discord Brief")
                                            </MudButton>
                                        }
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Error"
                                                   Disabled="@_isRevokingCommission"
                                                   OnClick="RevokeSelectedCommissionAsync">
                                            @(_isRevokingCommission ? "Revoking..." : "Revoke Link")
                                        </MudButton>
                                    </div>
                                }
                                else if (SelectedCommissionOwner == null &&
                                         !HasActiveCompanyPublication)
                                {
                                    <section class="trade-orders-collaboration-state">
                                        <div class="trade-orders-section-heading">
                                            <div>
                                                <MudText Typo="Typo.subtitle2">
                                                    @(HasFailedCompanyPublication
                                                        ? "Trade channel delivery needs attention"
                                                        : "Private order")
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @(HasFailedCompanyPublication
                                                        ? "The crafter brief is fixed, but the configured channel did not accept it. Retry the same delivery without creating another commission."
                                                        : "Publish a crafter-facing brief without sharing this workspace, internal notes, or the mutable Craft Architect plan.")
                                                </MudText>
                                            </div>
                                            <span class="trade-orders-publication-chip">
                                                @(HasFailedCompanyPublication ? "Not delivered" : "Not published")
                                            </span>
                                        </div>
                                    </section>
                                    <div class="trade-orders-visibility">
                                        <div><strong>Requested delivery</strong><span>Item, quantity, and quality</span><b>Included</b></div>
                                        <div><strong>Payment terms</strong><span>@FormatGil(paymentSummary.TotalPayment)</span><b>Included</b></div>
                                        <div><strong>Material responsibility</strong><span>Crafter and company responsibility groups</span><b>Included</b></div>
                                        <div><strong>Evidence identity</strong><span>Scope, basis, and captured time</span><b>Included</b></div>
                                        <div class="is-private"><strong>Internal notes</strong><span>Operator-only planning notes</span><b>Private</b></div>
                                        <div class="is-private"><strong>Full craft plan</strong><span>Never required for the crafter</span><b>Private</b></div>
                                    </div>
                                    @if (!HasFailedCompanyPublication)
                                    {
                                        <div class="trade-orders-collaboration-fields">
                                            <MudTextField @bind-Value="_commissionContact"
                                                          id="commission-contact"
                                                          Label="Commission contact"
                                                          HelperText="Discord username or reply method shown to the crafter; defaults from company settings"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Immediate="true"
                                                          MaxLength="240" />
                                            <MudTextField @bind-Value="_commissionDeliveryInstructions"
                                                          id="commission-delivery-instructions"
                                                          Label="Crafter-facing delivery note"
                                                          HelperText="Internal order notes remain private"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Immediate="true"
                                                          Lines="2"
                                                          MaxLength="1000" />
                                        </div>
                                    }
                                    @if (!_isPublishingCommission &&
                                         PublishCommissionUnavailableReason is { } unavailableReason)
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                            @unavailableReason
                                        </MudAlert>
                                    }
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               Class="mt-3"
                                               StartIcon="@Icons.Material.Filled.Share"
                                               Disabled="@(!CanPublishCommission)"
                                               OnClick="PublishSelectedCommissionAsync">
                                        @(_isPublishingCommission ? "Publishing..." : PublishCommissionButtonLabel)
                                    </MudButton>
                                }
                            </MudTabPanel>
                        </MudTabs>
                    }
                </aside>
        </div>
    }
</div>

@code {
    private RenderFragment<TradeOrderProcurementRow> RenderProcurementSourceCell => row => @<div class="trade-orders-source-cell">
        @if (CanEditProcurementSource(row))
        {
            <select class="trade-orders-procurement-select"
                    aria-label="@($"{row.ItemName} procurement route")"
                    value="@row.Source.ToString()"
                    @onchange="args => ChangeProcurementRowSourceValueAsync(row, args.Value?.ToString())">
                @foreach (var source in GetProcurementSourceOptions(row))
                {
                    <option value="@source.ToString()"
                            disabled="@(source == AcquisitionSource.Craft && row.Responsibility == CommissionMaterialResponsibility.Provided)"
                            selected="@(source == row.Source)">@RecipePlanDisplayHelpers.GetSourceDisplayName(source)</option>
                }
            </select>
        }
        else
        {
            <strong class="trade-orders-source-locked">@row.SourceLabel</strong>
        }
        <div class="trade-orders-procurement-route-actions">
            <button type="button"
                    @onclick="@(() => OpenMarketAnalysisForProcurementRowAsync(row))">
                Market
            </button>
            <button type="button"
                    @onclick="@(() => OpenAcquisitionEvaluationForProcurementRowAsync(row))">
                Compare routes
            </button>
        </div>
    </div>;

    private RenderFragment<TradeOrderProcurementRow> RenderProcurementCostCell => row => @<div class="trade-orders-procurement-cost-cell">
        <strong>@(row.Responsibility == CommissionMaterialResponsibility.Provided || row.Source == AcquisitionSource.OnHand
            ? FormatGilAllowZero(0)
            : FormatGil(row.TotalCost))</strong>
        <span>
            @(row.Responsibility == CommissionMaterialResponsibility.Provided
                ? row.TotalCost > 0
                    ? $"{FormatGil(row.TotalCost)} company value"
                    : "Company provided"
                : row.Source == AcquisitionSource.OnHand
                    ? row.TotalCost > 0
                        ? $"{FormatGil(row.TotalCost)} material value"
                        : "Replacement value unavailable"
                    : row.UnitCost > 0
                        ? $"{FormatGil(row.UnitCost)} each"
                        : row.UnitCostExplanation)
        </span>
    </div>;

    private RenderFragment<TradeOrderProcurementRow> RenderProcurementResponsibilityCell => row => @<div class="trade-orders-procurement-responsibility-cell">
        @if (HasCanonicalCommission && !CanEditCanonicalWorkPackage)
        {
            <strong title="Create a terms revision before changing a published commission supply plan.">@FormatResponsibility(row.Responsibility)</strong>
        }
        else
        {
            <select class="trade-orders-procurement-select"
                    aria-label="@($"{row.ItemName} responsibility")"
                    value="@row.Responsibility.ToString()"
                    disabled="@(IsSelectedOrderArchived || _isCommissionCommandRunning)"
                    @onchange="args => ChangeProcurementRowResponsibilityValueAsync(row, args.Value?.ToString())">
                <option value="@CommissionMaterialResponsibility.Crafter.ToString()"
                        selected="@(row.Responsibility == CommissionMaterialResponsibility.Crafter)">Crafter supplies</option>
                <option value="@CommissionMaterialResponsibility.Provided.ToString()"
                        selected="@(row.Responsibility == CommissionMaterialResponsibility.Provided)">Company supplies</option>
            </select>
        }
    </div>;
}
