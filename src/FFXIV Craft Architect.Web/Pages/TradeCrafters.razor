@page "/trade/crafters"
@using FFXIV_Craft_Architect.Web.Shared
@using FFXIV_Craft_Architect.Web.Shared.Workforce
@inject AppState AppState
@inject TradeOperationsPersistenceService TradeOperationsPersistence
@inject FFXIV_Craft_Architect.Web.Services.ProfileHosting.ProfileSyncService ProfileSync
@inject FFXIV_Craft_Architect.Web.Services.ProfileHosting.ProfileSyncLocalStateService ProfileSyncLocalState
@inject ILodestoneCrafterLookupService LodestoneCrafterLookup
@inject TradeCrafterProfileImportMapper LodestoneImportMapper
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@using FFXIV_Craft_Architect.Web.Services.TradeCompany
@inject CompanyHubClient CompanyHubs
@inject TradeWorkspaceProfileResolver WorkspaceProfiles
@implements IDisposable

<div class="trade-crafters-page">
    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error" Class="ma-4">
            <MudText Typo="Typo.subtitle2">Trade operations storage is unavailable.</MudText>
            <MudText Typo="Typo.body2">@_loadError</MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Class="mt-2"
                       OnClick="LoadAsync">
                Retry
            </MudButton>
        </MudAlert>
    }
    else
    {
        <header class="workforce-header">
            <div class="workforce-heading">
                @if (_companyProfile != null)
                {
                    <span class="workforce-company">@_companyProfile.Name</span>
                }
                <h1>Company workforce</h1>
            </div>
            <div class="workforce-header-actions">
                @if (_isAdmin)
                {
                    <button type="button" class="workforce-button is-quiet" @onclick="() => OpenDrawer(WorkforceDrawerKind.Requests)">
                        Review requests <span class="workforce-count">@RequestedRows.Count</span>
                    </button>
                    <button type="button" class="workforce-button" @onclick="() => OpenInvite(null)">
                        Invite crafter
                        @if (OpenInvitationCount > 0)
                        {
                            <span class="workforce-count" title="Open invitations">@OpenInvitationCount</span>
                        }
                    </button>
                }
                @if (CanEditRecords)
                {
                    <button type="button" class="workforce-button is-primary" @onclick="OpenNewRecord">Add contractor</button>
                }
            </div>
        </header>

        <div class="workforce-toolbar">
            <input type="search"
                   class="workforce-search"
                   aria-label="Search company workforce"
                   placeholder="Search people, characters, or worlds"
                   value="@_search"
                   @oninput="args => _search = args.Value?.ToString() ?? string.Empty" />
            <div class="workforce-segmented" role="group" aria-label="Relationship filter">
                @foreach (var filter in Enum.GetValues<CompanyWorkforceFilter>())
                {
                    <button type="button"
                            class="@(_filter == filter ? "is-active" : null)"
                            aria-pressed="@(_filter == filter ? "true" : "false")"
                            @onclick="() => _filter = filter">
                        @filter @_rows.Count(row => row.Matches(filter))
                    </button>
                }
            </div>
            <span class="workforce-spacer"></span>
            @if (CanEditRecords)
            {
                <button type="button" class="workforce-button is-small is-quiet" @onclick="() => OpenLodestone(null)">Import from Lodestone</button>
            }
        </div>

        <div class="workforce-table-wrap">
            @if (!_hasLoaded)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            <table class="workforce-table">
                <thead>
                    <tr>
                        <th scope="col">Person</th>
                        <th scope="col">Relationship</th>
                        <th scope="col">Company access</th>
                        <th scope="col">Connected history</th>
                        <th scope="col">Current work</th>
                        <th scope="col"><span class="workforce-visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in VisibleRows)
                    {
                        <tr @key="row.Key">
                            <td>
                                <div class="workforce-person">
                                    @if (!string.IsNullOrWhiteSpace(row.AvatarUrl))
                                    {
                                        <img class="workforce-avatar" src="@row.AvatarUrl" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="workforce-avatar" aria-hidden="true">@Initial(row.DisplayName)</span>
                                    }
                                    <div>
                                        <strong>@row.DisplayName</strong>
                                        @if (!string.IsNullOrWhiteSpace(row.Secondary))
                                        {
                                            <span>@row.Secondary</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><WorkforceRelationshipPill Row="row" /></td>
                            <td><WorkforceAccessStatus Access="row.Access" /></td>
                            <td>
                                @if (FormatHistory(row) is { } history)
                                {
                                    <span>@history</span>
                                }
                                else
                                {
                                    <span class="workforce-muted">No connected history</span>
                                }
                            </td>
                            <td>
                                @if (row.ActiveOrders.Count == 0)
                                {
                                    <span class="workforce-muted">None</span>
                                }
                                else
                                {
                                    <span>@row.ActiveOrders.Count.ToString("N0") active</span>
                                }
                            </td>
                            <td class="workforce-row-actions">
                                @RowActions(row)
                            </td>
                        </tr>
                    }
                    @if (_hasLoaded && VisibleRows.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="workforce-empty">
                                @(_rows.Count == 0 ? "No members or contractors yet." : "No one matches this search.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="workforce-summary">
            <span><strong>@_rows.Count(row => row.AccountProfileId.HasValue && row.Access == CompanyWorkforceAccess.Active)</strong> authenticated members</span>
            <span><strong>@_rows.Count(row => !row.IsMemberSide)</strong> external contractors</span>
            @if (_isAdmin)
            {
                <span><strong>@RequestedRows.Count</strong> pending requests</span>
            }
        </div>

        <WorkforceDrawer Open="@(_drawer == WorkforceDrawerKind.Record && (_selectedCrafter != null || CanEditRecords))"
                         OnClose="CloseDrawer"
                         Title="@(_selectedCrafter?.DisplayName ?? "Add contractor")"
                         Eyebrow="@(_selectedCrafter == null ? "Company workforce" : RecordEyebrow(_selectedCrafter.Id))"
                         Wide="@(_selectedCrafter != null)">
            <ChildContent>
                @if (_selectedCrafter == null)
                {
                    <div class="workforce-form-grid">
                        <MudTextField @bind-Value="_newCrafterName"
                                      id="new-crafter-name"
                                      Label="Display name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                        <CompactSelectField Id="new-crafter-region"
                                            Label="Region"
                                            Value="@_newCrafterRegion"
                                            ValueChanged="SetNewCrafterRegion"
                                            Options="RegionOptions" />
                        <CompactSelectField Id="new-crafter-data-center"
                                            Label="Data center"
                                            Value="@_newCrafterDataCenter"
                                            ValueChanged="SetNewCrafterDataCenter"
                                            Options="GetDataCenterOptions(_newCrafterRegion)" />
                        <CompactSelectField Id="new-crafter-world"
                                            Label="World"
                                            Value="@_newCrafterWorld"
                                            ValueChanged="SetNewCrafterWorld"
                                            Options="GetWorldOptions(_newCrafterDataCenter)" />
                    </div>
                }
                else
                {
                    <section class="workforce-drawer-section">
                        <div class="workforce-form-grid">
                            <MudTextField @bind-Value="_detailName"
                                          id="crafter-detail-name"
                                          Label="Display name"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="@(!CanEditRecords)"
                                          Immediate="true" />
                            <MudTextField @bind-Value="_detailAlias"
                                          id="crafter-detail-alias"
                                          Label="Alias"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="@(!CanEditRecords)" />
                            <MudTextField @bind-Value="_detailContact"
                                          id="crafter-detail-contact"
                                          Label="General contact"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="@(!CanEditRecords)" />
                            <MudTextField @bind-Value="_detailDiscordHandle"
                                          id="crafter-detail-discord"
                                          Label="Discord"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="@(!CanEditRecords)" />
                            <MudTextField @bind-Value="_detailSocialProfileUrl"
                                          id="crafter-detail-social-profile"
                                          Label="Social/profile URL"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="@(!CanEditRecords)" />
                            <CompactSelectField Id="detail-region"
                                                Label="Region"
                                                Value="@_detailRegion"
                                                ValueChanged="SetDetailRegion"
                                                Disabled="@(!CanEditRecords)"
                                                Options="RegionOptions" />
                            <CompactSelectField Id="detail-data-center"
                                                Label="Data center"
                                                Value="@_detailDataCenter"
                                                ValueChanged="SetDetailDataCenter"
                                                Disabled="@(!CanEditRecords)"
                                                Options="GetDataCenterOptions(_detailRegion)" />
                            <CompactSelectField Id="detail-world"
                                                Label="World"
                                                Value="@_detailWorld"
                                                ValueChanged="SetDetailWorld"
                                                Disabled="@(!CanEditRecords)"
                                                Options="GetWorldOptions(_detailDataCenter)" />
                        </div>
                        @if (HasLodestoneFlair(_selectedCrafter))
                        {
                            <div class="trade-crafter-lodestone-flair">
                                @if (!string.IsNullOrWhiteSpace(_selectedCrafter.LodestonePortraitUrl) ||
                                     !string.IsNullOrWhiteSpace(_selectedCrafter.LodestoneAvatarUrl))
                                {
                                    <img src="@(_selectedCrafter.LodestonePortraitUrl ?? _selectedCrafter.LodestoneAvatarUrl)"
                                         alt=""
                                         loading="lazy" />
                                }
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Lodestone</MudText>
                                    @if (!string.IsNullOrWhiteSpace(_selectedCrafter.LodestoneProfileUrl))
                                    {
                                        <MudLink Href="@_selectedCrafter.LodestoneProfileUrl"
                                                 Target="_blank"
                                                 Typo="Typo.body2">
                                            Open profile
                                        </MudLink>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(FormatLodestoneIdentity(_selectedCrafter)))
                                    {
                                        <MudText Typo="Typo.body2">@FormatLodestoneIdentity(_selectedCrafter)</MudText>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_selectedCrafter.LodestoneFreeCompanyName))
                                    {
                                        <MudText Typo="Typo.body2">@_selectedCrafter.LodestoneFreeCompanyName</MudText>
                                    }
                                    @if (_selectedCrafter.LodestoneLastSyncedAtUtc != null)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Synced @_selectedCrafter.LodestoneLastSyncedAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd h:mm tt")
                                        </MudText>
                                    }
                                </div>
                            </div>
                        }
                        <MudTextField @bind-Value="_detailPaymentNotes"
                                      id="crafter-detail-payment-notes"
                                      Label="Payment notes"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="@(!CanEditRecords)"
                                      Lines="2" />
                        <MudTextField @bind-Value="_detailOperatorNotes"
                                      id="crafter-detail-operator-notes"
                                      Label="Operator notes"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="@(!CanEditRecords)"
                                      Lines="2" />
                    </section>

                    <section class="workforce-drawer-section">
                        <h3>Crafting job levels</h3>
                        <div class="trade-crafter-jobs">
                            @foreach (var job in Enum.GetValues<TradeCraftingJob>())
                            {
                                <MudNumericField T="int"
                                                 id="@($"crafter-job-level-{job}")"
                                                 Value="@GetJobLevel(job)"
                                                 ValueChanged="value => SetJobLevel(job, value)"
                                                 Label="@FormatJob(job)"
                                                 Min="0"
                                                 Max="100"
                                                 HideSpinButtons="true"
                                                 ReadOnly="@(!CanEditRecords)"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            }
                        </div>
                    </section>

                    <section class="workforce-drawer-section">
                        <h3>Current assignments</h3>
                        <WorkforceOrderList Orders="GetAssignmentsForSelectedCrafter()" OnOpenOrder="OpenOrderAssignment" />
                    </section>
                }
            </ChildContent>
            <Actions>
                @if (_selectedCrafter == null && CanEditRecords)
                {
                    <button type="button"
                            class="workforce-button is-primary"
                            aria-label="Create contractor"
                            disabled="@string.IsNullOrWhiteSpace(_newCrafterName)"
                            @onclick="CreateCrafterAsync">
                        Create contractor
                    </button>
                }
                else if (_selectedCrafter != null && CanEditRecords)
                {
                    <button type="button" class="workforce-button is-quiet" @onclick="() => OpenLodestone(_selectedCrafter.Id)">Update from Lodestone</button>
                    <button type="button"
                            class="workforce-button is-primary"
                            disabled="@string.IsNullOrWhiteSpace(_detailName)"
                            @onclick="SaveSelectedCrafterAsync">
                        Save contractor
                    </button>
                }
            </Actions>
        </WorkforceDrawer>

        <WorkforceDrawer Open="@(_drawer == WorkforceDrawerKind.Lodestone && CanEditRecords)"
                         OnClose="CloseLodestone"
                         Title="@(_lodestoneTarget == null ? "Import from Lodestone" : $"Update {_lodestoneTarget.DisplayName}")"
                         Eyebrow="Lodestone"
                         Wide="true">
            <div class="trade-crafters-lodestone-search-row">
                <MudTextField @bind-Value="_lodestoneSearchName"
                              id="lodestone-character-name"
                              Label="Character name"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true" />
                <CompactSelectField Id="lodestone-search-scope"
                                    Label="Search scope"
                                    Value="@_lodestoneSearchScope.ToString()"
                                    ValueChanged="SetLodestoneSearchScope"
                                    Options="LodestoneSearchScopeOptions" />
                @if (_lodestoneSearchScope == LodestoneSearchScope.SpecificWorld)
                {
                    <CompactSelectField @key="_lodestoneSearchScope"
                                        Id="lodestone-search-world"
                                        Label="World"
                                        Value="@_lodestoneSearchWorld"
                                        ValueChanged="SetLodestoneSearchWorld"
                                        Options="GetLodestoneSearchWorldOptions()" />
                }
                else
                {
                    <CompactValueField @key="_lodestoneSearchScope"
                                       Label="Location"
                                       Value="@GetLodestoneSearchScopeSummary()" />
                }
                <button type="button"
                        class="workforce-button is-primary"
                        aria-label="Search Lodestone"
                        disabled="@(_lodestoneIsBusy || string.IsNullOrWhiteSpace(_lodestoneSearchName) || IsLodestoneSearchLocationMissing())"
                        @onclick="SearchLodestoneAsync">
                    Search
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_lodestoneError))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_lodestoneError</MudAlert>
            }
            @if (_lodestoneCandidates.Count > 0)
            {
                <div class="trade-crafters-lodestone-results">
                    @foreach (var candidate in _lodestoneCandidates)
                    {
                        <button type="button"
                                class="trade-crafters-lodestone-result"
                                @onclick="@(() => PreviewLodestoneCandidateAsync(candidate))">
                            <span>@candidate.DisplayName</span>
                            <small>@FormatLodestoneCandidateLocation(candidate) @candidate.LodestoneCharacterId</small>
                        </button>
                    }
                </div>
            }
            @if (_lodestonePreview != null)
            {
                <div class="trade-crafters-lodestone-preview">
                    <div class="trade-crafters-lodestone-preview-heading">
                        <strong>@_lodestonePreview.DisplayName</strong>
                        <span>@FormatPreviewLocation(_lodestonePreview)</span>
                    </div>
                    <span>@FormatImportedJobSummary(_lodestonePreview)</span>
                    @if (!string.IsNullOrWhiteSpace(_lodestonePreview.FreeCompanyName))
                    {
                        <span>@_lodestonePreview.FreeCompanyName</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(FormatLodestonePreviewIdentity(_lodestonePreview)))
                    {
                        <span>@FormatLodestonePreviewIdentity(_lodestonePreview)</span>
                    }
                    <div class="trade-crafters-lodestone-actions">
                        @if (_lodestoneTarget == null)
                        {
                            <button type="button"
                                    class="workforce-button is-primary"
                                    disabled="@_lodestoneIsBusy"
                                    @onclick="CreateCrafterFromLodestoneAsync">
                                Add as contractor
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="workforce-button is-primary"
                                    disabled="@_lodestoneIsBusy"
                                    @onclick="UpdateSelectedCrafterFromLodestoneAsync">
                                Update @_lodestoneTarget.DisplayName
                            </button>
                        }
                    </div>
                </div>
            }
        </WorkforceDrawer>

        @if (_isAdmin && _hostedCompanyId != null)
        {
            @* One drawer instance per company: an in-flight multi-step action or unsubmitted selection
               must never resume against a different company after a switch. Keys stay unique per sibling. *@
            <WorkforceMemberDrawer @key="@($"member:{_hostedCompanyId}")"
                                   CompanyId="@_hostedCompanyId"
                                   ViewerRole="@(_hub?.Standing.Role ?? string.Empty)"
                                   Row="@(_drawer == WorkforceDrawerKind.Member ? _rows.FirstOrDefault(row => row.Key == _memberRowKey) : null)"
                                   AvailableRecords="AvailableRecords"
                                   RecordNames="RecordNames"
                                   OnClose="CloseDrawer"
                                   OnChanged="RefreshHostedAsync"
                                   OnOpenRecord="OpenRecord"
                                   OnOpenOrder="OpenOrderAssignment" />
            <WorkforceRequestsDrawer @key="@($"requests:{_hostedCompanyId}")"
                                     Open="@(_drawer == WorkforceDrawerKind.Requests)"
                                     CompanyId="@_hostedCompanyId"
                                     Requests="RequestedRows"
                                     AvailableRecords="AvailableRecords"
                                     RecordNames="RecordNames"
                                     OnClose="CloseDrawer"
                                     OnChanged="RefreshHostedAsync" />
            <WorkforceInviteDrawer @key="@($"invite:{_hostedCompanyId}")"
                                   Open="@(_drawer == WorkforceDrawerKind.Invite)"
                                   CompanyId="@_hostedCompanyId"
                                   PreselectedRecordId="_invitePreselect"
                                   AvailableRecords="InvitableRecords"
                                   Invitations="@(_hosted?.Invitations ?? [])"
                                   OnClose="CloseDrawer"
                                   OnChanged="RefreshHostedAsync" />
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "company")] private string? Company { get; set; }
    private TradeCompanyProfile? _companyProfile;
    private CompanyHubProjection? _hub;
    private string? _hostedCompanyId;
    private bool _isAdmin;
    private CompanyWorkforceHostedFacts? _hosted;
    private IReadOnlyList<CompanyWorkforceRow> _rows = [];
    private CompanyWorkforceFilter _filter = CompanyWorkforceFilter.Everyone;
    private string _search = string.Empty;
    private WorkforceDrawerKind _drawer;
    private string? _memberRowKey;
    private Guid? _invitePreselect;
    private TradeCrafterProfile? _lodestoneTarget;
    private List<TradeCrafterProfile> _crafters = [];
    private List<TradeOrder> _orders = [];
    private TradeCrafterProfile? _selectedCrafter;
    private bool _hasLoaded;
    private string _newCrafterName = string.Empty;
    private string _newCrafterRegion = string.Empty;
    private string _newCrafterDataCenter = string.Empty;
    private string _newCrafterWorld = string.Empty;
    private string _detailName = string.Empty;
    private string? _detailAlias;
    private string? _detailContact;
    private string? _detailDiscordHandle;
    private string? _detailSocialProfileUrl;
    private string _detailRegion = string.Empty;
    private string _detailWorld = string.Empty;
    private string _detailDataCenter = string.Empty;
    private string? _detailPaymentNotes;
    private string? _detailOperatorNotes;
    private Dictionary<TradeCraftingJob, int> _jobLevels = [];
    private string? _loadError;
    private string _lodestoneSearchName = string.Empty;
    private LodestoneSearchScope _lodestoneSearchScope = LodestoneSearchScope.EntireRegion;
    private string _lodestoneSearchWorld = string.Empty;
    private bool _lodestoneIsBusy;
    private string? _lodestoneError;
    private IReadOnlyList<LodestoneCrafterSearchCandidate> _lodestoneCandidates = [];
    private LodestoneCrafterImportPreview? _lodestonePreview;
    private static readonly IReadOnlyList<string> TradeRegions = ["North America", "Europe", "Japan", "Oceania"];
    private static readonly IReadOnlyList<CompactSelectOption> LodestoneSearchScopeOptions =
    [
        new(LodestoneSearchScope.EntireRegion.ToString(), "Entire region"),
        new(LodestoneSearchScope.SelectedDataCenter.ToString(), "Selected data center"),
        new(LodestoneSearchScope.SpecificWorld.ToString(), "Specific world")
    ];
    private static readonly IReadOnlyList<CompactSelectOption> RegionOptions =
        TradeRegions.Select(ToOption).ToArray();

    // Local-only companies stay fully editable. Hosted companies are editable only for an
    // active owner/operator; crafter-role, pending/revoked viewers and a hosted company whose
    // hub did not load get a read-only view.
    private bool CanEditRecords => _companyProfile != null && (!_isHostedCompany || _isAdmin);

    private IReadOnlyList<CompanyCrafterBinding> CrafterBindings =>
        _hosted?.Migration?.Bindings.Select(binding => new CompanyCrafterBinding(binding.LegacyCrafterId, binding.AccountProfileId)).ToArray()
        ?? _hosted?.Bindings
        ?? [];

    // Invitations not tied to a record are not people yet; they live in the Invite drawer.
    private int OpenInvitationCount => (_hosted?.Invitations ?? []).Count(invitation => invitation.State == "active");

    private IReadOnlyList<CompanyWorkforceRow> RequestedRows => _rows
        .Where(row => row.Relationship == CompanyWorkforceRelationship.Requested && row.Member != null)
        .ToArray();

    private IReadOnlyList<LegacyCrafterCandidate> AvailableRecords => (_hosted?.Migration?.LegacyCrafters ?? [])
        .Where(candidate => CrafterBindings.All(binding => binding.LegacyCrafterId != candidate.LegacyCrafterId))
        .OrderBy(candidate => candidate.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    // Contractor records can be invited even when a non-member account is already bound to
    // them (a Discord claimant); only a member's own records are excluded.
    private IReadOnlyList<LegacyCrafterCandidate> InvitableRecords => (_hosted?.Migration?.LegacyCrafters ?? [])
        .Where(candidate => !_rows.Any(row => row.IsMemberSide && row.RecordIds.Contains(candidate.LegacyCrafterId)))
        .OrderBy(candidate => candidate.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private IReadOnlyDictionary<Guid, string> RecordNames
    {
        get
        {
            var names = new Dictionary<Guid, string>();
            foreach (var candidate in _hosted?.Migration?.LegacyCrafters ?? [])
            {
                names[candidate.LegacyCrafterId] = candidate.DisplayName;
            }

            foreach (var crafter in _crafters)
            {
                names[crafter.Id] = crafter.DisplayName;
            }

            return names;
        }
    }

    private IReadOnlyList<CompanyWorkforceRow> VisibleRows => _rows
        .Where(row => row.Matches(_filter) && MatchesSearch(row))
        .ToArray();

    private RenderFragment RowActions(CompanyWorkforceRow row) => __builder =>
    {
        if (_isAdmin && row.Relationship == CompanyWorkforceRelationship.Requested)
        {
            <button type="button" class="workforce-button is-small is-blue" @onclick="() => OpenDrawer(WorkforceDrawerKind.Requests)">Review</button>
        }
        else if (_isAdmin && row.Member != null)
        {
            <button type="button" class="workforce-button is-small is-quiet" @onclick="() => OpenMember(row)">Manage</button>
        }
        else if (row.RecordIds.Count > 0)
        {
            var recordId = row.RecordIds[0];
            if (_isAdmin && row.Relationship == CompanyWorkforceRelationship.Contractor && InvitableRecords.Any(candidate => candidate.LegacyCrafterId == recordId))
            {
                <button type="button" class="workforce-button is-small is-blue" @onclick="() => OpenInvite(recordId)">Invite to join</button>
            }
            else if (_isAdmin && row.Invitation != null)
            {
                <button type="button" class="workforce-button is-small is-quiet" @onclick="() => OpenInvite(null)">Invitation</button>
            }
            <button type="button" class="workforce-button is-small is-quiet" @onclick="() => OpenRecord(recordId)">Open</button>
        }
    };

    private bool MatchesSearch(CompanyWorkforceRow row)
    {
        var term = _search.Trim();
        if (term.Length == 0)
        {
            return true;
        }

        var haystack = new List<string?> { row.DisplayName, row.Secondary };
        foreach (var recordId in row.RecordIds)
        {
            var record = _crafters.FirstOrDefault(crafter => crafter.Id == recordId);
            haystack.Add(RecordNames.GetValueOrDefault(recordId));
            haystack.AddRange([record?.Alias, record?.WorldName, record?.DataCenter, record?.LodestoneFreeCompanyName]);
        }

        return haystack.Any(value => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true);
    }

    private static string? FormatHistory(CompanyWorkforceRow row)
    {
        var parts = new List<string>();
        if (row.CommissionCount > 0)
        {
            parts.Add(row.CommissionCount == 1 ? "1 commission" : $"{row.CommissionCount:N0} commissions");
        }

        if (row.HasCharacterProfile)
        {
            parts.Add(row.RecordIds.Count == 1 ? "character profile" : $"{row.RecordIds.Count:N0} character profiles");
        }

        if (parts.Count == 0)
        {
            return null;
        }

        var text = string.Join(" · ", parts);
        return char.ToUpperInvariant(text[0]) + text[1..];
    }

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

