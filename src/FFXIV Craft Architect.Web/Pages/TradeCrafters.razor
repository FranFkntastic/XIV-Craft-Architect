    protected override void OnInitialized()
    {
        AppState.OnStateChanged += OnAppStateChanged;
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private void OnAppStateChanged(AppStateChange change)
    {
        if (!change.HasScope(AppStateChangeScope.Settings))
        {
            return;
        }

        _hasLoaded = false;
        _ = InvokeAsync(EnsureLoadedAsync);
    }

    private async Task EnsureLoadedAsync()
    {
        if (_hasLoaded)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        await ReloadAsync();
        _hasLoaded = string.IsNullOrWhiteSpace(_loadError);
        await InvokeAsync(StateHasChanged);
    }

    // Loads can overlap (parameter set, settings change, the ?company= replace navigation).
    // Each load captures its company and generation and only the newest one applies.
    private int _loadGeneration;
    private Task? _activeLoad;
    private Guid? _loadedCompanyId;
    private bool _isHostedCompany;

    private async Task LoadAsync()
    {
        var load = LoadCoreAsync(++_loadGeneration);
        _activeLoad = load;
        await load;
    }

    // Reload after a mutation and wait for whichever load ends up current.
    private async Task ReloadAsync()
    {
        await LoadAsync();
        while (_activeLoad is { IsCompleted: false } pending)
        {
            await pending;
        }
    }

    private async Task LoadCoreAsync(int generation)
    {
        try
        {
            await ProfileSync.SyncNowAsync();
            var profile = await TradeCompanyContext.ResolveAsync(TradeOperationsPersistence, CompanyHubs, Company);
            if (generation != _loadGeneration)
            {
                return;
            }

            if (!string.IsNullOrWhiteSpace(Company))
            {
                // The query has been applied to the workspace selector; drop it so a later
                // company switch is not overridden by a stale ?company= on reload.
                Company = null;
                NavigationManager.NavigateTo("trade/crafters", replace: true);
            }

            var hosted = await LoadHostedFactsAsync(profile);
            var crafters = (await TradeOperationsPersistence.LoadCraftersAsync(profile.Id)).ToList();
            var orders = (await TradeOperationsPersistence.LoadOrdersAsync(profile.Id)).ToList();
            if (generation != _loadGeneration)
            {
                return;
            }

            if (_loadedCompanyId != profile.Id)
            {
                ResetDrawerState();
            }

            _loadError = null;
            _loadedCompanyId = profile.Id;
            _companyProfile = profile;
            ApplyHostedLoad(hosted);
            var selectedCrafterId = _selectedCrafter?.Id;
            _crafters = crafters;
            _selectedCrafter = _crafters.FirstOrDefault(crafter => crafter.Id == selectedCrafterId);
            _orders = orders;
            RebuildRows();
            EnsureNewCrafterLocationDefaults();
            _hasLoaded = true;
        }
        catch (Exception ex)
        {
            if (generation != _loadGeneration)
            {
                return;
            }

            _hasLoaded = false;
            _companyProfile = null;
            _loadedCompanyId = null;
            ApplyHostedLoad(HostedLoad.None);
            _crafters = [];
            _orders = [];
            _rows = [];
            ResetDrawerState();
            _loadError = ex.Message;
            Snackbar.Add("Trade operations storage is unavailable.", Severity.Error);
        }
    }

    // Closes every drawer and forgets everything a drawer could act on, so nothing opened for
    // one company can create, invite or edit in another.
    private void ResetDrawerState()
    {
        _drawer = WorkforceDrawerKind.None;
        _memberRowKey = null;
        _invitePreselect = null;
        _lodestoneTarget = null;
        _lodestonePreview = null;
        _lodestoneCandidates = [];
        _lodestoneError = null;
        _selectedCrafter = null;
        _jobLevels = [];
        _newCrafterName = string.Empty;
    }

    private async Task RefreshHostedAsync()
    {
        var generation = _loadGeneration;
        var profile = _companyProfile;
        if (profile == null)
        {
            return;
        }

        var hosted = await LoadHostedFactsAsync(profile);
        if (generation != _loadGeneration || _companyProfile?.Id != profile.Id)
        {
            return;
        }

        ApplyHostedLoad(hosted);
        RebuildRows();
        StateHasChanged();
    }

    private void RebuildRows() =>
        _rows = CompanyWorkforceProjection.Build(_crafters, _orders, _hosted);

    private void ApplyHostedLoad(HostedLoad load)
    {
        _hub = load.Hub;
        _isHostedCompany = load.IsHostedCompany;
        _isAdmin = load.IsAdmin;
        _hostedCompanyId = load.IsAdmin ? load.CompanyId : null;
        _hosted = load.Facts;
    }

    private sealed record HostedLoad(
        string? CompanyId,
        CompanyHubProjection? Hub,
        bool IsHostedCompany,
        bool IsAdmin,
        CompanyWorkforceHostedFacts? Facts)
    {
        public static HostedLoad None { get; } = new(null, null, false, false, null);
    }

    private async Task<HostedLoad> LoadHostedFactsAsync(TradeCompanyProfile profile)
    {
        var companyId = profile.Id.ToString("D");
        CompanyHubProjection? hub;
        try
        {
            hub = await CompanyHubs.LoadWorkspaceHubAsync(profile.Id);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException or System.Text.Json.JsonException)
        {
            Console.Error.WriteLine(
                $"[TradeCrafters] Company hub unavailable for company {companyId}; " +
                $"showing contractor records only. {ex.GetType().Name}: {ex.Message}");
            hub = null;
        }

        var isHosted = await IsHostedCompanyAsync(profile, hub);
        if (isHosted && hub is not { Kind: "hub" })
        {
            Console.Error.WriteLine(
                $"[TradeCrafters] Hosted company {companyId} has no active hub standing for this viewer; " +
                "contractor records are read-only until the hub loads.");
        }

        // Membership administration (requests, invitations, bindings) is Owner/Operator only;
        // crafter-role members would get 403s from every manager endpoint.
        var isAdmin = hub is { Kind: "hub", Standing.State: "active", Standing.Role: "owner" or "operator" };
        if (hub is not { Kind: "hub" })
        {
            return new HostedLoad(companyId, hub, isHosted, false, null);
        }

        if (!isAdmin)
        {
            // The member list comes from the hub roster; active members may also read the
            // record/account pairs so a member's own contractor record folds into their row.
            // On failure rows stay separate.
            var memberBindings = hub.Standing?.State == "active"
                ? await TryLoadAsync(companyId, "account bindings", () => CompanyHubs.LoadCrafterBindingsAsync(companyId))
                : null;
            return new HostedLoad(
                companyId,
                hub,
                isHosted,
                false,
                new CompanyWorkforceHostedFacts(HubRoster: hub.Roster ?? [], Bindings: memberBindings));
        }

        var membersTask = TryLoadAsync(companyId, "members", () => CompanyHubs.LoadCompanyMembersAsync(companyId));
        var requestsTask = TryLoadAsync(companyId, "membership requests", () => CompanyHubs.LoadPendingMembershipsAsync(companyId));
        var invitationsTask = TryLoadAsync(companyId, "invitations", () => CompanyHubs.LoadMembershipInvitationsAsync(companyId));
        var migrationTask = TryLoadAsync(companyId, "account bindings", () => CompanyHubs.LoadLegacyCrafterMigrationAsync(companyId));
        await Task.WhenAll(membersTask, requestsTask, invitationsTask, migrationTask);
        return new HostedLoad(
            companyId,
            hub,
            isHosted,
            true,
            new CompanyWorkforceHostedFacts(
                await membersTask,
                hub.Roster ?? [],
                await requestsTask,
                await invitationsTask,
                await migrationTask));
    }

    // A company is hosted when the host answered for it, when it is the hub transient copy, or
    // when dev host-first workspace resolution says so. If the host is unreachable, synced
    // company-profile provenance decides; unknown provenance fails closed. Local-only
    // companies (never hosted, or no Profile Hosting connection) stay fully editable.
    private async Task<bool> IsHostedCompanyAsync(TradeCompanyProfile profile, CompanyHubProjection? hub)
    {
        if (hub != null ||
            profile.SyncState != TradeSyncState.LocalOnly ||
            !string.IsNullOrWhiteSpace(profile.RemoteId))
        {
            return true;
        }

        try
        {
            // Dev's canonical host-first resolution: the host's workspace profile decides.
            return (await WorkspaceProfiles.ResolveAsync(profile.Id)).IsHosted;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException or System.Text.Json.JsonException)
        {
            Console.Error.WriteLine(
                $"[TradeCrafters] Host workspace profile unavailable for company {profile.Id:D}; " +
                $"falling back to local sync provenance. {ex.GetType().Name}: {ex.Message}");
        }

        try
        {
            var connection = await ProfileSyncLocalState.LoadConnectionSettingsAsync();
            return connection.IsConfigured &&
                   await ProfileSyncLocalState.HasKnownHostedObjectAsync(
                       ProfileSyncCollections.TradeCompanyProfiles,
                       profile.Id.ToString("D"));
        }
        catch (Exception ex) when (ex is InvalidOperationException or Microsoft.JSInterop.JSException)
        {
            // Unknown provenance: fail closed rather than grant edits on a possibly hosted company.
            Console.Error.WriteLine(
                $"[TradeCrafters] Could not confirm whether company {profile.Id:D} is hosted; " +
                $"treating contractor records as read-only. {ex.GetType().Name}: {ex.Message}");
            return true;
        }
    }

    private static async Task<T?> TryLoadAsync<T>(string companyId, string label, Func<Task<T>> load) where T : class
    {
        try
        {
            return await load();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException or System.Text.Json.JsonException)
        {
            Console.Error.WriteLine(
                $"[TradeCrafters] Company {label} unavailable for company {companyId}; " +
                $"workforce rows omit them. {ex.GetType().Name}: {ex.Message}");
            return null;
        }
    }

    private async Task<bool> SaveCrafterAsync(TradeCrafterProfile crafter)
    {
        if (!await TradeOperationsPersistence.SaveCrafterAsync(crafter))
        {
            return false;
        }

        await ProfileSync.QueueLocalSaveAsync(
            ProfileSyncCollections.TradeCrafters,
            crafter.Id.ToString("D"));
        return true;
    }

    private async Task CreateCrafterAsync()
    {
        if (!CanEditRecords)
        {
            return;
        }

        if (_companyProfile == null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_newCrafterName))
        {
            Snackbar.Add("Contractor display name is required.", Severity.Warning);
            return;
        }

        var now = DateTime.UtcNow;
        var crafter = new TradeCrafterProfile
        {
            Id = Guid.NewGuid(),
            CompanyProfileId = _companyProfile.Id,
            DisplayName = _newCrafterName.Trim(),
            DataCenter = NormalizeOptionalText(_newCrafterDataCenter),
            WorldName = NormalizeOptionalText(_newCrafterWorld),
            CreatedAtUtc = now,
            UpdatedAtUtc = now
        };

        var saved = await SaveCrafterAsync(crafter);
        if (!saved)
        {
            Snackbar.Add("Failed to save contractor.", Severity.Error);
            return;
        }

        _newCrafterName = string.Empty;
        await ReloadAsync();
        if (!string.IsNullOrWhiteSpace(_loadError) ||
            !SelectCrafterAfterReload(crafter.Id, "Contractor was saved, but it could not be loaded."))
        {
            return;
        }

        Snackbar.Add("Contractor added", Severity.Success);
    }

    private async Task SearchLodestoneAsync()
    {
        _lodestoneIsBusy = true;
        _lodestoneError = null;
        _lodestonePreview = null;
        try
        {
            var worldName = _lodestoneSearchScope == LodestoneSearchScope.SpecificWorld
                ? NormalizeOptionalText(_lodestoneSearchWorld)
                : null;
            var dataCenter = _lodestoneSearchScope == LodestoneSearchScope.SelectedDataCenter
                ? GetDefaultDataCenter()
                : null;
            var region = _lodestoneSearchScope == LodestoneSearchScope.EntireRegion
                ? GetDefaultRegion()
                : null;
            var result = await LodestoneCrafterLookup.SearchAsync(new LodestoneCrafterSearchRequest(
                _lodestoneSearchName,
                worldName,
                dataCenter,
                region));

            if (!result.Succeeded || result.Value == null)
            {
                _lodestoneCandidates = [];
                _lodestoneError = result.ErrorMessage ?? "Lodestone search failed.";
                return;
            }

            _lodestoneCandidates = result.Value;
            if (_lodestoneCandidates.Count == 0)
            {
                _lodestoneError = $"No Lodestone characters matched that {GetLodestoneSearchScopeSummary().ToLowerInvariant()} search.";
            }
        }
        finally
        {
            _lodestoneIsBusy = false;
        }
    }

    private async Task PreviewLodestoneCandidateAsync(LodestoneCrafterSearchCandidate candidate)
    {
        _lodestoneIsBusy = true;
        _lodestoneError = null;
        try
        {
            var result = await LodestoneCrafterLookup.GetImportPreviewAsync(candidate.LodestoneCharacterId);
            if (!result.Succeeded || result.Value == null)
            {
                _lodestonePreview = null;
                _lodestoneError = result.ErrorMessage ?? "Lodestone preview failed.";
                return;
            }

            _lodestonePreview = EnrichPreviewLocation(result.Value);
        }
        finally
        {
            _lodestoneIsBusy = false;
        }
    }

    private async Task CreateCrafterFromLodestoneAsync()
    {
        if (!CanEditRecords)
        {
            return;
        }

        if (_companyProfile == null || _lodestonePreview == null)
        {
            return;
        }

        var crafter = LodestoneImportMapper.CreateProfile(_companyProfile.Id, _lodestonePreview);
        var saved = await SaveCrafterAsync(crafter);
        if (!saved)
        {
            Snackbar.Add("Failed to save Lodestone contractor.", Severity.Error);
            return;
        }

        await ReloadAsync();
        if (_loadError != null ||
            !SelectCrafterAfterReload(crafter.Id, "Contractor imported, but it could not be loaded."))
        {
            return;
        }

        _lodestoneTarget = null;
        _drawer = WorkforceDrawerKind.Record;
        Snackbar.Add("Contractor imported from Lodestone", Severity.Success);
    }

    private async Task UpdateSelectedCrafterFromLodestoneAsync()
    {
        if (!CanEditRecords)
        {
            return;
        }

        if (_companyProfile == null ||
            _lodestoneTarget == null ||
            _lodestoneTarget.CompanyProfileId != _companyProfile.Id ||
            _lodestonePreview == null)
        {
            return;
        }

        var crafter = LodestoneImportMapper.UpdateProfile(_lodestoneTarget, _lodestonePreview);
        var saved = await SaveCrafterAsync(crafter);
        if (!saved)
        {
            Snackbar.Add("Failed to update contractor from Lodestone.", Severity.Error);
            return;
        }

        await ReloadAsync();
        if (_loadError != null ||
            !SelectCrafterAfterReload(crafter.Id, "Contractor updated, but it could not be loaded."))
        {
            return;
        }

        _lodestoneTarget = null;
        _drawer = WorkforceDrawerKind.Record;
        Snackbar.Add("Contractor updated from Lodestone", Severity.Success);
    }

    private void SelectCrafter(TradeCrafterProfile crafter)
    {
        _selectedCrafter = crafter;
        _detailName = crafter.DisplayName;
        _detailAlias = crafter.Alias;
        _detailContact = crafter.ContactHandle;
        _detailDiscordHandle = crafter.DiscordHandle;
        _detailSocialProfileUrl = crafter.SocialProfileUrl;
        _detailDataCenter = string.IsNullOrWhiteSpace(crafter.DataCenter)
            ? GetDefaultDataCenter()
            : crafter.DataCenter;
        _detailRegion = MarketFetchScopeResolver.ResolveRegionForDataCenter(_detailDataCenter, GetDefaultRegion());
        _detailWorld = IsWorldInDataCenter(crafter.WorldName, _detailDataCenter) ? crafter.WorldName! : string.Empty;
        _detailPaymentNotes = crafter.PaymentNotes;
        _detailOperatorNotes = crafter.OperatorNotes;
        _jobLevels = crafter.JobLevels.ToDictionary(level => level.Job, level => level.Level);
    }

    private bool SelectCrafterAfterReload(Guid crafterId, string missingMessage)
    {
        var reloadedCrafter = _crafters.FirstOrDefault(crafter => crafter.Id == crafterId);
        if (reloadedCrafter == null)
        {
            _selectedCrafter = null;
            _jobLevels = [];
            _drawer = WorkforceDrawerKind.None;
            Snackbar.Add(missingMessage, Severity.Warning);
            return false;
        }

        SelectCrafter(reloadedCrafter);
        return true;
    }

    private async Task SaveSelectedCrafterAsync()
    {
        if (!CanEditRecords)
        {
            return;
        }

        if (_companyProfile == null ||
            _selectedCrafter == null ||
            _selectedCrafter.CompanyProfileId != _companyProfile.Id ||
            string.IsNullOrWhiteSpace(_detailName))
        {
            return;
        }

        var crafterId = _selectedCrafter.Id;
        var crafterToSave = CopyCrafter(_selectedCrafter);
        crafterToSave.DisplayName = _detailName.Trim();
        crafterToSave.Alias = NormalizeOptionalText(_detailAlias);
        crafterToSave.ContactHandle = NormalizeOptionalText(_detailContact);
        crafterToSave.DiscordHandle = NormalizeOptionalText(_detailDiscordHandle);
        crafterToSave.SocialProfileUrl = NormalizeOptionalText(_detailSocialProfileUrl);
        crafterToSave.WorldName = NormalizeOptionalText(_detailWorld);
        crafterToSave.DataCenter = NormalizeOptionalText(_detailDataCenter);
        crafterToSave.PaymentNotes = _detailPaymentNotes;
        crafterToSave.OperatorNotes = _detailOperatorNotes;
        crafterToSave.UpdatedAtUtc = DateTime.UtcNow;
        crafterToSave.JobLevels = _jobLevels
            .Where(pair => pair.Value > 0)
            .OrderBy(pair => pair.Key)
            .Select(pair => new TradeCraftingJobLevel(pair.Key, pair.Value))
            .ToArray();

        var saved = await SaveCrafterAsync(crafterToSave);
        if (!saved)
        {
            Snackbar.Add("Failed to save contractor.", Severity.Error);
            return;
        }

        await ReloadAsync();
        if (!string.IsNullOrWhiteSpace(_loadError) ||
            !SelectCrafterAfterReload(crafterId, "Contractor was saved, but it could not be loaded."))
        {
            return;
        }

        Snackbar.Add("Contractor saved", Severity.Success);
    }

    private int GetJobLevel(TradeCraftingJob job)
    {
        return _jobLevels.TryGetValue(job, out var level) ? level : 0;
    }

