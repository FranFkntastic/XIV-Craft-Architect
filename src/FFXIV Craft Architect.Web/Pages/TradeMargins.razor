@page "/trade/margins"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Rendering
@using Franthropy.Web.Icons
@using FFXIV_Craft_Architect.Web.Shared.TablePrimitives
@using FFXIV_Craft_Architect.Web.Services.TradeCompany
@using FFXIV_Craft_Architect.Web.Services.ProfileHosting
@inject TradeOperationsPersistenceService Persistence
@inject TradeWorkspaceProfileResolver Profiles
@inject CompanyHubClient Hubs
@inject ProfileSyncService Sync
@inject IGarlandService Garland
@inject TradeMarginCalculator Calculator
@inject ISettingsService Settings
@inject AppState AppState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<TradeMargins> Log
@implements IAsyncDisposable

<div class="margins-backdrop @(_glass ? "franthropy-glass-backdrop" : null)">
<div class="trade-margins-page">
    <header class="margins-header"><span>@_profile?.Name</span><h1>Margins</h1></header>
    <div class="@Glass("card")">
    <div class="margins-toolbar @Glass("toolbar")">
        <div class="add-item">
            <input type="search" aria-label="Add item" placeholder="Add item" autocomplete="off"
                   value="@_search" disabled="@(_rows.Count >= 500)" @oninput="SearchAsync" @onkeydown="SearchKeyAsync"
                   aria-expanded="@(_matches.Count > 0)" aria-controls="margin-results" />
            @if (_matches.Count > 0 && _rows.Count < 500)
            {
                <div id="margin-results" class="add-results @Glass("dropdown")" role="listbox" aria-label="Items">
                    @foreach (var match in _matches)
                    {
                        <button type="button" role="option" aria-selected="@(match == _matches[_activeMatch])"
                                @onclick="() => AddAsync(match)">
                            <ItemIcon IconId="@match.Object.IconId" Name="@match.Object.Name" />
                            @match.Object.Name
                        </button>
                    }
                </div>
            }
        </div>
        <span class="toolbar-spacer"></span>
        <button type="button" class="margin-button" disabled="@Refreshing" @onclick="RefreshAsync">@(Refreshing ? "Refreshing…" : "↻ Refresh prices")</button>
    </div>
    <div @ref="_tableWrap" class="margins-table-wrap @Glass("table")">
        <WebDataTable TItem="MarginRow" TColumnId="Column" Items="@SortedRows" Columns="@Columns"
                      SortState="@_sort" SortChanged="value => _sort = value" GetRowKey="row => row.ItemId.ToString()"
                      IsRowExpanded="row => _expanded.Contains(row.ItemId) && row.Breakdown != null"
                      ExpandedContent="row => builder => RenderMaterials(builder, row)">
            <EmptyContent>No items yet.</EmptyContent>
        </WebDataTable>
    </div>
    <footer class="margins-summary @Glass("footer")">
        <span><strong>@_rows.Count</strong> @(_rows.Count == 1 ? "item" : "items")</span>
        @if (_lastCheckedUtc is { } checkedAt) { <span title="@checkedAt.ToLocalTime().ToString("f")">checked @(RelativeAge(checkedAt) == "now" ? "just now" : RelativeAge(checkedAt) + " ago")</span> }
        <span><strong>@(_profile == null ? "—" : Rate.ToString("N0"))</strong> gil per synth</span>
        @if (_profile?.CommissionPricingScope is { } scope)
        {
            <span><strong>@scope.DataCenter</strong> · @scope.Region</span>
        }
    </footer>
    </div>
</div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "company")] public string? Company { get; set; }
    private TradeCompanyProfile? _profile;
    private long? _revision;
    private bool _hosted, _glass = true, _disposed;
    private DateTime? _lastCheckedUtc;
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _ageLoop;
    private string _search = "";
    private int _searchGeneration, _activeMatch;
    private int? _editingSale;
    private string? _loadedCompany;
    private bool _loaded;
    private List<GarlandSearchResult> _matches = [];
    private List<MarginRow> _rows = [];
    private readonly Dictionary<int, string> _itemNames = [];
    private readonly SemaphoreSlim _gate = new(1);
    private ElementReference _tableWrap;
    private IJSObjectReference? _module;
    private WebTableSortState<Column> _sort = WebTableSortState<Column>.Unsorted;
    // Per-session view state: expanded rows, materials whose Set price is chosen but not yet
    // typed, and the unit cost being typed (kept through hosted syncs and re-renders).
    private readonly HashSet<int> _expanded = [];
    private readonly HashSet<int> _pendingSetPrice = [];
    private int? _editingPrice;
    private string _priceDraft = "";
    private string? _focusPrice;
    // The batch size being typed, kept through hosted syncs and background repricing.
    private int? _editingBatch;
    private string _batchDraft = "";
    // Background price update: one job at a time. Rows in _forceFetch refetch every pair
    // (Refresh prices); other rows refetch only pairs older than the Margins reuse window.
    private readonly HashSet<int> _forceFetch = [];
    private CancellationTokenSource? _priceJob;
    private (Guid? Company, TradeCompanyPricingScope? Scope) _priceJobScope;
    private bool _priceAgain;
    private bool Refreshing => _forceFetch.Count > 0;
    private decimal Rate => _profile == null ? 0 : TradePaymentPolicyNormalizer.Normalize(_profile.PaymentPolicy).LaborGilPerSynth;
    private TradeMarginPricing Pricing => new(Rate, _profile?.MaterialSources ?? []);
    private string? Glass(string surface) => _glass ? $"franthropy-glass-{surface}" : null;
    private enum Column { Item, Sale, Batch, Materials, Labor, Total, Margin, Percent, Age, Commission, Remove }
    private sealed class MarginRow(int itemId, long? sale)
    {
        public int ItemId { get; } = itemId;
        public long? Sale { get; set; } = sale;
        public long? SavedSale { get; set; } = sale;
        public int Batch { get; set; } = 1;
        public string ItemName { get; set; } = "Item";
        public TradeMarginCost? Cost { get; set; }
        public TradeMarginBreakdown? Breakdown { get; set; }
        public TradeMarginCalculator.PreparedRow? Plan { get; set; }
        /// <summary>Market data this row is priced from, by item and data center.</summary>
        public Dictionary<(int itemId, string dataCenter), CachedMarketData>? Market { get; set; }
        public string Name => Cost?.Name ?? ItemName;
    }
    // Calculator costs the whole production run; every displayed figure is per unit sold.
    private static decimal? PerUnit(MarginRow row, decimal? batch) => batch / Math.Max(1, row.Cost?.Units ?? 1);
    private decimal? Materials(MarginRow row) => PerUnit(row, row.Cost?.Materials);
    private decimal? Labor(MarginRow row) => PerUnit(row, row.Cost?.Synths * Rate);
    private decimal? Total(MarginRow row) => Materials(row) is { } materials && Labor(row) is { } labor ? materials + labor : null;
    private decimal? MarginGil(MarginRow row) => row.Sale is { } sale && Total(row) is { } total ? sale - total : null;
    private decimal? Percent(MarginRow row) => row.Sale > 0 && MarginGil(row) is { } margin ? margin / row.Sale * 100 : null;
    private static string Number(decimal? value) => value?.ToString("N0") ?? "—";
    private string Sign(MarginRow row) => MarginGil(row) < 0 ? "is-loss" : "is-gain";
    private object? SortValue(MarginRow row) => _sort.Column switch
    {
        Column.Item => row.Name, Column.Sale => row.SavedSale, Column.Batch => row.Batch, Column.Materials => Materials(row),
        Column.Labor => Labor(row), Column.Total => Total(row), Column.Margin => row.SavedSale - Total(row),
        Column.Percent => row.SavedSale > 0 ? (row.SavedSale - Total(row)) / row.SavedSale * 100 : null,
        Column.Age => row.Cost?.OldestPriceUtc, _ => null
    };
    private IReadOnlyList<MarginRow> SortedRows => _sort.Column == null ? _rows :
        (_sort.Descending ? _rows.OrderBy(row => SortValue(row) == null).ThenByDescending(SortValue)
            : _rows.OrderBy(row => SortValue(row) == null).ThenBy(SortValue)).ToArray();
    private IReadOnlyList<WebTableColumn<MarginRow, Column>> Columns =>
    [
        new() { Id = Column.Item, Header = "Item", Size = new(268), CellTemplate = row => @<div class="item-cell">@if (row.Cost?.Basis != null) { <button type="button" class="expander" aria-expanded="@(_expanded.Contains(row.ItemId) ? "true" : "false")" aria-label="@(row.Name + " materials")" @onclick="() => ToggleExpandedAsync(row)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" /></svg></button> } else { <span class="expander-space"></span> }<ItemIcon IconId="@(row.Cost?.IconId ?? 0)" Name="@row.Name" /><span title="@row.Name">@row.Name</span></div> },
new() { Id = Column.Sale, Header = "Sale price", Size = new(132), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<input class="sale-input" inputmode="numeric" maxlength="19" aria-label="@(row.Name + " sale price")" value="@(_editingSale == row.ItemId ? row.Sale?.ToString(CultureInfo.InvariantCulture) : row.Sale?.ToString("N0", CultureInfo.InvariantCulture))" @onfocus="() => _editingSale = row.ItemId" @onblur="() => _editingSale = null" @oninput="e => PreviewSale(row, e)" @onchange="() => SaveSaleAsync(row)" /> },
        new() { Id = Column.Batch, Header = "Batch", Size = new(84), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<input class="batch-input" inputmode="numeric" maxlength="4" autocomplete="off" aria-label="@(row.Name + " batch size")" value="@(_editingBatch == row.ItemId ? _batchDraft : row.Batch.ToString(CultureInfo.InvariantCulture))" @onfocus="() => BeginBatch(row)" @oninput="e => PreviewBatch(row, e)" @onblur="() => CommitBatchAsync(row.ItemId)" @onkeydown="e => BatchKeyAsync(e, row.ItemId)" /> },
        new() { Id = Column.Materials, Header = "Materials", Size = new(150), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<span>@if (row.Cost?.Issue is { } issue) { <span class="missing">@issue</span> } else if (row.Cost?.Missing.Count > 0) { <span class="missing">@string.Join(", ", row.Cost.Missing) unpriced</span> } else { @Number(Materials(row)) }</span> },
        new() { Id = Column.Labor, Header = "Labor", Size = new(160), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<span>@Number(Labor(row))<span class="sub">@(row.Cost?.Synths is { } synths ? SynthCount(synths, row.Cost.Units) : "")</span></span> },
        WebTableColumn<MarginRow, Column>.Text(Column.Total, "Total cost", row => Number(Total(row)), 116, alignEnd: true, headerCssClass: "is-align-end"),
        new() { Id = Column.Margin, Header = "Margin", Size = new(110), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellCssClassSelector = Sign, CellTemplate = row => @<span>@Number(MarginGil(row))</span> },
        new() { Id = Column.Percent, Header = "Margin %", Size = new(84), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellCssClassSelector = Sign, CellTemplate = row => @<span>@(Percent(row) is { } percent ? $"{percent:N1}%" : "—")</span> },
        new() { Id = Column.Age, Header = "Prices", Size = new(74, 50), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<span class="age @(row.Cost?.UnknownPriceAge == true || row.Cost?.OldestPriceUtc <= DateTime.UtcNow.AddDays(-1) ? "is-stale" : null)" title="@AgeTitle(row)">@Age(row)</span> },
        new() { Id = Column.Commission, Header = "", Size = new(44, 44), Sortable = false, CellTemplate = row => @<button type="button" class="commission-btn" title="@("Create commission for " + row.Name)" aria-label="@("Create commission for " + row.Name)" @onclick="() => CreateCommission(row)"><MudIcon Icon="@Icons.Material.Filled.PostAdd" Size="Size.Small" /></button> },
        new() { Id = Column.Remove, Header = "", Size = new(44, 44), Sortable = false, CellTemplate = row => @<button type="button" class="remove-btn" aria-label="@("Remove " + row.Name)" @onclick="() => RemoveAsync(row)">×</button> }
    ];

    private void RenderMaterials(RenderTreeBuilder __builder, MarginRow row)
    {
        var breakdown = row.Breakdown!;
        var costs = LineCosts(row, breakdown);
        var sold = breakdown.Lines.First(line => line.IsSoldItem);
        var precrafts = breakdown.Lines.Where(line => !line.IsSoldItem && line.IsCraftable).ToArray();
        var materials = breakdown.Lines.Where(line => !line.IsCraftable).ToArray();
        <div class="margin-detail">
            <table class="margin-materials" aria-label="@(row.Name + " materials")">
                <colgroup><col /><col style="width:104px" /><col style="width:260px" /><col style="width:150px" /><col style="width:150px" /></colgroup>
                <thead><tr><th>Material</th><th class="is-align-end">Per unit sold</th><th>Source</th><th class="is-align-end">Unit cost</th><th class="is-align-end">Cost</th></tr></thead>
                <tbody>
                    <tr>
                        <td><div class="material-cell"><ItemIcon IconId="@sold.IconId" Name="@sold.Name" /><span title="@sold.Name">@sold.Name</span></div></td>
                        <td class="is-align-end">@Quantity(sold, breakdown)</td>
                        <td>Craft</td>
                        <td class="is-align-end"><span class="blank">—</span></td>
                        <td class="is-align-end">@Number(costs.GetValueOrDefault(sold.ItemId))<span class="sub">@Synths(sold, breakdown)</span></td>
                    </tr>
                    @if (precrafts.Length > 0)
                    {
                        <tr class="group"><td colspan="5">Precrafts</td></tr>
                        @foreach (var line in precrafts) { RenderLine(__builder, row, breakdown, line, costs); }
                    }
                    @if (materials.Length > 0)
                    {
                        <tr class="group"><td colspan="5">Materials</td></tr>
                        @foreach (var line in materials) { RenderLine(__builder, row, breakdown, line, costs); }
                    }
                </tbody>
            </table>
        </div>
    }

    private void RenderLine(RenderTreeBuilder __builder, MarginRow row, TradeMarginBreakdown breakdown, TradeMarginLine line,
        IReadOnlyDictionary<int, decimal?> costs)
    {
        var route = DisplayedRoute(line);
        var market = line.Options.FirstOrDefault(option => option.Route == TradeMaterialRoute.Market);
        <tr @key="line.ItemId">
            <td><div class="material-cell"><ItemIcon IconId="@line.IconId" Name="@line.Name" /><span title="@line.Name">@line.Name</span></div></td>
            <td class="is-align-end">@Quantity(line, breakdown)</td>
            <td>
                <div class="material-source">
                    <ListboxPicker Items="@RouteItems(line, breakdown)" Value="@route.ToString()"
                                   ValueChanged="@(value => ChooseRouteAsync(row, line, value))"
                                   AriaLabel="@(line.Name + " source")" TriggerClass="material-source-picker" />
                    @if (line.DefaultDelta is { } delta && _editingPrice != line.ItemId)
                    {
                        <span class="override-delta" title="Total cost vs. default source">@Signed(delta / breakdown.Units)</span>
                    }
                    @if (line.IsExplicit)
                    {
                        <button type="button" class="reset-btn" title="@($"Reset {line.Name} to default")"
                                aria-label="@($"Reset {line.Name} to default")" @onclick="() => ResetSourceAsync(line.ItemId)">×</button>
                    }
                </div>
            </td>
            <td class="is-align-end">
                @if (route == TradeMaterialRoute.SetPrice)
                {
                    <input class="set-price-input" inputmode="numeric" maxlength="19" autocomplete="off"
                           data-price-key="@($"{row.ItemId}-{line.ItemId}")" aria-label="@(line.Name + " unit cost")"
                           value="@(_editingPrice == line.ItemId ? _priceDraft : StoredPrice(line)?.ToString("N0", CultureInfo.InvariantCulture))"
                           @onfocus="() => BeginPrice(line)" @oninput="e => PreviewPrice(line, e)"
                           @onblur="() => CommitPriceAsync(line.ItemId)" @onkeydown="e => PriceKeyAsync(e, line.ItemId)" />
                }
                else if (route == TradeMaterialRoute.Craft && line.Synths > 0)
                {
                    <span class="blank">—</span>
                }
                else if (route == TradeMaterialRoute.Market && line.UnitCost == null && market != null)
                {
                    <span class="short-listed">@ShortOfListings(market)</span>
                }
                else if (line.UnitCost is { } unit)
                {
                    @unit.ToString("N0")
                    @if (route == TradeMaterialRoute.Market && market is { IsShortOfListings: true }) { <span class="sub short-listed">@ShortOfListings(market)</span> }
                    else if (route == TradeMaterialRoute.Market && market?.ObservedAtUtc is { } observed) { <span class="sub">@RelativeAge(observed)</span> }
                }
                else
                {
                    <span class="blank">—</span>
                }
            </td>
            <td class="is-align-end">@Number(costs.GetValueOrDefault(line.ItemId))@if (line.Synths > 0) { <span class="sub">@Synths(line, breakdown)</span> }</td>
        </tr>
    }

    private static decimal? StoredPrice(TradeMarginLine line) =>
        line.Route == TradeMaterialRoute.SetPrice ? line.Chosen?.UnitPrice : null;
    private TradeMaterialRoute DisplayedRoute(TradeMarginLine line) =>
        _pendingSetPrice.Contains(line.ItemId) ? TradeMaterialRoute.SetPrice : line.Route;
    private static string Quantity(TradeMarginLine line, TradeMarginBreakdown breakdown) =>
        ((decimal)line.Quantity / breakdown.Units).ToString(breakdown.Units > 1 ? "#,0.##" : "N0", CultureInfo.InvariantCulture);
    private static string Synths(TradeMarginLine line, TradeMarginBreakdown breakdown) => SynthCount(line.Synths, breakdown.Units);
    // Synths are counted for the whole run, so a run of several units names how many it makes.
    private static string SynthCount(int synths, int units) =>
        (synths == 1 ? "1 synth" : $"{synths:N0} synths") + (units > 1 ? $" per {units:N0}" : "");
    private static string Gil(decimal value) => $"{Math.Ceiling(value):N0} gil";
    private static string Signed(decimal value) => (value < 0 ? "−" : "+") + Math.Abs(value).ToString("N0");
    private static string ShortOfListings(TradeMarginRouteOption market) =>
        market.ListedQuantity == 0 ? "⚠ None listed" : $"⚠ Only {market.ListedQuantity:N0} of {market.RequiredQuantity:N0} listed";
    private string? ScopeLabel => _profile?.CommissionPricingScope is not { } scope ? null
        : scope.MarketFetchScope == MarketFetchScope.EntireRegion ? $"{scope.Region} region"
        : string.IsNullOrWhiteSpace(scope.DataCenter) ? scope.Region : scope.DataCenter;

    /// <summary>
    /// Each line's cost per unit sold, rounded so the column adds up to the row's Total cost
    /// (largest remainder); a line without a price stays unavailable.
    /// </summary>
    private static Dictionary<int, decimal?> LineCosts(MarginRow row, TradeMarginBreakdown breakdown)
    {
        var exact = breakdown.Lines.ToDictionary(line => line.ItemId, line => line.Cost / breakdown.Units);
        if (exact.Values.Any(value => value == null))
        {
            return exact.ToDictionary(pair => pair.Key, pair => pair.Value is { } value ? Math.Round(value, MidpointRounding.AwayFromZero) : (decimal?)null);
        }

        var target = Math.Round(exact.Values.Sum(value => value!.Value), MidpointRounding.AwayFromZero);
        var rounded = exact.ToDictionary(pair => pair.Key, pair => Math.Floor(pair.Value!.Value));
        var remainder = (int)(target - rounded.Values.Sum());
        foreach (var id in exact.OrderByDescending(pair => pair.Value!.Value - Math.Floor(pair.Value!.Value)).ThenBy(pair => pair.Key)
                     .Select(pair => pair.Key).Take(Math.Max(0, remainder)))
        {
            rounded[id] += 1;
        }
        return rounded.ToDictionary(pair => pair.Key, pair => (decimal?)pair.Value);
    }

    private IReadOnlyList<ListboxPickerItem> RouteItems(TradeMarginLine line, TradeMarginBreakdown breakdown)
    {
        var items = new List<ListboxPickerItem>();
        string Amount(decimal? total) => total is { } value ? Gil(value / breakdown.Units) : "—";
        foreach (var option in line.Options)
        {
            var value = option.Route.ToString();
            switch (option.Route)
            {
                case TradeMaterialRoute.Craft:
                    items.Add(new(value, "Craft", option.Total is { } && option.Materials is { } materials
                        ? $"{Gil(materials / breakdown.Units)} materials + {Gil(option.Synths * Rate / breakdown.Units)} labor ({SynthCount(option.Synths, breakdown.Units)})"
                        : option.Missing is { Count: > 0 } missing ? $"{string.Join(", ", missing)} unpriced" : null,
                        Amount(option.Total)));
                    break;
                case TradeMaterialRoute.Market when option.IsShortOfListings || option.Total == null:
                    items.Add(new(value, "Market", ShortOfListings(option), "—", Disabled: true, IsWarning: true));
                    break;
                case TradeMaterialRoute.Market:
                    items.Add(new(value, "Market", string.Join(" · ", new[]
                    {
                        option.ListingCount == 1 ? "1 listing" : $"{option.ListingCount:N0} listings",
                        ScopeLabel, option.ObservedAtUtc is { } observed ? RelativeAge(observed) : null
                    }.Where(part => !string.IsNullOrWhiteSpace(part))), Amount(option.Total)));
                    break;
                case TradeMaterialRoute.Vendor:
                    items.Add(new(value, "Vendor", $"{option.UnitPrice:N0} gil each", Amount(option.Total)));
                    break;
                case TradeMaterialRoute.SetPrice:
                    items.Add(new(value, "Set price", Amount: option.Total is { } ? Amount(option.Total) : null));
                    break;
            }
        }
        return items;
    }

    private static string Age(MarginRow row)
    {
        if (row.Cost?.UnknownPriceAge == true) return "?";
        if (row.Cost?.OldestPriceUtc is not { } time) return "—";
        return RelativeAge(time);
    }
    private static string AgeTitle(MarginRow row) => row.Cost?.UnknownPriceAge == true ? "Price age unknown" :
        row.Cost?.OldestPriceUtc is { } time ? $"Oldest material price: {time.ToLocalTime():f}" : "Oldest material price";
    private static string RelativeAge(DateTime time)
    {
        var age = DateTime.UtcNow - time;
        return age.TotalDays >= 1 ? $"{(int)age.TotalDays} d" : age.TotalHours >= 1 ? $"{(int)age.TotalHours} h" : age.TotalMinutes >= 1 ? $"{(int)age.TotalMinutes} min" : "now";
    }
    protected override void OnInitialized()
    {
        AppState.OnStateChanged += OnStateChanged;
        _ageLoop = UpdateAgesAsync();
    }
    private async Task UpdateAgesAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
                await InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { ReportError(ex); }
    }
    private void ReportError(Exception ex)
    {
        if (_disposed) return;
        Snackbar.Add(ex switch
        {
            CompanyHubRequestException { ErrorCode: "invalid_margin_items" } =>
                "Could not save margin items. Use at most 500 distinct items with non-negative sale prices and batch sizes from 1 to 9,999.",
            CompanyHubRequestException { ErrorCode: TradeMaterialSourceValidator.ErrorCode } =>
                "Could not save material sources.",
            _ => $"Margins: {ex.Message}"
        }, Severity.Error);
    }
    protected override Task OnParametersSetAsync() => !_loaded || Company != _loadedCompany ? LoadAsync() : Task.CompletedTask;
    private void OnStateChanged(AppStateChange change)
    {
        if (change.HasScope(AppStateChangeScope.Settings) || change.HasScope(AppStateChangeScope.TradeOperationsData))
            _ = ReloadSafelyAsync();
    }
    private async Task ReloadSafelyAsync()
    {
        try { if (!_disposed) await InvokeAsync(LoadAsync); }
        catch (Exception ex) { ReportError(ex); }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/trade-margins.js");
                if (_disposed) { await ReleaseModuleAsync(module); return; }
                _module = module;
                await module.InvokeVoidAsync("attach", _tableWrap);
            }
            catch (Exception ex) { ReportError(ex); }
        }
        if (_focusPrice is { } key && _module != null)
        {
            _focusPrice = null;
            try { await _module.InvokeVoidAsync("focusPrice", _tableWrap, key); }
            catch (JSDisconnectedException) { }
        }
    }
    private async Task LoadAsync()
    {
        await _gate.WaitAsync();
        try
        {
            if (_disposed) return;
            _glass = await Settings.GetAsync("ui.glass_surfaces", true);
            var selected = await TradeCompanyContext.ResolveAsync(Persistence, Hubs, Company);
            var resolved = await Profiles.ResolveAsync(selected.Id);
            var previous = _profile;
            var previousRate = Rate;
            var scopeChanged = previous?.Id != resolved.Profile.Id ||
                previous?.CommissionPricingScope != resolved.Profile.CommissionPricingScope;
            if (scopeChanged) _lastCheckedUtc = null;
            var unchanged = !scopeChanged && _revision == resolved.HostedRevision &&
                (previous?.MarginItems ?? []).SequenceEqual(resolved.Profile.MarginItems ?? []);
            var previousRows = _rows.ToDictionary(row => row.ItemId);
            _profile = resolved.Profile;
            _revision = resolved.HostedRevision;
            _hosted = resolved.IsHosted;
            if (!unchanged) RebuildRows(previousRows, scopeChanged, preserveEdit: previous?.Id == _profile.Id);
            if (previous?.Id != _profile.Id) { _expanded.Clear(); _pendingSetPrice.Clear(); _editingPrice = null; }
            _loaded = true;
            _loadedCompany = null;
            if (Company != null) { Company = null; Navigation.NavigateTo("trade/margins", replace: true); }
            await CalculateAsync(false);
            if (previous != null && (previousRate != Rate ||
                !(previous.MaterialSources ?? []).SequenceEqual(_profile.MaterialSources ?? [])))
                await RepriceAllAsync();
        }
        catch (Exception ex) { ReportError(ex); }
        finally { _gate.Release(); if (!_disposed) StateHasChanged(); }
    }
    private void RebuildRows(Dictionary<int, MarginRow> previousRows, bool scopeChanged, bool preserveEdit = true)
    {
        if (scopeChanged) _forceFetch.Clear();
        _rows = (_profile?.MarginItems ?? []).DistinctBy(item => item.ItemId).Select(item =>
        {
            previousRows.TryGetValue(item.ItemId, out var prior);
            var batch = Math.Clamp(item.BatchSize, 1, TradeMarginItem.MaxBatchSize);
            // A cost priced for another batch size (e.g. changed in another session) is recalculated.
            var stale = scopeChanged || prior?.Cost?.BatchSize != batch;
            return new MarginRow(item.ItemId, item.SalePrice)
            {
                Sale = preserveEdit && _editingSale == item.ItemId && prior != null ? prior.Sale : item.SalePrice,
                Batch = batch,
                ItemName = prior?.Name ?? _itemNames.GetValueOrDefault(item.ItemId, "Item"),
                Cost = stale ? null : prior?.Cost,
                Breakdown = stale ? null : prior?.Breakdown,
                // A plan is prepared for one batch size; market data is the same for any.
                Plan = stale ? null : prior?.Plan,
                Market = scopeChanged ? null : prior?.Market
            };
        }).ToList();
    }
    private static bool NeedsPricing(MarginRow row) =>
        row.Cost == null || row.Cost.Issue is "Pricing failed" or "Item data unavailable";
    private static TradeMarginCost Named(MarginRow row, TradeMarginCost cost) =>
        cost.Name == "Item unavailable" && row.ItemName != "Item" ? cost with { Name = row.ItemName } : cost;
    /// <summary>
    /// Runs under _gate. Rows without a figure are priced at once from the market data the
    /// browser holds, whatever its age; the background update then refetches what is due.
    /// </summary>
    private async Task CalculateAsync(bool refresh)
    {
        if (_disposed) return;
        var scope = _profile?.CommissionPricingScope;
        var ct = _lifetime.Token;
        if (refresh) foreach (var row in _rows) _forceFetch.Add(row.ItemId);
        StateHasChanged();
        foreach (var row in _rows.ToArray())
        {
            if (_disposed) return;
            if (!NeedsPricing(row)) continue;
            try
            {
                var plan = row.Plan != null && row.Cost == null ? row.Plan : await Calculator.PrepareAsync(row.ItemId, scope, ct, row.Batch);
                row.Plan = plan;
                row.Market = await Calculator.ReadStoredAsync(TradeMarginCalculator.Pairs(plan, scope), ct);
                // A row with no stored data for some material waits for the update rather
                // than showing that material as unpriced.
                if (TradeMarginCalculator.HasMarketData(plan, row.Market))
                {
                    SetCost(row, Named(row, await TradeMarginCalculator.PriceAsync(plan, scope, row.Market, Pricing, ct)));
                    StateHasChanged();
                }
            }
            catch (Exception ex) when (!ct.IsCancellationRequested)
            {
                row.Plan = null;
                await ShowPricingFailureAsync(row, ex, ct);
            }
        }
        StartPriceUpdate();
    }
    private void StartPriceUpdate()
    {
        var scope = (_profile?.Id, _profile?.CommissionPricingScope);
        if (_priceJob != null && _priceJobScope == scope)
        {
            _priceAgain = true;
            return;
        }
        _priceJob?.Cancel();
        _priceJobScope = scope;
        var job = _priceJob = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _ = RunPriceUpdateAsync(job);
    }
    /// <summary>
    /// Brings stored prices up to date without holding _gate while Universalis answers. Each
    /// item/data-center pair is fetched at most once per pass; rows reprice in place as their
    /// data lands, keeping expanded rows and values being typed.
    /// </summary>
    private async Task RunPriceUpdateAsync(CancellationTokenSource job)
    {
        var ct = job.Token;
        try
        {
            do
            {
                _priceAgain = false;
                var (company, scope) = _priceJobScope;
                var forcedPass = _forceFetch.Count > 0;
                var attempted = new HashSet<(int itemId, string dataCenter)>();
                var landed = new Dictionary<(int itemId, string dataCenter), CachedMarketData>();
                // Rows still without a figure go first, then table order.
                foreach (var itemId in _rows.OrderBy(row => row.Cost == null ? 0 : 1).Select(row => row.ItemId).ToArray())
                {
                    ct.ThrowIfCancellationRequested();
                    var row = _rows.FirstOrDefault(candidate => candidate.ItemId == itemId);
                    if (row?.Plan is not { Issue: null } plan || row.Market is not { } stored)
                    {
                        _forceFetch.Remove(itemId);
                        continue;
                    }
                    var forced = _forceFetch.Contains(itemId);
                    var reuseCutoff = DateTime.UtcNow - MarketEvidencePolicyDefaults.AgingThreshold;
                    var pairs = TradeMarginCalculator.Pairs(plan, scope);
                    var due = pairs.Where(pair => !attempted.Contains(pair) &&
                        (forced || !stored.TryGetValue(pair, out var entry) || entry.FetchedAt <= reuseCutoff)).ToArray();
                    if (due.Length > 0)
                    {
                        attempted.UnionWith(due);
                        var result = await Calculator.FetchAsync(due, ct);
                        foreach (var (pair, entry) in result.Stored) landed[pair] = entry;
                        LogKeptPrices(result, stored);
                    }
                    var updated = pairs.Where(landed.ContainsKey).ToArray();
                    if (updated.Length > 0 || (row.Cost == null && due.Length > 0))
                    {
                        var market = new Dictionary<(int itemId, string dataCenter), CachedMarketData>(stored);
                        foreach (var pair in updated) market[pair] = landed[pair];
                        if (!await ApplyUpdateAsync(itemId, plan, market, company, scope, ct)) return;
                    }
                    if (forced && _forceFetch.Remove(itemId) && !_disposed) StateHasChanged();
                }
                if (forcedPass && !_disposed) _lastCheckedUtc = DateTime.UtcNow;
            } while (_priceAgain && !ct.IsCancellationRequested);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) { Log.LogWarning(ex, "Margins price update stopped; stored prices kept"); }
        finally
        {
            if (ReferenceEquals(_priceJob, job))
            {
                _priceJob = null;
                _forceFetch.Clear();
                if (!_disposed) StateHasChanged();
            }
            job.Dispose();
        }
    }
    /// <summary>Reprices one row from updated market data; false when the company or scope changed.</summary>
    private async Task<bool> ApplyUpdateAsync(int itemId, TradeMarginCalculator.PreparedRow plan,
        Dictionary<(int itemId, string dataCenter), CachedMarketData> market, Guid? company, TradeCompanyPricingScope? scope,
        CancellationToken ct)
    {
        TradeMarginCost cost;
        var rate = Rate;
        var sources = _profile?.MaterialSources ?? [];
        try { cost = await TradeMarginCalculator.PriceAsync(plan, scope, market, Pricing, ct); }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            Log.LogWarning(ex, "Margins could not price item {ItemId} from updated market data; stored prices kept", itemId);
            return true;
        }
        await _gate.WaitAsync(ct);
        try
        {
            if (_disposed || _profile?.Id != company || _profile?.CommissionPricingScope != scope) return false;
            var row = _rows.FirstOrDefault(candidate => candidate.ItemId == itemId);
            if (row == null) return true;
            // Labor, material sources or the batch size may have changed while this row was priced.
            while (cost.Basis != null && (rate != Rate || !sources.SequenceEqual(_profile?.MaterialSources ?? []) || cost.BatchSize != row.Batch))
            {
                rate = Rate;
                sources = _profile?.MaterialSources ?? [];
                cost = await TradeMarginCalculator.RepriceAsync(cost, Pricing, row.Batch, ct);
            }
            row.Plan = plan;
            row.Market = market;
            SetCost(row, Named(row, cost));
            StateHasChanged();
            return true;
        }
        finally { _gate.Release(); }
    }
    /// <summary>Names every pair Universalis did not answer, per data center, and what the row keeps.</summary>
    private void LogKeptPrices(MarketPairRefreshResult result, IReadOnlyDictionary<(int itemId, string dataCenter), CachedMarketData> stored)
    {
        foreach (var group in result.Failed.GroupBy(pair => pair.dataCenter, StringComparer.OrdinalIgnoreCase))
        {
            var kept = group.Select(pair => stored.TryGetValue(pair, out var entry)
                ? $"{pair.itemId} (stored {RelativeAge(entry.FetchedAt)} old)" : $"{pair.itemId} (nothing stored)");
            Log.LogWarning("Margins price update: {DataCenter} did not answer for {Count} items ({Failure}); kept {Kept}",
                group.Key, group.Count(), result.FailureByDataCenter.GetValueOrDefault(group.Key, "no data returned"),
                string.Join(", ", kept));
        }
    }
    private void SetCost(MarginRow row, TradeMarginCost cost)
    {
        row.Cost = cost;
        row.ItemName = cost.Name;
        if (cost.Basis == null) row.Breakdown = null;
        _ = DescribeSafelyAsync(row);
    }
    /// <summary>Re-describes an expanded row from its current cost; a newer cost wins.</summary>
    private async Task DescribeSafelyAsync(MarginRow row)
    {
        if (_disposed || !_expanded.Contains(row.ItemId) || row.Cost is not { Basis: not null } cost) return;
        try
        {
            var breakdown = await TradeMarginCalculator.DescribeAsync(cost, Pricing, _lifetime.Token);
            if (_disposed || !ReferenceEquals(row.Cost, cost)) return;
            row.Breakdown = breakdown;
            StateHasChanged();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) { ReportError(ex); }
    }
    /// <summary>Reprices every row for the current labor rate and material sources, without fetching.</summary>
    private async Task RepriceAllAsync()
    {
        var pricing = Pricing;
        foreach (var row in _rows.ToArray())
        {
            if (_disposed) return;
            if (row.Cost is not { Basis: not null } cost) continue;
            var repriced = await TradeMarginCalculator.RepriceAsync(cost, pricing, _lifetime.Token);
            if (ReferenceEquals(row.Cost, cost)) SetCost(row, repriced);
        }
        if (!_disposed) StateHasChanged();
    }
    private async Task ToggleExpandedAsync(MarginRow row)
    {
        if (!_expanded.Remove(row.ItemId))
        {
            _expanded.Add(row.ItemId);
            await DescribeSafelyAsync(row);
        }
    }
    private async Task ShowPricingFailureAsync(MarginRow row, Exception error, CancellationToken ct)
    {
        if (row.ItemName == "Item")
        {
            try { row.ItemName = (await Garland.GetItemAsync(row.ItemId, ct))?.Name ?? "Item"; }
            catch (Exception) when (!ct.IsCancellationRequested) { /* Preserve the pricing error. */ }
        }
        ct.ThrowIfCancellationRequested();
        row.Cost = new(row.Name, row.Cost?.IconId ?? 0, null, null, null, [], "Pricing failed");
        row.Breakdown = null;
        ReportError(error);
    }
    private async Task RefreshAsync()
    {
        if (Refreshing) return;
        await _gate.WaitAsync();
        try { if (!_disposed) await CalculateAsync(true); }
        catch (Exception ex) { ReportError(ex); }
        finally { _gate.Release(); }
    }
    private async Task SearchAsync(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        var generation = ++_searchGeneration;
        _matches = [];
        if (_search.Trim().Length < 2) return;
        try
        {
            var matches = await Garland.SearchAsync(_search);
            if (!_disposed && generation == _searchGeneration)
            {
                _activeMatch = 0;
                _matches = matches.Where(item => item.Type == "item" && _rows.All(row => row.ItemId != item.Id)).Take(6).ToList();
            }
        }
        catch (Exception ex) { if (generation == _searchGeneration) ReportError(ex); }
    }
    private async Task SearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { ++_searchGeneration; _matches = []; }
        if (_matches.Count == 0) return;
        if (e.Key == "ArrowDown") _activeMatch = (_activeMatch + 1) % _matches.Count;
        if (e.Key == "ArrowUp") _activeMatch = (_activeMatch + _matches.Count - 1) % _matches.Count;
        if (e.Key == "Enter") await AddAsync(_matches[_activeMatch]);
    }
    private Task SaveItemsAsync(Func<IReadOnlyList<TradeMarginItem>, IReadOnlyList<TradeMarginItem>> edit) =>
        SaveProfileAsync(profile => profile.MarginItems = edit(profile.MarginItems ?? []), marginItems: true);
    /// <summary>
    /// Rebases only this edit onto the latest company profile and retries one concurrent hosted
    /// write. Margin items and material sources each travel only on their own explicit flag.
    /// </summary>
    private async Task SaveProfileAsync(Action<TradeCompanyProfile> edit, bool marginItems = false, bool materialSources = false)
    {
        if (_disposed) return;
        if (_profile == null) throw new InvalidOperationException("Company is unavailable.");
        for (var attempt = 0; attempt < 2; attempt++)
        {
            var current = await Profiles.ResolveAsync(_profile.Id);
            edit(current.Profile);
            try
            {
                if (current.IsHosted)
                    _revision = await Hubs.UpdateWorkspaceProfileAsync(current.Profile, current.HostedRevision!.Value,
                        updateMarginItems: marginItems, updateMaterialSources: materialSources);
                else
                {
                    if (!await Persistence.SaveCompanyProfileAsync(current.Profile)) throw new InvalidOperationException("Could not save company.");
                    // Persistence has succeeded; sync failure must not roll the displayed value back.
                    try { await Sync.QueueLocalSaveAsync(ProfileSyncCollections.TradeCompanyProfiles, current.Profile.Id.ToString("D")); }
                    catch (Exception ex) { ReportError(ex); }
                }
                var scopeChanged = _profile.CommissionPricingScope != current.Profile.CommissionPricingScope;
                var pricingChanged = Rate != TradePaymentPolicyNormalizer.Normalize(current.Profile.PaymentPolicy).LaborGilPerSynth ||
                    !(_profile.MaterialSources ?? []).SequenceEqual(current.Profile.MaterialSources ?? []);
                _profile = current.Profile;
                RebuildRows(_rows.ToDictionary(row => row.ItemId), scopeChanged);
                await CalculateAsync(false);
                if (pricingChanged) await RepriceAllAsync();
                return;
            }
            catch (CompanyHubRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict && attempt == 0) { }
        }
    }
    private async Task SaveSourcesAsync(Func<IReadOnlyList<TradeMaterialSource>, IReadOnlyList<TradeMaterialSource>> edit)
    {
        if (_profile == null) return;
        IReadOnlyList<TradeMaterialSource> Apply(IReadOnlyList<TradeMaterialSource> sources)
        {
            var next = edit(sources).Select(TradeMaterialSourceValidator.Normalize).ToArray();
            return TradeMaterialSourceValidator.IsValid(next, out var error) ? next : throw new InvalidOperationException(error);
        }
        // The choice shows at once; the save below rebases it onto the latest company.
        try
        {
            _profile.MaterialSources = Apply(_profile.MaterialSources ?? []);
            await RepriceAllAsync();
        }
        catch (Exception ex) { ReportError(ex); return; }
        var failed = false;
        await _gate.WaitAsync();
        try { await SaveProfileAsync(profile => profile.MaterialSources = Apply(profile.MaterialSources ?? []), materialSources: true); }
        catch (Exception ex) { failed = true; ReportError(ex); }
        finally { _gate.Release(); }
        if (failed) await ReloadSafelyAsync();
    }
    private Task SaveSourceAsync(int itemId, TradeMaterialRoute route, long? price = null) =>
        SaveSourcesAsync(sources => sources.Where(source => source.ItemId != itemId)
            .Append(new TradeMaterialSource(itemId, route, price)).ToArray());
    private Task ResetSourceAsync(int itemId)
    {
        _pendingSetPrice.Remove(itemId);
        if (_editingPrice == itemId) _editingPrice = null;
        return SaveSourcesAsync(sources => sources.Where(source => source.ItemId != itemId).ToArray());
    }
    private async Task ChooseRouteAsync(MarginRow row, TradeMarginLine line, string value)
    {
        if (!Enum.TryParse<TradeMaterialRoute>(value, out var route)) return;
        if (route == TradeMaterialRoute.SetPrice)
        {
            // Set price is complete only with a number: nothing is stored until one is typed.
            _pendingSetPrice.Add(line.ItemId);
            _focusPrice = $"{row.ItemId}-{line.ItemId}";
            return;
        }
        _pendingSetPrice.Remove(line.ItemId);
        await SaveSourceAsync(line.ItemId, route);
    }
    private void BeginPrice(TradeMarginLine line)
    {
        if (_editingPrice == line.ItemId) return;
        _editingPrice = line.ItemId;
        _priceDraft = StoredPrice(line) is { } price ? price.ToString("0", CultureInfo.InvariantCulture) : "";
    }
    // Typing (re)starts an edit even when focus never left the input, e.g. after Enter.
    private void PreviewPrice(TradeMarginLine line, ChangeEventArgs e)
    {
        _editingPrice = line.ItemId;
        _priceDraft = new string((e.Value?.ToString() ?? "").Where(char.IsAsciiDigit).ToArray());
    }
    private async Task PriceKeyAsync(KeyboardEventArgs e, int itemId)
    {
        if (e.Key == "Enter") await CommitPriceAsync(itemId);
    }
    private async Task CommitPriceAsync(int itemId)
    {
        if (_editingPrice != itemId) return;
        var draft = _priceDraft;
        _editingPrice = null;
        _priceDraft = "";
        _pendingSetPrice.Remove(itemId);
        var stored = _profile?.MaterialSources?.FirstOrDefault(source => source.ItemId == itemId);
        if (long.TryParse(draft, NumberStyles.None, CultureInfo.InvariantCulture, out var price))
        {
            if (stored is not { Route: TradeMaterialRoute.SetPrice } || stored.UnitPrice != price)
                await SaveSourceAsync(itemId, TradeMaterialRoute.SetPrice, price);
        }
        // An empty unit cost stores nothing: the material returns to its default.
        else if (stored != null)
            await SaveSourcesAsync(sources => sources.Where(source => source.ItemId != itemId).ToArray());
    }
    private async Task AddAsync(GarlandSearchResult item)
    {
        await _gate.WaitAsync();
        try
        {
            if (_profile == null || _rows.Count >= 500 || _rows.Any(row => row.ItemId == item.Id)) return;
            _itemNames[item.Id] = item.Object.Name;
            await SaveItemsAsync(items =>
            {
                if (items.Any(existing => existing.ItemId == item.Id)) return items;
                if (items.Count >= 500) throw new InvalidOperationException("Margins supports at most 500 items.");
                return items.Append(new TradeMarginItem(item.Id)).ToArray();
            });
            var added = _rows.FirstOrDefault(row => row.ItemId == item.Id);
            if (added != null) added.ItemName = item.Object.Name;
            ++_searchGeneration; _search = ""; _matches = [];
        }
        catch (Exception ex) { ReportError(ex); }
        finally { _gate.Release(); }
    }
    private static void PreviewSale(MarginRow row, ChangeEventArgs e)
    {
        var text = new string((e.Value?.ToString() ?? "").Where(char.IsAsciiDigit).ToArray());
        row.Sale = long.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out var value) && value >= 0 ? value : null;
    }
    private async Task SaveSaleAsync(MarginRow row)
    {
        var sale = row.Sale;
        await _gate.WaitAsync();
        try
        {
            await SaveItemsAsync(items => items.Select(item => item.ItemId == row.ItemId ? item with { SalePrice = sale } : item).ToArray());
        }
        catch (Exception ex)
        {
            row.Sale = row.SavedSale;
            var displayed = _rows.FirstOrDefault(item => item.ItemId == row.ItemId);
            if (displayed != null) displayed.Sale = displayed.SavedSale;
            ReportError(ex);
        }
        finally { _gate.Release(); }
    }
    private void BeginBatch(MarginRow row)
    {
        if (_editingBatch == row.ItemId) return;
        _editingBatch = row.ItemId;
        _batchDraft = row.Batch.ToString(CultureInfo.InvariantCulture);
    }
    // Typing (re)starts an edit even when focus never left the input, e.g. after Enter.
    private void PreviewBatch(MarginRow row, ChangeEventArgs e)
    {
        _editingBatch = row.ItemId;
        _batchDraft = new string((e.Value?.ToString() ?? "").Where(char.IsAsciiDigit).ToArray());
    }
    private async Task BatchKeyAsync(KeyboardEventArgs e, int itemId)
    {
        if (e.Key == "Enter") await CommitBatchAsync(itemId);
    }
    /// <summary>
    /// Reprices the row for the new batch size from its evidence, then saves it beside the sale
    /// price. Empty, zero or unparsable input keeps the previous batch size.
    /// </summary>
    private async Task CommitBatchAsync(int itemId)
    {
        if (_editingBatch != itemId) return;
        var draft = _batchDraft;
        _editingBatch = null;
        _batchDraft = "";
        if (!int.TryParse(draft, NumberStyles.None, CultureInfo.InvariantCulture, out var batch) || batch < 1) return;
        batch = Math.Min(batch, TradeMarginItem.MaxBatchSize);
        await _gate.WaitAsync();
        try
        {
            if (_disposed || _rows.FirstOrDefault(item => item.ItemId == itemId) is not { } row || row.Batch == batch) return;
            var previous = row.Batch;
            row.Batch = batch;
            await RepriceBatchAsync(row);
            try
            {
                await SaveItemsAsync(items => items.Select(item => item.ItemId == itemId ? item with { BatchSize = batch } : item).ToArray());
            }
            catch (Exception ex)
            {
                if (_rows.FirstOrDefault(item => item.ItemId == itemId) is { } displayed)
                {
                    displayed.Batch = previous;
                    await RepriceBatchAsync(displayed);
                }
                ReportError(ex);
            }
        }
        catch (Exception ex) { ReportError(ex); }
        finally { _gate.Release(); if (!_disposed) StateHasChanged(); }
    }
    /// <summary>Brings a row's cost to its batch size without fetching; a row without evidence is recalculated.</summary>
    private async Task RepriceBatchAsync(MarginRow row)
    {
        if (row.Cost is not { } cost || cost.BatchSize == row.Batch) return;
        if (cost.Basis == null)
        {
            row.Cost = null;
            row.Breakdown = null;
            row.Plan = null;
            await CalculateAsync(false);
            return;
        }
        try { SetCost(row, await TradeMarginCalculator.RepriceAsync(cost, Pricing, row.Batch, _lifetime.Token)); }
        catch (Exception ex) when (!_lifetime.IsCancellationRequested) { await ShowPricingFailureAsync(row, ex, _lifetime.Token); }
    }
    // Opens Trade Orders with a New Order draft already holding this item.
    private void CreateCommission(MarginRow row)
    {
        var query = new Dictionary<string, object?>
        {
            ["newOrderItem"] = row.ItemId,
            ["newOrderName"] = row.Name is { Length: > 0 } name && name != "Item" ? name : null,
            ["company"] = _profile?.Id.ToString()
        };
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("trade/orders", query));
    }

    private async Task RemoveAsync(MarginRow row)
    {
        await _gate.WaitAsync();
        try
        {
            var companyId = _profile?.Id;
            var removed = new TradeMarginItem(row.ItemId, row.SavedSale, row.Batch);
            await SaveItemsAsync(items => items.Where(item => item.ItemId != row.ItemId).ToArray());
            if (!_disposed) Snackbar.Add($"Removed {row.Name}.", Severity.Normal, options =>
            {
                options.Action = "Undo";
                options.Onclick = async _ => await UndoRemoveAsync(companyId, removed);
            });
        }
        catch (Exception ex) { ReportError(ex); }
        finally { _gate.Release(); }
    }
    private async Task UndoRemoveAsync(Guid? companyId, TradeMarginItem removed)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await _gate.WaitAsync();
                try
                {
                    if (_disposed) return;
                    if (_profile?.Id != companyId) throw new InvalidOperationException("The active company changed; the item was not restored.");
                    await SaveItemsAsync(items =>
                    {
                        if (items.Any(item => item.ItemId == removed.ItemId)) return items;
                        if (items.Count >= 500) throw new InvalidOperationException("Margins supports at most 500 items.");
                        return items.Append(removed).ToArray();
                    });
                }
                finally { _gate.Release(); if (!_disposed) StateHasChanged(); }
            });
        }
        catch (Exception ex) { ReportError(ex); }
    }
    private async ValueTask ReleaseModuleAsync(IJSObjectReference module)
    {
        try { await module.InvokeVoidAsync("detach", _tableWrap); }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex) { ReportError(ex); }
        finally
        {
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
            catch (JSException ex) { ReportError(ex); }
        }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        AppState.OnStateChanged -= OnStateChanged;
        _lifetime.Cancel();
        if (_ageLoop != null) await _ageLoop;
        if (_module is { } module) { _module = null; await ReleaseModuleAsync(module); }
        _lifetime.Dispose();
    }
