    /// <summary>Tracks a precraft in Source, batched by the stack (999 when Garland does not say), staying in Sell.</summary>
    private async Task TrackInSourceAsync(TradeMarginLine line)
    {
        var batch = 999;
        try
        {
            if ((await Garland.GetItemAsync(line.ItemId, _lifetime.Token))?.StackSize is > 0 and var stack) batch = Math.Min(999, stack);
        }
        catch (Exception) when (!_lifetime.IsCancellationRequested) { /* Keep the default batch. */ }
        await AddItemAsync(line.ItemId, line.Name, TradeMarginMode.Source, batch);
    }
    /// <summary>Adds one item to one mode; false when it was not added.</summary>
    private async Task<bool> AddItemAsync(int itemId, string name, TradeMarginMode mode, int batch)
    {
        var key = new RowKey(itemId, mode);
        var added = false;
        await _gate.WaitAsync();
        try
        {
            if (_disposed || _profile == null || _rows.Count >= 500 || _rows.Any(row => row.Key == key)) return false;
            _itemNames[itemId] = name;
            await SaveItemsAsync(items =>
            {
                if (items.Any(existing => KeyOf(existing) == key)) return items;
                if (items.Count >= 500) throw new InvalidOperationException("Margins supports at most 500 items.");
                return items.Append(new TradeMarginItem(itemId, null, Math.Clamp(batch, 1, TradeMarginItem.MaxBatchSize), mode)).ToArray();
            });
            if (_rows.FirstOrDefault(row => row.Key == key) is { } row) row.ItemName = name;
            added = true;
        }
        catch (Exception ex) { ReportError(ex); return false; }
        finally { _gate.Release(); if (!_disposed) StateHasChanged(); }
        // Priced from stored data right away, not after the rows the background pass is fetching.
        if (added) _ = StageNowAsync(key);
        return added;
    }
