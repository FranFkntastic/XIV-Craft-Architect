@page "/trade/margins"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Rendering
@using Franthropy.Web.Icons
@using FFXIV_Craft_Architect.Web.Shared.TablePrimitives
@using FFXIV_Craft_Architect.Web.Services.TradeCompany
@using FFXIV_Craft_Architect.Web.Services.ProfileHosting
@inject TradeOperationsPersistenceService Persistence
@inject TradeWorkspaceProfileResolver Profiles
@inject CompanyHubClient Hubs
@inject ProfileSyncService Sync
@inject IGarlandService Garland
@inject TradeMarginCalculator Calculator
@inject MarginFiguresStore SavedFigures
@inject PlanLifecycleWorkflowService PlanLifecycle
@inject WorkerSessionCoordinator WorkerSession
@inject WorkerProjectionStore WorkerProjections
@inject WebPlanPersistenceService PlanPersistence
@inject ISettingsService Settings
@inject AppState AppState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<TradeMargins> Log
@implements IAsyncDisposable

<div class="margins-backdrop @(_glass ? "franthropy-glass-backdrop" : null)">
<div class="trade-margins-page">
    <header class="margins-header"><span>@_profile?.Name</span><h1>Margins</h1></header>
    <div class="@Glass("card")">
    <div class="margins-toolbar @Glass("toolbar")">
        <div class="add-item">
            <input type="search" aria-label="Add item" placeholder="Add item" autocomplete="off"
                   value="@_search" disabled="@(_rows.Count >= 500)" @oninput="SearchAsync" @onkeydown="SearchKeyAsync"
                   aria-expanded="@(_matches.Count > 0)" aria-controls="margin-results" />
            @if (_matches.Count > 0 && _rows.Count < 500)
            {
                <div id="margin-results" class="add-results @Glass("dropdown")" role="listbox" aria-label="Items">
                    @foreach (var match in _matches)
                    {
                        <button @key="match.Id" type="button" role="option" aria-selected="@(match == _matches[_activeMatch])"
                                @onclick="() => AddAsync(match)">
                            <ItemIcon IconId="@match.Object.IconId" Name="@match.Object.Name" />
                            @match.Object.Name
                        </button>
                    }
                </div>
            }
        </div>
        <div class="margins-mode" role="group" aria-label="Margins mode">
            @foreach (var mode in Enum.GetValues<TradeMarginMode>())
            {
                <button type="button" class="@(_mode == mode ? "is-active" : null)" aria-pressed="@(_mode == mode ? "true" : "false")"
                        @onclick="() => SetMode(mode)">@mode</button>
            }
        </div>
        <span class="toolbar-spacer"></span>
        <CompactMultiSelectField Id="margins-market-scope" Label="Prices from" Class="margins-scope"
                                 Values="@RegionValues" ValuesChanged="SaveRegionsAsync"
                                 Options="@RegionOptions" ClearOptionLabel="Commission scope" SummaryText="@ScopeSummary"
                                 Disabled="@(_profile == null)" />
        <button type="button" class="margin-button" disabled="@Refreshing" @onclick="RefreshAsync">@(Refreshing ? "Refreshing…" : "↻ Refresh prices")</button>
    </div>
    <div @ref="_tableWrap" class="margins-table-wrap @Glass("table")">
        <WebDataTable TItem="MarginRow" TColumnId="Column" Items="@SortedRows" Columns="@Columns"
                      SortState="@_sort" SortChanged="value => _sort = value" GetRowKey="row => row.KeyText"
                      IsRowExpanded="IsExpanded"
                      ExpandedContent="row => builder => RenderMaterials(builder, row)">
            <EmptyContent>No items yet.</EmptyContent>
        </WebDataTable>
    </div>
    <footer class="margins-summary @Glass("footer")">
        @{ var shown = _rows.Count(row => row.Mode == _mode); }
        <span><strong>@shown</strong> @(shown == 1 ? "item" : "items")</span>
        @if (_lastCheckedUtc is { } checkedAt) { <span title="@checkedAt.ToLocalTime().ToString("f")">checked @(RelativeAge(checkedAt) == "now" ? "just now" : RelativeAge(checkedAt) + " ago")</span> }
        <span><strong>@(_profile == null ? "—" : Rate.ToString("N0"))</strong> gil per synth</span>
    </footer>
    </div>
</div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "company")] public string? Company { get; set; }
    private TradeCompanyProfile? _profile;
    private long? _revision;
    private bool _hosted, _glass = true, _disposed;
    private DateTime? _lastCheckedUtc;
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _ageLoop;
    private string _search = "";
    private int _activeMatch;
    // The pending search: debounced, and cancelled (request included) when a newer query supersedes it.
    private CancellationTokenSource? _searchJob;
    private Task _searchTask = Task.CompletedTask;
    private string? _matchesQuery;
    // Garland results per trimmed query this session, so backspacing or retyping is instant.
    private readonly Dictionary<string, List<GarlandSearchResult>> _searchCache = new(StringComparer.OrdinalIgnoreCase);
    private static readonly TimeSpan SearchDebounce = TimeSpan.FromMilliseconds(150);
    // Sell or Source: which rows the table shows. Both modes stay priced so switching is instant.
    private TradeMarginMode _mode = TradeMarginMode.Sell;
    // The sale price (Sell) or manual buy price (Source) being typed.
    private RowKey? _editingSale;
    private string _saleDraft = "";
    private string? _loadedCompany;
    private bool _loaded;
    private List<GarlandSearchResult> _matches = [];
    private List<MarginRow> _rows = [];
    private readonly Dictionary<int, string> _itemNames = [];
    private readonly SemaphoreSlim _gate = new(1);
    private ElementReference _tableWrap;
    private IJSObjectReference? _module;
    private WebTableSortState<Column> _sort = WebTableSortState<Column>.Unsorted;
    // Per-session view state: expanded rows, materials whose Set price is chosen but not yet
    // typed, and the unit cost being typed (kept through hosted syncs and re-renders).
    private readonly HashSet<RowKey> _expanded = [];
    private readonly HashSet<int> _pendingSetPrice = [];
    private int? _editingPrice;
    private string _priceDraft = "";
    private string? _focusPrice;
    // The batch size being typed, kept through hosted syncs and background repricing.
    private RowKey? _editingBatch;
    private string _batchDraft = "";
    // Background price update: one job at a time. Rows in _forceFetch refetch every pair
    // (Refresh prices); other rows refetch only pairs older than the Margins reuse window.
    private readonly HashSet<RowKey> _forceFetch = [];
    private CancellationTokenSource? _priceJob;
    private (Guid? Company, TradeMarginMarketScope? Scope) _priceJobScope;
    private bool _priceAgain;
    // Rows the background job has prepared and priced from stored data in its current pass, and
    // rows being prepared right now (by the job or on demand).
    private readonly HashSet<RowKey> _staged = [];
    private readonly Dictionary<RowKey, Task<bool>> _staging = [];
    // Rows someone is waiting on (expanded or just added): they go first.
    private readonly HashSet<RowKey> _urgent = [];
    // Rows the current pass has brought up to date.
    private readonly HashSet<RowKey> _updated = [];
    private StoredPass? _storedPass;
    private bool Refreshing => _forceFetch.Count > 0;
    private decimal Rate => _profile == null ? 0 : TradePaymentPolicyNormalizer.Normalize(_profile.PaymentPolicy).LaborGilPerSynth;
    private TradeMarginPricing Pricing => new(Rate, _profile?.MaterialSources ?? [], _profile?.MaterialPricingPolicy);
    /// <summary>The material pricing policy settings every market route depends on.</summary>
    private string RouteKey => TradeMarginPricing.RouteKeyOf(_profile?.MaterialPricingPolicy);
    /// <summary>The market Margins prices from: whole regions, or the commission scope when none are chosen.</summary>
    private TradeMarginMarketScope? MarginScope => MarginScopeOf(_profile);
    private static TradeMarginMarketScope? MarginScopeOf(TradeCompanyProfile? profile) =>
        profile == null ? null : TradeMarginMarketScope.Resolve(profile.CommissionPricingScope, profile.MarginsMarketRegions);
    // The region selection while its save is pending, so quick successive clicks build on each
    // other instead of on the last saved value.
    private IReadOnlyList<string>? _regionsDraft;
    private IReadOnlyList<string> RegionValues => _regionsDraft ?? _profile?.MarginsMarketRegions ?? [];
    private static readonly IReadOnlyList<CompactSelectOption> RegionOptions =
        MarketFetchScopeResolver.GetRegions().Select(region => new CompactSelectOption(region, region)).ToArray();
    private string? Glass(string surface) => _glass ? $"franthropy-glass-{surface}" : null;
    private enum Column { Item, Sale, Batch, Materials, Labor, Total, Margin, Percent, Age, Planner, Commission, Remove }
    // The row being opened in the Recipe Planner; one handoff at a time.
    private RowKey? _openingPlanner;
    /// <summary>One Margins row: an item may be tracked once per mode.</summary>
    private readonly record struct RowKey(int ItemId, TradeMarginMode Mode);
    private static RowKey KeyOf(TradeMarginItem item) => new(item.ItemId, item.Mode);
    private sealed class MarginRow(int itemId, TradeMarginMode mode, long? sale)
    {
        public int ItemId { get; } = itemId;
        public TradeMarginMode Mode { get; } = mode;
        public RowKey Key => new(ItemId, Mode);
        public string KeyText => $"{(int)Mode}-{ItemId}";
        /// <summary>Sell: the sale price. Source: the manual buy price; null buys at the live market.</summary>
        public long? Sale { get; set; } = sale;
        public long? SavedSale { get; set; } = sale;
        public int Batch { get; set; } = 1;
        public string ItemName { get; set; } = "Item";
        public TradeMarginCost? Cost { get; set; }
        public TradeMarginBreakdown? Breakdown { get; set; }
        /// <summary>The cost and pricing the breakdown was described for; a match re-expands without work.</summary>
        public (TradeMarginCost Cost, TradeMarginPricing Pricing)? BreakdownFor { get; set; }
        public TradeMarginCalculator.PreparedRow? Plan { get; set; }
        /// <summary>Market data this row is priced from, by item and data center.</summary>
        public Dictionary<(int itemId, string dataCenter), CachedMarketData>? Market { get; set; }
        /// <summary>
        /// Cost holds the figures saved last visit: shown until real pricing lands, never priced
        /// from, and never final.
        /// </summary>
        public bool Restored { get; set; }
        public string Name => Cost?.Name ?? ItemName;
    }
    // Calculator costs the whole production run; every displayed figure is per unit sold.
    private static decimal? PerUnit(MarginRow row, decimal? batch) => batch / Math.Max(1, row.Cost?.Units ?? 1);
    private decimal? Materials(MarginRow row) => PerUnit(row, row.Cost?.Materials);
    private decimal? Labor(MarginRow row) => PerUnit(row, row.Cost?.Synths * Rate);
    private decimal? Total(MarginRow row) => Materials(row) is { } materials && Labor(row) is { } labor ? materials + labor : null;
    /// <summary>
    /// Buying one unit live: the root buy plan for the full run, per unit. Units it commissions
    /// cost exactly the row's commission cost, so they save nothing. Null when nothing can be
    /// bought, so no full-run price is ever made up.
    /// </summary>
    private decimal? LiveBuy(MarginRow row) => row.Cost is { LiveBuy: { } plan } cost
        ? plan.Remainder == TradeMarginBuyRemainder.Commission
            ? Total(row) is { } total ? (plan.MarketCost + plan.RemainderUnits * total) / Math.Max(1, cost.Units) : null
            : plan.Total / Math.Max(1, cost.Units)
        : null;
    /// <summary>Per unit: the sale price (Sell) or the buy price, manual or live (Source).</summary>
    private decimal? Price(MarginRow row) => row.Mode == TradeMarginMode.Source ? row.Sale ?? LiveBuy(row) : row.Sale;
    private decimal? SavedPrice(MarginRow row) => row.Mode == TradeMarginMode.Source ? row.SavedSale ?? LiveBuy(row) : row.SavedSale;
    /// <summary>Sell: margin (sale − cost). Source: savings (buy − commission cost); positive means commissioning is cheaper.</summary>
    private decimal? Delta(MarginRow row) => Price(row) is { } price && Total(row) is { } total ? price - total : null;
    private decimal? Percent(MarginRow row) => Price(row) is > 0 and var price && Delta(row) is { } delta ? delta / price * 100 : null;
    private static string Number(decimal? value) => value?.ToString("N0") ?? "—";
    // Source savings carry their sign (color is never the only signal); Sell margins mark only losses.
    private static string DeltaText(decimal value, TradeMarginMode mode, string format = "N0")
    {
        var rounded = Math.Round(value, format == "N1" ? 1 : 0, MidpointRounding.AwayFromZero);
        var sign = rounded < 0 ? "−" : rounded > 0 && mode == TradeMarginMode.Source ? "+" : "";
        return sign + Math.Abs(rounded).ToString(format, CultureInfo.InvariantCulture);
    }
    private string? DeltaRun(MarginRow row) => row.Batch > 1 && Delta(row) is { } delta && (row.Cost?.Units ?? row.Batch) is var units
        ? $"{DeltaText(delta * units, row.Mode)} per {units:N0}" : null;
    // Source: buying cheaper than commissioning is a plain fact, not a loss, so it stays calm.
    private string Tone(MarginRow row) => row.Mode == TradeMarginMode.Source
        ? Delta(row) switch { > 0 => "is-gain", null => "", _ => "is-neutral" }
        : Delta(row) < 0 ? "is-loss" : "is-gain";
    private object? SortValue(MarginRow row) => _sort.Column switch
    {
        Column.Item => row.Name, Column.Sale => SavedPrice(row), Column.Batch => row.Batch, Column.Materials => Materials(row),
        Column.Labor => Labor(row), Column.Total => Total(row), Column.Margin => SavedPrice(row) - Total(row),
        Column.Percent => SavedPrice(row) is > 0 and var price ? (price - Total(row)) / price * 100 : null,
        Column.Age => PriceAge(row).Oldest, _ => null
    };
    private IReadOnlyList<MarginRow> SortedRows
    {
        get
        {
            var rows = _rows.Where(row => row.Mode == _mode).ToArray();
            return _sort.Column == null ? rows :
                (_sort.Descending ? rows.OrderBy(row => SortValue(row) == null).ThenByDescending(SortValue)
                    : rows.OrderBy(row => SortValue(row) == null).ThenBy(SortValue)).ToArray();
        }
    }
    private IReadOnlyList<WebTableColumn<MarginRow, Column>> Columns =>
    [
        new() { Id = Column.Item, Header = "Item", Size = new(268), CellTemplate = row => @<div class="item-cell">@if (ShowsExpander(row)) { <button type="button" class="expander" aria-expanded="@(_expanded.Contains(row.Key) ? "true" : "false")" aria-label="@(row.Name + " materials")" @onclick="() => ToggleExpandedAsync(row)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" /></svg></button> } else { <span class="expander-space"></span> }<ItemIcon IconId="@(row.Cost?.IconId ?? 0)" Name="@row.Name" /><span title="@row.Name">@row.Name</span></div> },
        _mode == TradeMarginMode.Source
            ? new() { Id = Column.Sale, Header = "Buy price", Size = new(164), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<div class="buy-cell"><div class="buy-entry">@if (row.Sale != null) { <button type="button" class="reset-btn" title="Reset to live buy price" aria-label="@($"Reset {row.Name} to live buy price")" @onclick="() => ResetBuyAsync(row)">×</button> }<input class="sale-input @(row.Sale == null ? "is-live" : null)" inputmode="numeric" maxlength="19" autocomplete="off" aria-label="@(row.Name + " buy price")" value="@SaleValue(row)" @onfocus="() => BeginSale(row)" @onblur="() => EndSale(row)" @oninput="e => PreviewSale(row, e)" @onchange="() => SaveSaleAsync(row)" /></div>@if (row.Sale == null && BuyLabel(row) is { } buy) { <span class="sub @(buy.Warning ? "short-listed" : null)" title="@buy.Title">@buy.Text</span> }</div> }
            : new() { Id = Column.Sale, Header = "Sale price", Size = new(132), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<input class="sale-input" inputmode="numeric" maxlength="19" aria-label="@(row.Name + " sale price")" value="@SaleValue(row)" @onfocus="() => BeginSale(row)" @onblur="() => EndSale(row)" @oninput="e => PreviewSale(row, e)" @onchange="() => SaveSaleAsync(row)" /> },
        new() { Id = Column.Batch, Header = "Batch", Size = new(84), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<input class="batch-input" inputmode="numeric" maxlength="4" autocomplete="off" aria-label="@(row.Name + " batch size")" value="@(_editingBatch == row.Key ? _batchDraft : row.Batch.ToString(CultureInfo.InvariantCulture))" @onfocus="() => BeginBatch(row)" @oninput="e => PreviewBatch(row, e)" @onblur="() => CommitBatchAsync(row.Key)" @onkeydown="e => BatchKeyAsync(e, row.Key)" /> },
        new() { Id = Column.Materials, Header = "Materials", Size = new(150), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<span>@if (row.Cost?.Issue is { } issue) { <span class="missing">@issue</span> } else if (row.Cost?.Missing.Count > 0) { <span class="missing">@string.Join(", ", row.Cost.Missing) unpriced</span> } else { @Number(Materials(row)) }</span> },
        new() { Id = Column.Labor, Header = "Labor", Size = new(160), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<span>@Number(Labor(row))<span class="sub">@(row.Cost?.Synths is { } synths ? SynthCount(synths, row.Cost.Units) : "")</span></span> },
        new() { Id = Column.Total, Header = _mode == TradeMarginMode.Source ? "Commission cost" : "Total cost", Size = new(128), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<span>@Number(Total(row))@if (row.Mode == TradeMarginMode.Sell && row.Cost?.RootVendorPrice is > 0 and var vendorPrice) { <span class="sub">Vendor @vendorPrice.ToString("N0", CultureInfo.InvariantCulture)</span> }</span> },
        new() { Id = Column.Margin, Header = _mode == TradeMarginMode.Source ? "Savings" : "Margin", Size = new(140), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellCssClassSelector = Tone, CellTemplate = row => @<span>@(Delta(row) is { } delta ? DeltaText(delta, row.Mode) : "—")@if (DeltaRun(row) is { } run) { <span class="sub">@run</span> }</span> },
        new() { Id = Column.Percent, Header = _mode == TradeMarginMode.Source ? "Savings %" : "Margin %", Size = new(88), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellCssClassSelector = Tone, CellTemplate = row => @<span>@(Percent(row) is { } percent ? DeltaText(percent, row.Mode, "N1") + "%" : "—")</span> },
        new() { Id = Column.Age, Header = "Prices", Size = new(74, 50), HeaderCssClass = "is-align-end", CellCssClass = "is-align-end", CellTemplate = row => @<span class="age @(IsStale(row) ? "is-stale" : null)" title="@AgeTitle(row)">@Age(row)</span> },
        new() { Id = Column.Planner, Header = "", Size = new(44, 44), Sortable = false, CellCssClass = "is-action", CellTemplate = row => @<button type="button" class="planner-btn" title="@($"Open {row.Name} in Recipe Planner")" aria-label="@($"Open {row.Name} in Recipe Planner")" disabled="@(_openingPlanner != null || row.Cost?.Issue is "Item data unavailable" or "Not craftable")" @onclick="() => OpenInPlannerAsync(row)"><MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" /></button> },
        new() { Id = Column.Commission, Header = "", Size = new(44, 44), Sortable = false, CellCssClass = "is-action", CellTemplate = row => @<button type="button" class="commission-btn" title="@("Create commission for " + row.Name)" aria-label="@("Create commission for " + row.Name)" @onclick="() => CreateCommission(row)"><MudIcon Icon="@Icons.Material.Filled.PostAdd" Size="Size.Small" /></button> },
        new() { Id = Column.Remove, Header = "", Size = new(44, 44), Sortable = false, CellCssClass = "is-action", CellTemplate = row => @<button type="button" class="remove-btn" aria-label="@("Remove " + row.Name)" @onclick="() => RemoveAsync(row)">×</button> }
    ];

    private void RenderMaterials(RenderTreeBuilder __builder, MarginRow row)
    {
        if (row.Breakdown is not { } breakdown)
        {
            <div class="margin-detail"><div class="margin-detail-loading">@(MaterialsPending(row) ? "Loading materials…" : "No prices yet")</div></div>
            return;
        }
        var costs = LineCosts(row, breakdown);
        var sold = breakdown.Lines.First(line => line.IsSoldItem);
        var precrafts = breakdown.Lines.Where(line => !line.IsSoldItem && line.IsCraftable).ToArray();
        var materials = breakdown.Lines.Where(line => !line.IsCraftable).ToArray();
        <div class="margin-detail">
            <table class="margin-materials" aria-label="@(row.Name + " materials")">
                <colgroup><col /><col style="width:104px" /><col style="width:260px" /><col style="width:150px" /><col style="width:150px" /></colgroup>
                <thead><tr><th>Material</th><th class="is-align-end">Per unit sold</th><th>Source</th><th class="is-align-end">Unit cost</th><th class="is-align-end">Cost</th></tr></thead>
                <tbody>
                    <tr>
                        <td><div class="material-cell"><ItemIcon IconId="@sold.IconId" Name="@sold.Name" /><span title="@sold.Name">@sold.Name</span></div></td>
                        <td class="is-align-end">@Quantity(sold, breakdown)</td>
                        <td>Craft</td>
                        <td class="is-align-end"><span class="blank">—</span></td>
                        <td class="is-align-end">@Number(costs.GetValueOrDefault(sold.ItemId))<span class="sub">@Synths(sold, breakdown)</span></td>
                    </tr>
                    @if (precrafts.Length > 0)
                    {
                        <tr class="group"><td colspan="5">Precrafts</td></tr>
                        @foreach (var line in precrafts) { RenderLine(__builder, row, breakdown, line, costs, track: row.Mode == TradeMarginMode.Sell); }
                    }
                    @if (materials.Length > 0)
                    {
                        <tr class="group"><td colspan="5">Materials</td></tr>
                        @foreach (var line in materials) { RenderLine(__builder, row, breakdown, line, costs); }
                    }
                </tbody>
            </table>
        </div>
    }

    private void RenderLine(RenderTreeBuilder __builder, MarginRow row, TradeMarginBreakdown breakdown, TradeMarginLine line,
        IReadOnlyDictionary<int, decimal?> costs, bool track = false)
    {
        var route = DisplayedRoute(line);
        var market = line.Options.FirstOrDefault(option => option.Route == TradeMaterialRoute.Market);
        var priceKey = $"{row.KeyText}-{line.ItemId}";
        <tr @key="line.ItemId">
            <td>
                <div class="material-cell">
                    <ItemIcon IconId="@line.IconId" Name="@line.Name" /><span title="@line.Name">@line.Name</span>
                    @if (track)
                    {
                        var tracked = _rows.Any(candidate => candidate.Key == new RowKey(line.ItemId, TradeMarginMode.Source));
                        var full = !tracked && _rows.Count >= 500;
                        var label = tracked ? "Already in Source" : full ? "Margins holds at most 500 items" : $"Track {line.Name} in Source";
                        <button type="button" class="track-btn" disabled="@(tracked || full)" title="@label"
                                aria-label="@(tracked ? $"{line.Name} already in Source" : label)" @onclick="() => TrackInSourceAsync(line)">
                            <MudIcon Icon="@(tracked ? Icons.Material.Filled.PlaylistAddCheck : Icons.Material.Filled.PlaylistAdd)" Size="Size.Small" />
                        </button>
                    }
                </div>
            </td>
            <td class="is-align-end">@Quantity(line, breakdown)</td>
            <td>
                <div class="material-source">
                    <ListboxPicker Items="@RouteItems(line, breakdown)" Value="@route.ToString()"
                                   ValueChanged="@(value => ChooseRouteAsync(row, line, value))"
                                   AriaLabel="@(line.Name + " source")" TriggerClass="material-source-picker" />
                    @if (line.DefaultDelta is { } delta && _editingPrice != line.ItemId)
                    {
                        <span class="override-delta" title="Total cost vs. default source">@Signed(delta / breakdown.Units)</span>
                    }
                    @if (line.IsExplicit)
                    {
                        <button type="button" class="reset-btn" title="@($"Reset {line.Name} to default")"
                                aria-label="@($"Reset {line.Name} to default")" @onclick="() => ResetSourceAsync(line.ItemId)">×</button>
                    }
                </div>
            </td>
            <td class="is-align-end">
                @if (route == TradeMaterialRoute.SetPrice)
                {
                    <input class="set-price-input" inputmode="numeric" maxlength="19" autocomplete="off"
                           data-price-key="@priceKey" aria-label="@(line.Name + " unit cost")"
                           value="@(_editingPrice == line.ItemId ? _priceDraft : StoredPrice(line)?.ToString("N0", CultureInfo.InvariantCulture))"
                           @onfocus="() => BeginPrice(line)" @oninput="e => PreviewPrice(line, e)"
                           @onblur="() => CommitPriceAsync(line.ItemId)" @onkeydown="e => PriceKeyAsync(e, line.ItemId)" />
                }
                else if (route == TradeMaterialRoute.Craft && line.Synths > 0)
                {
                    <span class="blank">—</span>
                }
                else if (route == TradeMaterialRoute.Market && line.UnitCost == null && market != null)
                {
                    <span class="short-listed">@ShortOfListings(market)</span>
                }
                else if (line.UnitCost is { } unit)
                {
                    @unit.ToString("N0")
                    @if (route == TradeMaterialRoute.Market && market is { IsShortOfListings: true }) { <span class="sub short-listed">@ShortOfListings(market)</span> }
                    else if (route is TradeMaterialRoute.Market or TradeMaterialRoute.MarketVendor && line.Chosen?.Plan is { MarketUnits: > 0 } plan) { <span class="sub" title="@BuyTitle(plan)">@PlanBasis(plan)</span> }
                }
                else
                {
                    <span class="blank">—</span>
                }
            </td>
            <td class="is-align-end">@Number(costs.GetValueOrDefault(line.ItemId))@if (line.Synths > 0) { <span class="sub">@Synths(line, breakdown)</span> }</td>
        </tr>
    }

    // A breakdown is on its way while the row is being described, prepared or priced in the background.
    private bool MaterialsPending(MarginRow row) => row.Cost is { Basis: not null } || _priceJob != null || _staging.ContainsKey(row.Key);
    private static decimal? StoredPrice(TradeMarginLine line) =>
        line.Route == TradeMaterialRoute.SetPrice ? line.Chosen?.UnitPrice : null;
    private TradeMaterialRoute DisplayedRoute(TradeMarginLine line) =>
        _pendingSetPrice.Contains(line.ItemId) ? TradeMaterialRoute.SetPrice : line.Route;
    private static string Quantity(TradeMarginLine line, TradeMarginBreakdown breakdown) =>
        ((decimal)line.Quantity / breakdown.Units).ToString(breakdown.Units > 1 ? "#,0.##" : "N0", CultureInfo.InvariantCulture);
    private static string Synths(TradeMarginLine line, TradeMarginBreakdown breakdown) => SynthCount(line.Synths, breakdown.Units);
    // Synths are counted for the whole run, so a run of several units names how many it makes.
    private static string SynthCount(int synths, int units) =>
        (synths == 1 ? "1 synth" : $"{synths:N0} synths") + (units > 1 ? $" per {units:N0}" : "");
    private static string Gil(decimal value) => $"{Math.Ceiling(value):N0} gil";
    private static string Signed(decimal value) => (value < 0 ? "−" : "+") + Math.Abs(value).ToString("N0");
    private string ShortOfListings(TradeMarginRouteOption market) =>
        market.ListedQuantity == 0 ? "⚠ None listed"
        : market.ListedQuantity < market.RequiredQuantity ? $"⚠ Only {market.ListedQuantity:N0} of {market.RequiredQuantity:N0} listed"
        : TradeMaterialPricingPolicyNormalizer.Normalize(_profile?.MaterialPricingPolicy) is { AllowSplitPurchases: true, MaximumWorldStops: > 1 } policy
            ? $"⚠ Needs over {policy.MaximumWorldStops:N0} worlds" : "⚠ No one world has enough";
    /// <summary>The root buy under the buy price: where the live buy comes from, or why the market falls short.</summary>
    private (string Text, string? Title, bool Warning)? BuyLabel(MarginRow row)
    {
        var market = row.Cost?.MarketBuy;
        return row.Cost?.LiveBuy switch
        {
            null => market is { IsShortOfListings: true } ? (ShortOfListings(market), null, true) : null,
            { Remainder: TradeMarginBuyRemainder.Commission } plan =>
                (market is { IsShortOfListings: true } ? ShortOfListings(market) : "⚠ Partly commissioned", BuyTitle(plan), true),
            { MarketUnits: 0 } => ("Vendor", null, false),
            var plan => (PlanLabel(plan), BuyTitle(plan), false)
        };
    }
    /// <summary>The main world, how many more, and whether the vendor tops it up.</summary>
    private static string PlanLabel(TradeMarginBuyPlan plan) =>
        (plan.Worlds.Count > 0 ? plan.Worlds[0].Label : "") +
        (plan.Worlds.Count > 1 ? $" +{plan.Worlds.Count - 1:N0} {(plan.Worlds.Count == 2 ? "world" : "worlds")}" : "") +
        (plan.Remainder == TradeMarginBuyRemainder.Vendor && plan.RemainderUnits > 0 ? " + vendor" : "");
    private static string PlanBasis(TradeMarginBuyPlan plan) =>
        string.Join(" · ", new[] { PlanLabel(plan), plan.ObservedAtUtc is { } observed ? RelativeAge(observed) : null }
            .Where(part => !string.IsNullOrWhiteSpace(part)));
    /// <summary>Units from each world, then the vendor or commissioned rest.</summary>
    private static string BuyTitle(TradeMarginBuyPlan plan)
    {
        var lines = plan.Worlds.Select(world => $"{world.Label} · {world.Quantity:N0}").ToList();
        if (plan.RemainderUnits > 0 && plan.Remainder == TradeMarginBuyRemainder.Vendor) lines.Add($"Vendor · {plan.RemainderUnits:N0}");
        if (plan.Remainder == TradeMarginBuyRemainder.Commission)
            lines.Insert(0, $"{plan.MarketUnits:N0} market · {plan.RemainderUnits:N0} commissioned");
        return string.Join("\n", lines);
    }
    /// <summary>The closed scope control: the effective Margins scope.</summary>
    private string ScopeSummary
    {
        get
        {
            var regions = TradeMarginMarketScope.NormalizeRegions(RegionValues);
            if (regions.Count == MarketFetchScopeResolver.GetRegions().Count) return "All regions";
            if (regions.Count > 0) return string.Join(" + ", regions);
            return _profile?.CommissionPricingScope is not { } scope ? "Commission scope"
                : scope.MarketFetchScope == MarketFetchScope.EntireRegion || string.IsNullOrWhiteSpace(scope.DataCenter)
                    ? $"Commission · {scope.Region}" : $"Commission · {scope.DataCenter}";
        }
    }
    /// <summary>
    /// Each line's cost per unit sold, rounded so the column adds up to the row's Total cost
    /// (largest remainder); a line without a price stays unavailable.
    /// </summary>
    private static Dictionary<int, decimal?> LineCosts(MarginRow row, TradeMarginBreakdown breakdown)
    {
        var exact = breakdown.Lines.ToDictionary(line => line.ItemId, line => line.Cost / breakdown.Units);
        if (exact.Values.Any(value => value == null))
        {
            return exact.ToDictionary(pair => pair.Key, pair => pair.Value is { } value ? Math.Round(value, MidpointRounding.AwayFromZero) : (decimal?)null);
        }

        var target = Math.Round(exact.Values.Sum(value => value!.Value), MidpointRounding.AwayFromZero);
        var rounded = exact.ToDictionary(pair => pair.Key, pair => Math.Floor(pair.Value!.Value));
        var remainder = (int)(target - rounded.Values.Sum());
        foreach (var id in exact.OrderByDescending(pair => pair.Value!.Value - Math.Floor(pair.Value!.Value)).ThenBy(pair => pair.Key)
                     .Select(pair => pair.Key).Take(Math.Max(0, remainder)))
        {
            rounded[id] += 1;
        }
        return rounded.ToDictionary(pair => pair.Key, pair => (decimal?)pair.Value);
    }

    private IReadOnlyList<ListboxPickerItem> RouteItems(TradeMarginLine line, TradeMarginBreakdown breakdown)
    {
        var items = new List<ListboxPickerItem>();
        string Amount(decimal? total) => total is { } value ? Gil(value / breakdown.Units) : "—";
        foreach (var option in line.Options)
        {
            var value = option.Route.ToString();
            switch (option.Route)
            {
                case TradeMaterialRoute.Craft:
                    items.Add(new(value, "Craft", option.Total is { } && option.Materials is { } materials
                        ? $"{Gil(materials / breakdown.Units)} materials + {Gil(option.Synths * Rate / breakdown.Units)} labor ({SynthCount(option.Synths, breakdown.Units)})"
                        : option.Missing is { Count: > 0 } missing ? $"{string.Join(", ", missing)} unpriced" : null,
                        Amount(option.Total)));
                    break;
                case TradeMaterialRoute.Market when option.IsShortOfListings || option.Total == null:
                    items.Add(new(value, "Market", ShortOfListings(option), "—", Disabled: true, IsWarning: true));
                    break;
                case TradeMaterialRoute.Market:
                    items.Add(new(value, "Market", option.Plan is { } plan ? PlanBasis(plan) : null, Amount(option.Total)));
                    break;
                case TradeMaterialRoute.MarketVendor:
                    items.Add(new(value, "Market + vendor", option.Plan is { MarketUnits: > 0 } blend
                        ? $"{blend.MarketUnits:N0} listed · {blend.RemainderUnits:N0} vendor · {PlanBasis(blend)}"
                        : "Vendor", Amount(option.Total)));
                    break;
                case TradeMaterialRoute.Vendor:
                    items.Add(new(value, "Vendor", $"{option.UnitPrice:N0} gil each", Amount(option.Total)));
                    break;
                case TradeMaterialRoute.SetPrice:
                    items.Add(new(value, "Set price", Amount: option.Total is { } ? Amount(option.Total) : null));
                    break;
            }
        }
        return items;
    }

    /// <summary>
    /// A Source row buying live also prices from the item's own listings; its vendor or
    /// commissioned part has no age.
    /// </summary>
    private static bool AgesWithMarketBuy(MarginRow row) =>
        row.Mode == TradeMarginMode.Source && row.Sale == null && row.Cost?.LiveBuy is { MarketUnits: > 0 };
    /// <summary>The oldest price a row's figures rest on: its materials, plus its live market buy.</summary>
    private static (DateTime? Oldest, bool Unknown) PriceAge(MarginRow row)
    {
        if (row.Cost is not { } cost) return (null, false);
        var unknown = cost.UnknownPriceAge;
        var oldest = cost.OldestPriceUtc;
        if (AgesWithMarketBuy(row))
        {
            if (cost.LiveBuy!.ObservedAtUtc is { } observed) oldest = oldest == null || observed < oldest ? observed : oldest;
            else unknown = true;
        }
        return (unknown ? null : oldest, unknown);
    }
    private static bool IsStale(MarginRow row) => PriceAge(row) is var age && (age.Unknown || age.Oldest <= DateTime.UtcNow.AddDays(-1));
    private static string Age(MarginRow row)
    {
        var (oldest, unknown) = PriceAge(row);
        if (unknown) return "?";
        if (oldest is not { } time) return "—";
        return RelativeAge(time);
    }
    private static string AgeTitle(MarginRow row)
    {
        var (oldest, unknown) = PriceAge(row);
        var label = AgesWithMarketBuy(row) ? "Oldest price" : "Oldest material price";
        return unknown ? "Price age unknown" : oldest is { } time ? $"{label}: {time.ToLocalTime():f}" : label;
    }
    private static string RelativeAge(DateTime time)
    {
        var age = DateTime.UtcNow - time;
        return age.TotalDays >= 1 ? $"{(int)age.TotalDays} d" : age.TotalHours >= 1 ? $"{(int)age.TotalHours} h" : age.TotalMinutes >= 1 ? $"{(int)age.TotalMinutes} min" : "now";
    }
    protected override void OnInitialized()
    {
        AppState.OnStateChanged += OnStateChanged;
        _ageLoop = UpdateAgesAsync();
    }
    private async Task UpdateAgesAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
                await InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { ReportError(ex); }
    }
    private void ReportError(Exception ex)
    {
        if (_disposed) return;
        Snackbar.Add(ex switch
        {
            CompanyHubRequestException { ErrorCode: "invalid_margin_items" } =>
                "Could not save margin items. Use at most 500 items, each at most once per mode, with non-negative prices and batch sizes from 1 to 9,999.",
            CompanyHubRequestException { ErrorCode: TradeMaterialSourceValidator.ErrorCode } =>
                "Could not save material sources.",
            CompanyHubRequestException { ErrorCode: TradeMarginMarketScope.ErrorCode } =>
                "Could not save the Margins market scope.",
            _ => $"Margins: {ex.Message}"
        }, Severity.Error);
    }
    protected override Task OnParametersSetAsync() => !_loaded || Company != _loadedCompany ? LoadAsync() : Task.CompletedTask;
    private void OnStateChanged(AppStateChange change)
    {
        if (change.HasScope(AppStateChangeScope.Settings) || change.HasScope(AppStateChangeScope.TradeOperationsData))
            _ = ReloadSafelyAsync();
    }
    private async Task ReloadSafelyAsync()
    {
        try { if (!_disposed) await InvokeAsync(LoadAsync); }
        catch (Exception ex) { ReportError(ex); }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/trade-margins.js");
                if (_disposed) { await ReleaseModuleAsync(module); return; }
                _module = module;
                await module.InvokeVoidAsync("attach", _tableWrap);
            }
            catch (Exception ex) { ReportError(ex); }
        }
        if (_focusPrice is { } key && _module != null)
        {
            _focusPrice = null;
            try { await _module.InvokeVoidAsync("focusPrice", _tableWrap, key); }
            catch (JSDisconnectedException) { }
        }
    }
    private async Task LoadAsync()
    {
        await _gate.WaitAsync();
        try
        {
            if (_disposed) return;
            _glass = await Settings.GetAsync("ui.glass_surfaces", true);
            var selected = await TradeCompanyContext.ResolveAsync(Persistence, Hubs, Company);
            var resolved = await Profiles.ResolveAsync(selected.Id);
            var previous = _profile;
            var previousRate = Rate;
            var previousRouteKey = RouteKey;
            var scopeChanged = previous?.Id != resolved.Profile.Id || MarginScopeOf(previous) != MarginScopeOf(resolved.Profile);
            if (scopeChanged) _lastCheckedUtc = null;
            var unchanged = !scopeChanged && _revision == resolved.HostedRevision &&
                (previous?.MarginItems ?? []).SequenceEqual(resolved.Profile.MarginItems ?? []);
            var previousRows = _rows.ToDictionary(row => row.Key);
            _profile = resolved.Profile;
            _revision = resolved.HostedRevision;
            _hosted = resolved.IsHosted;
            if (!unchanged) RebuildRows(previousRows, scopeChanged, preserveEdit: previous?.Id == _profile.Id);
            if (previous?.Id != _profile.Id) { _expanded.Clear(); _urgent.Clear(); _pendingSetPrice.Clear(); _editingPrice = null; }
            _loaded = true;
            _loadedCompany = null;
            if (Company != null) { Company = null; Navigation.NavigateTo("trade/margins", replace: true); }
            if (_rows.Any(row => row.Cost == null)) await RestoreFiguresAsync();
            if (previous != null && (previousRate != Rate || previousRouteKey != RouteKey ||
                !(previous.MaterialSources ?? []).SequenceEqual(_profile.MaterialSources ?? [])))
                await RepriceAllAsync();
            // Rows are prepared and priced in the background, so nothing waits on a full-table load.
            QueuePricing(false);
        }
        catch (Exception ex) { ReportError(ex); }
        finally { _gate.Release(); if (!_disposed) StateHasChanged(); }
    }
    private void RebuildRows(Dictionary<RowKey, MarginRow> previousRows, bool scopeChanged, bool preserveEdit = true)
    {
        if (scopeChanged) _forceFetch.Clear();
        _rows = (_profile?.MarginItems ?? []).Where(item => Enum.IsDefined(item.Mode)).DistinctBy(KeyOf).Select(item =>
        {
            var key = KeyOf(item);
            previousRows.TryGetValue(key, out var prior);
            var batch = Math.Clamp(item.BatchSize, 1, TradeMarginItem.MaxBatchSize);
            // A cost priced for another batch size (e.g. changed in another session) is recalculated.
            var stale = scopeChanged || prior?.Cost?.BatchSize != batch;
            return new MarginRow(item.ItemId, item.Mode, item.SalePrice)
            {
                Sale = preserveEdit && _editingSale == key && prior != null ? prior.Sale : item.SalePrice,
                Batch = batch,
                ItemName = prior?.Name ?? _itemNames.GetValueOrDefault(item.ItemId, "Item"),
                Cost = stale ? null : prior?.Cost,
                Restored = !stale && prior?.Restored == true,
                Breakdown = stale ? null : prior?.Breakdown,
                BreakdownFor = stale ? null : prior?.BreakdownFor,
                // A plan is prepared for one batch size; market data is the same for any.
                Plan = stale ? null : prior?.Plan,
                Market = scopeChanged ? null : prior?.Market
            };
        }).ToList();
    }
    private static bool IsFailure(TradeMarginCost cost) => cost.Issue is "Pricing failed" or "Item data unavailable";
    /// <summary>True until a row shows figures priced in this session.</summary>
    private static bool Unpriced(MarginRow row) => row.Cost == null || row.Restored;
    private static bool NeedsPricing(MarginRow row) => Unpriced(row) || IsFailure(row.Cost!);
    private string? FiguresInputs(MarginRow row, int batchSize) =>
        _profile != null && MarginScope is { } scope
            ? SavedFigures.Inputs(_profile.Id, scope, row.ItemId, batchSize, Rate, _profile.MaterialSources ?? [], RouteKey)
            : null;
    /// <summary>
    /// Runs under _gate before any row is prepared or market data is read: shows the figures
    /// saved last visit for every row whose inputs still match, in one read.
    /// </summary>
    private async Task RestoreFiguresAsync()
    {
        if (_profile == null || _disposed) return;
        var company = _profile.Id;
        var saved = await SavedFigures.LoadAsync(company, _rows.Select(row => (row.ItemId, row.Mode)).ToArray());
        if (_disposed || _profile?.Id != company || saved.Count == 0) return;
        var shown = 0;
        foreach (var row in _rows)
        {
            if (row.Cost != null || !saved.TryGetValue((row.ItemId, row.Mode), out var figures) ||
                figures.Inputs != FiguresInputs(row, row.Batch) || figures.BatchSize != row.Batch) continue;
            row.Cost = figures.ToCost();
            row.ItemName = row.Cost.Name;
            row.Breakdown = null;
            row.Restored = true;
            shown++;
        }
        if (shown == 0) return;
        StateHasChanged();
        await MainThreadYield.Async(_lifetime.Token);
    }
    private static TradeMarginCost Named(MarginRow row, TradeMarginCost cost) =>
        cost.Name == "Item unavailable" && row.ItemName != "Item" ? cost with { Name = row.ItemName } : cost;
    /// <summary>
    /// Stored market data read during one background pass: each item/data-center pair is read
    /// from the browser's store at most once, however many rows share it (shards, crystals,
    /// ingots, lumber). Entries fetched during the pass replace what was read.
    /// </summary>
    private sealed class StoredPass
    {
        private readonly Dictionary<(int itemId, string dataCenter), CachedMarketData> _entries = [];
        private readonly HashSet<(int itemId, string dataCenter)> _read = [];

        public async Task<Dictionary<(int itemId, string dataCenter), CachedMarketData>> ReadAsync(
            TradeMarginCalculator calculator, IReadOnlyList<(int itemId, string dataCenter)> pairs, CancellationToken ct)
        {
            var missing = pairs.Where(pair => !_read.Contains(pair)).Distinct().ToArray();
            if (missing.Length > 0)
            {
                // A pair fetched while this read was in flight is newer: it is kept.
                foreach (var (pair, entry) in await calculator.ReadStoredAsync(missing, ct)) _entries.TryAdd(pair, entry);
                _read.UnionWith(missing);
            }
            return pairs.Distinct().Where(_entries.ContainsKey).ToDictionary(pair => pair, pair => _entries[pair]);
        }

        public void Landed(IReadOnlyDictionary<(int itemId, string dataCenter), CachedMarketData> fetched)
        {
            foreach (var (pair, entry) in fetched)
            {
                _entries[pair] = entry;
                _read.Add(pair);
            }
        }
    }
    /// <summary>Background order: rows someone waits on, then the mode on screen, then the other mode.</summary>
    private int Priority(MarginRow row) => _urgent.Contains(row.Key) ? 0 : row.Mode == _mode ? 1 : 2;
    private RowKey? NextToStage() => _rows
        .Where(row => NeedsPricing(row) && !_staged.Contains(row.Key) && !_staging.ContainsKey(row.Key))
        .OrderBy(Priority).ThenBy(row => row.Cost == null ? 0 : 1)
        .Select(row => (RowKey?)row.Key).FirstOrDefault();
    private RowKey? NextToUpdate() => _rows
        .Where(row => !_updated.Contains(row.Key) && !_staging.ContainsKey(row.Key))
        .OrderBy(Priority).ThenBy(row => Unpriced(row) ? 0 : 1)
        .Select(row => (RowKey?)row.Key).FirstOrDefault();
    /// <summary>
    /// Queues every row without a figure to be prepared and priced from the market data the
    /// browser holds, whatever its age, and the background update to refetch what is due. Never
    /// waits on that work. With <paramref name="refresh"/>, every row refetches every pair.
    /// </summary>
    private void QueuePricing(bool refresh)
    {
        if (_disposed) return;
        if (refresh) foreach (var row in _rows) _forceFetch.Add(row.Key);
        _staged.Clear();
        StartPriceUpdate();
    }
    private void StartPriceUpdate()
    {
        var scope = (_profile?.Id, MarginScope);
        if (_priceJob != null && _priceJobScope == scope)
        {
            _priceAgain = true;
            return;
        }
        _priceJob?.Cancel();
        _priceJobScope = scope;
        var job = _priceJob = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _ = RunPriceUpdateAsync(job);
    }
    /// <summary>
    /// Prepares and prices rows from stored data, then brings stored prices up to date, never
    /// holding _gate while a row is prepared or Universalis answers. The next row is chosen
    /// before every step, so switching mode or expanding a row moves it ahead, and a row added
    /// mid-pass is priced from stored data before the next fetch. Each stored pair is read once
    /// and each item/data-center pair fetched at most once per pass; rows reprice in place as
    /// their data lands, keeping expanded rows and values being typed.
    /// </summary>
    private async Task RunPriceUpdateAsync(CancellationTokenSource job)
    {
        var ct = job.Token;
        try
        {
            do
            {
                _priceAgain = false;
                _staged.Clear();
                _updated.Clear();
                var (company, scope) = _priceJobScope;
                var forcedPass = _forceFetch.Count > 0;
                var pass = _storedPass = new StoredPass();
                var attempted = new HashSet<(int itemId, string dataCenter)>();
                var landed = new Dictionary<(int itemId, string dataCenter), CachedMarketData>();
                while (true)
                {
                    ct.ThrowIfCancellationRequested();
                    if (NextToStage() is { } next)
                    {
                        _staged.Add(next);
                        if (!await StageAsync(next, company, scope, pass, ct)) return;
                        await MainThreadYield.Async(ct);
                        continue;
                    }
                    if (NextToUpdate() is not { } key)
                    {
                        // A row still being prepared (on demand, or by a cancelled pass) is updated once it lands.
                        if (_staging.Count == 0) break;
                        await Task.WhenAny(_staging.Values);
                        continue;
                    }
                    _updated.Add(key);
                    var row = _rows.FirstOrDefault(candidate => candidate.Key == key);
                    if (row?.Plan is not { Issue: null } plan || row.Market is not { } stored)
                    {
                        _forceFetch.Remove(key);
                        _urgent.Remove(key);
                        continue;
                    }
                    var forced = _forceFetch.Contains(key);
                    var reuseCutoff = DateTime.UtcNow - MarketEvidencePolicyDefaults.AgingThreshold;
                    var pairs = TradeMarginCalculator.Pairs(plan, scope);
                    var due = pairs.Where(pair => !attempted.Contains(pair) &&
                        (forced || !stored.TryGetValue(pair, out var entry) || entry.FetchedAt <= reuseCutoff)).ToArray();
                    if (due.Length > 0)
                    {
                        attempted.UnionWith(due);
                        var result = await Calculator.FetchAsync(due, ct);
                        foreach (var (pair, entry) in result.Stored) landed[pair] = entry;
                        pass.Landed(result.Stored);
                        LogKeptPrices(result, stored);
                    }
                    var updated = pairs.Where(landed.ContainsKey).ToArray();
                    if (updated.Length > 0 || (Unpriced(row) && due.Length > 0))
                    {
                        var market = new Dictionary<(int itemId, string dataCenter), CachedMarketData>(stored);
                        foreach (var pair in updated) market[pair] = landed[pair];
                        if (!await ApplyUpdateAsync(key, plan, market, company, scope, ct)) return;
                    }
                    _urgent.Remove(key);
                    if (forced && _forceFetch.Remove(key) && !_disposed) StateHasChanged();
                }
                if (forcedPass && !_disposed) _lastCheckedUtc = DateTime.UtcNow;
            } while (_priceAgain && !ct.IsCancellationRequested);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) { Log.LogWarning(ex, "Margins price update stopped; stored prices kept"); }
        finally
        {
            if (ReferenceEquals(_priceJob, job))
            {
                _priceJob = null;
                _storedPass = null;
                _forceFetch.Clear();
                if (!_disposed) StateHasChanged();
            }
            job.Dispose();
        }
    }
    /// <summary>
    /// Prepares one row and prices it from stored market data without holding _gate; the result
    /// lands under _gate only while the company and scope match and the row still has no
    /// figure priced this session. False when the company or scope changed.
    /// </summary>
    private Task<bool> StageAsync(RowKey key, Guid? company, TradeMarginMarketScope? scope, StoredPass pass,
        CancellationToken ct)
    {
        if (_staging.TryGetValue(key, out var running)) return running;
        if (_rows.FirstOrDefault(candidate => candidate.Key == key) is not { } row || !NeedsPricing(row)) return Task.FromResult(true);
        var task = StageRowAsync(row, key, company, scope, pass, ct);
        // Completion removes the entry, which can only happen after it is added here.
        if (!task.IsCompleted) _staging[key] = task;
        return task;
    }
    private async Task<bool> StageRowAsync(MarginRow row, RowKey key, Guid? company, TradeMarginMarketScope? scope,
        StoredPass pass, CancellationToken ct)
    {
        try
        {
            var pricing = Pricing;
            TradeMarginCalculator.PreparedRow? plan = null;
            Dictionary<(int itemId, string dataCenter), CachedMarketData>? market = null;
            TradeMarginCost? cost = null;
            Exception? failure = null;
            try
            {
                plan = row.Plan != null && Unpriced(row) ? row.Plan : await Calculator.PrepareAsync(key.ItemId, scope, ct, row.Batch,
                    includeRootMarket: key.Mode == TradeMarginMode.Source);
                market = await pass.ReadAsync(Calculator, TradeMarginCalculator.Pairs(plan, scope), ct);
                // A row without stored data for some material in some data center of the scope
                // waits for the update rather than showing a figure priced from part of the scope.
                if (TradeMarginCalculator.HasMarketData(plan, scope, market))
                    cost = await TradeMarginCalculator.PriceAsync(plan, scope, market, pricing, ct);
            }
            catch (Exception ex) when (!ct.IsCancellationRequested) { failure = ex; }
            var name = failure != null && row.ItemName == "Item" ? await LookupNameAsync(key.ItemId, ct) : null;
            await _gate.WaitAsync(ct);
            try
            {
                if (_disposed || _profile?.Id != company || MarginScope != scope) return false;
                if (_rows.FirstOrDefault(candidate => candidate.Key == key) is not { } current || !NeedsPricing(current)) return true;
                if (failure != null)
                {
                    if (name != null && current.ItemName == "Item") current.ItemName = name;
                    current.Plan = null;
                    MarkPricingFailed(current, failure);
                }
                else
                {
                    current.Plan = plan;
                    current.Market = market;
                    if (cost != null) SetCost(current, Named(current, await ToCurrentPricingAsync(cost, pricing, current, ct)));
                }
                StateHasChanged();
                return true;
            }
            finally { _gate.Release(); }
        }
        finally { _staging.Remove(key); }
    }
    /// <summary>
    /// Prepares and prices one row from stored data at once, ahead of the background pass (a row
    /// just added or expanded), and makes sure the background update fetches what it is due.
    /// </summary>
    private async Task StageNowAsync(RowKey key)
    {
        if (_disposed) return;
        _urgent.Add(key);
        _staged.Add(key);
        try
        {
            await StageAsync(key, _profile?.Id, MarginScope, _storedPass ?? new StoredPass(), _lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return; }
        // A pass cancelled for a company or scope change took the row with it; the new pass prices it.
        catch (OperationCanceledException) { }
        catch (Exception ex) { ReportError(ex); }
        // A running pass updates the row in turn; otherwise a new pass starts.
        _updated.Remove(key);
        if (_priceJob == null) StartPriceUpdate();
        if (!_disposed) StateHasChanged();
    }
    /// <summary>Reprices one row from updated market data; false when the company or scope changed.</summary>
    private async Task<bool> ApplyUpdateAsync(RowKey key, TradeMarginCalculator.PreparedRow plan,
        Dictionary<(int itemId, string dataCenter), CachedMarketData> market, Guid? company, TradeMarginMarketScope? scope,
        CancellationToken ct)
    {
        TradeMarginCost cost;
        var pricing = Pricing;
        try { cost = await TradeMarginCalculator.PriceAsync(plan, scope, market, pricing, ct); }
        catch (Exception ex) when (!ct.IsCancellationRequested)
        {
            Log.LogWarning(ex, "Margins could not price item {ItemId} ({Mode}) from updated market data; stored prices kept", key.ItemId, key.Mode);
            return true;
        }
        await _gate.WaitAsync(ct);
        try
        {
            if (_disposed || _profile?.Id != company || MarginScope != scope) return false;
            var row = _rows.FirstOrDefault(candidate => candidate.Key == key);
            if (row == null) return true;
            row.Plan = plan;
            row.Market = market;
            SetCost(row, Named(row, await ToCurrentPricingAsync(cost, pricing, row, ct)));
            StateHasChanged();
            return true;
        }
        finally { _gate.Release(); }
    }
    /// <summary>
    /// Runs under _gate. Labor, material sources, the pricing policy or the batch size may have
    /// changed while a cost was priced outside _gate: it is brought to the current ones from its evidence.
    /// </summary>
    private async Task<TradeMarginCost> ToCurrentPricingAsync(TradeMarginCost cost, TradeMarginPricing pricing,
        MarginRow row, CancellationToken ct)
    {
        while (cost.Basis != null && (!IsCurrent(pricing) || cost.BatchSize != row.Batch))
        {
            pricing = Pricing;
            cost = await TradeMarginCalculator.RepriceAsync(cost, pricing, row.Batch, ct);
        }
        return cost;
    }
    /// <summary>True when <paramref name="pricing"/> still matches the company's labor rate, sources and policy.</summary>
    private bool IsCurrent(TradeMarginPricing pricing) =>
        Pricing is var current && pricing.LaborGilPerSynth == current.LaborGilPerSynth && pricing.RouteKey == current.RouteKey &&
        pricing.Sources.Count == current.Sources.Count &&
        current.Sources.All(pair => pricing.Sources.TryGetValue(pair.Key, out var source) && source == pair.Value);
    /// <summary>Names every pair Universalis did not answer, per data center, and what the row keeps.</summary>
    private void LogKeptPrices(MarketPairRefreshResult result, IReadOnlyDictionary<(int itemId, string dataCenter), CachedMarketData> stored)
    {
        foreach (var group in result.Failed.GroupBy(pair => pair.dataCenter, StringComparer.OrdinalIgnoreCase))
        {
            var kept = group.Select(pair => stored.TryGetValue(pair, out var entry)
                ? $"{pair.itemId} (stored {RelativeAge(entry.FetchedAt)} old)" : $"{pair.itemId} (nothing stored)");
            Log.LogWarning("Margins price update: {DataCenter} did not answer for {Count} items ({Failure}); kept {Kept}",
                group.Key, group.Count(), result.FailureByDataCenter.GetValueOrDefault(group.Key, "no data returned"),
                string.Join(", ", kept));
        }
    }
    /// <summary>Shows a cost priced in this session and saves its figures for the next open.</summary>
    private void SetCost(MarginRow row, TradeMarginCost cost)
    {
        row.Cost = cost;
        row.Restored = false;
        row.ItemName = cost.Name;
        // An open row keeps its breakdown on screen until the new one is described; a closed
        // row's is dropped, so it never reopens on figures it no longer matches.
        if (cost.Basis == null || !_expanded.Contains(row.Key))
        {
            row.Breakdown = null;
            row.BreakdownFor = null;
        }
        if (!IsFailure(cost) && _profile != null && FiguresInputs(row, cost.BatchSize) is { } inputs)
            SavedFigures.Save(_profile.Id, row.Mode, row.ItemId, inputs, cost);
        _ = DescribeSafelyAsync(row);
    }
    /// <summary>True when the row's breakdown was described for its current cost and pricing.</summary>
    private bool HasCurrentBreakdown(MarginRow row) =>
        row.Breakdown != null && row.BreakdownFor is { } basis && ReferenceEquals(basis.Cost, row.Cost) &&
        IsCurrent(basis.Pricing);
    /// <summary>Re-describes an expanded row from its current cost; a newer cost wins.</summary>
    private async Task DescribeSafelyAsync(MarginRow row)
    {
        if (_disposed || !_expanded.Contains(row.Key) || row.Cost is not { Basis: not null } cost || HasCurrentBreakdown(row)) return;
        var pricing = Pricing;
        try
        {
            var breakdown = await TradeMarginCalculator.DescribeAsync(cost, pricing, _lifetime.Token);
            // Rows are rebuilt on every sync: the breakdown lands on whichever row now shows this cost.
            if (_disposed || _rows.FirstOrDefault(candidate => candidate.Key == row.Key) is not { } current ||
                !ReferenceEquals(current.Cost, cost)) return;
            current.Breakdown = breakdown;
            current.BreakdownFor = (cost, pricing);
            StateHasChanged();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) { ReportError(ex); }
    }
    /// <summary>Reprices every row for the current labor rate, material sources and pricing policy, without fetching.</summary>
    private async Task RepriceAllAsync()
    {
        var pricing = Pricing;
        foreach (var row in _rows.ToArray())
        {
            if (_disposed) return;
            // Saved figures were computed for the previous rate and sources: they no longer apply.
            if (row.Restored) { row.Cost = null; row.Restored = false; continue; }
            if (row.Cost is not { Basis: not null } cost) continue;
            var repriced = await TradeMarginCalculator.RepriceAsync(cost, pricing, _lifetime.Token);
            if (ReferenceEquals(row.Cost, cost)) SetCost(row, repriced);
        }
        if (!_disposed) StateHasChanged();
    }
    /// <summary>A row opens once it has evidence to describe, or saved figures to price it from on demand.</summary>
    private static bool Expandable(MarginRow row) => row.Cost is { Basis: not null } || row.Restored && row.Cost?.Issue == null;
    // An open row waiting for its first figure stays open (and closable) instead of flickering shut.
    private bool ShowsExpander(MarginRow row) => Expandable(row) || row.Cost == null && _expanded.Contains(row.Key);
    private bool IsExpanded(MarginRow row) => _expanded.Contains(row.Key) && (row.Cost == null || Expandable(row));
    /// <summary>
    /// Opens at once. An unchanged breakdown is reused; otherwise the row shows a loading line
    /// while it is described, or (saved figures only) prepared and priced ahead of the table.
    /// </summary>
    private async Task ToggleExpandedAsync(MarginRow row)
    {
        if (_expanded.Remove(row.Key) || _disposed) return;
        _expanded.Add(row.Key);
        if (HasCurrentBreakdown(row)) return;
        row.Breakdown = null;
        row.BreakdownFor = null;
        StateHasChanged();
        try { await MainThreadYield.Async(_lifetime.Token); }
        catch (OperationCanceledException) { return; }
        if (row.Cost is { Basis: not null }) await DescribeSafelyAsync(row);
        // Pricing describes the open row as its cost lands.
        else await StageNowAsync(row.Key);
    }
    private async Task<string?> LookupNameAsync(int itemId, CancellationToken ct)
    {
        try { return (await Garland.GetItemAsync(itemId, ct))?.Name; }
        catch (Exception) when (!ct.IsCancellationRequested) { return null; /* Preserve the pricing error. */ }
    }
    private async Task ShowPricingFailureAsync(MarginRow row, Exception error, CancellationToken ct)
    {
        if (row.ItemName == "Item") row.ItemName = await LookupNameAsync(row.ItemId, ct) ?? "Item";
        ct.ThrowIfCancellationRequested();
        MarkPricingFailed(row, error);
    }
    private void MarkPricingFailed(MarginRow row, Exception error)
    {
        row.Cost = new(row.Name, row.Cost?.IconId ?? 0, null, null, null, [], "Pricing failed");
        row.Restored = false;
        row.Breakdown = null;
        row.BreakdownFor = null;
        ReportError(error);
