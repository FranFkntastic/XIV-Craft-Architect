    private async Task BatchKeyAsync(KeyboardEventArgs e, RowKey key)
    {
        if (e.Key == "Enter") await CommitBatchAsync(key);
    }
    /// <summary>
    /// Reprices the row for the new batch size from its evidence, then saves it beside the sale
    /// price. Empty, zero or unparsable input keeps the previous batch size.
    /// </summary>
    private async Task CommitBatchAsync(RowKey key)
    {
        if (_editingBatch != key) return;
        var draft = _batchDraft;
        _editingBatch = null;
        _batchDraft = "";
        if (!int.TryParse(draft, NumberStyles.None, CultureInfo.InvariantCulture, out var batch) || batch < 1) return;
        batch = Math.Min(batch, TradeMarginItem.MaxBatchSize);
        await _gate.WaitAsync();
        try
        {
            if (_disposed || _rows.FirstOrDefault(item => item.Key == key) is not { } row || row.Batch == batch) return;
            var previous = row.Batch;
            row.Batch = batch;
            await RepriceBatchAsync(row);
            try
            {
                await SaveItemsAsync(items => items.Select(item => KeyOf(item) == key ? item with { BatchSize = batch } : item).ToArray());
            }
            catch (Exception ex)
            {
                if (_rows.FirstOrDefault(item => item.Key == key) is { } displayed)
                {
                    displayed.Batch = previous;
                    await RepriceBatchAsync(displayed);
                }
                ReportError(ex);
            }
        }
        catch (Exception ex) { ReportError(ex); }
        finally { _gate.Release(); if (!_disposed) StateHasChanged(); }
    }
    /// <summary>Brings a row's cost to its batch size without fetching; a row without evidence is recalculated.</summary>
    private async Task RepriceBatchAsync(MarginRow row)
    {
        if (row.Cost is not { } cost || cost.BatchSize == row.Batch) return;
        // Saved figures are never repriced: the row is priced for the new batch size from scratch.
        if (cost.Basis == null || row.Restored)
        {
            row.Cost = null;
            row.Restored = false;
            row.Breakdown = null;
            row.Plan = null;
            QueuePricing(false);
            return;
        }
        try { SetCost(row, await TradeMarginCalculator.RepriceAsync(cost, Pricing, row.Batch, _lifetime.Token)); }
        catch (Exception ex) when (!_lifetime.IsCancellationRequested) { await ShowPricingFailureAsync(row, ex, _lifetime.Token); }
    }
    // Opens Trade Orders with a New Order draft already holding this item.
    private void CreateCommission(MarginRow row)
    {
        var query = new Dictionary<string, object?>
        {
            ["newOrderItem"] = row.ItemId,
            ["newOrderName"] = row.Name is { Length: > 0 } name && name != "Item" ? name : null,
            ["newOrderQuantity"] = row.Batch,
            ["company"] = _profile?.Id.ToString()
        };
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("trade/orders", query));
    }
    /// <summary>
    /// Builds this row's item and batch as the Recipe Planner's active plan, runs its market
    /// analysis in the row's Margins scope (listings already stored in this browser are reused)
    /// and opens the planner. Company settings and the planner's default market are untouched; a
    /// saved active plan is kept first, and an unsaved one is never replaced.
    /// </summary>
    private async Task OpenInPlannerAsync(MarginRow row)
    {
        if (_openingPlanner != null) return;
        if (MarginScope is not { } scope)
        {
            Snackbar.Add("Choose where Margins prices from before opening the planner.", Severity.Warning);
            return;
        }
        var shell = WorkerProjections.Shell;
        if (shell.HasSession && string.IsNullOrWhiteSpace(shell.PlanId))
        {
            Snackbar.Add("Your unsaved Recipe Planner plan is kept. Save or clear it there, then open this item again.", Severity.Warning);
            return;
        }

        _openingPlanner = row.Key;
        var operation = AppState.BeginOperation("Recipe plan", $"Opening {row.Name} in the Recipe Planner...");
        StateHasChanged();
        try
        {
            if (shell.HasSession)
            {
                // Edits to the saved active plan are kept before the new plan replaces it.
                var snapshot = await WorkerSession.ExportStoredPlanAsync(shell.PlanId!, shell.PlanName ?? "Saved Plan",
                    includeSourcePlanIdentity: true, _lifetime.Token)
                    ?? throw new InvalidOperationException("The active planner plan could not be exported.");
                if (!(await PlanPersistence.PreserveBeforeReplacementAsync(snapshot)).Success)
                    throw new InvalidOperationException("The active planner plan could not be saved.");
            }
            // A fresh session, so the new plan never takes over (and later overwrites) a saved plan's identity.
            await WorkerSession.ClearSessionAsync(_lifetime.Token);
            var commission = scope.Commission;
            var region = commission?.Region ?? scope.Regions[0];
            var build = await PlanLifecycle.BuildRecipeAsync(
                new WorkerRecipeBuildRequest(
                    [new ProjectItem { Id = row.ItemId, Name = row.Name, IconId = row.Cost?.IconId ?? 0, Quantity = row.Batch }],
                    commission?.EffectiveDataCenter ?? MarketFetchScopeResolver.ResolveValidDataCenter(region),
                    region,
                    commission?.MarketFetchScope ?? MarketFetchScope.EntireRegion),
                PlanDerivationDispatch.Deferred,
                _lifetime.Token);
            if (!build.Built) throw new InvalidOperationException(build.Message);
            var derived = await PlanLifecycle.EnsureDerivedAsync(
                new PlanDerivationRequest(
                    CompanyPricingScope: commission,
                    SkipProcurement: true,
                    MarketRegions: commission == null ? scope.Regions : null),
                _lifetime.Token);
            // The purchase route follows in the background, as after any planner build.
            PlanLifecycle.Schedule(new PlanDerivationRequest(SkipMarketRefresh: true));
            foreach (var warning in derived.Warnings) Snackbar.Add(warning, Severity.Warning);
            Navigation.NavigateTo("./");
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Margins: opening item {ItemId} (batch {Batch}) in the Recipe Planner failed", row.ItemId, row.Batch);
            if (!_disposed) Snackbar.Add($"Could not open {row.Name} in the Recipe Planner: {ex.Message}", Severity.Error);
        }
        finally
        {
            AppState.EndOperation(operation);
            _openingPlanner = null;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task RemoveAsync(MarginRow row)
    {
        await _gate.WaitAsync();
        try
        {
            var companyId = _profile?.Id;
            var removed = new TradeMarginItem(row.ItemId, row.SavedSale, row.Batch, row.Mode);
            await SaveItemsAsync(items => items.Where(item => KeyOf(item) != row.Key).ToArray());
            if (companyId is { } company) SavedFigures.Delete(company, row.Mode, row.ItemId);
            if (!_disposed) Snackbar.Add($"Removed {row.Name}.", Severity.Normal, options =>
            {
                options.Action = "Undo";
                options.Onclick = async _ => await UndoRemoveAsync(companyId, removed);
            });
        }
        catch (Exception ex) { ReportError(ex); }
        finally { _gate.Release(); }
    }
    private async Task UndoRemoveAsync(Guid? companyId, TradeMarginItem removed)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await _gate.WaitAsync();
                try
                {
                    if (_disposed) return;
                    if (_profile?.Id != companyId) throw new InvalidOperationException("The active company changed; the item was not restored.");
                    await SaveItemsAsync(items =>
                    {
                        if (items.Any(item => KeyOf(item) == KeyOf(removed))) return items;
                        if (items.Count >= 500) throw new InvalidOperationException("Margins supports at most 500 items.");
                        return items.Append(removed).ToArray();
                    });
                }
                finally { _gate.Release(); if (!_disposed) StateHasChanged(); }
            });
        }
        catch (Exception ex) { ReportError(ex); }
    }
    private async ValueTask ReleaseModuleAsync(IJSObjectReference module)
    {
        try { await module.InvokeVoidAsync("detach", _tableWrap); }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (JSException ex) { ReportError(ex); }
        finally
        {
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
            catch (JSException ex) { ReportError(ex); }
        }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        AppState.OnStateChanged -= OnStateChanged;
        _lifetime.Cancel();
        if (_ageLoop != null) await _ageLoop;
        if (_module is { } module) { _module = null; await ReleaseModuleAsync(module); }
        _lifetime.Dispose();
    }
}
