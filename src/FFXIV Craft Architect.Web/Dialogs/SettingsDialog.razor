    private string GetProfileHostConnectionLabel()
    {
        return ProfileSync.CurrentStatus.IsConnected
            ? string.IsNullOrWhiteSpace(_profileHostProfileName) ? "Connected" : _profileHostProfileName
            : "Local only";
    }

    private string GetConnectedProfileHostSummary()
    {
        if (!ProfileSync.CurrentStatus.HostReachable)
        {
            return "Browser-profile sync is paused; browser data remains available";
        }

        if (ProfileSync.CurrentStatus.ConflictCount > 0 ||
            ProfileSync.CurrentStatus.PendingCount > 0)
        {
            return GetProfileHostAttentionSummary();
        }

        return "Available in this browser and synced to the hosted profile";
    }

    private string GetProfileSyncFailureMessage()
    {
        const string prefix = "Host unreachable: ";
        var message = ProfileSync.CurrentStatus.Message;
        if (message?.StartsWith(prefix, StringComparison.Ordinal) == true)
        {
            message = message[prefix.Length..];
        }

        return string.IsNullOrWhiteSpace(message)
            ? "Browser-profile sync could not complete."
            : $"Browser-profile sync stopped: {message}";
    }

    private static string FormatCompanyReference(Guid companyId) =>
        companyId.ToString("N")[..6].ToUpperInvariant();

    private string GetProfileHostConnectionStateLabel()
    {
        if (!ProfileSync.CurrentStatus.IsConnected)
        {
            return "Not connected";
        }

        return ProfileSync.CurrentStatus.HostReachable ? "Connected" : "Needs attention";
    }

    private Color GetProfileHostConnectionColor()
    {
        if (!ProfileSync.CurrentStatus.IsConnected)
        {
            return Color.Secondary;
        }

        return ProfileSync.CurrentStatus.HostReachable ? Color.Success : Color.Warning;
    }

    private string GetProfileHostAttentionSummary()
    {
        if (ProfileSync.CurrentStatus.ConflictCount > 0)
        {
            return $"{ProfileSync.CurrentStatus.ConflictCount:N0} conflicts need review.";
        }

        return $"{ProfileSync.CurrentStatus.PendingCount:N0} local changes are waiting to sync.";
    }

    private void SetProfileHostFailure(Exception exception)
    {
        var message = exception is ProfileHostConnectionException
            ? exception.Message
            : "The profile host could not complete the request. Try again in a moment.";
        SetProfileHostStatus(message, Color.Error);
    }

    private void SetProfileHostStatus(string message, Color color)
    {
        _profileHostStatus = message;
        _profileHostStatusColor = color;
        Snackbar.Add(message, color == Color.Error ? Severity.Error : color == Color.Success ? Severity.Success : Severity.Info);
    }
    
