            }
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        @if (SectionHasExplicitSave)
        {
            <MudButton Color="Color.Primary" OnClick="SaveCurrentSectionAsync" Disabled="@_isSaving">
                @(_isSaving ? "Applying..." : SaveButtonLabel)
