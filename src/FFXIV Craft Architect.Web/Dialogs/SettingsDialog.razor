        }
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public SettingsSection InitialSection { get; set; } = SettingsSection.MarketAndRoutes;

    private static readonly IReadOnlyList<SettingsNavItem> AllSettingsSections =
    [
        new(SettingsSection.Profile, "Profile", Icons.Material.Filled.Person),
        new(SettingsSection.Workspace, "Workspace", Icons.Material.Filled.BusinessCenter),
        new(SettingsSection.AccessAndDevices, "Access & devices", Icons.Material.Filled.Devices),
