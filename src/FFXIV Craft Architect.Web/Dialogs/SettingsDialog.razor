        new(SettingsSection.Integrations, "Integrations", Icons.Material.Filled.Hub),
        new(SettingsSection.CompanyAdministration, "Company administration", Icons.Material.Filled.AdminPanelSettings, AdministratorOnly: true),
        new(SettingsSection.Storage, "Storage", Icons.Material.Filled.Storage),
        new(SettingsSection.Diagnostics, "Diagnostics", Icons.Material.Filled.Troubleshoot),
        new(SettingsSection.About, "About", Icons.Material.Filled.Info)
    ];

    private IReadOnlyList<SettingsNavItem> VisibleSettingsSections => AllSettingsSections
        .Where(tab => !tab.AdministratorOnly || _canAdministerCompany)
        .ToList();

    private sealed record SettingsNavItem(
        SettingsSection Panel,
        string Label,
        string Icon,
        bool GroupBreak = false,
        bool AdministratorOnly = false);
    private static readonly IReadOnlyList<CompactSelectOption> RegionOptions =
    [
        new("North America", "North America"),
        new("Europe", "Europe"),
        new("Japan", "Japan"),
        new("Oceania", "Oceania")
    ];
    private static readonly IReadOnlyList<CompactSelectOption> MarketFetchScopeOptions =
    [
        new(nameof(MarketFetchScope.SelectedDataCenter), "Selected data center"),
        new(nameof(MarketFetchScope.EntireRegion), "Entire region")
    ];
    private static readonly IReadOnlyList<CompactSelectOption> TravelPriorityOptions =
    [
        new(nameof(MarketTravelPriority.DataCenterTransfersFirst), "Avoid data-center transfers first"),
        new(nameof(MarketTravelPriority.WorldVisitsFirst), "Avoid total world visits first")
    ];
    private static readonly IReadOnlyList<CompactSelectOption> PaymentContractOptions =
    [
        new(nameof(TradePaymentContractMode.LegacyCommission), "Legacy commission"),
        new(nameof(TradePaymentContractMode.LaborStandard), "Labor standard")
    ];
    private readonly ElementReference[] _tabElements = new ElementReference[AllSettingsSections.Count];
    private SettingsSection _activePanel = SettingsSection.MarketAndRoutes;
    private bool _canAdministerCompany;

    private static string GetTabId(SettingsSection panel) => $"settings-nav-{panel.ToString().ToLowerInvariant()}";
    private static string GetPanelId(SettingsSection panel) => $"settings-section-{panel.ToString().ToLowerInvariant()}";

    private async Task SelectTab(SettingsSection panel)
    {
        if (panel != _activePanel && HasPendingCompanyChanges)
        {
            var discard = await ConfirmDiscardCompanyChangesAsync();
            if (!discard)
            {
                return;
            }
            if (_companyProfile != null)
            {
                ApplyCompanyProfileFields(_companyProfile);
            }
        }
        if (!VisibleSettingsSections.Any(tab => tab.Panel == panel))
        {
            panel = SettingsSection.MarketAndRoutes;
        }

        _activePanel = panel;
        if (_activePanel == SettingsSection.Diagnostics)
        {
            await PrepareDiagnosticsAsync();
        }
    }

    private async Task HandleTabKeyDown(KeyboardEventArgs args, int currentIndex)
    {
        var visibleTabs = VisibleSettingsSections;
        var nextIndex = args.Key switch
        {
            "ArrowDown" => (currentIndex + 1) % visibleTabs.Count,
            "ArrowUp" => (currentIndex - 1 + visibleTabs.Count) % visibleTabs.Count,
            "Home" => 0,
            "End" => visibleTabs.Count - 1,
            _ => currentIndex
        };

        if (nextIndex == currentIndex)
        {
            return;
        }

        await SelectTab(visibleTabs[nextIndex].Panel);
        await InvokeAsync(StateHasChanged);
        await _tabElements[nextIndex].FocusAsync();
    }
    
    private string _defaultDataCenter = "Aether";
    private string _selectedRegion = "North America";
    private IReadOnlyList<string> _comparisonRegions = Array.Empty<string>();
