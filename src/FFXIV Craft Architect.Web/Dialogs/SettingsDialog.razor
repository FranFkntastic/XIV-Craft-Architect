    private string? _marketMafiosoConnectionStatus;
    private bool _isClearing = false;
    private TradeCompanyProfile? _companyProfile;
    private string _companyName = string.Empty;
    private string? _companyDescription;
    private string? _companyCommissionContact;
    private int _companyCrafterCount;
    private string? _companyLoadError;
    private bool _companyIsBusy;
    private CompanyDiscordNotificationRouteEditor? _companyNotificationRouteEditor;
    private TradePaymentContractMode _companyPaymentContract = TradePaymentContractMode.LegacyCommission;
    private decimal _companyLegacyCommissionPercent = CommissionPayoutPolicy.Default.CommissionPercent;
    private decimal _companyLaborGilPerSynth = TradePaymentPolicy.DefaultLaborGilPerSynth;
    private string? _persistedCompanyFingerprint;
    private string? _profileHostProfileName;
    private bool _profileHostIsBusy;
    private string? _profileHostStatus;
    private Color _profileHostStatusColor = Color.Secondary;
    private string _profileHostBusyMessage = "Connecting...";
    private bool _diagnosticsBusy;
    private bool _diagnosticSnapshotReady;
    private bool _prepareDiagnosticAttachment;
    private string? _diagnosticSnapshotFileName;
    private TradeIndexedDbDiagnostics? _tradeStorageDiagnostics;
    private CacheStats? _marketCacheStats;
    private string? _diagnosticStorageError;
    private bool _isPurgingCommissions;
    private string? _commissionPurgeStatus;
    private const string DiagnosticSnapshotSaveKey = "options-diagnostic-snapshot";
    private const string CommissionResetBackupSaveKey = "options-commission-reset-backup";

    private static readonly JsonSerializerOptions CompanyPackageJsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true,
        PropertyNameCaseInsensitive = true
    };
    
    private readonly Dictionary<string, string> _lastDataCenterByRegion =
        new(StringComparer.OrdinalIgnoreCase);
    
    protected override async Task OnInitializedAsync()
    {
        _activePanel = InitialSection;
        _defaultDataCenter = await Settings.GetAsync("market.default_datacenter", "Aether") ?? "Aether";
        _selectedRegion = await Settings.GetAsync("market.region", "North America") ?? "North America";
        _comparisonRegions = await LoadComparisonRegionsAsync();
        foreach (var region in MarketFetchScopeResolver.GetRegions())
        {
            var savedDataCenter = await Settings.GetAsync(
                GetRegionDataCenterSettingKey(region),
                string.Empty) ?? string.Empty;
            if (MarketFetchScopeResolver.IsDataCenterInRegion(savedDataCenter, region))
            {
                _lastDataCenterByRegion[region] = savedDataCenter;
            }
        }
        _defaultDataCenter = MarketFetchScopeResolver.ResolveValidDataCenter(
            _selectedRegion,
            _defaultDataCenter);
        _lastDataCenterByRegion[_selectedRegion] = _defaultDataCenter;
        _comparisonRegions = NormalizeComparisonRegions(_comparisonRegions, _selectedRegion);
        _defaultMarketFetchScope = ParseMarketFetchScope(
            await Settings.GetAsync("market.default_search_scope", nameof(MarketFetchScope.EntireRegion)));
        _procurementEnableSplitWorldPurchases = await Settings.GetAsync("procurement.enable_split_world_purchases", true);
        _procurementStartFromHomeDataCenter = await Settings.GetAsync("procurement.start_from_home_data_center", false);
        _procurementTravelPriority = ParseTravelPriority(
            await Settings.GetAsync(
                "procurement.travel_priority",
                nameof(MarketTravelPriority.DataCenterTransfersFirst)));
        _marketMafiosoEnabled = await Settings.GetAsync("marketmafioso.enabled", false);
        _marketMafiosoApiUrl = await Settings.GetAsync(
            "marketmafioso.workshop_host_url",
            string.Empty) ?? string.Empty;
        _marketMafiosoApiKey = await Settings.GetAsync("marketmafioso.api_key", string.Empty) ?? string.Empty;
        _marketMafiosoTargetCharacter = await Settings.GetAsync("marketmafioso.target_character", string.Empty) ?? string.Empty;
        _marketMafiosoTargetWorld = await Settings.GetAsync("marketmafioso.target_world", string.Empty) ?? string.Empty;
        _marketMafiosoAutoSyncEvidence = await Settings.GetAsync("marketmafioso.auto_sync_evidence", true);

        await LoadCompanyProfileAsync();
        if (_companyProfile != null)
        {
            try
            {
                _canAdministerCompany = (await CompanyHubClient.LoadMembershipsAsync())
                    .Any(membership =>
                        string.Equals(membership.CompanyId, _companyProfile.Id.ToString("D"), StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(membership.State, "active", StringComparison.OrdinalIgnoreCase) &&
                        membership.Role is "owner" or "operator");
            }
            catch
            {
                _canAdministerCompany = false;
            }
        }
        if (!VisibleSettingsSections.Any(section => section.Panel == _activePanel))
        {
            _activePanel = SettingsSection.MarketAndRoutes;
        }
        await LoadProfileHostSettingsAsync();
        if (_activePanel == SettingsSection.Diagnostics)
        {
            await PrepareDiagnosticsAsync();
        }
    }

    private async Task TestMarketMafiosoConnectionAsync()
    {
        _marketMafiosoConnectionIsBusy = true;
        _marketMafiosoConnectionTest = null;
        _marketMafiosoConnectionStatus = null;
        _marketMafiosoTestedConfigurationHash = GetMarketMafiosoConfigurationHash();
        try
        {
            _marketMafiosoConnectionTest = await MarketMafiosoAcquisitionWorkflow.TestConnectionAsync(
                _marketMafiosoApiUrl,
                _marketMafiosoApiKey);
            var service = string.IsNullOrWhiteSpace(_marketMafiosoConnectionTest.Service)
                ? "Workshop Host"
                : _marketMafiosoConnectionTest.Service;
            _marketMafiosoConnectionStatus = _marketMafiosoConnectionTest.AcquisitionQueueAvailable
                ? $"Connected to {service}. Market acquisition handoff is ready."
                : $"Connected to {service}, but this instance does not support market acquisition handoff.";
        }
        catch (Exception ex)
        {
            _marketMafiosoConnectionStatus = DescribeMarketMafiosoConnectionFailure(ex);
        }
        finally
        {
            _marketMafiosoConnectionIsBusy = false;
        }
    }

    private bool IsCurrentMarketMafiosoConnectionTest() =>
        _marketMafiosoTestedConfigurationHash == GetMarketMafiosoConfigurationHash();

    private int GetMarketMafiosoConfigurationHash() => HashCode.Combine(
        _marketMafiosoApiUrl.Trim().ToUpperInvariant(),
        _marketMafiosoApiKey.Trim());

    private Task OnMarketMafiosoEnabledChanged(bool value) =>
        SaveIntegrationSettingAsync(
            "marketmafioso.enabled",
            value,
            () => _marketMafiosoEnabled,
            saved =>
            {
                _marketMafiosoEnabled = saved;
                MarketMafiosoIntegrationState.SetEnabled(saved);
            });

    private Task OnMarketMafiosoApiUrlChanged(string value) =>
        SaveIntegrationSettingAsync(
            "marketmafioso.workshop_host_url",
            value.Trim(),
            () => _marketMafiosoApiUrl,
            saved => _marketMafiosoApiUrl = saved,
            invalidateConnectionTest: true);

    private Task OnMarketMafiosoApiKeyChanged(string value) =>
        SaveIntegrationSettingAsync(
            "marketmafioso.api_key",
            value.Trim(),
            () => _marketMafiosoApiKey,
            saved => _marketMafiosoApiKey = saved,
            invalidateConnectionTest: true);

    private Task OnMarketMafiosoTargetCharacterChanged(string value) =>
        SaveIntegrationSettingAsync(
            "marketmafioso.target_character",
            value.Trim(),
            () => _marketMafiosoTargetCharacter,
            saved => _marketMafiosoTargetCharacter = saved);

    private Task OnMarketMafiosoTargetWorldChanged(string value) =>
        SaveIntegrationSettingAsync(
            "marketmafioso.target_world",
            value.Trim(),
            () => _marketMafiosoTargetWorld,
            saved => _marketMafiosoTargetWorld = saved);

    private Task OnMarketMafiosoAutoSyncChanged(bool value) =>
        SaveIntegrationSettingAsync(
            "marketmafioso.auto_sync_evidence",
            value,
            () => _marketMafiosoAutoSyncEvidence,
            saved => _marketMafiosoAutoSyncEvidence = saved);

    private async Task SaveIntegrationSettingAsync<T>(
        string key,
        T value,
        Func<T> readCurrent,
        Action<T> apply,
        bool invalidateConnectionTest = false)
    {
        var previous = readCurrent();
        if (EqualityComparer<T>.Default.Equals(previous, value))
        {
            return;
        }

        apply(value);
        if (invalidateConnectionTest)
        {
            InvalidateMarketMafiosoConnectionTest();
        }
        try
        {
            await Settings.SetAsync(key, value);
        }
        catch (Exception exception)
        {
            apply(previous);
            Snackbar.Add($"Integration setting was not saved: {exception.Message}", Severity.Error);
        }
    }

    private void InvalidateMarketMafiosoConnectionTest()
    {
        _marketMafiosoConnectionTest = null;
        _marketMafiosoConnectionStatus = null;
        _marketMafiosoTestedConfigurationHash = null;
    }

    private async Task ForgetMarketMafiosoKey()
    {
        _marketMafiosoApiKey = string.Empty;
        InvalidateMarketMafiosoConnectionTest();
        await Settings.SetAsync("marketmafioso.api_key", string.Empty);
        Snackbar.Add("Craft Architect access key forgotten", Severity.Info);
    }

    private async Task OpenMarketMafiosoKeyManagerAsync()
    {
        if (!Uri.TryCreate(_marketMafiosoApiUrl.Trim(), UriKind.Absolute, out var apiUri))
        {
            Snackbar.Add("Enter a valid Workshop Host API URL first", Severity.Warning);
            return;
        }

        var apiSegment = apiUri.AbsolutePath.IndexOf("/api", StringComparison.OrdinalIgnoreCase);
        var dashboardPath = apiSegment < 0
            ? "/settings"
            : $"{apiUri.AbsolutePath[..apiSegment].TrimEnd('/')}/settings";
        var dashboardUri = new UriBuilder(apiUri)
        {
            Path = dashboardPath,
            Query = "tab=authentication",
            Fragment = string.Empty,
        }.Uri;

        await JSRuntime.InvokeVoidAsync("open", dashboardUri.ToString(), "_blank", "noopener,noreferrer");
    }

    private string GetMarketMafiosoConnectionLabel()
    {
        if (!_marketMafiosoEnabled)
            return "Disabled";
        if (!IsCurrentMarketMafiosoConnectionTest())
            return "Not tested";
        if (_marketMafiosoConnectionTest?.AcquisitionQueueAvailable == true)
            return "Ready";
        return _marketMafiosoConnectionTest == null ? "Failed" : "Limited";
    }

    private Color GetMarketMafiosoConnectionColor()
    {
        if (!_marketMafiosoEnabled)
            return Color.Default;
        if (!IsCurrentMarketMafiosoConnectionTest())
            return Color.Secondary;
        if (_marketMafiosoConnectionTest?.AcquisitionQueueAvailable == true)
            return Color.Success;
        return _marketMafiosoConnectionTest == null ? Color.Error : Color.Warning;
    }

    private static string DescribeMarketMafiosoConnectionFailure(Exception exception)
    {
        if (exception is HttpRequestException { StatusCode: System.Net.HttpStatusCode.Unauthorized })
            return "Connection failed: the Workshop Host rejected this client API key.";
        if (exception is HttpRequestException { StatusCode: null })
            return "Connection failed: CA could not reach the Workshop Host. Check the API URL and MarketMafioso__AllowedOrigins__0 when the hosts differ.";
        return $"Connection failed: {exception.Message}";
    }
    
    private IReadOnlyList<string> GetAvailableDataCenters() =>
        MarketFetchScopeResolver.GetDataCentersForRegion(_selectedRegion);

    private async Task OnRegionChanged(string region)
    {
        if (string.Equals(region, _selectedRegion, StringComparison.Ordinal))
        {
            return;
        }

        await ApplyMarketSelectionChangeAsync(() =>
        {
            if (MarketFetchScopeResolver.IsDataCenterInRegion(
                    _defaultDataCenter,
                    _selectedRegion))
            {
                _lastDataCenterByRegion[_selectedRegion] = _defaultDataCenter;
            }

            _selectedRegion = region;
            _comparisonRegions = NormalizeComparisonRegions(_comparisonRegions, region);
            _lastDataCenterByRegion.TryGetValue(region, out var lastDataCenter);
            _defaultDataCenter = MarketFetchScopeResolver.ResolveValidDataCenter(
                region,
                lastDataCenter);
            _lastDataCenterByRegion[region] = _defaultDataCenter;
        });
    }

    private Task OnDefaultDataCenterChanged(string dataCenter) =>
        ApplyMarketSelectionChangeAsync(() =>
        {
            _defaultDataCenter = MarketFetchScopeResolver.ResolveValidDataCenter(
                _selectedRegion,
                dataCenter);
            _lastDataCenterByRegion[_selectedRegion] = _defaultDataCenter;
        });

    private Task OnMarketFetchScopeChanged(string value) =>
        ApplyMarketSelectionChangeAsync(() =>
        {
            if (Enum.TryParse<MarketFetchScope>(value, out var parsed))
            {
                _defaultMarketFetchScope = parsed;
            }
        });

    private Task OnComparisonRegionsChanged(IReadOnlyList<string> comparisonRegions) =>
        ApplyMarketSelectionChangeAsync(() =>
            _comparisonRegions = NormalizeComparisonRegions(comparisonRegions, _selectedRegion));

    private async Task ApplyMarketSelectionChangeAsync(Action mutate)
    {
        var previousDataCenter = _defaultDataCenter;
        var previousRegion = _selectedRegion;
        var previousScope = _defaultMarketFetchScope;
        var previousComparisons = _comparisonRegions;
        mutate();
        try
        {
            await ApplyMarketSettingsAsync();
        }
        catch (Exception exception)
        {
            _defaultDataCenter = previousDataCenter;
            _selectedRegion = previousRegion;
            _defaultMarketFetchScope = previousScope;
            _comparisonRegions = previousComparisons;
            Snackbar.Add($"Market setting was not saved: {exception.Message}", Severity.Error);
        }
    }

    private static string GetRegionDataCenterSettingKey(string region) =>
        $"market.last_datacenter.{region.Replace(" ", "_").ToLowerInvariant()}";

    private IReadOnlyList<CompactSelectOption> GetComparisonRegionOptions() =>
        RegionOptions
            .Where(option => !string.Equals(
                option.Value,
                _selectedRegion,
                StringComparison.OrdinalIgnoreCase))
            .ToArray();

    private async Task OnSplitWorldPurchasesChanged(bool value)
    {
        var previous = _procurementEnableSplitWorldPurchases;
        _procurementEnableSplitWorldPurchases = value;
        AppState.SetProcurementSettings(
            value,
            AppState.ProcurementTravelTolerance,
            AppState.TemporaryWorldBlacklistDurationMinutes);
        try
        {
            await Settings.SetAsync("procurement.enable_split_world_purchases", value);
            ScheduleCurrentPlanDerivation();
        }
        catch (Exception exception)
        {
            _procurementEnableSplitWorldPurchases = previous;
            AppState.SetProcurementSettings(
                previous,
                AppState.ProcurementTravelTolerance,
                AppState.TemporaryWorldBlacklistDurationMinutes);
            Snackbar.Add($"Route setting was not saved: {exception.Message}", Severity.Error);
        }
    }

