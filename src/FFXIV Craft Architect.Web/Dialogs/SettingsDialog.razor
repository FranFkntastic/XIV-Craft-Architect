    private async Task PrepareDiagnosticSnapshotAsync()
    {
        if (_diagnosticSnapshotReady || !WorkerProjections.Shell.HasSession)
        {
            return;
        }

        _diagnosticsBusy = true;
        try
        {
            var exportedAtUtc = DateTime.UtcNow;
            var shell = WorkerProjections.Shell;
            var planName = shell.PlanName ?? "Unsaved Diagnostic Plan";
            var planId = shell.PlanId ??
                $"diagnostic-{exportedAtUtc:yyyyMMddHHmmss}";
            var storedPlan = await WorkerSession.ExportStoredPlanAsync(
                planId,
                planName,
                includeSourcePlanIdentity: true);
            var recipe = await WorkerSession.GetRecipeProjectionAsync();
            var acquisition = await WorkerSession.GetAcquisitionProjectionAsync("All");
            var market = await WorkerSession.GetMarketProjectionAsync();
            var procurement = await WorkerSession.GetProcurementProjectionAsync();
            var bundle = new
            {
                schemaVersion = 2,
                tool = "craft-architect-worker-diagnostic-snapshot",
                exportedAtUtc,
                build = new
                {
                    version = WebBuildInfo.BuildVersion,
                    branch = WebBuildInfo.BranchName,
                    commit = WebBuildInfo.CommitSha,
                    dirty = WebBuildInfo.IsDirty
                },
                revision = WorkerProjections.Shell.Revision,
                shell = WorkerProjections.Shell,
                storedPlan,
                recipe,
                acquisition,
                market,
                procurement
            };
            _diagnosticSnapshotFileName = CreateDiagnosticSnapshotFileName(exportedAtUtc);
            await BrowserFileExportService.PrepareTextFileSaveAsync(
                DiagnosticSnapshotSaveKey,
                _diagnosticSnapshotFileName,
                JsonSerializer.Serialize(bundle, CompanyPackageJsonOptions),
                "application/json");
            _diagnosticSnapshotReady = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not prepare diagnostics: {ex.Message}", Severity.Error);
        }
        finally
        {
            _diagnosticsBusy = false;
        }
    }

    private async Task RunBrowserStorageChecksAsync()
    {
        _diagnosticsBusy = true;
        _diagnosticStorageError = null;
        try
        {
            var tradeTask = IndexedDb.GetTradeStoreDiagnosticsAsync();
            var marketTask = MarketCache.GetStatsAsync();
            await Task.WhenAll(tradeTask, marketTask);
            _tradeStorageDiagnostics = await tradeTask;
            _marketCacheStats = await marketTask;
        }
        catch (Exception ex)
        {
            _tradeStorageDiagnostics = null;
            _marketCacheStats = null;
            _diagnosticStorageError = $"Storage checks failed: {ex.Message}";
        }
        finally
        {
            _diagnosticsBusy = false;
        }
    }

    private async Task PurgeCommissionWorkspaceAsync()
    {
        if (_isPurgingCommissions)
        {
            return;
        }

        _isPurgingCommissions = true;
        _commissionPurgeStatus = "Preparing recovery export...";
        try
        {
            var backup = await OrderLifecycle.CreateResetBackupAsync();
            var confirmed = await DialogService.ShowMessageBox(
                "Reset Commission Workspace",
                $"Permanently delete {backup.Orders.Count:N0} orders and {backup.PayrollDrafts.Count:N0} payroll drafts across every company? A recovery JSON file will be saved first. Companies and crafters are preserved.",
                yesText: "Export and Reset",
                cancelText: "Keep Everything");
            if (confirmed != true)
            {
                _commissionPurgeStatus = null;
                return;
            }

            var exportedAt = DateTime.UtcNow;
            var fileName = $"craft-architect-commission-reset-{exportedAt:yyyyMMdd-HHmmss}.json";
            var saved = await BrowserFileExportService.SaveTextFileAsync(
                CommissionResetBackupSaveKey,
                fileName,
                JsonSerializer.Serialize(backup, CompanyPackageJsonOptions),
                "application/json");
            if (!saved.Completed)
            {
                _commissionPurgeStatus = "Reset canceled because the recovery export was not saved.";
                return;
            }

            _commissionPurgeStatus = "Retracting Discord posts and deleting commission data...";
            var result = await OrderLifecycle.PurgeAllAsync(backup);
            _commissionPurgeStatus =
                $"Reset complete: {result.OrdersDeleted:N0} orders, " +
                $"{result.PayrollDraftsDeleted:N0} drafts, " +
                $"{result.GeneratedPlansDeleted:N0} generated plans, and " +
                $"{result.LegacyCraftSnapshotsDeleted:N0} legacy snapshots deleted. " +
                $"{result.DiscordPublicationsRetracted:N0} Discord publications retracted.";
            Snackbar.Add("Commission workspace reset complete.", Severity.Success);
        }
        catch (Exception exception)
        {
            _commissionPurgeStatus = $"Reset failed without discarding the recovery path: {exception.Message}";
            Snackbar.Add($"Could not reset commissions: {exception.Message}", Severity.Error);
        }
        finally
        {
            _isPurgingCommissions = false;
        }
    }

