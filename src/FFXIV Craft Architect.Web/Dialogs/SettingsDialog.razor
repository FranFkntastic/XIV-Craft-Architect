    private const string SaveButtonLabel = "Save company changes";

    private async Task SaveCurrentSectionAsync()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;
        try
        {
            if (_activePanel == SettingsSection.CompanyAdministration && _companyProfile != null)
            {
                if (string.IsNullOrWhiteSpace(_companyName))
                {
                    Snackbar.Add("Company name is required.", Severity.Error);
                    return;
                }

                var paymentPolicy = BuildCompanyPaymentPolicy();
                if (paymentPolicy == null)
                {
                    return;
                }

                if (_activePanel == SettingsSection.CompanyAdministration &&
                    _companyNotificationRouteEditor != null &&
                    !await _companyNotificationRouteEditor.SavePendingChangesAsync())
                {
                    return;
                }

                _companyProfile.Name = _companyName.Trim();
                _companyProfile.Description = NormalizeOptionalText(_companyDescription);
                _companyProfile.CommissionContact = NormalizeOptionalText(_companyCommissionContact);
                _companyProfile.PaymentPolicy = paymentPolicy;
                var companySaved = await SaveCompanyProfileAsync(_companyProfile);
                if (!companySaved)
                {
                    Snackbar.Add("Failed to save company profile.", Severity.Error);
                    return;
                }
                _persistedCompanyFingerprint = BuildCompanyFingerprint();
            }

            Snackbar.Add($"{SaveButtonLabel} saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{SaveButtonLabel} could not be saved: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task<bool> ApplyMarketSettingsAsync()
    {
        var previous = new MarketSettingsSnapshot(
            AppState.SelectedDataCenter,
            AppState.SelectedRegion,
            AppState.DefaultMarketFetchScope,
            AppState.ComparisonRegions.ToArray());
        var requested = new MarketSettingsSnapshot(
            _defaultDataCenter,
            _selectedRegion,
            _defaultMarketFetchScope,
            _comparisonRegions.ToArray());
        var changed = !AreMarketSettingsEqual(previous, requested);

        AppState.SetMarketEvidenceSettings(
            requested.DataCenter,
            requested.Region,
            requested.Scope,
            requested.ComparisonRegions);

        if (!changed)
        {
            return false;
        }

        try
        {
            await PersistMarketSettingsAsync(requested);
            if (WorkerProjections.Shell.HasSession)
            {
                PlanLifecycle.Cancel();
                await PlanLifecycle.EnsureDerivedAsync(
                    new PlanDerivationRequest(UseCurrentSettingsContext: true));
            }

            return true;
        }
        catch
        {
            AppState.SetMarketEvidenceSettings(
                previous.DataCenter,
                previous.Region,
                previous.Scope,
                previous.ComparisonRegions);
            _defaultDataCenter = previous.DataCenter;
            _selectedRegion = previous.Region;
            _defaultMarketFetchScope = previous.Scope;
            _comparisonRegions = previous.ComparisonRegions;

            if (WorkerProjections.Shell.HasSession)
            {
                try
                {
                    await WorkerSession.MutateActiveContextAsync(
                        new WorkerActiveContextMutation(
                            previous.DataCenter,
                            previous.Region,
                            previous.Scope));
                }
                catch
                {
                    // Preserve the original failure; the Worker will retain its last
                    // truthful publication if the rollback command is unavailable.
                }
            }

            try
            {
                await PersistMarketSettingsAsync(previous);
            }
            catch
            {
                // Surface the original market transition failure to the user.
            }

            throw;
        }
    }

    private async Task PersistMarketSettingsAsync(MarketSettingsSnapshot settings)
    {
        await Settings.SetAsync("market.default_datacenter", settings.DataCenter);
        await Settings.SetAsync("market.region", settings.Region);
        await Settings.SetAsync("market.comparison_regions", settings.ComparisonRegions.ToArray());
        await Settings.SetAsync("market.comparison_region", string.Empty);
        foreach (var (region, dataCenter) in _lastDataCenterByRegion)
        {
            await Settings.SetAsync(
                GetRegionDataCenterSettingKey(region),
                dataCenter);
        }
        await Settings.SetAsync("market.default_search_scope", settings.Scope.ToString());
    }

    private static bool AreMarketSettingsEqual(
        MarketSettingsSnapshot left,
        MarketSettingsSnapshot right) =>
        string.Equals(left.DataCenter, right.DataCenter, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(left.Region, right.Region, StringComparison.OrdinalIgnoreCase) &&
        left.Scope == right.Scope &&
        left.ComparisonRegions.SequenceEqual(
            right.ComparisonRegions,
            StringComparer.OrdinalIgnoreCase);

