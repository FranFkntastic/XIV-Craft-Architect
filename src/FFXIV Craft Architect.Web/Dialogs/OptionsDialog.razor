    private async Task LinkDiscordAsync()
    {
        _discordIdentityBusy = true;
        _discordIdentityMessage = "Waiting for Discord authorization...";
        _discordIdentityMessageColor = Color.Info;
        try
        {
            var settings = await RequireDiscordIdentityConnectionAsync();
            var opened = await JSRuntime.InvokeAsync<bool>(
                "CraftArchitectDiscordIdentity.begin");
            if (!opened)
            {
                throw new InvalidOperationException(
                    "The Discord authorization window was blocked.");
            }

            var authorizationUri = await DiscordIdentityClient.StartLinkAsync(
                settings.HostUrl!,
                settings.AccessKey!,
                CancellationToken.None);
            if (!await JSRuntime.InvokeAsync<bool>(
                    "CraftArchitectDiscordIdentity.navigate",
                    authorizationUri.AbsoluteUri))
            {
                throw new InvalidOperationException(
                    "The Discord authorization window was closed.");
            }

            for (var attempt = 0; attempt < 120; attempt++)
            {
                await Task.Delay(TimeSpan.FromSeconds(1));
                DiscordIdentityWebStatus status;
                try
                {
                    status = await DiscordIdentityClient.GetStatusAsync(
                        settings.HostUrl!,
                        settings.AccessKey!,
                        CancellationToken.None);
                }
                catch when (attempt < 119)
                {
                    continue;
                }

                _discordIdentityStatus = status;
                await InvokeAsync(StateHasChanged);
                if (status.Linked)
                {
                    _discordIdentityMessage = $"{status.DisplayName} linked.";
                    _discordIdentityMessageColor = Color.Success;
                    return;
                }
            }

            _discordIdentityMessage =
                "Discord authorization is still pending. Complete the Discord tab, then refresh this status.";
            _discordIdentityMessageColor = Color.Warning;
        }
        catch (Exception)
        {
            await JSRuntime.InvokeVoidAsync("CraftArchitectDiscordIdentity.close");
            _discordIdentityMessage =
                "Discord linking could not start from the connected profile.";
            _discordIdentityMessageColor = Color.Error;
        }
        finally
        {
            _discordIdentityBusy = false;
        }
    }

