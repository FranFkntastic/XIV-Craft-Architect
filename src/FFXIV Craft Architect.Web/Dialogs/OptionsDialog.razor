    private static string GetTabId(OptionsPanel panel) => $"options-tab-{panel.ToString().ToLowerInvariant()}";
    private static string GetPanelId(OptionsPanel panel) => $"options-panel-{panel.ToString().ToLowerInvariant()}";

    private async Task SelectTab(OptionsPanel panel)
    {
        if (!VisibleOptionsTabs.Any(tab => tab.Panel == panel))
        {
            panel = OptionsPanel.General;
        }

        _activePanel = panel;
        if (_activePanel == OptionsPanel.Diagnostics)
        {
            await PrepareDiagnosticsAsync();
        }
    }

    private async Task HandleTabKeyDown(KeyboardEventArgs args, int currentIndex)
    {
        var visibleTabs = VisibleOptionsTabs;
        var nextIndex = args.Key switch
        {
            "ArrowRight" => (currentIndex + 1) % visibleTabs.Count,
            "ArrowLeft" => (currentIndex - 1 + visibleTabs.Count) % visibleTabs.Count,
            "Home" => 0,
            "End" => visibleTabs.Count - 1,
            _ => currentIndex
        };

        if (nextIndex == currentIndex)
        {
            return;
        }

        await SelectTab(visibleTabs[nextIndex].Panel);
        await InvokeAsync(StateHasChanged);
        await _tabElements[nextIndex].FocusAsync();
    }
    
