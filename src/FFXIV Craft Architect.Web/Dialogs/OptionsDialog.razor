        var message = ProfileSync.CurrentStatus.Message;
        if (message?.StartsWith(prefix, StringComparison.Ordinal) == true)
        {
            message = message[prefix.Length..];
        }

        return string.IsNullOrWhiteSpace(message)
            ? "Browser-profile sync could not complete."
            : $"Browser-profile sync stopped: {message}";
    }

