    private async Task ConnectProfileHostAsync()
    {
        var settings = BuildProfileHostConnectionSettings();
        if (settings == null)
        {
            return;
        }

        _profileHostIsBusy = true;
        _profileHostBusyMessage = "Checking profile host...";
        ClearPendingProfileHostConnection();
        try
        {
            var health = await ProfileHostClient.GetHealthAsync(
                settings.HostUrl!,
                CancellationToken.None);
            if (!health.ProfileHostEnabled)
            {
                throw new ProfileHostConnectionException(
                    ProfileHostConnectionFailure.ProfileHostingDisabled,
                    "Profile hosting is not enabled on that server.");
            }
            if (health.ProtocolVersion != 1)
            {
                throw new ProfileHostConnectionException(
                    ProfileHostConnectionFailure.IncompatibleHost,
                    "This profile host uses an unsupported connection protocol.");
            }

            _profileHostBusyMessage = "Authorizing this browser...";
            var profile = await ProfileHostClient.GetProfileAsync(settings.HostUrl!, settings.AccessKey!, CancellationToken.None);
            await PrepareVerifiedProfileHostConnectionAsync(settings, profile);
        }
        catch (Exception ex)
        {
            SetProfileHostFailure(ex);
        }
        finally
        {
            _profileHostIsBusy = false;
        }
    }

    private async Task RedeemProfileHostPairingCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_profileHostPairingCode))
        {
            SetProfileHostStatus("Enter the one-time pairing code from the connected browser.", Color.Error);
            return;
        }

        _profileHostIsBusy = true;
        _profileHostBusyMessage = "Pairing this browser...";
        ClearPendingProfileHostConnection();
        try
        {
            var hostUrl = GetSelectedProfileHostUrl();
            var health = await ProfileHostClient.GetHealthAsync(hostUrl, CancellationToken.None);
            if (!health.ProfileHostEnabled || health.ProtocolVersion != 1)
            {
                throw new ProfileHostConnectionException(
                    ProfileHostConnectionFailure.IncompatibleHost,
                    "This server is not a compatible Craft Architect profile host.");
            }

            var redeemed = await ProfileHostClient.RedeemPairingCodeAsync(
                hostUrl,
                _profileHostPairingCode.Trim(),
                CancellationToken.None);
            _profileHostAccessKey = redeemed.AccessKey;
            _profileHostPairingCode = string.Empty;
            var settings = new HostedProfileConnectionSettings
            {
                HostUrl = hostUrl,
                AccessKey = redeemed.AccessKey,
                RememberAccessKey = true,
                ConnectedProfileId = redeemed.Profile.ProfileId,
                ConnectedProfileName = redeemed.Profile.DisplayName
            };
            await PrepareVerifiedProfileHostConnectionAsync(settings, redeemed.Profile);
        }
        catch (Exception ex)
        {
            SetProfileHostFailure(ex);
        }
        finally
        {
            _profileHostIsBusy = false;
        }
    }

    private async Task PrepareVerifiedProfileHostConnectionAsync(
        HostedProfileConnectionSettings settings,
        ProfileHostProfileResponse profile)
    {
        settings.ConnectedProfileId = profile.ProfileId;
        settings.ConnectedProfileName = profile.DisplayName;
        _profileHostProfileName = profile.DisplayName;
        _profileHostBusyMessage = "Comparing browser and hosted data...";
        var preview = await ProfileSync.PreviewFirstConnectAsync(settings);

        if (preview.LocalObjectCount > 0 &&
            preview.RemoteObjectCount > 0 &&
            !preview.ContentsMatch)
        {
            _profileHostBootstrapPreview = preview;
            _profileHostPendingSettings = settings.Snapshot();
            _profileHostFirstConnectMode = FirstConnectMode.DownloadRemote;
            _profileHostStatus = null;
            return;
        }

        var mode = preview.RemoteObjectCount == 0 && preview.LocalObjectCount > 0
            ? FirstConnectMode.UploadLocal
            : FirstConnectMode.DownloadRemote;
        await ConnectVerifiedProfileHostAsync(settings, mode);
    }

