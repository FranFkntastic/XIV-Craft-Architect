    private async Task Save()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;
        try
        {
            _defaultDataCenter = MarketFetchScopeResolver.ResolveValidDataCenter(
                _selectedRegion,
                _defaultDataCenter);
            _lastDataCenterByRegion[_selectedRegion] = _defaultDataCenter;
            _comparisonRegions = NormalizeComparisonRegions(_comparisonRegions, _selectedRegion);

            if (_companyProfile != null)
            {
                if (string.IsNullOrWhiteSpace(_companyName))
                {
                    Snackbar.Add("Company name is required.", Severity.Error);
                    return;
                }

                var paymentPolicy = BuildCompanyPaymentPolicy();
                if (paymentPolicy == null)
                {
                    return;
                }

                if (_activePanel == OptionsPanel.Company &&
                    _companyNotificationRouteEditor != null &&
                    !await _companyNotificationRouteEditor.SavePendingChangesAsync())
                {
                    return;
                }

                _companyProfile.Name = _companyName.Trim();
                _companyProfile.Description = NormalizeOptionalText(_companyDescription);
                _companyProfile.CommissionContact = NormalizeOptionalText(_companyCommissionContact);
                _companyProfile.PaymentPolicy = paymentPolicy;
                var companySaved = await SaveCompanyProfileAsync(_companyProfile);
                if (!companySaved)
                {
                    Snackbar.Add("Failed to save company profile.", Severity.Error);
                    return;
                }
            }

            var marketSettingsChanged = await ApplyMarketSettingsAsync();
            AppState.SetProcurementSettings(
                _procurementEnableSplitWorldPurchases,
                AppState.ProcurementTravelTolerance,
                AppState.TemporaryWorldBlacklistDurationMinutes);
            AppState.SetProcurementHomeDataCenterOrigin(_procurementStartFromHomeDataCenter);
            AppState.SetProcurementTravelPriority(_procurementTravelPriority);

            await Settings.SetAsync("procurement.enable_split_world_purchases", _procurementEnableSplitWorldPurchases);
            await Settings.SetAsync("procurement.start_from_home_data_center", _procurementStartFromHomeDataCenter);
            await Settings.SetAsync("procurement.travel_priority", _procurementTravelPriority.ToString());
            await Settings.SetAsync("marketmafioso.enabled", _marketMafiosoEnabled);
            await Settings.SetAsync("marketmafioso.workshop_host_url", _marketMafiosoApiUrl.Trim());
            await Settings.SetAsync("marketmafioso.api_key", _marketMafiosoApiKey.Trim());
            await Settings.SetAsync("marketmafioso.target_character", _marketMafiosoTargetCharacter.Trim());
            await Settings.SetAsync("marketmafioso.target_world", _marketMafiosoTargetWorld.Trim());
            await Settings.SetAsync("marketmafioso.auto_sync_evidence", _marketMafiosoAutoSyncEvidence);
            MarketMafiosoIntegrationState.SetEnabled(_marketMafiosoEnabled);
            if (WorkerProjections.Shell.HasSession && !marketSettingsChanged)
            {
                PlanLifecycle.Schedule(new PlanDerivationRequest(
                    UseCurrentSettingsContext: true));
            }

            Snackbar.Add("Settings saved", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Settings could not be saved: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task<bool> ApplyMarketSettingsAsync()
    {
        var previous = new MarketSettingsSnapshot(
            AppState.SelectedDataCenter,
            AppState.SelectedRegion,
            AppState.DefaultMarketFetchScope,
            AppState.ComparisonRegions.ToArray());
        var requested = new MarketSettingsSnapshot(
            _defaultDataCenter,
            _selectedRegion,
            _defaultMarketFetchScope,
            _comparisonRegions.ToArray());
        var changed = !AreMarketSettingsEqual(previous, requested);

        AppState.SetMarketEvidenceSettings(
            requested.DataCenter,
            requested.Region,
            requested.Scope,
            requested.ComparisonRegions);

        if (!changed)
        {
            return false;
        }

        try
        {
            await PersistMarketSettingsAsync(requested);
            if (WorkerProjections.Shell.HasSession)
            {
                PlanLifecycle.Cancel();
                await PlanLifecycle.EnsureDerivedAsync(
                    new PlanDerivationRequest(UseCurrentSettingsContext: true));
            }

            return true;
        }
        catch
        {
            AppState.SetMarketEvidenceSettings(
                previous.DataCenter,
                previous.Region,
                previous.Scope,
                previous.ComparisonRegions);
            _defaultDataCenter = previous.DataCenter;
            _selectedRegion = previous.Region;
            _defaultMarketFetchScope = previous.Scope;
            _comparisonRegions = previous.ComparisonRegions;

            if (WorkerProjections.Shell.HasSession)
            {
                try
                {
                    await WorkerSession.MutateActiveContextAsync(
                        new WorkerActiveContextMutation(
                            previous.DataCenter,
                            previous.Region,
                            previous.Scope));
                }
                catch
                {
                    // Preserve the original failure; the Worker will retain its last
                    // truthful publication if the rollback command is unavailable.
                }
            }

            try
            {
                await PersistMarketSettingsAsync(previous);
            }
            catch
            {
                // Surface the original market transition failure to the user.
            }

            throw;
        }
    }

    private async Task PersistMarketSettingsAsync(MarketSettingsSnapshot settings)
    {
        await Settings.SetAsync("market.default_datacenter", settings.DataCenter);
        await Settings.SetAsync("market.region", settings.Region);
        await Settings.SetAsync("market.comparison_regions", settings.ComparisonRegions.ToArray());
        await Settings.SetAsync("market.comparison_region", string.Empty);
        foreach (var (region, dataCenter) in _lastDataCenterByRegion)
        {
            await Settings.SetAsync(
                GetRegionDataCenterSettingKey(region),
                dataCenter);
        }
        await Settings.SetAsync("market.default_search_scope", settings.Scope.ToString());
    }

    private static bool AreMarketSettingsEqual(
        MarketSettingsSnapshot left,
        MarketSettingsSnapshot right) =>
        string.Equals(left.DataCenter, right.DataCenter, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(left.Region, right.Region, StringComparison.OrdinalIgnoreCase) &&
        left.Scope == right.Scope &&
        left.ComparisonRegions.SequenceEqual(
            right.ComparisonRegions,
            StringComparer.OrdinalIgnoreCase);

    private async Task ToggleSecretDebugToolsAsync()
    {
        var enabled = !AppState.SecretDebugToolsEnabled;
        AppState.SetSecretDebugToolsEnabled(enabled);
        await Settings.SetAsync("debug.secret_tools_enabled", enabled);
        Snackbar.Add(enabled ? "Developer Mode enabled" : "Developer Mode disabled", Severity.Info);
    }

    private async Task PrepareDiagnosticsAsync()
    {
        if (!AppState.SecretDebugToolsEnabled)
        {
            return;
        }

        await PrepareDiagnosticSnapshotAsync();
    }

    private async Task PrepareDiagnosticSnapshotAsync()
    {
        if (_diagnosticSnapshotReady || !WorkerProjections.Shell.HasSession)
        {
            return;
        }

        _diagnosticsBusy = true;
        try
        {
            var exportedAtUtc = DateTime.UtcNow;
            var shell = WorkerProjections.Shell;
            var planName = shell.PlanName ?? "Unsaved Diagnostic Plan";
            var planId = shell.PlanId ??
                $"diagnostic-{exportedAtUtc:yyyyMMddHHmmss}";
            var storedPlan = await WorkerSession.ExportStoredPlanAsync(
                planId,
                planName,
                includeSourcePlanIdentity: true);
            var recipe = await WorkerSession.GetRecipeProjectionAsync();
            var acquisition = await WorkerSession.GetAcquisitionProjectionAsync("All");
            var market = await WorkerSession.GetMarketProjectionAsync();
            var procurement = await WorkerSession.GetProcurementProjectionAsync();
            var bundle = new
            {
                schemaVersion = 2,
                tool = "craft-architect-worker-diagnostic-snapshot",
                exportedAtUtc,
                build = new
                {
                    version = WebBuildInfo.BuildVersion,
                    branch = WebBuildInfo.BranchName,
                    commit = WebBuildInfo.CommitSha,
                    dirty = WebBuildInfo.IsDirty
                },
                revision = WorkerProjections.Shell.Revision,
                shell = WorkerProjections.Shell,
                storedPlan,
                recipe,
                acquisition,
                market,
                procurement
            };
            _diagnosticSnapshotFileName = CreateDiagnosticSnapshotFileName(exportedAtUtc);
            await BrowserFileExportService.PrepareTextFileSaveAsync(
                DiagnosticSnapshotSaveKey,
                _diagnosticSnapshotFileName,
                JsonSerializer.Serialize(bundle, CompanyPackageJsonOptions),
                "application/json");
            _diagnosticSnapshotReady = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not prepare diagnostics: {ex.Message}", Severity.Error);
        }
        finally
        {
            _diagnosticsBusy = false;
        }
    }

    private async Task RunBrowserStorageChecksAsync()
    {
        _diagnosticsBusy = true;
        _diagnosticStorageError = null;
        try
        {
            var tradeTask = IndexedDb.GetTradeStoreDiagnosticsAsync();
            var marketTask = MarketCache.GetStatsAsync();
            await Task.WhenAll(tradeTask, marketTask);
            _tradeStorageDiagnostics = await tradeTask;
            _marketCacheStats = await marketTask;
        }
        catch (Exception ex)
        {
            _tradeStorageDiagnostics = null;
            _marketCacheStats = null;
            _diagnosticStorageError = $"Storage checks failed: {ex.Message}";
        }
        finally
        {
            _diagnosticsBusy = false;
        }
    }

    private async Task PurgeCommissionWorkspaceAsync()
    {
        if (_isPurgingCommissions)
        {
            return;
        }

        _isPurgingCommissions = true;
        _commissionPurgeStatus = "Preparing recovery export...";
        try
        {
            var backup = await OrderLifecycle.CreateResetBackupAsync();
            var confirmed = await DialogService.ShowMessageBox(
                "Reset Commission Workspace",
                $"Permanently delete {backup.Orders.Count:N0} orders and {backup.PayrollDrafts.Count:N0} payroll drafts across every company? A recovery JSON file will be saved first. Companies and crafters are preserved.",
                yesText: "Export and Reset",
                cancelText: "Keep Everything");
            if (confirmed != true)
            {
                _commissionPurgeStatus = null;
                return;
            }

            var exportedAt = DateTime.UtcNow;
            var fileName = $"craft-architect-commission-reset-{exportedAt:yyyyMMdd-HHmmss}.json";
            var saved = await BrowserFileExportService.SaveTextFileAsync(
                CommissionResetBackupSaveKey,
                fileName,
                JsonSerializer.Serialize(backup, CompanyPackageJsonOptions),
                "application/json");
            if (!saved.Completed)
            {
                _commissionPurgeStatus = "Reset canceled because the recovery export was not saved.";
                return;
            }

            _commissionPurgeStatus = "Retracting Discord posts and deleting commission data...";
            var result = await OrderLifecycle.PurgeAllAsync(backup);
            _commissionPurgeStatus =
                $"Reset complete: {result.OrdersDeleted:N0} orders, " +
                $"{result.PayrollDraftsDeleted:N0} drafts, " +
                $"{result.GeneratedPlansDeleted:N0} generated plans, and " +
                $"{result.LegacyCraftSnapshotsDeleted:N0} legacy snapshots deleted. " +
                $"{result.DiscordPublicationsRetracted:N0} Discord publications retracted.";
            Snackbar.Add("Commission workspace reset complete.", Severity.Success);
        }
        catch (Exception exception)
        {
            _commissionPurgeStatus = $"Reset failed without discarding the recovery path: {exception.Message}";
            Snackbar.Add($"Could not reset commissions: {exception.Message}", Severity.Error);
        }
        finally
        {
            _isPurgingCommissions = false;
        }
    }

    private string CreateDiagnosticSnapshotFileName(DateTime exportedAtUtc)
    {
        var planName = WorkerProjections.Shell.PlanName ?? "plan";
        var safePlanName = string.Join("_", planName.Split(Path.GetInvalidFileNameChars()));
        if (safePlanName.Length > 60)
        {
            safePlanName = safePlanName[..60];
        }

        return $"{safePlanName}-{exportedAtUtc:yyyyMMdd-HHmmss}.ca-diagnostic.json";
    }

    private string CreateGitHubIssueUrl()
    {
        var market = WorkerProjections.Market;
        var scope = market?.Scope == MarketFetchScope.EntireRegion
            ? market.SelectedRegion
            : market?.SelectedDataCenter ?? WorkerProjections.Shell.SelectedDataCenter;
        return GitHubIssueReportService.CreateIssueUrl(new GitHubIssueReportContext(
            WebBuildInfo.BuildVersion,
            WebBuildInfo.BranchName,
            WebBuildInfo.CommitSha,
            scope,
            WorkerProjections.Shell.ShoppingPlanCount,
            WorkerProjections.Shell.MarketAnalysisCount,
            "Worker-owned",
            _prepareDiagnosticAttachment,
            _prepareDiagnosticAttachment ? _diagnosticSnapshotFileName : null));
    }

    private string FormatWorkerScope()
    {
        var market = WorkerProjections.Market;
        return market?.Scope == MarketFetchScope.EntireRegion
            ? market.SelectedRegion
            : market?.SelectedDataCenter ?? WorkerProjections.Shell.SelectedDataCenter;
    }

    private string? GetGitHubIssueClickScript()
    {
        return _prepareDiagnosticAttachment && _diagnosticSnapshotReady
            ? $"window.CraftArchitectFileExport?.downloadPreparedFile('{DiagnosticSnapshotSaveKey}')"
            : null;
    }

    private static string FormatBytes(long bytes)
    {
        return bytes >= 1024 * 1024
            ? $"{bytes / (1024d * 1024d):F1} MB"
            : $"{bytes / 1024d:F1} KB";
    }
    
    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private static MarketFetchScope ParseMarketFetchScope(string? value)
    {
        return Enum.TryParse<MarketFetchScope>(value, ignoreCase: true, out var scope)
            ? scope
            : MarketFetchScope.EntireRegion;
    }

    private static MarketTravelPriority ParseTravelPriority(string? value)
    {
        return Enum.TryParse<MarketTravelPriority>(value, ignoreCase: true, out var priority)
            ? priority
            : MarketTravelPriority.DataCenterTransfersFirst;
    }

    private static string? NormalizeOptionalText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }
