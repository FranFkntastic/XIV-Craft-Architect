@using FFXIV_Craft_Architect.Web.Services.CompanyMigration
@using FFXIV_Craft_Architect.Web.Services.ProfileHosting

<MudDialog Class="company-migration-dialog"
           DisableSidePadding="true"
           ContentStyle="height: min(640px, calc(100vh - 210px)); padding: 0; overflow: hidden;"
           Style="width: min(1180px, calc(100vw - 32px)); max-width: 1180px; overflow: hidden; border: 1px solid #3d3d3d; border-radius: 7px; background: #1e1e1e;">
    <TitleContent>
        <div class="migration-titlebar">
            <div>
                <MudText Typo="Typo.overline">Trade Architect</MudText>
                <MudText Typo="Typo.h6">Move companies to a hosted profile</MudText>
                <MudText Typo="Typo.caption" Class="migration-subtitle">
                    Inventory this browser, resolve authoritative differences, then write the complete migration once.
                </MudText>
            </div>
            <div class="migration-title-actions">
                <span class="migration-safety">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" aria-hidden="true" />
                    Recovery required before commit
                </span>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Disabled="@_isCommitting"
                               OnClick="Close"
                               aria-label="Close company migration" />
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="migration-shell">
            <nav class="migration-steps" aria-label="Company migration steps">
                @foreach (var item in StepItems)
                {
                    <button type="button"
                            class="@GetStepClass(item.Step)"
                            disabled="@(!CanEnterStep(item.Step) || _isCommitting)"
                            aria-current="@GetAriaCurrent(item.Step)"
                            aria-controls="company-migration-step"
                            @onclick="() => GoToStepAsync(item.Step)">
                        <span class="migration-step-index" aria-hidden="true">
                            @if (IsStepComplete(item.Step))
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                            else
                            {
                                @(Array.IndexOf(StepItems, item) + 1)
                            }
                        </span>
                        <span>
                            <strong>@item.Label</strong>
                            <small>@GetStepSummary(item.Step)</small>
                        </span>
                    </button>
                }

                <div class="migration-identity">
                    <span>Migration ID</span>
                    <code>@(_source is null ? "Pending inventory" : ShortId(_source.MigrationId.ToString("D")))</code>
                    <p>Nothing is written until you choose Commit migration.</p>
                </div>
            </nav>

            <main id="company-migration-step"
                  class="migration-content"
                  aria-busy="@(_isCapturing || _isImporting || _isRecoveringActivation || _isVerifying || _isPreflighting || _isCommitting)">
                <div class="migration-view-heading" tabindex="-1" @ref="_stepHeading">
                    <div>
                        <MudText Typo="Typo.h6">@CurrentStepTitle</MudText>
                        <MudText Typo="Typo.body2" Class="migration-subtitle">@CurrentStepDescription</MudText>
                    </div>
                    <span class="@GetCurrentBadgeClass()">@GetCurrentBadgeText()</span>
                </div>

                @if (_activationError is not null && !_hasPendingActivation)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                        Recovery state could not be read: @_activationError
                    </MudAlert>
                }

                @if (_step == WizardStep.Sources)
                {
                    <section aria-label="Migration source">
                        @if (_isCapturing)
                        {
                            <div class="migration-loading" role="status">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                <span>Inventorying the current browser…</span>
                            </div>
                        }
                        else if (_source is null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">
                                @_sourceError
                            </MudAlert>
                            <MudButton Class="mt-3"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="RefreshSourceAsync">
                                Try inventory again
                            </MudButton>
                        }
                        else
                        {
                            <div class="migration-toolbar">
                                <label class="@(_isImporting ? "migration-file-button disabled" : "migration-file-button")">
                                    <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" aria-hidden="true" />
                                    <span>@(_isImporting ? "Reading export…" : "Add migration export")</span>
                                    <InputFile class="migration-file-input"
                                               accept=".camigration,.json,application/json"
                                               disabled="@(_isImporting || _isCommitting)"
                                               OnChange="ImportBundleAsync" />
                                </label>
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Refresh"
                                           Disabled="@(_isCapturing || _isImporting)"
                                           OnClick="RefreshSourceAsync">
                                    Refresh current browser
                                </MudButton>
                                <span class="migration-toolbar-spacer"></span>
                                <span class="migration-badge">@_sourceEntries.Count source inventories</span>
                            </div>

                            <div class="migration-source-list">
                                @foreach (var entry in _sourceEntries)
                                {
                                    <article class="migration-source-card">
                                        <div>
                                            <strong>@entry.Label</strong>
                                            <small>@DisplayOrigin(entry.Bundle.Manifest.Source.Origin)</small>
                                        </div>
                                        <div class="migration-metric">
                                            <strong>@BundleCount(entry.Bundle, "companies")</strong>
                                            <span>companies</span>
                                        </div>
                                        <div class="migration-metric">
                                            <strong>@BundleCount(entry.Bundle, "sourceRecords")</strong>
                                            <span>source records</span>
                                        </div>
                                        <span class="@(entry.Bundle.Manifest.CanPreflight ? "migration-badge good" : "migration-badge bad")">
                                            @(entry.Bundle.Manifest.CanPreflight ? "Readable" : $"{entry.Bundle.Manifest.Blockers.Count} blocked")
                                        </span>
                                    </article>
                                }
                            </div>

                            @if (_importError is not null || _sourceError is not null || _sourceOperationBlockers.Count > 0)
                            {
                                <div class="migration-blockers" role="alert">
                                    <strong>@(_importError ?? _sourceError ?? "The selected inventories could not be combined.")</strong>
                                    @if (_sourceOperationBlockers.Count > 0)
                                    {
                                        <ul>
                                            @foreach (var blocker in _sourceOperationBlockers)
                                            {
                                                <li><span>@blocker.Message</span><code>@blocker.Code</code></li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }

                            <div class="migration-facts">
                                <div><span>Combined migration</span><code>@ShortId(_source.MigrationId.ToString("D"))</code></div>
                                <div><span>Captured</span><strong>@FormatLocalTime(_source.Manifest.Source.CapturedAtUtc)</strong></div>
                                <div><span>Companies</span><strong>@GetCount("companies")</strong></div>
                                <div><span>Combined records</span><strong>@GetCount("sourceRecords")</strong></div>
                            </div>

                            @if (HardSourceBlockers.Count > 0)
                            {
                                <div class="migration-blockers" role="alert">
                                    <strong>The browser inventory cannot be preflighted yet.</strong>
                                    <ul>
                                        @foreach (var blocker in HardSourceBlockers)
                                        {
                                            <li>
                                                <span>@blocker.Message</span>
                                                <code>@blocker.Code</code>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (ArchiveSourceBlockers.Count > 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                                    @ArchiveSourceBlockers.Count preserved records are unsupported for hosted activation. They will stay in the recovery archive instead of being silently discarded.
                                </MudAlert>
                            }
                            @if (HardSourceBlockers.Count == 0 && _sourceOperationBlockers.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                    Origins and export filenames are provenance only. Company identity comes from stable object IDs, never the branch or deployment URL.
                                </MudAlert>
                            }
                        }
                    </section>
                }
                else if (_step == WizardStep.Destination)
                {
                    <section aria-label="Hosted destination">
                        @if (_hasPendingCommit || _hasPendingActivation)
                        {
                            <div class="migration-recovery-card" role="alert">
                                <div>
                                    <strong>@(_hasPendingCommit
                                        ? "A migration commit has an uncertain outcome."
                                        : "A committed migration still needs browser activation.")</strong>
                                    <span>@(_hasPendingCommit
                                        ? "Retry the exact saved request. The hosted receipt makes this idempotent, so it cannot create a second migration."
                                        : "The hosted write already has a receipt. Resume that exact activation before starting another migration.")</span>
                                </div>
                                <MudTextField @bind-Value="_accessKey"
                                              Label="Profile access key"
                                              InputType="InputType.Password"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Disabled="@_isRecoveringActivation" />
                                <MudCheckBox T="bool"
                                             @bind-Value="_rememberAccessKey"
                                             Dense="true"
                                             Color="Color.Primary"
                                             Disabled="@_isRecoveringActivation">
                                    <MudText Typo="Typo.caption">Remember access key in this browser</MudText>
                                </MudCheckBox>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Restore"
                                           Disabled="@(_isRecoveringActivation || string.IsNullOrWhiteSpace(_accessKey))"
                                           OnClick="ResumeRecoveryAsync">
                                    @(_isRecoveringActivation
                                        ? "Resuming…"
                                        : _hasPendingCommit
                                            ? "Retry exact commit"
                                            : "Resume activation")
                                </MudButton>
                                @if (_activationError is not null)
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true">
                                        @_activationError
                                    </MudAlert>
                                }
                            </div>
                        }
                        else if (_activationRecovered)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                                Hosted activation is complete. This browser is now using the committed hosted profile.
                            </MudAlert>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="CloseRecovered">
                                Done
                            </MudButton>
                        }

                        @if (!_hasPendingCommit && !_hasPendingActivation && !_activationRecovered)
                        {
                            <div class="migration-destination-form">
                            <MudTextField @bind-Value="_hostUrl"
                                          Label="Host URL"
                                          Placeholder="https://trade-api.example.com/"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Disabled="@_isCommitting"
                                          Class="migration-host-field" />
                            <div class="migration-key-field">
                                <MudTextField @bind-Value="_accessKey"
                                              Label="Profile access key"
                                              InputType="InputType.Password"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Disabled="@_isCommitting" />
                                <MudCheckBox T="bool"
                                             @bind-Value="_rememberAccessKey"
                                             Dense="true"
                                             Color="Color.Primary"
                                             Disabled="@_isCommitting">
                                    <MudText Typo="Typo.caption">Remember access key in this browser</MudText>
                                </MudCheckBox>
                            </div>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudDone"
                                       Disabled="@(!CanVerifyDestination)"
                                       OnClick="VerifyDestinationAsync">
                                @(_isVerifying ? "Verifying…" : "Verify destination")
                            </MudButton>
                            </div>

                            @if (_destinationError is not null)
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">
                                    @_destinationError
                                </MudAlert>
                            }

                            @if (_destination is not null)
                            {
                                <article class="migration-destination-card">
                                    <header>
                                        <div>
                                            <strong>@DisplayProfileName(_destination)</strong>
                                            <small>One access key selects exactly one hosted profile.</small>
                                        </div>
                                        <span class="migration-badge good">Connection verified</span>
                                    </header>
                                    <div class="migration-facts">
                                        <div><span>Profile ID</span><code>@ShortId(_destination.ProfileId)</code></div>
                                        <div><span>Server revision</span><strong>@_destination.ServerRevision</strong></div>
                                        <div><span>Destination</span><strong>@DisplayHost(_verifiedHostUrl)</strong></div>
                                        <div><span>State</span><strong>@(_destination.ServerRevision == 0 ? "Empty profile" : "Existing records")</strong></div>
                                    </div>
                                </article>
                            }

                            @if (_destination is not null && !DestinationIsCurrent)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                                    The URL or key changed after verification. Verify this destination again before reconciliation.
                                </MudAlert>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                    A non-empty destination is always reconciled record by record. This wizard never performs a blind overwrite.
                                </MudAlert>
                            }
                        }
                    </section>
                }
                else if (_step == WizardStep.Reconcile)
                {
                    <section aria-label="Migration reconciliation">
                        @if (_isPreflighting)
                        {
                            <div class="migration-loading" role="status">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                <span>Comparing the browser inventory with the hosted profile…</span>
                            </div>
                        }
                        else if (_preflight is null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">
                                @(_preflightError ?? "The destination has not been preflighted.")
                            </MudAlert>
                            <MudButton Class="mt-3"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="RunPreflightAsync">
                                Run preflight again
                            </MudButton>
                        }
                        else
                        {
                            <div class="migration-filter-row" role="group" aria-label="Filter reconciliation records">
                                @foreach (var filter in ReconcileFilters)
                                {
                                    <button type="button"
                                            class="@GetFilterClass(filter)"
                                            aria-pressed="@(_reconcileFilter == filter)"
                                            @onclick="() => _reconcileFilter = filter">
                                        @FilterLabel(filter)
                                    </button>
                                }
                                <span class="migration-toolbar-spacer"></span>
                                <span class="@(_preflight.CanCommit ? "migration-badge good" : "migration-badge bad")">
                                    @(_preflight.CanCommit ? "Ready for review" : $"{DecisionCount} decisions or blockers")
                                </span>
                            </div>

                            <div class="migration-table-scroll">
                                <table class="migration-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Record</th>
                                            <th scope="col">Assessment</th>
                                            <th scope="col">Authoritative state</th>
                                            <th scope="col">Resolution</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var assessment in FilteredAssessments)
                                        {
                                            <tr class="@GetAssessmentRowClass(assessment)">
                                                <td>
                                                    <strong>@DisplayCollection(assessment.Collection)</strong>
                                                    <code>@ShortId(assessment.ObjectId)</code>
                                                </td>
                                                <td>
                                                    <span class="@GetDispositionBadgeClass(assessment.Disposition)">
                                                        @DisplayDisposition(assessment.Disposition)
                                                    </span>
                                                    @if (!string.Equals(assessment.ObjectId, assessment.CanonicalObjectId, StringComparison.Ordinal))
                                                    {
                                                        <small>Canonical: @ShortId(assessment.CanonicalObjectId)</small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (assessment.AuthoritativeDeleted)
                                                    {
                                                        <span>Deleted at revision @assessment.AuthoritativeRevision</span>
                                                    }
                                                    else if (assessment.AuthoritativeRevision is not null)
                                                    {
                                                        <span>Revision @assessment.AuthoritativeRevision</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Not present</span>
                                                    }
                                                    @if (assessment.RetiresAuthoritativeSource)
                                                    {
                                                        <small>Source identity will be retired.</small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (RequiresResolution(assessment))
                                                    {
                                                        <select class="migration-resolution"
                                                                aria-label="@($"Resolution for {DisplayCollection(assessment.Collection)} {assessment.ObjectId}")"
                                                                value="@GetResolutionValue(assessment)"
                                                                disabled="@_isPreflighting"
                                                                @onchange="args => OnResolutionChangedAsync(assessment, args)">
                                                            <option value="">Choose a resolution…</option>
                                                            @foreach (var option in GetResolutionOptions(assessment))
                                                            {
                                                                <option value="@option">@DisplayResolution(option)</option>
                                                            }
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <span class="migration-auto-resolution">
                                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" aria-hidden="true" />
                                                            Automatic
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (FilteredAssessments.Count == 0)
                            {
                                <div class="migration-empty">No records match this filter.</div>
                            }

                            @if (_preflight.Blockers.Count > 0)
                            {
                                <div class="migration-blockers" role="alert">
                                    <strong>Preflight found blocking conditions.</strong>
                                    <ul>
                                        @foreach (var blocker in _preflight.Blockers)
                                        {
                                            <li>
                                                <span>@blocker.Message</span>
                                                <code>@blocker.Code</code>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    </section>
                }
                else if (_step == WizardStep.Review && _review is not null)
                {
                    <section aria-label="Immutable migration review">
                        <div class="migration-summary-grid">
                            @foreach (var count in ReviewCounts)
                            {
                                <div>
                                    <span>@count.Label</span>
                                    <strong>@count.Value</strong>
                                </div>
                            }
                        </div>

                        <div class="migration-review-list">
                            <div>
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                <span><strong>Stable identities preserved</strong><small>Company and child object IDs remain authoritative across branches and deployments.</small></span>
                                <span class="migration-badge good">@_review.Preflight.Objects.Count records</span>
                            </div>
                            <div>
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                <span><strong>Explicit differences resolved</strong><small>The commit reuses the exact request and preflight hashes shown below.</small></span>
                                <span class="migration-badge good">@_review.Resolutions.Count decisions</span>
                            </div>
                            <div>
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                <span><strong>Recovery evidence prepared</strong><small>The pre-migration browser state and every imported bundle are archived before the hosted write; activation may retire remapped local source IDs.</small></span>
                                <span class="migration-badge good">@_sourceEntries.Count sources</span>
                            </div>
                        </div>

                        @if (_review.Source.Manifest.Companies.Count > 0)
                        {
                            <div class="migration-table-scroll mt-3">
                                <table class="migration-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Company</th>
                                            <th scope="col">Crafters</th>
                                            <th scope="col">Orders</th>
                                            <th scope="col">Payroll drafts</th>
                                            <th scope="col">Plan references</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var company in _review.Source.Manifest.Companies)
                                        {
                                            <tr>
                                                <td><strong>@DisplayCompanyName(company)</strong><code>@ShortId(company.CompanyId)</code></td>
                                                <td>@company.CrafterCount</td>
                                                <td>@company.OrderCount</td>
                                                <td>@company.PayrollDraftCount</td>
                                                <td>@company.LinkedPlanReferenceCount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="migration-hash-grid">
                            <div><span>Request hash</span><code>@_review.Preflight.RequestHash</code></div>
                            <div><span>Preflight hash</span><code>@_review.Preflight.PreflightHash</code></div>
                        </div>
                    </section>
                }
                else if (_step == WizardStep.Move && _review is not null)
                {
                    <section class="migration-commit-grid" aria-label="Commit company migration">
                        <article class="migration-commit-card">
                            <h4>Commit boundary</h4>
                            <ul>
                                <li><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /><span>@_sourceEntries.Count source inventories combined</span></li>
                                <li><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /><span>@DisplayProfileName(_review.Destination) verified</span></li>
                                <li><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /><span>Preflight permits one transactional commit</span></li>
                                <li><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /><span>Recovery archive saves before the hosted write</span></li>
                            </ul>

                            @if (_isCommitting)
                            {
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
                                <p role="status">Writing the resolved bundle and waiting for its durable receipt…</p>
                            }
                            else if (_commit is null)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           OnClick="CommitAsync">
                                    Commit migration
                                </MudButton>
                            }
                            else
                            {
                                <div class="migration-success">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                                    <span><strong>Migration committed</strong><small>This browser is now using the hosted profile.</small></span>
                                </div>
                            }

                            @if (_commitError is not null)
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">
                                    @_commitError
                                </MudAlert>
                            }
                        </article>

                        <article class="migration-commit-card">
                            <h4>Migration receipt</h4>
                            @if (_commit is null)
                            {
                                <div class="migration-receipt pending">
                                    <span>Not issued</span>
                                    <dl>
                                        <dt>Migration</dt><dd>@_review.Preflight.MigrationId</dd>
                                        <dt>Destination</dt><dd>@_review.Destination.ProfileId</dd>
                                        <dt>Receipt</dt><dd>—</dd>
                                        <dt>Server revision</dt><dd>—</dd>
                                    </dl>
                                </div>
                                <p>Retry uses the same migration ID and immutable request. It cannot silently create a second migration.</p>
                            }
                            else
                            {
                                <div class="migration-receipt success">
                                    <span>Committed</span>
                                    <dl>
                                        <dt>Migration</dt><dd>@_commit.MigrationId</dd>
                                        <dt>Request</dt><dd>@_commit.RequestHash</dd>
                                        <dt>Receipt</dt><dd>@_commit.ReceiptHash</dd>
                                        <dt>Server revision</dt><dd>@_commit.ServerRevision</dd>
                                    </dl>
                                </div>
                                <p>Recovery evidence was saved before the hosted profile became authoritative; the connection was saved last.</p>
                            }
                        </article>
                    </section>
                }
            </main>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="migration-footer">
            <div class="@GetFooterStatusClass()" role="status" aria-live="polite">
                @if (_isCapturing || _isImporting || _isRecoveringActivation || _isVerifying || _isPreflighting || _isCommitting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else
                {
                    <MudIcon Icon="@GetFooterStatusIcon()" Size="Size.Small" aria-hidden="true" />
                }
                <span>@FooterStatus</span>
            </div>
            <span class="migration-toolbar-spacer"></span>
            @if (_step != WizardStep.Sources)
            {
                <MudButton Variant="Variant.Text"
                           Disabled="@(_isCommitting || _commit is not null)"
                           OnClick="BackAsync">
                    Back
                </MudButton>
            }
            @if (_commit is not null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseWithReceipt">
                    Done
                </MudButton>
            }
            else if (_step != WizardStep.Move)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!CanContinue)"
                           OnClick="ContinueAsync">
                    @ContinueLabel
                </MudButton>
            }
        </div>
    </DialogActions>
</MudDialog>
